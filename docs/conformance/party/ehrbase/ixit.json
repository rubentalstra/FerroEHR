{
  "instances": {
    "sut": {
      "base_url": "http://localhost:8091/ehrbase/rest/openehr/v1",
      "auth": {
        "mode": "basic",
        "user_env": "SUT_USER",
        "password_env": "SUT_PASS"
      }
    },
    "admin": {
      "base_url": "http://localhost:8091/ehrbase/rest/openehr/v1",
      "auth": {
        "mode": "basic",
        "user_env": "SUT_ADMIN_USER",
        "password_env": "SUT_ADMIN_PASS"
      }
    },
    "unauthenticated": {
      "base_url": "http://localhost:8091/ehrbase/rest/openehr/v1",
      "auth": {
        "mode": "none"
      }
    }
  },
  "containers": {
    "sut": "cnf-ehrbase-ehrbase-1",
    "db": "cnf-ehrbase-ehrbase-db-1"
  },
  "environment": {
    "exclusive_server": true,
    "hardware_class": "ci-runner",
    "cores": 4,
    "memory_gb": 16,
    "storage_class": "ssd",
    "topology": "single-node docker compose (docker/sut-ehrbase.yml, ehrbase/ehrbase:2.34.0 + ehrbase-v2-postgres:16.2; no readonly principal — EHRbase Basic auth carries one clinical user and one admin user)"
  }
}
