# TLS for sandbox.ferroehr.eu, which Caddy obtains and renews on its own.
#
# The file reaches the box from inside the ferroehr image (/opt/sandbox-posture,
# docker/Dockerfile) and is installed by the deploy script, which restarts the
# caddy service when it changed — a bind-mounted file's contents changing does
# not recreate the container that mounts it.
#
# The routing table is the one vercel.json used to hold: the CDR owns its base
# path and the operational families, the console is the landing surface for
# everything else.

sandbox.ferroehr.eu {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	redir /favicon.ico /ferroehr/rest/swagger-ui/favicon-32x32.png

	# The hydration bundle is served under content-hashed names
	# (LEPTOS_HASH_FILES; docker/viewer/Dockerfile), so a changed build is a
	# changed URL and the bytes behind one URL never change — the RFC 9111
	# immutable case. Repeat visits skip re-downloading the wasm entirely.
	@bundle path /pkg/*
	header @bundle Cache-Control "public, max-age=31536000, immutable"

	@cdr path /ferroehr/* /health /health/* /management /management/* /.well-known/*
	handle @cdr {
		reverse_proxy ferroehr:8080
	}

	handle {
		reverse_proxy console:3000
	}

	log {
		output stdout
		format console
	}
}
