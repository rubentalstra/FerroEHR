            </archetype_id>
            <term_definitions code="at0000">
              <items id="description">Измерение температуры тела, которая является суррогатом температуры тела человека в целом.</items>
              <items id="text">Температура тела</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">**(en)</items>
              <items id="text">Дерево</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="description">*@ internal @(en)</items>
              <items id="text">История</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="description">Любое событие.</items>
              <items id="text">Любое событие</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="description">Измеряется температура тела (как суррогат для всего тела).</items>
              <items id="text">Температура</items>
            </term_definitions>
            <term_definitions code="at0020">
              <items id="description">*@ internal @(en)</items>
              <items id="text">Дерево!!</items>
            </term_definitions>
            <term_definitions code="at0021">
              <items id="description">Анатомическое место измернеия температуры.</items>
              <items id="text">Место измерения</items>
            </term_definitions>
            <term_definitions code="at0022">
              <items id="description">Температура измеряется в ротовой полости.</items>
              <items id="text">Рот</items>
            </term_definitions>
            <term_definitions code="at0023">
              <items id="description">Температура измеряется в наружном слуховом проходе.</items>
              <items id="text">Наружный слуховой проход</items>
            </term_definitions>
            <term_definitions code="at0024">
              <items id="description">Температура измеряется в кожной складке в подмышечной впадине, рука опущена вниз и прижата к туловищу.</items>
              <items id="text">Подмышечная впадина</items>
            </term_definitions>
            <term_definitions code="at0025">
              <items id="description">Температура измеряется внутри прямой кишки.</items>
              <items id="text">Прямая кишка</items>
            </term_definitions>
            <term_definitions code="at0026">
              <items id="description">Температура измеряется в носоглотке.</items>
              <items id="text">Носоглотка</items>
            </term_definitions>
            <term_definitions code="at0027">
              <items id="description">Температура измеряется внутри мочевого пузыря.</items>
              <items id="text">Мочевой пузырь</items>
            </term_definitions>
            <term_definitions code="at0028">
              <items id="description">Температура измеряется внутри сосоудистого русла.</items>
              <items id="text">Внутрисосудистая</items>
            </term_definitions>
            <term_definitions code="at0029">
              <items id="description">Информация о состоянии пациента.</items>
              <items id="text">Состояние</items>
            </term_definitions>
            <term_definitions code="at0030">
              <items id="description">*The thermal situation of the person who is having the temperature taken(en)</items>
              <items id="text">*Body exposure(en)</items>
            </term_definitions>
            <term_definitions code="at0031">
              <items id="description">Без одежды, ничем не укрыт.</items>
              <items id="text">Обнажён</items>
            </term_definitions>
            <term_definitions code="at0032">
              <items id="description">На пациенте меньшее количество одежды / постельных принадлежностей, чем этого требуют условия внешней среды.</items>
              <items id="text">Лёгкая одежда/постель</items>
            </term_definitions>
            <term_definitions code="at0033">
              <items id="description">Одежда/постельные принадлежности пациента соответствуют условиям внешней среды.</items>
              <items id="text">Соответствующая одежда/постель</items>
            </term_definitions>
            <term_definitions code="at0034">
              <items id="description">На пациенте большее количество одежды / постельных принадлежностей, чем этого требуют условия внешней среды.</items>
              <items id="text">Теплая одежда/постель</items>
            </term_definitions>
            <term_definitions code="at0041">
              <items id="description">Описание особенностей, которые могут повлиять на результат измерения температуры тела.</items>
              <items id="text">Тепловой стресс</items>
            </term_definitions>
            <term_definitions code="at0043">
              <items id="description">Температура измеряется на поверхности кожи.</items>
              <items id="text">Кожа</items>
            </term_definitions>
            <term_definitions code="at0051">
              <items id="description">Температура измеряется внутри влагвалища.</items>
              <items id="text">Влагалище</items>
            </term_definitions>
            <term_definitions code="at0054">
              <items id="description">Температура измеряется внитри пищевода.</items>
              <items id="text">Пищевод</items>
            </term_definitions>
            <term_definitions code="at0055">
              <items id="description">Температура измеряется в паховой складке кожи между ногой и передней брюшной стенкой.</items>
              <items id="text">Паховая складка</items>
            </term_definitions>
            <term_definitions code="at0056">
              <items id="description">Подробная информация об условиях внешней среды в момент изменения температуры.</items>
              <items id="text">Условия внешней среды</items>
            </term_definitions>
            <term_definitions code="at0057">
              <items id="description">Подробная информация о нагрузках в момент измерения температуры.</items>
              <items id="text">Нагрузка</items>
            </term_definitions>
            <term_definitions code="at0058">
              <items id="description">Информация о фазе менструального цикла у женщины.</items>
              <items id="text">Менструальный цикл</items>
            </term_definitions>
            <term_definitions code="at0059">
              <items id="description">Информация об устройстве, используемом для измерения температуры тела.</items>
              <items id="text">Устройство</items>
            </term_definitions>
