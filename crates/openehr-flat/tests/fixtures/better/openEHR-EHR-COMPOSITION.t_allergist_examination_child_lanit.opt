                              <items id="text">Пищеварительная система</items>
                            </term_definitions>
                            <term_definitions code="at0047">
                              <items id="description">*</items>
                              <items id="text">использование ортопедического приспособления</items>
                            </term_definitions>
                            <term_definitions code="at0048">
                              <items id="description">*</items>
                              <items id="text">направлен в школу диабета</items>
                            </term_definitions>
                            <term_definitions code="at0049">
                              <items id="description">*</items>
                              <items id="text">направлен на консультацию в центр «диабетическая стопа»</items>
                            </term_definitions>
                            <term_definitions code="at0050">
                              <items id="description">*</items>
                              <items id="text">обследование полового партнера</items>
                            </term_definitions>
                            <term_definitions code="at0051">
                              <items id="description">*</items>
                              <items id="text">самоконтроль гликемии натощак</items>
                            </term_definitions>
                            <term_definitions code="at0052">
                              <items id="description">*</items>
                              <items id="text">самоконтроль гликемии через 2 часа после еды</items>
                            </term_definitions>
                            <term_definitions code="at0053">
                              <items id="description">*</items>
                              <items id="text">при возникновении болезненных явлений со стороны женской половой сферы, немедленно обратиться к врачу-гинекологу</items>
                            </term_definitions>
                            <term_definitions code="at0054">
                              <items id="description">*</items>
                              <items id="text">Сердечно-сосудистая система</items>
                            </term_definitions>
                            <term_definitions code="at0055">
                              <items id="description">*</items>
                              <items id="text">контроль пульса</items>
                            </term_definitions>
                            <term_definitions code="at0056">
                              <items id="description">*</items>
                              <items id="text">контроль артериального давления</items>
                            </term_definitions>
                            <term_definitions code="at0057">
                              <items id="description">*</items>
                              <items id="text">Дыхательная система</items>
                            </term_definitions>
                            <term_definitions code="at0058">
                              <items id="description">*</items>
                              <items id="text">отказ от курения</items>
                            </term_definitions>
                            <term_definitions code="at0059">
                              <items id="description">*</items>
                              <items id="text">Выделительная система</items>
                            </term_definitions>
                            <term_definitions code="at0060">
                              <items id="description">*</items>
                              <items id="text">ведение дневника мочеиспусканий</items>
                            </term_definitions>
                            <term_definitions code="at0061">
                              <items id="description">*</items>
                              <items id="text">дозированные регулярные физические нагрузки</items>
                            </term_definitions>
                            <term_definitions code="at0062">
                              <items id="description">*</items>
                              <items id="text">Иммунная система</items>
                            </term_definitions>
                            <term_definitions code="at0063">
                              <items id="description">*</items>
                              <items id="text">элиминационная диета</items>
                            </term_definitions>
                            <term_definitions code="at0064">
                              <items id="description">*</items>
                              <items id="text">элиминационные мероприятия</items>
                            </term_definitions>
                            <term_definitions code="at0065">
                              <items id="description">*</items>
                              <items id="text">ведение пищевого дневника</items>
                            </term_definitions>
                            <term_definitions code="at0066">
                              <items id="description">*</items>
                              <items id="text">обучение правилам и технике введения адреналина, кортикостероидов, антигистаминных препаратов</items>
                            </term_definitions>
                            <term_definitions code="at0067">
                              <items id="description">*</items>
                              <items id="text">обучение технике ингаляций при бронхиальной астме и использования различных средств доставки аэрозолей, применения спейсера, небулайзера</items>
                            </term_definitions>
                            <term_definitions code="at0068">
                              <items id="description">*</items>
                              <items id="text">обучение ведению дневника больного аллергически ринитом</items>
                            </term_definitions>
                            <term_definitions code="at0069">
                              <items id="description">*</items>
                              <items id="text">обучение использованию назальных спреев больных аллергичесим ринитом.</items>
                            </term_definitions>
                            <term_definitions code="at0070">
                              <items id="description">*</items>
                              <items id="text">обучение правилам ухода за кожей и наружной лекарственной терапии больным с атопическим дерматитом</items>
                            </term_definitions>
                            <term_definitions code="at0071">
                              <items id="description">*</items>
                              <items id="text">разработка плана самоконтроля для больных первичными иммунодефицитами</items>
                            </term_definitions>
                            <term_definitions code="at0072">
                              <items id="description">*</items>
                              <items id="text">обсуждение правил лечения иммунодефицита, выявленного у больного, и возможных методов лечения</items>
                            </term_definitions>
                            <term_definitions code="at0073">
                              <items id="description">*</items>
                              <items id="text">ведение дневника самоконтроля</items>
                            </term_definitions>
                            <term_definitions code="at0074">
                              <items id="description">*</items>
                              <items id="text">ведение пищевого дневника</items>
                            </term_definitions>
                            <term_definitions code="at0075">
                              <items id="description">*</items>
                              <items id="text">элиминационный режим</items>
                            </term_definitions>
                            <term_definitions code="at0076">
                              <items id="description">*</items>
                              <items id="text">не содержать животных дома, избегать контакта с ними</items>
                            </term_definitions>
                            <term_definitions code="at0077">
                              <items id="description">*</items>
                              <items id="text">освободить от уборок помещений и территории, работ с пыльным материалом, бытовой химией</items>
                            </term_definitions>
                            <term_definitions code="at0078">
                              <items id="description">*</items>
                              <items id="text">избегать пребывания в сырых помещениях, исключить работу с землёй</items>
                            </term_definitions>
                            <term_definitions code="at0079">
                              <items id="description">*</items>
                              <items id="text">избегать контакта с никель-содержащими металлами</items>
                            </term_definitions>
                            <term_definitions code="at0080">
                              <items id="description">*</items>
                              <items id="text">избегать контакта с латексом</items>
                            </term_definitions>
                            <term_definitions code="at0081">
                              <items id="description">*</items>
                              <items id="text">Аллергология</items>
                            </term_definitions>
                            <term_definitions code="at0082">
                              <items id="description">*</items>
                              <items id="text">не вакцинировать, не проводить р. Манту, плановых оперативных вмешательств, рентгено-контрастных обследований</items>
                            </term_definitions>
                            <term_definitions code="at0083">
                              <items id="description">*</items>
                              <items id="text">освобождать от уборок помещений и территории, любых работ на улице</items>
                            </term_definitions>
                            <term_definitions code="at0084">
                              <items id="description">*</items>
                              <items id="text">освобождать от занятий физкультурой на улице</items>
                            </term_definitions>
                            <term_definitions code="at0085">
                              <items id="description">*</items>
                              <items id="text">домашний режим на 2-4 недели в период обострения пыльцевой аллергии</items>
                            </term_definitions>
                            <term_definitions code="at0086">
                              <items id="description">*</items>
                              <items id="text">соблюдать диету с учётом возможной перекрёстной пыльцевой аллергии</items>
                            </term_definitions>
                            <term_definitions code="at0087">
                              <items id="description">*</items>
                              <items id="text">не применять  фитопрепараты, не употреблять мёд</items>
                            </term_definitions>
                            <term_definitions code="at0088">
                              <items id="description">*</items>
                              <items id="text">вести дневник симптомов</items>
                            </term_definitions>
                            <term_definitions code="at0089">
                              <items id="description">*</items>
                              <items id="text">целесообразно менять климатическую полосу в сезон пыления причинных растений</items>
                            </term_definitions>
                            <term_definitions code="at0090">
                              <items id="description">*</items>
                              <items id="text">Подробности</items>
                            </term_definitions>
                            <term_definitions code="at0091">
                              <items id="description">*</items>
                              <items id="text">разработка плана элиминационных мероприятий</items>
                            </term_definitions>
                            <term_definitions code="at0092">
                              <items id="description">*</items>
                              <items id="text">проверка техники использования ингаляционных препаратов</items>
                            </term_definitions>
                            <term_definitions code="at0093">
                              <items id="description">*</items>
                              <items id="text">обучение методике пикфлоуметрии и составление индивидуального плана самоконтроля для больного с астмой</items>
                            </term_definitions>
                            <term_definitions code="at0094">
                              <items id="description">*</items>
                              <items id="text">регулярное прохождение профилактических медицинских осмотров</items>
                            </term_definitions>
                            <term_definitions code="at0095">
                              <items id="description">*</items>
                              <items id="text">регулярное прохождение диспансерного (динамического) наблюдения у врача</items>
                            </term_definitions>
                            <term_definitions code="at0096">
                              <items id="description">*</items>
                              <items id="text">выполнение назначенных врачом исследований</items>
                            </term_definitions>
                            <term_definitions code="at0097">
                              <items id="description">*</items>
                              <items id="text">Подробности</items>
                            </term_definitions>
                            <term_definitions code="at0098">
                              <items id="description">*</items>
                              <items id="text">контроль уровня глюкозы  крови</items>
                            </term_definitions>
                            <term_definitions code="at0099">
                              <items id="description">*</items>
                              <items id="text">Нервная система</items>
                            </term_definitions>
                            <term_definitions code="at0100">
                              <items id="description">*</items>
                              <items id="text">индивидуальное профилактическое  консультирование</items>
                            </term_definitions>
                            <term_definitions code="at0101">
                              <items id="description">*</items>
                              <items id="text">групповое профилактическое  консультирование</items>
                            </term_definitions>
                          </children>
