            <term_definitions code="at0000">
              <items id="description">Рост или длина тела измеряется от макушки до подошв.</items>
              <items id="text">Рост</items>
            </term_definitions>
            <term_definitions code="at0000.1">
              <items id="description">Рост или длина тела измеряется от макушки до подошв.   Height is measured with the individual in a standing position and body length in a recumbent position.(en)</items>
              <items id="text">Рост/длина тела</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">*@ internal @(en)</items>
              <items id="text">*history(en)</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="description">Результат измерения роста или длины тела в любое время. </items>
              <items id="text">Любое событие</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="description">*@ internal @(en)</items>
              <items id="text">*Simple(en)</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="description">Длина тела от макушки до подошв.  </items>
              <items id="text">Рост/длина тела</items>
            </term_definitions>
            <term_definitions code="at0004.1">
              <items id="description">Длина тела от макушки до подошв.  </items>
              <items id="text">Рост</items>
            </term_definitions>
            <term_definitions code="at0007">
              <items id="description">*@ internal @(en)</items>
              <items id="text">*List(en)</items>
            </term_definitions>
            <term_definitions code="at0011">
              <items id="description">Описание устройства, использованного для измерения роста или длины тела. </items>
              <items id="text">Оборудование</items>
            </term_definitions>
            <term_definitions code="at0013">
              <items id="description">*@ internal @(en)</items>
              <items id="text">*Tree(en)</items>
            </term_definitions>
            <term_definitions code="at0014">
              <items id="description">Положение человека во время измерения. </items>
              <items id="text">Положение</items>
            </term_definitions>
            <term_definitions code="at0016">
              <items id="description">Рост измеряется в положении стоя на обеих ногах с весом, распределенным равномерно, пятки вместе, ягодицы и пятки касаются вертикальной задней планки. </items>
              <items id="text">Стоя</items>
            </term_definitions>
            <term_definitions code="at0018">
              <items id="description">Комментарий к измерению роста или длины тела. </items>
              <items id="text">Комментарий</items>
            </term_definitions>
            <term_definitions code="at0019">
              <items id="description">Сведения о всех проблемах или факторах, которые могли оказать влияние на результат измерения роста/ длины тела (например, информация об ампутации). </items>
              <items id="text">Мешающие факторы</items>
            </term_definitions>
            <term_definitions code="at0020">
              <items id="description">Длина тела измеряется в полностью растянутом положении лежа, с плоским тазом, вытянутыми ногами и подтянутыми ступнями. </items>
              <items id="text">Лежа</items>
            </term_definitions>
          </children>
