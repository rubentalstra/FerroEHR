            <term_definitions code="at1018">
              <items id="description">Комментарий к записи и другие случайные факторы, которые могут вносить свой вклад в частоту сердечных сокращений и ритм измерения. Например, уровень тревожности, боли или лихорадки и т.д.</items>
              <items id="text">Смешанные факторы</items>
            </term_definitions>
            <term_definitions code="at1019">
              <items id="description">Источник частоты сердечных сокращений и  записи ритма.</items>
              <items id="text">Метод</items>
            </term_definitions>
            <term_definitions code="at1020">
              <items id="description">Прямая аускультации сердца.</items>
              <items id="text">Аускультация</items>
            </term_definitions>
            <term_definitions code="at1021">
              <items id="description">Производное от электрической активности сердца, часто с помощью электрокардиографа.</items>
              <items id="text">Прибор</items>
            </term_definitions>
