                              <items id="text">Локализованная болезненность</items>
                            </term_definitions>
                            <term_definitions code="at0011">
                              <items id="description">Область, место или орган, являющаяся (являющийся) объектом пальпации.</items>
                              <items id="text">Место на теле</items>
                            </term_definitions>
                            <term_definitions code="at0012">
                              <items id="description">Показатели нормы при осмотре</items>
                              <items id="text">Описание нормы</items>
                            </term_definitions>
                            <term_definitions code="at0013">
                              <items id="description">Пальпация не выявила отклонений от нормы.</items>
                              <items id="text">Норма</items>
                            </term_definitions>
                            <term_definitions code="at0014">
                              <items id="description">Пальпация в целом не выявила отклонений от нормы, но некоторая неопределенность осталась.</items>
                              <items id="text">Вероятно, норма</items>
                            </term_definitions>
                            <term_definitions code="at0015">
                              <items id="description">При пальпации аномалий не обнаружено.</items>
                              <items id="text">Отклонений от нормы не выявлено</items>
                            </term_definitions>
                            <term_definitions code="at0019">
                              <items id="description">Группа указаний относительно болезненности при  пальпации.</items>
                              <items id="text">Болезненность</items>
                            </term_definitions>
                            <term_definitions code="at0020">
                              <items id="description">Степень болезненных ощущений при пальпации.</items>
                              <items id="text">Степень</items>
                            </term_definitions>
                            <term_definitions code="at0020.1">
                              <items id="description">Степень болезненных ощущений при пальпации.</items>
                              <items id="text">Степень</items>
                            </term_definitions>
                            <term_definitions code="at0021">
                              <items id="description">Некоторое ощущение боли или дискомфорта при пальпации.</items>
                              <items id="text">Слабая</items>
                            </term_definitions>
                            <term_definitions code="at0022">
                              <items id="description">При пальпации возникают отчетливые болезненные ощущения.</items>
                              <items id="text">Средняя</items>
                            </term_definitions>
                            <term_definitions code="at0023">
                              <items id="description">Мягкая пальпация вызывает умеренную боль.</items>
                              <items id="text">Заметная</items>
                            </term_definitions>
                            <term_definitions code="at0024">
                              <items id="description">Мягкая пальпация вызывает сильную боль.</items>
                              <items id="text">Сильная</items>
                            </term_definitions>
                            <term_definitions code="at0025">
                              <items id="description">При пальпации ощущается напряжение мышц живота.</items>
                              <items id="text">Напряженность</items>
                            </term_definitions>
                            <term_definitions code="at0041">
                              <items id="description">Температура, ощущаемая при пальпации.</items>
                              <items id="text">Температура</items>
                            </term_definitions>
                            <term_definitions code="at0042">
                              <items id="description">Температура кажется сильно ниже нормы.</items>
                              <items id="text">Холод</items>
                            </term_definitions>
                            <term_definitions code="at0043">
                              <items id="description">Температура кажется несколько ниже нормы.</items>
                              <items id="text">Прохладность</items>
                            </term_definitions>
                            <term_definitions code="at0044">
                              <items id="description">Температура кажется нормальной.</items>
                              <items id="text">Норма</items>
                            </term_definitions>
                            <term_definitions code="at0045">
                              <items id="description">Температура кажется превышающей норму.</items>
                              <items id="text">Тепло</items>
                            </term_definitions>
                            <term_definitions code="at0046">
                              <items id="description">Температура кажется сильно повышенной.</items>
                              <items id="text">Горячо</items>
                            </term_definitions>
                            <term_definitions code="at0047">
                              <items id="description">Детальное обследование обстоятельств, обнаруженных при пальпации.</items>
                              <items id="text">Сведения</items>
                            </term_definitions>
                            <term_definitions code="at0048">
                              <items id="description">Плотность поверхности или границы объекта пальпации.</items>
                              <items id="text">Консистенция</items>
                            </term_definitions>
                            <term_definitions code="at0048.1">
                              <items id="description">Плотность поверхности или границы объекта пальпации.</items>
                              <items id="text">Консистенция</items>
                            </term_definitions>
                            <term_definitions code="at0049">
                              <items id="description">Поверхность твердая или напряженная.</items>
                              <items id="text">Твердость/напряженность</items>
                            </term_definitions>
                            <term_definitions code="at0050">
                              <items id="description">Поверхность твердая.</items>
                              <items id="text">Твердая</items>
                            </term_definitions>
                            <term_definitions code="at0052">
                              <items id="description">Поверхность мягкая.</items>
                              <items id="text">мягкая</items>
                            </term_definitions>
                            <term_definitions code="at0053">
                              <items id="description">Результаты, относящиеся к поверхности или границе объекта пальпации.</items>
                              <items id="text">Консистенция/граница</items>
                            </term_definitions>
                            <term_definitions code="at0054">
                              <items id="description">Особенности поверхности или границы.</items>
                              <items id="text">Особенности</items>
                            </term_definitions>
                            <term_definitions code="at0054.1">
                              <items id="description">Особенности поверхности или границы.</items>
                              <items id="text">Неоднородность консистенции</items>
                            </term_definitions>
                            <term_definitions code="at0055">
                              <items id="description">Поверхность или граница является гладкой.</items>
                              <items id="text">Гладкая</items>
                            </term_definitions>
                            <term_definitions code="at0056">
                              <items id="description">Крупные нерегулярности.</items>
                              <items id="text">Неровная</items>
                            </term_definitions>
                            <term_definitions code="at0057">
                              <items id="description">Поверхность или граница нерегулярная.</items>
                              <items id="text">Нерегулярная</items>
                            </term_definitions>
                            <term_definitions code="at0058">
                              <items id="description">Поверхность характеризуется наличием утолщений.</items>
                              <items id="text">Узловатая</items>
                            </term_definitions>
                            <term_definitions code="at0059">
                              <items id="description">Группа признаков, описывающих состояние нормы при пальпации</items>
                              <items id="text">Описание нормы</items>
                            </term_definitions>
                            <term_definitions code="at0060">
                              <items id="description">Пальпация не выявила раздутости, сосредоточений или напряженности.</items>
                              <items id="text">Мягкость</items>
                            </term_definitions>
                            <term_definitions code="at0061">
                              <items id="description">Пальпация не выявила болезненности.</items>
                              <items id="text">Отсутствие болезненности</items>
                            </term_definitions>
                            <term_definitions code="at0062">
                              <items id="description">Поверхность мягкая с дряблостью.</items>
                              <items id="text">Дряблость</items>
                            </term_definitions>
                            <term_definitions code="at0063">
                              <items id="description">После нажатий на поверхности или на границе остаются вмятины.</items>
                              <items id="text">Вмятины</items>
                            </term_definitions>
                            <term_definitions code="at0064">
                              <items id="description">Поверхность объекта пальпации.</items>
                              <items id="text">Поверхность</items>
                            </term_definitions>
                            <term_definitions code="at0065">
                              <items id="description">Граница объекта пальпации.</items>
                              <items id="text">Край</items>
                            </term_definitions>
                            <term_definitions code="at0067">
                              <items id="description">Информация о местонахождении пальпируемой поверхности или границы.</items>
                              <items id="text">Описание места</items>
                            </term_definitions>
                            <term_definitions code="at0068">
                              <items id="description">Никакие узелки не прощупываются.</items>
                              <items id="text">Отсутствие узелков</items>
                            </term_definitions>
                            <term_definitions code="at0069">
                              <items id="description">Инородные тела не прощупываются</items>
                              <items id="text">Отсутствие инородных тел</items>
                            </term_definitions>
                            <term_definitions code="at0070">
                              <items id="description">Напряжение подшлежащих мышц при пальпации.</items>
                              <items id="text">Мышечная защита</items>
                            </term_definitions>
                            <term_definitions code="at0071">
