                              <items id="text">Степень</items>
                            </term_definitions>
                            <term_definitions code="at0072">
                              <items id="description">Характер мышечного дефанса.</items>
                              <items id="text">Характер</items>
                            </term_definitions>
                            <term_definitions code="at0073">
                              <items id="description">Дефанс очевидно сознательный со стороны субъекта.</items>
                              <items id="text">Сознательный</items>
                            </term_definitions>
                            <term_definitions code="at0074">
                              <items id="description">Дефанс происходит помимо желания субъекта.</items>
                              <items id="text">Непроизвольный</items>
                            </term_definitions>
                            <term_definitions code="at0075">
                              <items id="description">Непонятно, сознательным или непроизвольным является мышечный дефанс.</items>
                              <items id="text">Неопределенный</items>
                            </term_definitions>
                            <term_definitions code="at0076">
                              <items id="description">Дефанс отсутствует</items>
                              <items id="text">Отсутствует</items>
                            </term_definitions>
                            <term_definitions code="at0077">
                              <items id="description">Имеет место некоторый дефанс при глубокой пальпации.</items>
                              <items id="text">Слабый</items>
                            </term_definitions>
                            <term_definitions code="at0078">
                              <items id="description">Имеет место мышечный дефанс при средней пальпации.</items>
                              <items id="text">Средний</items>
                            </term_definitions>
                            <term_definitions code="at0079">
                              <items id="description">Имеет место мышечный дефанс при очень слабой пальпации.</items>
                              <items id="text">Сильный</items>
                            </term_definitions>
                            <term_definitions code="at0080">
                              <items id="description">Группа результатов.</items>
                              <items id="text">Результаты</items>
                            </term_definitions>
                            <term_definitions code="at0081">
                              <items id="description">При пальпации ощущается позыв к кашлю.</items>
                              <items id="text">Позыв к кашлю</items>
                            </term_definitions>
                            <term_definitions code="at0082">
                              <items id="description">Пальпация не выявила наличия грыж.</items>
                              <items id="text">Отсутствие грыж</items>
