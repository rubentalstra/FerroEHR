            <term_definitions code="at0.1054">
              <items id="description">*</items>
              <items id="text">Повышение АД в течение</items>
            </term_definitions>
            <term_definitions code="at0.1055">
              <items id="description">*</items>
              <items id="text">Подробности</items>
            </term_definitions>
            <term_definitions code="at0.1056">
              <items id="description">*</items>
              <items id="text">Дата</items>
            </term_definitions>
            <term_definitions code="at0000">
              <items id="description">Локальное измерение артериального давления, являющееся отражением системного артериального давления. Как правило, использование термина "артериальное давление" относится к измерению давления плечевой артерии</items>
              <items id="text">Артериальное давление</items>
            </term_definitions>
            <term_definitions code="at0000.1">
              <items id="description">Локальное измерение артериального давления, являющееся отражением системного артериального давления. Как правило, использование термина "артериальное давление" относится к измерению давления плечевой артерии</items>
              <items id="text">Артериальное давление</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">История</items>
              <items id="text">История</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="description">апр</items>
              <items id="text">апра</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="description">Систолическое давление</items>
              <items id="text">Систолическое давление</items>
            </term_definitions>
            <term_definitions code="at0004.1">
              <items id="comment">норма: менее 130</items>
              <items id="description">Систолическое давление</items>
              <items id="text">Систолическое</items>
            </term_definitions>
            <term_definitions code="at0005">
              <items id="description">Диастолическое давление</items>
              <items id="text">Диастолическое давление</items>
            </term_definitions>
            <term_definitions code="at0005.1">
              <items id="comment">норма: менее 85</items>
              <items id="description">Диастолическое давление</items>
              <items id="text">Диастолическое</items>
            </term_definitions>
            <term_definitions code="at0006">
              <items id="description">any event</items>
              <items id="text">any event</items>
            </term_definitions>
            <term_definitions code="at0007">
              <items id="description">рпа</items>
              <items id="text">еары</items>
            </term_definitions>
            <term_definitions code="at0008">
              <items id="description">Поза пациента во время измерения давления.</items>
              <items id="text">Поза</items>
            </term_definitions>
            <term_definitions code="at0008.1">
              <items id="description">Поза пациента во время измерения давления.</items>
              <items id="text">Поза</items>
            </term_definitions>
            <term_definitions code="at0011">
              <items id="description">пр</items>
              <items id="text">апра</items>
            </term_definitions>
            <term_definitions code="at0013">
              <items id="description">Размер манжеты для измерения кровяного давления.</items>
              <items id="text">Размер манжеты(ru)</items>
            </term_definitions>
            <term_definitions code="at0014">
              <items id="description">Обобщенное место тела, в которм производится измерение артериального давления.</items>
              <items id="text">Место измерения</items>
            </term_definitions>
            <term_definitions code="at0015">
              <items id="description">Манжеты для бедра  взрослого- пузырь приблизительно 20см х 42см.</items>
              <items id="text">Взрослая для бедра</items>
            </term_definitions>
            <term_definitions code="at0016">
              <items id="description">Манжета для руки взрослого, увеличенного объёма -  пузырь приблизительно 16cm x 38cm.</items>
              <items id="text">Взрослая большая</items>
            </term_definitions>
            <term_definitions code="at0017">
              <items id="description">Манжета стандартная для взрослого - пузырь приблизительно 13 х 30cm.</items>
              <items id="text">Взрослая</items>
            </term_definitions>
            <term_definitions code="at0025">
              <items id="description">Правая рука пациента.</items>
              <items id="text">правая рука</items>
            </term_definitions>
            <term_definitions code="at0026">
              <items id="description">Левая рука пациента.</items>
              <items id="text">левая рука</items>
            </term_definitions>
            <term_definitions code="at0027">
              <items id="description">Правое бедро пациента.</items>
              <items id="text">правое бедро</items>
            </term_definitions>
            <term_definitions code="at0028">
              <items id="description">Левое бедро пациента.</items>
              <items id="text">левое бедро</items>
            </term_definitions>
            <term_definitions code="at0033">
              <items id="description">Комментарии к измерению кровяного давления.</items>
              <items id="text">Комментарии</items>
            </term_definitions>
            <term_definitions code="at1000">
              <items id="description">Пациент стоит во время измерения АД.</items>
              <items id="text">стоя</items>
            </term_definitions>
            <term_definitions code="at1001">
              <items id="description">Пациент сидит во время измерения АД (на стуле, кровати или кресле).</items>
              <items id="text">сидя</items>
            </term_definitions>
            <term_definitions code="at1002">
              <items id="description">Пациент лежит в вынужденной неизменной позе (на реклинации)во время измерения АД.</items>
              <items id="text">реклинация</items>
            </term_definitions>
            <term_definitions code="at1003">
              <items id="description">Пациент лежит во время измерения АД.</items>
              <items id="text">лёжа</items>
            </term_definitions>
            <term_definitions code="at1005">
              <items id="description">краниокаудальный наклон поверхности, на которой лежит пациент во время измерения АД.</items>
              <items id="text">Наклонная поверхность</items>
            </term_definitions>
            <term_definitions code="at1006">
              <items id="description">Среднее артериальное давление на всём протяжении цикла сокращения и релаксации сердца.</items>
              <items id="text">Среднее АД</items>
            </term_definitions>
            <term_definitions code="at1007">
              <items id="description">Разница между систолическим и диастолическим давлением.</items>
              <items id="text">Пульсовое давление</items>
            </term_definitions>
            <term_definitions code="at1008">
              <items id="description">Манжета взрослая малая - пузырь приблизительно 10 x 24cm.</items>
              <items id="text">Взрослая малая</items>
            </term_definitions>
            <term_definitions code="at1009">
              <items id="description">Манжета для детей или взрослых с тонкой рукой - пузырь примерно 8см x 21cm.</items>
              <items id="text">Педиатрическая(детская)</items>
            </term_definitions>
            <term_definitions code="at1010">
              <items id="description">Запись звука Короткова который используют для определения диастолического давления с помощью метода аускультации.</items>
              <items id="text">Диастолическая конечная точка</items>
            </term_definitions>
            <term_definitions code="at1011">
              <items id="description">Четвёртый звук Короткова, определяющийся как резкое приглушение звуков.</items>
              <items id="text">Фаза 4</items>
            </term_definitions>
            <term_definitions code="at1012">
              <items id="description">Пятый звук Короткова определяется отсутствием звуков, так как давление в манжете падает ниже диастолического артериального давления.</items>
              <items id="text">Фаза 5</items>
            </term_definitions>
            <term_definitions code="at1014">
              <items id="description">Лёжа на плоской поверхности с боковым наклоном, как правило, под углом по направлению с левой стороны. Обычно требуется в последнем триместре беременности, чтобы облегчить сдавление нижней полой вены.</items>
              <items id="text">лёжа с наклоном влево</items>
            </term_definitions>
            <term_definitions code="at1018">
              <items id="description">Манжета для младенцев - пузырь приблизительно 5см x 15cm.</items>
              <items id="text">Для младенцев</items>
            </term_definitions>
            <term_definitions code="at1019">
              <items id="description">Манжета для новорожденных, используется в соответствии с весом новорожденного.</items>
              <items id="text">Для новорожденных</items>
            </term_definitions>
            <term_definitions code="at1020">
              <items id="description">Правое запястье пациента.</items>
              <items id="text">Правое запястье</items>
            </term_definitions>
            <term_definitions code="at1021">
              <items id="description">Левое запястье пациента.</items>
              <items id="text">Левое запястье</items>
            </term_definitions>
            <term_definitions code="at1025">
              <items id="description">Информация о сфигмоманометре или другом устройстве, используемом для измерения АД.</items>
              <items id="text">Устройство</items>
            </term_definitions>
            <term_definitions code="at1026">
              <items id="description">Правая лодыжка пациента.</items>
              <items id="text">Правая лодыжка</items>
            </term_definitions>
            <term_definitions code="at1030">
              <items id="description">Подробная информация о физической деятельности, осуществляемой во время измерения АД.</items>
              <items id="text">Нагрузка</items>
            </term_definitions>
            <term_definitions code="at1031">
              <items id="description">Левая лодыжка пациента</items>
              <items id="text">Левая лодыжка</items>
            </term_definitions>
            <term_definitions code="at1032">
              <items id="description">Палец руки пациента. Уточнение может быть записано в элемент данных "Точное месторасположение", в случае необходимости.</items>
              <items id="text">Палец руки</items>
            </term_definitions>
            <term_definitions code="at1033">
              <items id="description">Место тела, где измеряется АД. Используйте "Место измерения", чтобы выбрать из обобщённых мест. Используйте "Точное местограсположение", чтобы записать более конкретную информацию или место, которое не входит в обобщённый список или обратиться к внешней терминологии.</items>
              <items id="text">*Location(en)</items>
            </term_definitions>
            <term_definitions code="at1034">
              <items id="description">Конкретные сведения о месте тела, где  регистрируется АД.</items>
              <items id="text">Точное месторасположение</items>
            </term_definitions>
            <term_definitions code="at1035">
              <items id="description">Метод измерения кровяного давления.</items>
              <items id="text">Метод</items>
            </term_definitions>
            <term_definitions code="at1036">
              <items id="description">Неинвазивный метод измерения АД с использованием стетоскопа и звуков Короткова.</items>
              <items id="text">Аускультация</items>
            </term_definitions>
            <term_definitions code="at1037">
              <items id="description">Неинвазивный метод измерения АД с использованием пальпации (обычно плечевой или лучевой артерии).</items>
              <items id="text">Пальпация</items>
            </term_definitions>
            <term_definitions code="at1038">
              <items id="description">Формула, используемая для вычисления СрАД (если требуется записывать).</items>
              <items id="text">Формула среднего артериального давления</items>
            </term_definitions>
            <term_definitions code="at1039">
              <items id="description">Неинвазивный метод измерения АД с помощью автоматического тонометра.</items>
              <items id="text">Автоматический тонометр</items>
            </term_definitions>
            <term_definitions code="at1040">
              <items id="description">Инвазивный метод измерения АД, с помещением датчика внутри кровеносного сосуда.</items>
              <items id="text">Инвазивный</items>
            </term_definitions>
            <term_definitions code="at1042">
              <items id="description">Оценка среднего АД за период в 24 часа.</items>
              <items id="text">Среднее за 24 часа</items>
            </term_definitions>
            <term_definitions code="at1043">
              <items id="description">Стадия сна - для интерпретации записи амбулаторного измерения АД в течение 42 часов.</items>
              <items id="text">Стадия сна(ru)</items>
            </term_definitions>
            <term_definitions code="at1044">
              <items id="description">Пациент полностью в сознании.</items>
              <items id="text">Пробуждение и подъём</items>
            </term_definitions>
            <term_definitions code="at1045">
              <items id="description">Пациент находится в состоянии естественного покоя, тело расслаблено.</items>
              <items id="text">Сон</items>
            </term_definitions>
            <term_definitions code="at1051">
              <items id="description">Палец ноги пациента. Уточнение может быть записано в элемент данных "Точное месторасположение", в случае необходимости.</items>
              <items id="text">Палец ноги</items>
            </term_definitions>
            <term_definitions code="at1052">
              <items id="description">Комментарий и записи других случайных факторов, которые могут способствовать измерению артериального давления. Например,"боязнь белого халата" или боль и жар, изменения атмосферного давления т.д.</items>
              <items id="text">Стохастические факторы(ru)</items>
            </term_definitions>
            <term_definitions code="at1053">
              <items id="description">Инвазивное измерение с помощью датчика линии доступа в артерию. Расположение датчика могут быть записаны в элемент данных "Точное месторасположение", в случае необходимости.</items>
              <items id="text">Внутриартериальное</items>
            </term_definitions>
