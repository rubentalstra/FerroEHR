            <term_definitions code="at0.38">
              <items id="description">Результаты, относящиеся к регуляции функции кишечника. </items>
              <items id="text">Регуляция функции кишечника</items>
            </term_definitions>
            <term_definitions code="at0.39">
              <items id="description">Описание вопросов, относящихся к регуляции функции кишечника. </items>
              <items id="text">Описание</items>
            </term_definitions>
            <term_definitions code="at0000">
              <items id="description">Запись результатов и измерений (или оценок)  выделения продуктов жизнедеятельности (жидких и каловых). </items>
              <items id="text">Выделение продуктов жизнедеятельности организма</items>
            </term_definitions>
            <term_definitions code="at0000.1">
              <items id="description">Запись результатов и измерений (или оценок) опорожнения кишечника. </items>
              <items id="text">Опорожнение кишечника</items>
            </term_definitions>
            <term_definitions code="at0000.1.1">
              <items id="description">Для записи результатов оценки дефекации</items>
              <items id="text">Стул</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">@ internal @</items>
              <items id="text">Серия событий</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="description">Оценка жидких выделений без указания периода времени. </items>
              <items id="text">Временная диаграмма</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="description">@ internal @</items>
              <items id="text">Список</items>
            </term_definitions>
            <term_definitions code="at0006">
              <items id="description">Для записи общего объема жидких выделений за некоторый период времени (может выходить за пределы некоторого числа интервалов или моментов времени). </items>
              <items id="text">Всего</items>
            </term_definitions>
            <term_definitions code="at0007">
              <items id="description">Для записи объема жидких выделений за некоторый период времени для последующего получения полной величины. </items>
              <items id="text">Фактически</items>
            </term_definitions>
            <term_definitions code="at0008">
              <items id="description">@ internal @</items>
              <items id="text">Список</items>
            </term_definitions>
            <term_definitions code="at0016">
              <items id="description">Сведения о наблюдаемой жидкости или массе. </items>
              <items id="text">Сведения о массе</items>
            </term_definitions>
            <term_definitions code="at0016.1">
              <items id="description">Сведения о наблюдаемой жидкости или массе. </items>
              <items id="text">Сведения об испражнениях</items>
            </term_definitions>
            <term_definitions code="at0018">
              <items id="description">Объем жидкости согласно оценке. </items>
              <items id="text">Оценка</items>
            </term_definitions>
            <term_definitions code="at0019">
              <items id="description">Объем жидкости по результату прямого измерения. </items>
              <items id="text">Результат измерения</items>
            </term_definitions>
            <term_definitions code="at0020">
              <items id="description">Установленное количество жидких выделений. </items>
              <items id="text">Установленное значение</items>
            </term_definitions>
            <term_definitions code="at0028">
              <items id="description">Сведения об устройстве, использованном для измерения выделений. </items>
              <items id="text">Измерительное устройство</items>
            </term_definitions>
            <term_definitions code="at0030">
              <items id="description">Размещение тела, из которого взята масса. </items>
              <items id="text">Расположение тела</items>
            </term_definitions>
            <term_definitions code="at0031">
              <items id="description">Указание уровня точности определения объема жидких выделений. </items>
              <items id="text">Точность измерений</items>
            </term_definitions>
            <term_definitions code="at0032">
              <items id="description">Описание любых трудностей при опорожнении продуктов жизнедеятельности. </items>
              <items id="text">Опорожнение</items>
            </term_definitions>
            <term_definitions code="at0033">
              <items id="description">Выделена масса? </items>
              <items id="text">Масса выделенная</items>
            </term_definitions>
            <term_definitions code="at0033.1">
              <items id="description">Наличие стула у субъекта</items>
              <items id="text">Наличие стула</items>
            </term_definitions>
            <term_definitions code="at0034">
              <items id="description">Дата и/или время с последнего испражнения. </items>
              <items id="text">Дата и время последнего опорожнения</items>
            </term_definitions>
            <term_definitions code="at0034.1">
              <items id="description">Дата и/или время последнего выделения кала. </items>
              <items id="text">Дата и время последнего выделения кала</items>
            </term_definitions>
            <term_definitions code="at0036">
              <items id="description">Время, прошедшее с последнего испражнения. </items>
              <items id="text">Период времени с последнего опорожнения</items>
            </term_definitions>
            <term_definitions code="at0036.1">
              <items id="description">Время, прошедшее с последнего выделения кала. </items>
              <items id="text">Период времени с последнего выделения кала</items>
            </term_definitions>
            <term_definitions code="at0037">
              <items id="description">Описание любых трудностей, испытываемых при испражнении. </items>
              <items id="text">Трудности при испражнении</items>
            </term_definitions>
            <term_definitions code="at0037.1">
              <items id="description">Описание любых трудностей, испытываемых при опорожнение кишечника. </items>
              <items id="text">Трудности при опорожнении кишечника</items>
            </term_definitions>
