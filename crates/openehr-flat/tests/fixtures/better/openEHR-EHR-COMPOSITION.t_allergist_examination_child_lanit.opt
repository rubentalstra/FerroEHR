                        <archetype_id>
                          <value>openEHR-EHR-CLUSTER.vaccination_details.v1</value>
                        </archetype_id>
                        <term_definitions code="at0000">
                          <items id="description">Для дополнительной информации по вакцинации</items>
                          <items id="text">Особенности вакцинации</items>
                        </term_definitions>
                        <term_definitions code="at0015">
                          <items id="description">*</items>
                          <items id="text">Не вакцинировать, не проводить р. Манту</items>
                        </term_definitions>
                        <term_definitions code="at0016">
                          <items id="description">*</items>
                          <items id="text">Ограничения вакцинации</items>
                        </term_definitions>
                        <term_definitions code="at0017">
                          <items id="description">*</items>
                          <items id="text">2 недели</items>
                        </term_definitions>
                        <term_definitions code="at0018">
                          <items id="description">*</items>
                          <items id="text">1 месяц</items>
                        </term_definitions>
                        <term_definitions code="at0019">
                          <items id="description">*</items>
                          <items id="text">в период проведения АСИТ без согласования с аллергологом</items>
                        </term_definitions>
                        <term_definitions code="at0020">
                          <items id="description">*</items>
                          <items id="text">Не вакцинировать вакцинами, в состав которых входят</items>
                        </term_definitions>
                        <term_definitions code="at0021">
                          <items id="description">*</items>
                          <items id="text">белок куриного яйца</items>
                        </term_definitions>
                        <term_definitions code="at0022">
                          <items id="description">*</items>
                          <items id="text">неомицин</items>
                        </term_definitions>
                        <term_definitions code="at0023">
                          <items id="description">*</items>
                          <items id="text">производные дрожжевых грибов</items>
                        </term_definitions>
                        <term_definitions code="at0024">
                          <items id="description">*</items>
                          <items id="text">Место проведения  вакцинации</items>
                        </term_definitions>
                        <term_definitions code="at0025">
                          <items id="description">*</items>
                          <items id="text">нет ограничений</items>
                        </term_definitions>
                        <term_definitions code="at0026">
                          <items id="description">*</items>
                          <items id="text">вакцинация в поликлинике</items>
                        </term_definitions>
                        <term_definitions code="at0027">
                          <items id="description">*</items>
                          <items id="text">вакцинация в условиях центра по иммунопрофилактики/ его филиала</items>
                        </term_definitions>
                        <term_definitions code="at0029">
                          <items id="description">*</items>
                          <items id="text">Условия для проведения  вакцинации</items>
                        </term_definitions>
                        <term_definitions code="at0030">
                          <items id="description">*</items>
                          <items id="text">вакцинировать при условии полного контроля симптомов аллергических болезней не менее 4 -6 недель на фоне их базисной терапии</items>
                        </term_definitions>
                        <term_definitions code="at0031">
                          <items id="description">*</items>
                          <items id="text">при наличии эпид. показаний к вакцинации и нестабильном состоянии пациента внеплановая консультация аллерголога</items>
                        </term_definitions>
                        <term_definitions code="at0032">
                          <items id="description">*</items>
                          <items id="text">не отменять и не изменять объём базисной терапии в  период проведения вакцинации</items>
                        </term_definitions>
                        <term_definitions code="at0033">
                          <items id="description">*</items>
                          <items id="text">дополнительная медикаментозная терапия в период вакцинации</items>
                        </term_definitions>
                        <term_definitions code="at0034">
                          <items id="description">*</items>
                          <items id="text">Комментарий</items>
                        </term_definitions>
                      </children>
