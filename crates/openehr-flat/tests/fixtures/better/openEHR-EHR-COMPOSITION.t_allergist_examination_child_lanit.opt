                            <term_definitions code="at0053">
                              <items id="description">*</items>
                              <items id="text">физическая нагрузка (потение)</items>
                            </term_definitions>
                            <term_definitions code="at0054">
                              <items id="description">*</items>
                              <items id="text">контакт с водой</items>
                            </term_definitions>
                            <term_definitions code="at0055">
                              <items id="description">*</items>
                              <items id="text">другое</items>
                            </term_definitions>
                            <term_definitions code="at0056">
                              <items id="description">*</items>
                              <items id="text">Описание</items>
                            </term_definitions>
                            <term_definitions code="at0057">
                              <items id="description">*</items>
                              <items id="text">Интенсивность</items>
                            </term_definitions>
                            <term_definitions code="at0058">
                              <items id="description">*</items>
                              <items id="text">незначительный</items>
                            </term_definitions>
                            <term_definitions code="at0059">
                              <items id="description">*</items>
                              <items id="text">выраженный</items>
                            </term_definitions>
                            <term_definitions code="at0060">
                              <items id="description">*</items>
                              <items id="text">интенсивный (нарушает сон)</items>
                            </term_definitions>
                            <term_definitions code="at0061">
                              <items id="description">*</items>
                              <items id="text">Особенности</items>
                            </term_definitions>
                            <term_definitions code="at0062">
                              <items id="description">*</items>
                              <items id="text">биопсирующий</items>
                            </term_definitions>
                            <term_definitions code="at0063">
                              <items id="description">*</items>
                              <items id="text">не биопсирующий</items>
                            </term_definitions>
                            <term_definitions code="at0064">
                              <items id="description">*</items>
                              <items id="text">Время появления</items>
                            </term_definitions>
                            <term_definitions code="at0065">
                              <items id="description">*</items>
                              <items id="text">в течение суток</items>
                            </term_definitions>
                            <term_definitions code="at0066">
                              <items id="description">*</items>
                              <items id="text">не зависит от времени суток</items>
                            </term_definitions>
                            <term_definitions code="at0067">
                              <items id="description">*</items>
                              <items id="text">раннее утро</items>
                            </term_definitions>
                            <term_definitions code="at0068">
                              <items id="description">*</items>
                              <items id="text">утро</items>
                            </term_definitions>
                            <term_definitions code="at0069">
                              <items id="description">*</items>
                              <items id="text">день</items>
                            </term_definitions>
                            <term_definitions code="at0070">
                              <items id="description">*</items>
                              <items id="text">вечер</items>
                            </term_definitions>
                            <term_definitions code="at0071">
                              <items id="description">*</items>
                              <items id="text">ночь</items>
                            </term_definitions>
                            <term_definitions code="at0072">
                              <items id="description">*</items>
                              <items id="text">Комментарий</items>
                            </term_definitions>
                            <term_definitions code="at0073">
                              <items id="description">*</items>
                              <items id="text">Аллерген</items>
                            </term_definitions>
                            <term_definitions code="at0074">
                              <items id="description">*</items>
                              <items id="text">после приема определенных продуктов/медикаментов</items>
                            </term_definitions>
                            <term_definitions code="at0075">
                              <items id="description">*</items>
                              <items id="text">Длительность жалоб</items>
                            </term_definitions>
                            <term_definitions code="at0076">
                              <items id="description">*</items>
                              <items id="text">лицо</items>
