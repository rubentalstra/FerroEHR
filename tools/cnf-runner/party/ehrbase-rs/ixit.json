{
  "instances": {
    "sut": {
      "base_url": "http://localhost:8080/ehrbase/rest/openehr/v1",
      "auth": {
        "mode": "basic",
        "user_env": "SUT_USER",
        "password_env": "SUT_PASS"
      }
    },
    "admin": {
      "base_url": "http://localhost:8080/ehrbase/rest/openehr/v1",
      "auth": {
        "mode": "basic",
        "user_env": "SUT_ADMIN_USER",
        "password_env": "SUT_ADMIN_PASS"
      }
    },
    "readonly": {
      "base_url": "http://localhost:8080/ehrbase/rest/openehr/v1",
      "auth": {
        "mode": "basic",
        "user_env": "SUT_RO_USER",
        "password_env": "SUT_RO_PASS"
      }
    },
    "unauthenticated": {
      "base_url": "http://localhost:8080/ehrbase/rest/openehr/v1",
      "auth": {
        "mode": "none"
      }
    }
  },
  "containers": {
    "sut": "ehrbase-rs-cnf-ehrbase-1",
    "db": "ehrbase-rs-cnf-ehrbase-postgres-1"
  },
  "signing": {
    "mode": "digest",
    "algorithm": "sha256",
    "encoding": "base64",
    "prefix": "sha256:"
  },
  "environment": {
    "exclusive_server": true,
    "hardware_class": "consumer-laptop",
    "cores": 8,
    "memory_gb": 16,
    "storage_class": "nvme",
    "topology": "single-node docker compose (8-CPU/8GB Docker VM) on Apple M2"
  }
}