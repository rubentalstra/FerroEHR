            <archetype_id>
              <value>openEHR-EHR-OBSERVATION.agatston_score.v0</value>
            </archetype_id>
            <term_definitions code="at0000">
              <items id="description">An assessment score used to quantify and measure coronary artery calcium, usually as part of a preliminary noncontrast examination for coronary artery
and other cardiac structural calcification to estimate risk of cardiovascular diseases.</items>
              <items id="text">Agatston score</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">@ internal @</items>
              <items id="text">History</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="description">Default, unspecified point in time event which may be explicitly defined in a template or at run-time.</items>
              <items id="text">Any point in time event</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="description">@ internal @</items>
              <items id="text">Tree</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="description">@ internal @</items>
              <items id="text">Item tree</items>
            </term_definitions>
            <term_definitions code="at0010">
              <items id="comment">For example: the total score is at the Xth percentile
compared to the same age, gender, and race matched peers.</items>
              <items id="description">Calcium score percentile based on database representative of the cohort being assessed. This item indicates the percentage of people that have higher score compared to the age, gender, and race matched peers.</items>
              <items id="text">Percentile</items>
            </term_definitions>
            <term_definitions code="at0012">
              <items id="description">Overall risk classification based on the total score.</items>
              <items id="text">Risk classification</items>
            </term_definitions>
            <term_definitions code="at0013">
              <items id="comment">For example: the technical parameters of the ECG-gated CT examination in which the score was measured.</items>
              <items id="description">Structured technical parameters of the imaging examination in which the score was measured.</items>
              <items id="text">Technical details</items>
            </term_definitions>
            <term_definitions code="at0014">
              <items id="description">Score = 0.</items>
              <items id="text">Very low</items>
            </term_definitions>
            <term_definitions code="at0015">
              <items id="description">Score = 1 - 99.</items>
              <items id="text">Mildly increased</items>
            </term_definitions>
            <term_definitions code="at0016">
              <items id="description">Score = 100 - 299.</items>
              <items id="text">Moderately increased</items>
            </term_definitions>
            <term_definitions code="at0017">
              <items id="description">Score >= 299.</items>
              <items id="text">Moderate to severely increased</items>
            </term_definitions>
            <term_definitions code="at0018">
              <items id="description">Left main coronary artery calcium score.</items>
              <items id="text">LM</items>
            </term_definitions>
            <term_definitions code="at0019">
              <items id="description">Left anterior descending artery calcium score.</items>
              <items id="text">LAD</items>
            </term_definitions>
            <term_definitions code="at0020">
              <items id="description">Left circumflex artery calcium score.</items>
              <items id="text">LCx</items>
            </term_definitions>
            <term_definitions code="at0021">
              <items id="description">Right coronary artery calcium score.</items>
              <items id="text">RCA</items>
            </term_definitions>
            <term_definitions code="at0022">
              <items id="description">The score of all individual calcified lesions in all coronary arteries extending through the z-axis of the heart is summed up to give the total coronary artery calcium score.</items>
              <items id="text">Total</items>
            </term_definitions>
          </children>
