                                <term_definitions code="at0000">
                                  <items id="description">Coronary anatomy</items>
                                  <items id="text">Coronary anatomy</items>
                                </term_definitions>
                                <term_definitions code="at0001">
                                  <items id="description">*</items>
                                  <items id="text">Coronary artery dominance</items>
                                </term_definitions>
                                <term_definitions code="at0003">
                                  <items id="description">*</items>
                                  <items id="text">Anomalies</items>
                                </term_definitions>
                                <term_definitions code="at0004">
                                  <items id="description">If the posterior descending artery is supplied by both the right coronary artery and the circumflex artery, then the coronary circulation can be classified as "co-dominant".</items>
                                  <items id="text">Balanced coronary system</items>
                                </term_definitions>
                                <term_definitions code="at0005">
                                  <items id="description">If the posterior descending artery is supplied by the circumflex artery (CX), a branch of the left artery, then the coronary circulation can be classified as "left-dominant".</items>
                                  <items id="text">Left dominant coronary system</items>
                                </term_definitions>
                                <term_definitions code="at0006">
                                  <items id="description">If the posterior descending artery is supplied by the right coronary artery (RCA), then the coronary circulation can be classified as "right-dominant".</items>
                                  <items id="text">Right dominant coronary system</items>
                                </term_definitions>
