                    <term_definitions code="at0000">
                      <items id="description">Details related to the time and place of birth and additional non-clinical context around the birth.</items>
                      <items id="text">Birth details</items>
                    </term_definitions>
                    <term_definitions code="at0001">
                      <items id="description">Date and time of birth.</items>
                      <items id="text">Date/Time of birth</items>
                    </term_definitions>
                    <term_definitions code="at0002">
                      <items id="description">*</items>
                      <items id="text">Place of birth</items>
                    </term_definitions>
                  </children>
