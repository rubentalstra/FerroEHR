                <archetype_id>
                  <value>openEHR-EHR-CLUSTER.organisation.v0</value>
                </archetype_id>
                <term_definitions code="at0000">
                  <items id="description">A company, an institution, or an association that needs to be represented within the health record.</items>
                  <items id="text">Organisation</items>
                </term_definitions>
                <term_definitions code="at0001">
                  <items id="description">The name by which an organisation is known.</items>
                  <items id="text">Name line</items>
                </term_definitions>
                <term_definitions code="at0002">
                  <items id="description">Details about a contact person, or people, within the organisation.</items>
                  <items id="text">Contact person</items>
                </term_definitions>
                <term_definitions code="at0003">
                  <items id="description">Identifier associated with the identified organisation.</items>
                  <items id="text">Identifier</items>
                </term_definitions>
                <term_definitions code="at0004">
                  <items id="description">The role or capacity in which the organisation contributes to the health or social care of the subject of care.</items>
                  <items id="text">Role</items>
                </term_definitions>
                <term_definitions code="at0005">
                  <items id="description">Details about a specific address for the organisation.</items>
                  <items id="text">Address</items>
                </term_definitions>
                <term_definitions code="at0006">
                  <items id="description">Details about a specific type of electronic communication for the organisation.</items>
                  <items id="text">Electronic communication</items>
                </term_definitions>
                <term_definitions code="at0007">
                  <items id="comment">The scope of electronic communication medium includes, but is not limited to use of : a telephone, cellular phone, computer, or pager.</items>
                  <items id="description">The type of electronic communication or channel.</items>
