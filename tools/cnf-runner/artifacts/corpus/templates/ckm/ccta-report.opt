            <term_definitions code="at0000">
              <items id="description">An individual- or self-reported questionnaire screening for use of any medication or class of medication.</items>
              <items id="text">Medication screening questionnaire</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">@ internal @</items>
              <items id="text">Tree</items>
            </term_definitions>
            <term_definitions code="at0002">
