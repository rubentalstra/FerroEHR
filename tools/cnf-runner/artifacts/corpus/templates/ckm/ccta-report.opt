            <archetype_id>
              <value>openEHR-EHR-OBSERVATION.family_history_screening_questionnaire.v0</value>
            </archetype_id>
            <term_definitions code="at0000">
              <items id="description">A screening questionnaire about significant health-related problems found in family members.</items>
              <items id="text">Family history screening questionnaire</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">@ internal @</items>
              <items id="text">History</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items>
              <items id="text">Any event</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="description">@ internal @</items>
              <items id="text">Tree</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="comment">For example: pre-operative screening.</items>
              <items id="description">The reason for overall screening.</items>
              <items id="text">Screening purpose</items>
            </term_definitions>
            <term_definitions code="at0005">
              <items id="description">Presence of any relevant problems in the family.</items>
              <items id="text">Presence of any problems?</items>
            </term_definitions>
            <term_definitions code="at0006">
              <items id="description">Problems are present.</items>
              <items id="text">Yes</items>
            </term_definitions>
            <term_definitions code="at0007">
              <items id="description">Problems are not present.</items>
              <items id="text">No</items>
            </term_definitions>
            <term_definitions code="at0008">
              <items id="description">It is not known whether any problems are present or absent.</items>
              <items id="text">Unknown</items>
            </term_definitions>
            <term_definitions code="at0009">
              <items id="description">Grouping of data elements related to screening for a specific problem.</items>
              <items id="text">Specific problem</items>
            </term_definitions>
            <term_definitions code="at0010">
              <items id="description">Presence of any relevant specific problem.</items>
              <items id="text">Present?</items>
            </term_definitions>
            <term_definitions code="at0011">
              <items id="description">The specific problem is present.</items>
              <items id="text">Yes</items>
            </term_definitions>
            <term_definitions code="at0012">
              <items id="description">The specific problem is absent.</items>
              <items id="text">No</items>
            </term_definitions>
            <term_definitions code="at0013">
              <items id="description">It is not known whether any problems are present or absent.</items>
              <items id="text">Unknown</items>
            </term_definitions>
            <term_definitions code="at0015">
              <items id="comment">The data elements in this cluster will relate to the individual identified either by name or by alias. Repeat the use of the cluster for other family members.</items>
              <items id="description">Details about a specific family member.</items>
              <items id="text">Specific family member</items>
            </term_definitions>
            <term_definitions code="at0016">
              <items id="comment">For example: 'Aunt Susan' or 'Susan Smith'. However, for privacy reasons this may not be appropriate for recording, sharing or public display and in this situation the 'Alias' should be used.</items>
              <items id="description">Name of family member.</items>
              <items id="text">Family member name</items>
            </term_definitions>
            <term_definitions code="at0017">
              <items id="comment">To be used to assist in distinguishing one individual from multiple family members with identical relationships. For example, the label to distinguish one specific sister from three known sisters might be 'eldest sister' 'sister with the red hair' or 'sister #1'.</items>
              <items id="description">An alternative name or label to uniquely identify a family member, without using a personal name which might publicly identify the individual.</items>
              <items id="text">Alias</items>
            </term_definitions>
            <term_definitions code="at0018">
              <items id="comment">For example: mother, step-father, maternal grandmother, or paternal uncle. Coding of the relationship with a terminology is preferred, where possible and including specification of maternal and paternal as required.</items>
              <items id="description">The relationship of the family member to the subject of care.</items>
              <items id="text">Relationship</items>
            </term_definitions>
            <term_definitions code="at0019">
              <items id="description">Grouping of data elements about the specific problem relatet to the family member.</items>
              <items id="text">Specific problem</items>
            </term_definitions>
            <term_definitions code="at0020">
              <items id="comment">Coding of the family member's problem or diagnosis with a terminology is preferred, where possible.</items>
              <items id="description">Identification of the significant problem or diagnosis in the identified family member.</items>
              <items id="text">Problem/diagnosis name</items>
            </term_definitions>
            <term_definitions code="at0021">
              <items id="description">@ internal @</items>
              <items id="text">Item tree</items>
            </term_definitions>
            <term_definitions code="at0023">
              <items id="description">Presence of any significant problem in the identified family member.</items>
              <items id="text">Present?</items>
            </term_definitions>
            <term_definitions code="at0024">
              <items id="description">The significant problem is present.</items>
              <items id="text">Yes</items>
            </term_definitions>
            <term_definitions code="at0025">
              <items id="description">The significant problem is absent.</items>
              <items id="text">No</items>
            </term_definitions>
            <term_definitions code="at0026">
              <items id="description">It is not known whether any significant problems are present or absent.</items>
              <items id="text">Unknown</items>
            </term_definitions>
            <term_definitions code="at0028">
              <items id="description">Additional narrative about the problems, not captured in other fields.</items>
              <items id="text">Comment</items>
            </term_definitions>
            <term_definitions code="at0029">
              <items id="comment">For example: local information requirements or additional metadata to align with FHIR.</items>
              <items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items>
              <items id="text">Extension</items>
            </term_definitions>
            <term_definitions code="at0032">
              <items id="description">Additional structured questionnaire questions directly related to the specific problem.</items>
              <items id="text">Additional detailed questions</items>
            </term_definitions>
            <term_definitions code="at0033">
              <items id="description">Additional structured questionnaire questions directly related to the specific problem.</items>
              <items id="text">Additional detailed questions</items>
            </term_definitions>
            <term_definitions code="at0035">
              <items id="comment">Coding of the family member's problem or diagnosis with a terminology is preferred, where possible.</items>
              <items id="description">Identification of the significant problem or diagnosis in the identified family member.</items>
              <items id="text">Problem/diagnosis name</items>
            </term_definitions>
