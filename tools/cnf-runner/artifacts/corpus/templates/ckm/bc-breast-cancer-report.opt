                                    <archetype_id>
                                      <value>openEHR-EHR-CLUSTER.microscopy_breast_carcinoma.v1</value>
                                    </archetype_id>
                                    <term_definitions code="at0000">
                                      <items id="description">Microscopic anatomic pathology findings related to breast cancer.</items>
                                      <items id="text">Microscopic findings - Breast cancer</items>
                                    </term_definitions>
                                    <term_definitions code="at0014">
                                      <items id="description">Mitotic frequency is calculated from the number of mitoses per 10 high-power fields.</items>
                                      <items id="text">Mitosis count</items>
                                    </term_definitions>
                                    <term_definitions code="at0015">
                                      <items id="description">Histologic grading of breast cancer.</items>
                                      <items id="text">Histologic grading</items>
                                    </term_definitions>
                                    <term_definitions code="at0016">
                                      <items id="description">Nuclear score.</items>
                                      <items id="text">Nuclear score</items>
                                    </term_definitions>
                                    <term_definitions code="at0017">
                                      <items id="description">Tubular formation score, representing the extent of tubular formation within invasive carcinoma cells.</items>
                                      <items id="text">Tubular formation score</items>
                                    </term_definitions>
                                    <term_definitions code="at0018">
                                      <items id="description">Bloom and Richardson Grade of breast cancer, derived from the total score of its components: Mitotic frequency score, Nuclear score and Tubular formation score.</items>
                                      <items id="text">Histologic grade</items>
                                    </term_definitions>
                                    <term_definitions code="at0020">
                                      <items id="description">Bloom and Richardson Histology Grade ( with modification by Elston and Ellis) is composed of three  components which are combined to produce a calculated Histology Grade.</items>
                                      <items id="text">Bloom and Richardson Grade</items>
                                    </term_definitions>
                                    <term_definitions code="at0021">
                                      <items id="description">Findings of the relation of tumour to surgical resection margins.</items>
                                      <items id="text">Resection margins</items>
                                    </term_definitions>
                                    <term_definitions code="at0023">
                                      <items id="description">Finding of non-neoplastic cellular change.</items>
                                      <items id="text">Non-neoplastic cellular change</items>
                                    </term_definitions>
                                    <term_definitions code="at0024">
                                      <items id="description">Findings related to microcalcification.</items>
                                      <items id="text">Microcalcification</items>
                                    </term_definitions>
                                    <term_definitions code="at0025">
                                      <items id="description">Findings of microcalcification.</items>
                                      <items id="text">Microcalcification</items>
                                    </term_definitions>
                                    <term_definitions code="at0026">
                                      <items id="description">A text description of pathology associated with microcalcification.</items>
                                      <items id="text">Associated pathology</items>
                                    </term_definitions>
                                    <term_definitions code="at0030">
                                      <items id="description">Findings related to the involvement of tumour in lymph nodes.</items>
                                      <items id="text">Lymph node involvement</items>
                                    </term_definitions>
                                    <term_definitions code="at0033">
                                      <items id="description">Assessments of tumour size.</items>
                                      <items id="text">Tumour size and extent</items>
                                    </term_definitions>
                                    <term_definitions code="at0036">
                                      <items id="description">The size of the invasive aspect of the breast cancer.</items>
                                      <items id="text">Invasive tumour extent</items>
                                    </term_definitions>
                                    <term_definitions code="at0037">
                                      <items id="description">The extent of total breast cancer lesion.</items>
                                      <items id="text">Total lesion extent</items>
                                    </term_definitions>
                                    <term_definitions code="at0043">
                                      <items id="description">A text description of any assessment issues which may confound the accuracy of the Bloom and Richardson histologic grade.</items>
                                      <items id="text">Confounding issues</items>
                                    </term_definitions>
                                    <term_definitions code="at0044">
                                      <items id="description">Less than 75% of invasive carcinoma forming tubular or glandular structures.</items>
                                      <items id="text">Tubular formation score 1</items>
                                    </term_definitions>
                                    <term_definitions code="at0045">
                                      <items id="description">10-75% of invasive carcinoma forming tubular or glandular structures.</items>
                                      <items id="text">Tubular formation score 2</items>
                                    </term_definitions>
                                    <term_definitions code="at0046">
                                      <items id="description">Less than 10% of invasive carcinoma forming tubular or glandular structures.</items>
                                      <items id="text">Tubular formation score 3</items>
                                    </term_definitions>
                                    <term_definitions code="at0047">
                                      <items id="description">Total score of 3-5.</items>
                                      <items id="text">Grade 1</items>
                                    </term_definitions>
                                    <term_definitions code="at0048">
                                      <items id="description">Total score of 6 or 7.</items>
                                      <items id="text">Grade 2</items>
                                    </term_definitions>
                                    <term_definitions code="at0049">
                                      <items id="description">Total score of 8 or 9.</items>
                                      <items id="text">Grade 3</items>
                                    </term_definitions>
                                    <term_definitions code="at0050">
                                      <items id="description">Size equivalent to 1.5–2 red blood cell diameters or normal duct epithelial nuclei; Diffuse chromatin; Inconspicuous nucleoli.</items>
                                      <items id="text">Score 1</items>
                                    </term_definitions>
                                    <term_definitions code="at0051">
                                      <items id="description">Size equivalent to 2–2.5 red blood cell diameters; Coarse chromatin; Infrequent nucleoli and mitoses.</items>
                                      <items id="text">Score 2</items>
                                    </term_definitions>
                                    <term_definitions code="at0052">
                                      <items id="description">Size > 2.5 red blood cell diameters; Pleomorphic vesicular nuclei; One or more prominent nucleoli; Frequent mitotic figures commonly present.</items>
                                      <items id="text">Score 3</items>
                                    </term_definitions>
                                    <term_definitions code="at0054">
                                      <items id="description">Findings of non-neoplastic cellular changes.</items>
                                      <items id="text">Non-neoplastic cellular changes</items>
                                    </term_definitions>
                                    <term_definitions code="at0055">
                                      <items id="description">Finding of atypical lobular hyperplasia.</items>
                                      <items id="text">Atypical lobular hyperplasia</items>
                                    </term_definitions>
                                    <term_definitions code="at0056">
                                      <items id="description">A text description of finding of lobular neoplasia.</items>
                                      <items id="text">Description</items>
                                    </term_definitions>
                                    <term_definitions code="at0058">
                                      <items id="description">Finding of lobular carcinoma-in-situ.</items>
                                      <items id="text">Lobular carcinoma-in-situ</items>
                                    </term_definitions>
                                    <term_definitions code="at0060">
                                      <items id="description">Findings of lobular neoplasia and variants.</items>
                                      <items id="text">Lobular neoplasia</items>
