                <archetype_id>
                  <value>openEHR-EHR-OBSERVATION.problem_screening.v1</value>
                </archetype_id>
                <term_definitions code="at0000">
                  <items id="comment">The answers may be self-reported.</items>
                  <items id="description">Series of questions and associated answers used to screen for issues, problems or diagnoses.</items>
                  <items id="text">Problem/Diagnosis screening questionnaire</items>
                </term_definitions>
                <term_definitions code="at0001">
                  <items id="description">@ internal @</items>
                  <items id="text">History</items>
                </term_definitions>
                <term_definitions code="at0002">
                  <items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items>
                  <items id="text">Any event</items>
                </term_definitions>
                <term_definitions code="at0003">
                  <items id="description">@ internal @</items>
                  <items id="text">Tree</items>
                </term_definitions>
                <term_definitions code="at0004">
                  <items id="comment">Coding of the 'Problem/diagnosis name' with a terminology is preferred, where possible.</items>
                  <items id="description">Identification of an issue, problem or diagnosis, or grouping of issues, problems or diagnoses, by name.</items>
                  <items id="text">Problem/diagnosis name</items>
                </term_definitions>
                <term_definitions code="at0005">
                  <items id="comment">In a template, the data element would usually be renamed to the specific question asked. The proposed value set can be adapted for local use by using the DV_TEXT or the DV_BOOLEAN datatypes choice to match each specific use case.</items>
                  <items id="description">Is there a history of the specific issue, problem or diagnosis?</items>
                  <items id="text">Presence?</items>
                </term_definitions>
                <term_definitions code="at0007">
                  <items id="description">@ internal @</items>
                  <items id="text">Item tree</items>
                </term_definitions>
                <term_definitions code="at0021">
                  <items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items>
                  <items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items>
                  <items id="text">Extension</items>
                </term_definitions>
                <term_definitions code="at0022">
                  <items id="description">Details about a specific issue, problem or diagnosis or grouping of problems or diagnoses relevant for the screening purpose.</items>
                  <items id="text">Specific problem or diagnosis</items>
                </term_definitions>
                <term_definitions code="at0023">
                  <items id="description">*</items>
                  <items id="text">Yes</items>
                </term_definitions>
                <term_definitions code="at0024">
                  <items id="description">*</items>
                  <items id="text">No</items>
                </term_definitions>
                <term_definitions code="at0025">
                  <items id="description">Additional narrative about the specific issue, problem or diagnosis question, not captured in other fields.</items>
                  <items id="text">Comment</items>
                </term_definitions>
                <term_definitions code="at0027">
                  <items id="description">*</items>
                  <items id="text">Unknown</items>
                </term_definitions>
                <term_definitions code="at0028">
                  <items id="comment">In a template, the data element would usually be renamed to the specific question asked. The proposed value set can be adapted for local use by using the DV_TEXT or the DV_BOOLEAN datatypes choice to match each specific use case.</items>
                  <items id="description">Is there a history of any issues, problems or diagnoses relevant for the screening purpose?</items>
                  <items id="text">Any problems or diagnoses?</items>
                </term_definitions>
                <term_definitions code="at0031">
                  <items id="description">*</items>
                  <items id="text">Yes</items>
                </term_definitions>
                <term_definitions code="at0032">
                  <items id="description">*</items>
                  <items id="text">No</items>
                </term_definitions>
                <term_definitions code="at0033">
                  <items id="description">*</items>
                  <items id="text">Unknown</items>
                </term_definitions>
                <term_definitions code="at0034">
                  <items id="comment">This data element is intended to provide collection context for the question/answer groups when queried at a later date. It is not expected that this data element will be exposed to the individual, but only stored in data.
For example: pre-admission screening or the name of the actual questionnaire.</items>
                  <items id="description">The context or reason for screening.</items>
                  <items id="text">Screening purpose</items>
                </term_definitions>
                <term_definitions code="at0039">
                  <items id="comment">For example; hospital where treated.</items>
                  <items id="description">Structured details or questions about the specific issue, problem or diagnosis.</items>
                  <items id="text">Additional details</items>
                </term_definitions>
                <term_definitions code="at0040">
                  <items id="comment">The 'Timing' data element has deliberately been loosely modelled to support the myriad of ways that it can be used in questionnaires to capture when an issue, problem or diagnosis occured. The specific and intended semantics can be further clarified in a template. For example: the actual date and/or time; the start and stop time for when the issue, problem or diagnosis occured; the interval of time during which the issue, problem or diagnosis occured; the duration of the issue, problem or diagnosis; the age of the individual at the time of the issue, problem or diagnosis; or the duration of time since it occurred. A partial date is valid, using the DV_DATE_TIME data type, to record only a year.</items>
                  <items id="description">Indication of timing related to the issue, problem or diagnosis.</items>
                  <items id="text">Timing</items>
                </term_definitions>
                <term_definitions code="at0042">
                  <items id="description">Structured details or questions about screening for issues, problems or diagnoses.</items>
                  <items id="text">Additional details</items>
                </term_definitions>
                <term_definitions code="at0043">
                  <items id="description">Narrative description about the history of any issues, problems or diagnoses relevant for the screening purpose.</items>
                  <items id="text">Description</items>
                </term_definitions>
                <term_bindings terminology="SNOMED-CT">
                  <items code="at0023">
                    <value>
                      <terminology_id>
                        <value>SNOMED-CT</value>
