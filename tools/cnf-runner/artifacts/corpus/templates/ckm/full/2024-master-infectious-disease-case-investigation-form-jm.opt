                                    <archetype_id>
                                      <value>openEHR-EHR-CLUSTER.lab_microscopy_stain.v0</value>
                                    </archetype_id>
                                    <template_id>
                                      <value>Gram stain findings</value>
                                    </template_id>
                                    <term_definitions code="at0000">
                                      <items id="description">Findings observed during microscopic examination of tissue treated with specialised stains, intended to enhance the visualisation of specimen, including microorganisms, tissue structures and cellular details.</items>
                                      <items id="text">Microscopy stain findings</items>
                                    </term_definitions>
                                    <term_definitions code="at0004">
                                      <items id="comment">For example: Ziehl–Neelsen; Gram stain</items>
                                      <items id="description">Name of the technique used to stain the specimen.</items>
                                      <items id="text">Staining method</items>
                                    </term_definitions>
                                    <term_definitions code="at0005">
                                      <items id="description">*</items>
                                      <items id="text">Gram stain</items>
                                    </term_definitions>
                                    <term_definitions code="at0006">
                                      <items id="description">*</items>
                                      <items id="text">India ink stain</items>
                                    </term_definitions>
                                    <term_definitions code="at0007">
                                      <items id="description">*</items>
                                      <items id="text">Ziehl-Neelsen stain</items>
                                    </term_definitions>
                                    <term_definitions code="at0009">
                                      <items id="description">Statement about detection of the staining target in the specimen.</items>
                                      <items id="text">Presence</items>
                                    </term_definitions>
                                    <term_definitions code="at0010">
                                      <items id="description">*</items>
                                      <items id="text">Detected</items>
                                    </term_definitions>
                                    <term_definitions code="at0011">
                                      <items id="description">*</items>
                                      <items id="text">Not detected</items>
                                    </term_definitions>
                                    <term_definitions code="at0012">
                                      <items id="description">Additional narrative about the overall microscopy findings using the identified stain, not captured in other fields.</items>
                                      <items id="text">Comment</items>
                                    </term_definitions>
                                    <term_definitions code="at0014">
                                      <items id="description">*</items>
                                      <items id="text">Specimen</items>
                                    </term_definitions>
                                    <term_definitions code="at0015">
                                      <items id="comment">For example: crystal violet, carbol fuchsin.</items>
                                      <items id="description">A chemical dye or compound that interacts with biological specimens to produce a colour change, improving their visibility and differentiation under a microscope.</items>
                                      <items id="text">Staining agent</items>
                                    </term_definitions>
                                    <term_definitions code="at0016">
                                      <items id="description">Details about a specific microorganism, tissue structure, or cell structure observed during the microscopic examination of a stained specimen.</items>
                                      <items id="text">Per target finding</items>
                                    </term_definitions>
                                    <term_definitions code="at0017">
                                      <items id="comment">For example: gram-positive cocci, fungi, acid-fast bacilli, cell nuclei or pathological inclusions.
Coding with an external terminology is preferred, if available.</items>
                                      <items id="description">Identification of the target organism, cell or structure.</items>
                                      <items id="text">Staining target</items>
                                    </term_definitions>
                                    <term_definitions code="at0018">
                                      <items id="description">Qualitative assessment of the amount of the target organism, cell, or structure observed using the stain.</items>
                                      <items id="text">Qualitative result</items>
                                    </term_definitions>
                                    <term_definitions code="at0019">
                                      <items id="description">*</items>
                                      <items id="text">Scant</items>
                                    </term_definitions>
                                    <term_definitions code="at0020">
                                      <items id="description">*</items>
                                      <items id="text">Low</items>
                                    </term_definitions>
                                    <term_definitions code="at0021">
                                      <items id="description">*</items>
                                      <items id="text">Moderate</items>
                                    </term_definitions>
                                    <term_definitions code="at0022">
                                      <items id="description">*</items>
                                      <items id="text">High</items>
                                    </term_definitions>
                                    <term_definitions code="at0023">
                                      <items id="comment">For example: gram-positive cocci in clusters; gram-negative bacilli, short rods; elongated fibroblasts; multinucleated giant cells; branching hyphae; oval yeast forms with budding.</items>
                                      <items id="description">Narrative description about the physical characteristics of the staining target.</items>
                                      <items id="text">Morphology</items>
                                    </term_definitions>
                                    <term_definitions code="at0024">
                                      <items id="comment">For example: an overall description; the presence of non-targeted findings such as epithelial cells or debris.</items>
                                      <items id="description">Narrative description about the findings observed using the identified stain.</items>
                                      <items id="text">Clinical findings</items>
                                    </term_definitions>
                                    <term_definitions code="at0025">
                                      <items id="description">*</items>
                                      <items id="text">Absent</items>
                                    </term_definitions>
                                    <term_definitions code="at0026">
                                      <items id="description">*</items>
                                      <items id="text">Indeterminate</items>
                                    </term_definitions>
                                    <term_definitions code="at0027">
                                      <items id="description">Additional narrative about the target findings using the identified stain, not captured in other fields.</items>
                                      <items id="text">Comment</items>
                                    </term_definitions>
                                  </children>
