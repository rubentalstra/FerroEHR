    <term_definitions code="at0000">
      <items id="description">Findings observed from culturing a specimen to detect and identify the growth of microorganisms.</items>
      <items id="text">Microbiology culture findings</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="description">Narrative description of the findings on microbiological culture.</items>
      <items id="text">Findings</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="description">Details about specific culture findings for each identified organism.</items>
      <items id="text">Per microorganism</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="comment">For example: name of a bacteria, virus or fungus.</items>
      <items id="description">Name of the microorganism cultured.</items>
      <items id="text">Microorganism name</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="description">Qualitative assessment of the amount of the identified microorganism grown on culture.</items>
      <items id="text">Qualitative result</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="description">*</items>
      <items id="text">No growth</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="description">*</items>
      <items id="text">Light growth</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="description">*</items>
      <items id="text">Moderate growth</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="description">*</items>
      <items id="text">Heavy growth</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="description">Details about the ability of the microorganism to grow in the presence of an antimicrobial agent.</items>
      <items id="text">Susceptibility test</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="comment">For example: the name of an antibiotic, antiviral or antifungal.</items>
      <items id="description">The name of the antimicrobial substance being tested.</items>
      <items id="text">Antimicrobial agent</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="description">The lowest concentration of an antimicrobial agent  required to inhibit visible growth.</items>
      <items id="text">Minimum inhibitory concentration (MIC)</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="description">Interpretation of the MIC value as a category.</items>
      <items id="text">Interpretation</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="description">*</items>
      <items id="text">Sensitive (S)</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="description">*</items>
      <items id="text">Intermediate (I)</items>
    </term_definitions>
    <term_definitions code="at0015">
      <items id="description">*</items>
      <items id="text">Resistant (R)</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="description">Additional narrative about the culture findings for the identified microorganism, not captured in other fields.</items>
      <items id="text">Comment</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="description">Additional narrative about the overall culture findings, not captured in other fields.</items>
      <items id="text">Overall comment</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="description">Statement about the presence or absence of any microbial growth on culture.</items>
      <items id="text">Overall growth</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="description">*</items>
      <items id="text">Growth</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="description">*</items>
      <items id="text">No growth</items>
    </term_definitions>
    <term_definitions code="at0021">
      <items id="description">Observation about the presence or absence of growth of the identified organism on culture.</items>
      <items id="text">Growth</items>
    </term_definitions>
    <term_definitions code="at0022">
      <items id="description">*</items>
      <items id="text">Detected</items>
    </term_definitions>
    <term_definitions code="at0023">
      <items id="description">*</items>
      <items id="text">Not detected</items>
    </term_definitions>
    <term_definitions code="at0024">
      <items id="description">*</items>
      <items id="text">Indeterminate</items>
    </term_definitions>
    <term_definitions code="at0025">
      <items id="description">Quantitative assessment of the amount of the identified microorganism grown on culture.</items>
      <items id="text">Quantitative result</items>
    </term_definitions>
    <term_definitions code="at0030">
      <items id="description">*</items>
      <items id="text">-</items>
    </term_definitions>
    <term_definitions code="at0031">
      <items id="description">*</items>
      <items id="text">+</items>
    </term_definitions>
    <term_definitions code="at0032">
