          <items id="text">Unknown</items>
        </term_definitions>
        <term_definitions code="at0040">
          <items id="comment">This data element is intended to provide collection context for the question/answer groups when queried at a later date. It is not expected that this data element will be exposed to the individual, but only stored in data. For example: pre-admission screening, the name of the actual questionnaire or screening for previous investigations.</items>
          <items id="description">The context or reason for screening.</items>
          <items id="text">Screening purpose</items>
        </term_definitions>
        <term_definitions code="at0041">
          <items id="description">Structured details or questions about the specific investigation or group of investigations.</items>
          <items id="text">Additional details</items>
        </term_definitions>
        <term_definitions code="at0043">
          <items id="description">Narrative description about the history of any investigations relevant for the screening purpose.</items>
          <items id="text">Description</items>
        </term_definitions>
        <term_definitions code="at0044">
          <items id="description">Structured details or questions about screening for diagnostic investigations.</items>
          <items id="text">Additional details</items>
        </term_definitions>
        <term_definitions code="at0045">
          <items id="description">*</items>
          <items id="text">Unsure</items>
        </term_definitions>
        <term_definitions code="at0046">
          <items id="description">*</items>
          <items id="text">Unsure</items>
        </term_definitions>
        <term_definitions code="at0047">
          <items id="comment">For example: contrast-enhanced mammography, magnification mammography, mammographic digital tomosynthesis,  contrast imaging technique,  fluorescence in situ hybridisation, Immunoassay method.</items>
          <items id="description">The method, technique, modality or other more specific identification of the diagnostic investigation.</items>
          <items id="text">Type</items>
        </term_definitions>
