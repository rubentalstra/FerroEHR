                    <archetype_id>
                      <value>openEHR-EHR-CLUSTER.electronic_communication.v1</value>
                    </archetype_id>
                    <template_id>
                      <value>Phone - JM Work</value>
                    </template_id>
                    <term_definitions code="at0000">
                      <items id="description">Details about a specified type of electronic communication.</items>
                      <items id="text">Electronic communication</items>
                    </term_definitions>
                    <term_definitions code="at0001">
                      <items id="comment">The DV_CODED_TEXT value set supports recording of the most common electronic communications used in health. If other alternatives are required the DV_TEXT data type can be used to record other types of electronic communication such as social media or video conferencing URLs within a template.</items>
                      <items id="description">The type or form of electronic communication.</items>
                      <items id="text">Type</items>
                    </term_definitions>
                    <term_definitions code="at0002">
                      <items id="comment">For example: area code + landline phone/pager number; country code + mobile phone number; or email address.</items>
                      <items id="description">The unique combination of alphanumeric characters, relevant for representation of 'Type'.</items>
                      <items id="text">Value</items>
                    </term_definitions>
                    <term_definitions code="at0003">
                      <items id="description">The purpose or use for the identified type of electronic communication.</items>
                      <items id="text">Purpose</items>
                    </term_definitions>
                    <term_definitions code="at0004">
                      <items id="description">Additional narrative about the electronic communication not captured in other fields.</items>
                      <items id="text">Comment</items>
                    </term_definitions>
                    <term_definitions code="at0005">
                      <items id="description">For SMS or voice calls.</items>
                      <items id="text">Mobile (cellular) telephone</items>
                    </term_definitions>
                    <term_definitions code="at0006">
                      <items id="description">*</items>
                      <items id="text">Telephone (excluding mobile telephone)</items>
                    </term_definitions>
                    <term_definitions code="at0007">
                      <items id="description">*</items>
                      <items id="text">Email</items>
                    </term_definitions>
                    <term_definitions code="at0008">
                      <items id="description">*</items>
                      <items id="text">Pager</items>
                    </term_definitions>
                    <term_definitions code="at0009">
                      <items id="description">*</items>
                      <items id="text">Fax</items>
                    </term_definitions>
                    <term_definitions code="at0010">
                      <items id="description">*</items>
                      <items id="text">Business use</items>
                    </term_definitions>
                    <term_definitions code="at0011">
                      <items id="description">*</items>
                      <items id="text">Personal use</items>
                    </term_definitions>
                    <term_definitions code="at0012">
                      <items id="description">*</items>
                      <items id="text">Both business and personal use</items>
                    </term_definitions>
                    <term_definitions code="at0013">
                      <items id="description">Additional details about the electronic communication.</items>
                      <items id="text">Additional details</items>
                    </term_definitions>
