    <term_definitions code="at0000">
      <items id="description">Infectious disease investigation metadata.</items>
      <items id="text">Infectious disease investigation metadata</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="description">The name of the disease under investigation.</items>
      <items id="text">Notified disease</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="comment">The investigation ID and the notification ID may be identical if both the notification and investigation are carried out within the same system.</items>
      <items id="description">The unique identifier for this infectious disease investigation.</items>
      <items id="text">Investigation ID</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="comment">The investigation ID and the notification ID may be identical if both the notification and investigation are carried out within the same system.</items>
      <items id="description">The unique identifier for the notification that triggered this infectious disease investigation.</items>
      <items id="text">Notification ID</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="description">Name of the local health region.</items>
      <items id="text">Health region</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="description">The date when the infection was first identified by a clinician or notifier.</items>
      <items id="text">Date identified</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="comment">Also known as 'epi week'.</items>
      <items id="description">Standardised way to identify the week of onset of symptoms.</items>
      <items id="text">Epidemiological week of onset</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="comment">Also known as 'epi week'.</items>
      <items id="description">Standardised way to identify the week of notification to public health authorities.</items>
      <items id="text">Epidemiological week of notification</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="description">Details about the person who notified public health authorities about the infectious disease case.</items>
      <items id="text">Date of notification</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="description">Details about the person notifying about the infectious disease case.</items>
      <items id="text">Notifier</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="description">Method of detection of the index disease.</items>
      <items id="text">Detection method</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="description">Details about the person completing the investigation and corresponding report.</items>
      <items id="text">Investigator</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="description">The date when the investigator commenced the investigation.</items>
      <items id="text">Date investigation initiated</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="description">Details about one or more clinicians who have been treating the infected individual.</items>
      <items id="text">Treating clinician</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="description">Details about one or more health facilities who may have information about the infected individual.</items>
      <items id="text">Treating health facility</items>
    </term_definitions>
    <term_definitions code="at0015">
      <items id="description">The date when the investigator finished the investigation report.</items>
      <items id="text">Date investigation completed</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="description">The date when the investigator submitted the investigation report for review.</items>
      <items id="text">Date submitted for local review/sign-off</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="description">Details about review, sign off or approval by local or regional clinical authorities.</items>
      <items id="text">Local review details</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="description">The date when the reviewer received the investigation for review.</items>
      <items id="text">Date received for review</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="comment">For example: the local or regional public health officer.</items>
      <items id="description">Details about the person reviewing the completed investigation report.</items>
      <items id="text">Reviewer</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="comment">For example: sign-off, ready for submission to national public health authorities</items>
      <items id="description">Type of review requested.</items>
      <items id="text">Review type</items>
    </term_definitions>
    <term_definitions code="at0021">
      <items id="description">Narrative description about the investigation report.</items>
      <items id="text">Comment</items>
    </term_definitions>
    <term_definitions code="at0022">
      <items id="description">The date when the reviewer completed the review of the investigation.</items>
      <items id="text">Date review completed</items>
    </term_definitions>
    <term_definitions code="at0023">
      <items id="comment">This data element is redundant if there are no further levels of review required.</items>
      <items id="description">The date when the reviewer submitted the investigation report to the next level of review.</items>
      <items id="text">Date review submitted</items>
    </term_definitions>
    <term_definitions code="at0024">
      <items id="description">The date on which the investigation was submitted to public health authorities.</items>
      <items id="text">Date submitted to national authorities</items>
    </term_definitions>
    <term_definitions code="at0025">
      <items id="description">*</items>
      <items id="text">ITEM_TREE</items>
    </term_definitions>
    <term_definitions code="at0026">
      <items id="description">Details about the facility where the notifier is working when notifying about the infectious disease case.</items>
      <items id="text">Notifying facility</items>
    </term_definitions>
  </definition>
