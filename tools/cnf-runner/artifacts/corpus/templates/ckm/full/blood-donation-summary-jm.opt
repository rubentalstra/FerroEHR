      <items id="text">Donated</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="comment">May only record date if the blood product is not known.</items>
      <items id="description">*</items>
      <items id="text">Per donation event</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="comment">For example: 'Plasma' when the recorded 'Biological product type is 'Blood and blood component'. This data element may be redundant if the type of product is fully identified in 'Biological product type'.</items>
      <items id="description">Specific type of biological product.</items>
