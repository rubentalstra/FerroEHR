      <value>Molecular microbial test findings - JM</value>
    </template_id>
    <term_definitions code="at0000">
      <items id="description">The result of a laboratory test for the detection and identification of specific micro-organism DNA or RNA in a specimen, using nucleic acid probes.</items>
      <items id="text">Molecular microbial test findings</items>
    </term_definitions>
    <term_definitions code="at0022">
      <items id="description">Additional narrative about the test finding not captured in other fields.</items>
      <items id="text">Comment</items>
    </term_definitions>
    <term_definitions code="at0033">
      <items id="comment">If the tissue specimen has previously been identified in a a higher level archetype level archetype, such as the OBSERVATION.laboratory_test_result, this SLOT may be redundant.</items>
      <items id="description">Identification of the specimen examined.</items>
      <items id="text">Specimen</items>
    </term_definitions>
    <term_definitions code="at0049">
      <items id="comment">Coding with an external terminology is recommended, if available. For example: PCR for Mycobacterium tuberculosis or SARS-CoV-2.</items>
      <items id="description">Name of the molecular test carried out.</items>
      <items id="text">Test name</items>
    </term_definitions>
    <term_definitions code="at0050">
      <items id="description">Statement about detection of the identified microorganism in the specimen.</items>
      <items id="text">Presence</items>
    </term_definitions>
    <term_definitions code="at0051">
      <items id="description">*</items>
      <items id="text">Detected</items>
    </term_definitions>
    <term_definitions code="at0052">
      <items id="description">*</items>
      <items id="text">Not detected</items>
    </term_definitions>
    <term_definitions code="at0054">
      <items id="description">Quantitative assessment of the amount of the identified microorganism in the specimen.</items>
      <items id="text">Quantitative result</items>
    </term_definitions>
    <term_definitions code="at0055">
      <items id="comment">For example: PCR, RT-PCR, NGS, isothermal amplification.</items>
      <items id="description">Method used for the molecular test.</items>
      <items id="text">Test method</items>
    </term_definitions>
    <term_definitions code="at0056">
      <items id="description">*</items>
      <items id="text">Indeterminate</items>
    </term_definitions>
    <term_definitions code="at0057">
      <items id="comment">Coding with an external terminology is recommended, if available. For example: 16S rRNA gene (for bacteria), RdRp gene (for SARS-CoV-2), or ITS region (for fungi).</items>
      <items id="description">The specific genetic material within the microorganism that is being detected.</items>
      <items id="text">Molecular target</items>
    </term_definitions>
    <term_definitions code="at0059">
      <items id="comment">Coding with an external terminology is recommended, if available. For example: SARS-CoV-2, Mycobacterium tuberculosis, or Candida albicans.</items>
      <items id="description">The name of the microorganism being detected.</items>
      <items id="text">Microbial target</items>
    </term_definitions>
  </definition>
