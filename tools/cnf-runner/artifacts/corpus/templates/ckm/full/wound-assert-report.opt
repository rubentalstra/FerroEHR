                            <term_definitions code="at0000">
                              <items id="description">Details about an multimedia representation of the clinical data.</items>
                              <items id="text">Multimedia Resource</items>
                            </term_definitions>
                            <term_definitions code="at0001">
                              <items id="description">Multimedia representation of the clinical observation or finding.</items>
                              <items id="text">Multimedia</items>
                            </term_definitions>
                            <term_definitions code="at0002">
                              <items id="description">Title or identification of the multimedia resource.</items>
                              <items id="text">Name</items>
                            </term_definitions>
                            <term_definitions code="at0003">
                              <items id="description">The source of the multimedia resource.</items>
                              <items id="text">Source</items>
                            </term_definitions>
                            <term_definitions code="at0004">
                              <items id="description">Date/time that the multimedia resource was created.</items>
                              <items id="text">Date created</items>
                            </term_definitions>
                            <term_definitions code="at0005">
                              <items id="description">Narrative description of the multimedia resource.</items>
                              <items id="text">Description</items>
                            </term_definitions>
                            <term_definitions code="at0006">
                              <items id="description">Date/time that the multimedia resource was published.</items>
                              <items id="text">Date published</items>
                            </term_definitions>
                            <term_definitions code="at0007">
                              <items id="description">The version of the multimedia resource.</items>
                              <items id="text">Version</items>
                            </term_definitions>
                            <term_definitions code="at0008">
                              <items id="description">Internet link to the multimedia resource.</items>
                              <items id="text">URL</items>
                            </term_definitions>
                            <term_definitions code="at0009">
                              <items id="description">Name of the creator of the resource.</items>
                              <items id="text">Author</items>
                            </term_definitions>
                          </children>
