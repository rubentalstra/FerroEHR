                            </attributes>
                            <archetype_id>
                              <value>openEHR-EHR-CLUSTER.exam_body_fluid.v0</value>
                            </archetype_id>
                            <term_definitions code="at0000">
                              <items id="description">Findings observed during the examination of body fluid at a body site or from an identified body source, usually as part of a physical examination by a clinician.</items>
                              <items id="text">Examination of body fluid</items>
                            </term_definitions>
                            <term_definitions code="at0001">
                              <items id="comment">Coding of the 'Fluid name' with a coding system is desirable, if available.</items>
                              <items id="description">The name of the body fluid.</items>
                              <items id="text">Fluid name</items>
                            </term_definitions>
                            <term_definitions code="at0002">
                              <items id="comment">Record as True if no abnormality was detected on inspection. Specific statements about the normality of the findings can be included in the 'Clinical Interpretation' data element.</items>
                              <items id="description">Statement that no abnormality was detected (NAD) on inspection of the body fluid.</items>
                              <items id="text">No abnormality detected</items>
                            </term_definitions>
                            <term_definitions code="at0003">
                              <items id="description">Narrative description about the fluid.</items>
                              <items id="text">Clinical description</items>
                            </term_definitions>
                            <term_definitions code="at0004">
                              <items id="comment">For example: inclusion of detailed CLUSTER archetypes to record details about specific fluids such as clear fluids; or inclusion of further CLUSTER.exam_body_fluid archetypes could describe components of substances such as required to describe a mixture of blood and meconium post childbirth.</items>
                              <items id="description">Additional structured details about the body fluid.</items>
                              <items id="text">Specific findings</items>
                            </term_definitions>
                            <term_definitions code="at0005">
                              <items id="description">Digital image, video or diagram representing the inspection findings.</items>
                              <items id="text">Multimedia representation</items>
                            </term_definitions>
                            <term_definitions code="at0006">
                              <items id="description">Single word, phrase or brief description that represents the clinical meaning and significance of the examination findings.</items>
                              <items id="text">Clinical interpretation</items>
                            </term_definitions>
                            <term_definitions code="at0007">
                              <items id="description">Additional narrative about the inspection findings, not captured in other fields.</items>
                              <items id="text">Comment</items>
                            </term_definitions>
                            <term_definitions code="at0008">
                              <items id="description">Details to explicitly record that this examination was not performed.</items>
                              <items id="text">Examination not done</items>
                            </term_definitions>
                            <term_definitions code="at0014">
                              <items id="comment">The intent of this data element is to record either a narrative description of the amount, or to code with a value set such as small/medium/profuse or normal/increased where appropriate in a template. This data element is not intended for quantitative assessment of body fluids - use OBSERVATION.fluid_output for this purpose.</items>
                              <items id="description">Description of the amount of fluid observed at the identified body site.</items>
                              <items id="text">Amount</items>
                            </term_definitions>
                            <term_definitions code="at0015">
                              <items id="comment">Coding of the 'Body source' with a coding system is desirable, if available. If the body site has previously been identified in the 'Fluid name' data element or another archetype in which this archetype is nested, this data element becomes redundant. Please note: while this archetype will most likely be used in the context of a living subject, it is also appropriate to use in recording autopsy findings.</items>
                              <items id="description">Identification of the body site where the fluid was observed or source where the fluid was collected.</items>
                              <items id="text">Body source</items>
                            </term_definitions>
                            <term_definitions code="at0016">
                              <items id="comment">If the body source has previously been identified in the 'Fluid name' data element or another archetype in which this archetype is nested, this SLOT becomes redundant.</items>
                              <items id="description">A structured representation of the body site where the fluid was observed or source where the fluid was collected.</items>
                              <items id="text">Structured body source</items>
                            </term_definitions>
                            <term_definitions code="at0017">
                              <items id="comment">The intent of this data element is to record either a narrative description of the odour, or to code with a value set where appropriate in a template.</items>
                              <items id="description">Description of the smell of the body fluid.</items>
                              <items id="text">Odour</items>
                            </term_definitions>
                            <term_definitions code="at0018">
                              <items id="comment">The intent of this data element is to record either a narrative description of the colour, or to code with a value set where appropriate in a template.</items>
                              <items id="description">Description of the colour of the body fluid.</items>
                              <items id="text">Colour</items>
                            </term_definitions>
                            <term_definitions code="at0020">
                              <items id="comment">The intent of this data element is to record either a narrative description of the viscosity, or to code with a value set where appropriate in a template.</items>
                              <items id="description">Description of the viscosity or thickness of the body fluid.</items>
                              <items id="text">Viscosity</items>
                            </term_definitions>
                          </children>
