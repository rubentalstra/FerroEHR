                        <archetype_id>
                          <value>openEHR-EHR-CLUSTER.exam_wound.v0</value>
                        </archetype_id>
                        <term_definitions code="at0000">
                          <items id="description">Findings observed during the physical examination of a wound.</items>
                          <items id="text">Examination of a wound</items>
                        </term_definitions>
                        <term_definitions code="at0001">
                          <items id="comment">For example: the very generic term "skin", which will likely require additional qualification using one of the 'Body site' data elements, or the complete phrase "skin of right knee". Coding of the system or structure examined with a terminology is preferred, where possible.</items>
                          <items id="description">Identification of the examined body system or anatomical structure.</items>
                          <items id="text">System or structure examined</items>
                        </term_definitions>
                        <term_definitions code="at0003">
                          <items id="description">Narrative description of the overall findings observed during the examination of a wound.</items>
                          <items id="text">Clinical description</items>
                        </term_definitions>
                        <term_definitions code="at0004">
                          <items id="description">Structured details about the physical examination findings.</items>
                          <items id="text">Examination findings</items>
                        </term_definitions>
                        <term_definitions code="at0005">
                          <items id="description">Digital image, video or diagram representing the physical examination findings.</items>
                          <items id="text">Multimedia representation</items>
                        </term_definitions>
                        <term_definitions code="at0006">
                          <items id="comment">Coding of the 'Clinical interpretation' with a terminology is preferred, where possible.</items>
                          <items id="description">Single word, phrase or brief description that represents the clinical meaning and significance of the physical examination findings.</items>
                          <items id="text">Clinical interpretation</items>
                        </term_definitions>
                        <term_definitions code="at0007">
                          <items id="description">Additional narrative about the physical examination findings, not captured in other fields.</items>
                          <items id="text">Comment</items>
                        </term_definitions>
                        <term_definitions code="at0008">
                          <items id="description">Details to explicitly record that this examination was not performed.</items>
                          <items id="text">Examination not done</items>
                        </term_definitions>
                        <term_definitions code="at0011">
                          <items id="comment">If the body site has been fully identified in the 'System or structure examined' or the 'Body site' data element, this SLOT becomes redundant.</items>
                          <items id="description">A structured description of the area of the body under examination.</items>
                          <items id="text">Structured body site</items>
                        </term_definitions>
                        <term_definitions code="at0012">
                          <items id="comment">For example: "entire body", "face" or "right cheek". If the body site has been fully identified in the 'System or structure examined' data element, this data element becomes redundant.</items>
                          <items id="description">Identification of the area of the body under examination.</items>
                          <items id="text">Body site</items>
                        </term_definitions>
                        <term_definitions code="at0013">
                          <items id="comment">For example: color; induration; warmth; or oedema.</items>
                          <items id="description">Is undermining present in the wound?</items>
                          <items id="text">Undermining present?</items>
                        </term_definitions>
                        <term_definitions code="at0014">
                          <items id="description">Details about the observation of any exposed body structures, devices, and/or foreign bodies visible by the naked eye in a wound.</items>
                          <items id="text">Internal object or structure</items>
                        </term_definitions>
                        <term_definitions code="at0015">
                          <items id="comment">Coding of the visible internal structure if preferred, if possible.</items>
                          <items id="description">Idnetification of an exposed body structure, device, and/or foreign body visible by the naked eye within the wound.</items>
                          <items id="text">Object/structure</items>
                        </term_definitions>
                        <term_definitions code="at0016">
                          <items id="description">A name or alias for the wound, so that it can be distinguished from other wounds.</items>
                          <items id="text">Wound label</items>
                        </term_definitions>
                        <term_definitions code="at0017">
                          <items id="description">Is tunnelling present in the wound?</items>
                          <items id="text">Tunnelling present?</items>
                        </term_definitions>
                        <term_definitions code="at0020">
                          <items id="description">Is the object/structure present?</items>
                          <items id="text">Present or absent?</items>
                        </term_definitions>
                        <term_definitions code="at0021">
                          <items id="description">The identified object or structure is observed in the wound.</items>
                          <items id="text">Present</items>
                        </term_definitions>
                        <term_definitions code="at0022">
                          <items id="description">The identified object or structure is not observed in the wound.</items>
                          <items id="text">Absent</items>
                        </term_definitions>
                        <term_definitions code="at0023">
                          <items id="description">It is not possible to tell if the  identified object or structure is present or absent in the wound.</items>
                          <items id="text">Indeterminate</items>
                        </term_definitions>
                        <term_definitions code="at0024">
                          <items id="description">Narrative description about the associated factor.</items>
                          <items id="text">Description</items>
                        </term_definitions>
                        <term_definitions code="at0025">
                          <items id="description">Additional narrative about the associated factor, not captured in other fields.</items>
                          <items id="text">Comment</items>
                        </term_definitions>
                        <term_definitions code="at0026">
                          <items id="description">Undermining is observed in the wound.</items>
                          <items id="text">Present</items>
                        </term_definitions>
                        <term_definitions code="at0027">
                          <items id="description">Undermining is not observed in the wound.</items>
                          <items id="text">Absent</items>
                        </term_definitions>
                        <term_definitions code="at0028">
                          <items id="description">It is not possible to tell if undermining is present or absent.</items>
                          <items id="text">Indeterminate</items>
                        </term_definitions>
                        <term_definitions code="at0029">
                          <items id="description">Tunnelling is observed in the wound.</items>
                          <items id="text">Present</items>
                        </term_definitions>
                        <term_definitions code="at0030">
                          <items id="description">Tunnelling is not observed in the wound.</items>
                          <items id="text">Absent</items>
                        </term_definitions>
                        <term_definitions code="at0031">
                          <items id="description">It is not possible to tell if a tunnel is present or absent.</items>
                          <items id="text">Indeterminate</items>
                        </term_definitions>
                        <term_definitions code="at0032">
                          <items id="description">Is an exudate present in the wound?</items>
                          <items id="text">Exudate present?</items>
                        </term_definitions>
                        <term_definitions code="at0033">
                          <items id="description">An exudate is observed in the wound.</items>
                          <items id="text">Present</items>
                        </term_definitions>
                        <term_definitions code="at0034">
                          <items id="description">An exudate is not observed in the wound.</items>
                          <items id="text">Absent</items>
                        </term_definitions>
                        <term_definitions code="at0035">
                          <items id="description">It is not possible to tell if an exudate is present or absent.</items>
                          <items id="text">Indeterminate</items>
                        </term_definitions>
                        <term_definitions code="at0036">
                          <items id="description">Length of the wound (longest dimension).</items>
                          <items id="text">Length</items>
                        </term_definitions>
                        <term_definitions code="at0037">
                          <items id="description">Width of the wound (perpendicular to longest dimension).</items>
                          <items id="text">Width</items>
                        </term_definitions>
                        <term_definitions code="at0038">
                          <items id="description">Depth of the wound.</items>
                          <items id="text">Depth</items>
                        </term_definitions>
                        <term_definitions code="at0039">
                          <items id="description">Area of the wound.</items>
                          <items id="text">Area</items>
                        </term_definitions>
                        <term_definitions code="at0040">
                          <items id="description">Details about any exudate issuing from the wound.</items>
                          <items id="text">Exudate details</items>
                        </term_definitions>
                        <term_definitions code="at0041">
                          <items id="comment">Multiple occurrences of this cluster will allow recording of the undermining occurring in different parts of the wound.</items>
                          <items id="description">Details about undermining of the wound.</items>
                          <items id="text">Undermining details</items>
                        </term_definitions>
                        <term_definitions code="at0042">
                          <items id="description">Amount of tissue destruction that extends under the intact wound edge.</items>
                          <items id="text">Amount of undermining</items>
                        </term_definitions>
                        <term_definitions code="at0044">
                          <items id="comment">For example: one o'clock.</items>
                          <items id="description">Direction of the undermining outward from the centre of the wound, as described by a clock-face.</items>
                          <items id="text">Direction of undermining</items>
                        </term_definitions>
                        <term_definitions code="at0045">
                          <items id="comment">Multiple occurrences of this cluster will allow recording about each tunnel that leads from the wound.</items>
                          <items id="description">Details about tunnelling into other tissues.</items>
                          <items id="text">Tunnelling details</items>
                        </term_definitions>
                        <term_definitions code="at0046">
                          <items id="description">Length of an identified tunnel radiating out from the centre of the wound.</items>
                          <items id="text">Tunnel length</items>
                        </term_definitions>
                        <term_definitions code="at0047">
                          <items id="comment">For example: one o'clock.</items>
                          <items id="description">Direction of the tunnel radiating outward from the centre of the wound, as described by a clock-face.</items>
                          <items id="text">Direction of tunnel</items>
                        </term_definitions>
                        <term_definitions code="at0048">
                          <items id="description">Description about the edge of the wound.</items>
                          <items id="text">Edge description</items>
                        </term_definitions>
                        <term_definitions code="at0049">
                          <items id="description">Colour of the wound edge.</items>
                          <items id="text">Edge color</items>
                        </term_definitions>
                        <term_definitions code="at0051">
                          <items id="comment">Multiple occurrences of this Cluster allow for recordings of multiple discrete areas of different appearances..</items>
                          <items id="description">Details about the appearance of the base of the wound.</items>
                          <items id="text">Wound bed appearance</items>
                        </term_definitions>
                        <term_definitions code="at0052">
                          <items id="comment">For example: necrotic; sloughing; fibrinous; eschar; or granulation tissue.</items>
                          <items id="description">Description of the appearance of the wound base.</items>
                          <items id="text">Appearance</items>
                        </term_definitions>
                        <term_definitions code="at0053">
                          <items id="comment">This is the the area of the base of the wound that has a specific appearance, compared to the total area of the wound bed and represented as a percentage.</items>
                          <items id="description">The proportion of the wound that has the identified appearance.</items>
                          <items id="text">Proportion</items>
                        </term_definitions>
                        <term_definitions code="at0054">
                          <items id="comment">Multiple occurrences of this Cluster allow for recordings of more than one colour.</items>
                          <items id="description">Details about the colour of the base of the wound.</items>
                          <items id="text">Wound bed colour</items>
                        </term_definitions>
                        <term_definitions code="at0055">
                          <items id="comment">For example: red/healthy; red/hyperaemic; pink, yellow; black, brown; or grey.</items>
                          <items id="description">Description of the colour of the wound base.</items>
                          <items id="text">Colour</items>
                        </term_definitions>
                        <term_definitions code="at0056">
                          <items id="comment">This is the the area of the base of the wound that is a specific colour, compared to the total area of the wound bed and represented as a percentage.</items>
                          <items id="description">The proportion of the wound that is the identified colour.</items>
                          <items id="text">Proportion</items>
                        </term_definitions>
                        <term_definitions code="at0057">
                          <items id="comment">Multiple occurrences allow for the use of coded text to describe various aspects of the skin around the wound.</items>
                          <items id="description">Description of the skin surrounding the wound.</items>
                          <items id="text">Periwound description</items>
                        </term_definitions>
                        <term_definitions code="at0058">
                          <items id="description">Narrative description of a tunnel.</items>
                          <items id="text">Description</items>
                        </term_definitions>
                        <term_definitions code="at0059">
                          <items id="description">Narrative description about undermining of the whole wound.</items>
                          <items id="text">Undermining description</items>
                        </term_definitions>
                        <term_definitions code="at0060">
                          <items id="description">Details about factors that may be associated with the wound.</items>
                          <items id="text">Association</items>
                        </term_definitions>
                        <term_definitions code="at0061">
                          <items id="comment">For example: a device; or pressure point.</items>
                          <items id="description">Associated factor that may causing or influencing the healing of the wound.</items>
                          <items id="text">Factor</items>
                        </term_definitions>
                        <term_definitions code="at0062">
                          <items id="description">Is the identified factor present?</items>
                          <items id="text">Present or absent?</items>
                        </term_definitions>
                        <term_definitions code="at0063">
                          <items id="description">The identified factor is observed.</items>
                          <items id="text">Present</items>
                        </term_definitions>
                        <term_definitions code="at0064">
                          <items id="description">The identified factor is not observed.</items>
                          <items id="text">Absent</items>
                        </term_definitions>
                        <term_definitions code="at0065">
                          <items id="description">It is not possible to tell if the identified factor is present or absent.</items>
                          <items id="text">Indeterminate</items>
                        </term_definitions>
