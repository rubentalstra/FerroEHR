    <term_definitions code="at0000">
      <items id="description">The result of a laboratory test designed to detect and quantify the presence of specific antibodies produced by the immune system in response to a microorganism, tissue, allergen, or physiological process, within a clinical specimen.</items>
      <items id="text">Antibody test finding</items>
    </term_definitions>
    <term_definitions code="at0022">
      <items id="description">Additional narrative about the test finding not captured in other fields.</items>
      <items id="text">Comment</items>
    </term_definitions>
    <term_definitions code="at0033">
      <items id="comment">If the tissue specimen has previously been identified in a a higher level archetype level archetype, such as the OBSERVATION.laboratory_test_result, this SLOT may be redundant.</items>
      <items id="description">Identification of the specimen examined.</items>
      <items id="text">Specimen</items>
    </term_definitions>
    <term_definitions code="at0049">
      <items id="comment">Coding with an external terminology is recommended, if available. For example: SARS-CoV-2 IgG antibody test.</items>
      <items id="description">Name of the antibody test.</items>
      <items id="text">Test name</items>
    </term_definitions>
    <term_definitions code="at0050">
      <items id="description">Statement about detection of the identified antibody in the specimen.</items>
      <items id="text">Presence</items>
    </term_definitions>
    <term_definitions code="at0051">
      <items id="description">*</items>
      <items id="text">Detected</items>
    </term_definitions>
    <term_definitions code="at0052">
      <items id="description">*</items>
      <items id="text">Not detected</items>
    </term_definitions>
    <term_definitions code="at0054">
      <items id="description">Quantitative assessment of the amount of the identified antibody in the specimen.</items>
      <items id="text">Quantitative result</items>
    </term_definitions>
    <term_definitions code="at0055">
      <items id="comment">Coding with an external terminology is recommended, if available. For example: lateral flow immunoassay, ELISA, chemiluminescent immunoassay.</items>
      <items id="description">Method used for the antibody test.</items>
      <items id="text">Test method</items>
    </term_definitions>
    <term_definitions code="at0056">
      <items id="description">*</items>
      <items id="text">Indeterminate</items>
    </term_definitions>
    <term_definitions code="at0057">
      <items id="comment">Coding with an external terminology is recommended, if available. For example: infection-related IgG/IgM, IgG1 or IgG2, allergen-specific IgE; anti-dsDNA.</items>
      <items id="description">The specific antigenic structure or component that the test is designed to detect.</items>
      <items id="text">Antibody target</items>
    </term_definitions>
    <term_definitions code="at0059">
      <items id="comment">Coding with an external terminology is recommended, if available. For example: SARS-CoV-2.</items>
      <items id="description">The name of the microorganism associated with the antibody target, if relevant.</items>
      <items id="text">Microbial target</items>
    </term_definitions>
  </definition>
