                <archetype_id>
                  <value>openEHR-EHR-EVALUATION.recommendation-amd_treatment.v0</value>
                </archetype_id>
                <term_definitions code="at0.11">
                  <items id="description">A light-sensitive medicine is injected into the bloodstream, and blocks selectively abnormal blood vessels under the macula in response to laser light. PDT is applicable to stop further formation of wet AMD, but it cannot reverse damage.</items>
                  <items id="text">Photodynamic Therapy (PDT)</items>
                </term_definitions>
                <term_definitions code="at0.12">
                  <items id="description">Daily intake of certain antioxidants and minerals can help slow the progression of age-related macular degeneration (AMD).</items>
                  <items id="text">High dose Antioxidant Vitamin and Mineral Supplements</items>
                </term_definitions>
                <term_definitions code="at0.14">
                  <items id="description">By treating the abnormal blood vessels that have formed on the retina, laser surgery can delay advancement of the disease.</items>
                  <items id="text">Thermal Laser Photocoagulation Surgery</items>
                </term_definitions>
                <term_definitions code="at0.15">
                  <items id="description">Loss of at least one line of visual acuity, in comparison to the previous revision, associated with the presence of macular fluid indicative of activity on AMD.</items>
                  <items id="text">Visual acuity decrease with macular fluid</items>
                </term_definitions>
                <term_definitions code="at0.16">
                  <items id="description">Persistence of intraretinal or subretinal macular fluid indicative of AMD activity.</items>
                  <items id="text">Macular fluid</items>
                </term_definitions>
                <term_definitions code="at0.17">
                  <items id="description">Emerging new macular haemorrhage detected.</items>
                  <items id="text">New macular haemorrhage</items>
                </term_definitions>
                <term_definitions code="at0.4">
                  <items id="description">Observation of the condition is recommended when no treatment is indicated or the afection is not tratable.</items>
                  <items id="text">Do not treat</items>
                </term_definitions>
                <term_definitions code="at0.5">
                  <items id="description">Inhibition of neovascularization may delay or even halt progression of exudative form of AMD.</items>
                  <items id="text">Intravitreal anti-VEGF injection</items>
                </term_definitions>
                <term_definitions code="at0000">
                  <items id="description">A suggestion, advice or proposal for current healthcare management or for future action.</items>
                  <items id="text">Recommendation</items>
                </term_definitions>
                <term_definitions code="at0000.1">
                  <items id="description">A suggestion, advice or proposal toward application of the appropriate therapy for patients diagnosed with age-related macular degeneration.</items>
                  <items id="text">Recommendation on the treatment of AMD</items>
                </term_definitions>
                <term_definitions code="at0001">
                  <items id="description">@ internal @</items>
                  <items id="text">Tree</items>
                </term_definitions>
                <term_definitions code="at0002">
                  <items id="description">Narrative description of the recommendation.</items>
                  <items id="text">Recommendation</items>
                </term_definitions>
                <term_definitions code="at0002.1">
                  <items id="description">Narrative description of the most effective treatment based on a previous assessment of AMD.</items>
                  <items id="text">Therapeutic recommendation</items>
                </term_definitions>
                <term_definitions code="at0003">
                  <items id="description">Justification for the recommendation.</items>
                  <items id="text">Rationale</items>
                </term_definitions>
                <term_definitions code="at0003.1">
