                <archetype_id>
                  <value>openEHR-EHR-ADMIN_ENTRY.procedure_efficiency.v0</value>
                </archetype_id>
                <term_definitions code="at0000">
                  <items id="description">Parameters of interest for an objective study of the efficiency for a specific healthcare procedure.</items>
                  <items id="text">Efficiency of healthcare procedure</items>
                </term_definitions>
                <term_definitions code="at0001">
                  <items id="description">@ internal @</items>
                  <items id="text">Tree</items>
                </term_definitions>
                <term_definitions code="at0002">
                  <items id="description">Identifies the type of clinical encounter or healthcare procedure analysed. Specially useful when different types are compared.</items>
                  <items id="text">Procedure type</items>
                </term_definitions>
                <term_definitions code="at0003">
                  <items id="description">Time how long it takes to complete the encounter or healthcare procedure analysed.</items>
                  <items id="text">Duration</items>
                </term_definitions>
                <term_definitions code="at0008">
                  <items id="description">Number of fungible or medication units expent in the procedure.</items>
                  <items id="text">Quantity expent</items>
                </term_definitions>
                <term_definitions code="at0009">
                  <items id="description">Parameters about the use of healthcare resources in the procedure analysed.</items>
                  <items id="text">Resource usage</items>
                </term_definitions>
                <term_definitions code="at0011">
                  <items id="description">Identification of categories of the clinical personnel engaged in the healthcare procedure analized.</items>
                  <items id="text">Personnel type</items>
                </term_definitions>
                <term_definitions code="at0012">
                  <items id="description">Identification of any dispensation of fungible metrials and medications.</items>
                  <items id="text">Fungible/Medication</items>
                </term_definitions>
                <term_definitions code="at0013">
                  <items id="description">Type of fungible or medication dispensed.</items>
                  <items id="text">Resource type</items>
                </term_definitions>
                <term_definitions code="at0014">
                  <items id="description">Identification of fixed assets required to conduct the healthcare procedure analysed.</items>
                  <items id="text">Fixed assets</items>
                </term_definitions>
                <term_definitions code="at0015">
                  <items id="description">Quantification of human resources in the healthcare procedure analysed.</items>
                  <items id="text">Human</items>
                </term_definitions>
                <term_definitions code="at0016">
                  <items id="description">Number of paticipants in the healthcare procedure for the category defined above.</items>
                  <items id="text">Staff quantity</items>
                </term_definitions>
                <term_definitions code="at0017">
                  <items id="description">Date/time of onset of the encounter or healthcare procedure analysed.</items>
                  <items id="text">Start date</items>
                </term_definitions>
                <term_definitions code="at0019">
                  <items id="description">Additional differentiating details used later to compare clinical encounters or healthcare procedures on equal terms.</items>
                  <items id="text">Specific details</items>
                </term_definitions>
                <term_definitions code="at0020">
                  <items id="description">Narrative description of the clinical encounter or healthcare procedure analysed.</items>
                  <items id="text">Description</items>
                </term_definitions>
              </children>
              <cardinality>
                <is_ordered>false</is_ordered>
                <is_unique>false</is_unique>
