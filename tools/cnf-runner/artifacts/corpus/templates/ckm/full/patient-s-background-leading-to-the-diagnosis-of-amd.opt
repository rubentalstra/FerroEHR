        <term_definitions code="at0000">
          <items id="description">Record of clinical findings on fundoscopy of eyes</items>
          <items id="text">Fundoscopic examination of eyes</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Event Series</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">*</items>
          <items id="text">Any event</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="description">Determines the eye on which the test was performed.Matches to DICOM Laterality (0020,0060) attribute.</items>
          <items id="text">Side</items>
        </term_definitions>
        <term_definitions code="at0008">
          <items id="description">Descriptive overview of examination findings</items>
          <items id="text">Clinical Description</items>
        </term_definitions>
        <term_definitions code="at0013">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0014">
          <items id="description">True if mydriatic is used</items>
          <items id="text">Mydriatic used</items>
        </term_definitions>
        <term_definitions code="at0028">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0029">
          <items id="description">Method chosen to perform the funduscopic examination</items>
          <items id="text">Method</items>
        </term_definitions>
        <term_definitions code="at0030">
          <items id="description">Study performed by direct ophthalmoscopy</items>
          <items id="text">Direct</items>
        </term_definitions>
        <term_definitions code="at0031">
          <items id="description">Study of eye fundus by indirect ophthalmoscopy method</items>
          <items id="text">Indirect</items>
        </term_definitions>
        <term_definitions code="at0051">
          <items id="description">Details about acquisition obtained during the examination of eye fundus</items>
          <items id="text">Acquisition details</items>
        </term_definitions>
        <term_definitions code="at0053">
          <items id="description">True if Red Reflex is present</items>
          <items id="text">Red reflex</items>
        </term_definitions>
        <term_definitions code="at0054">
          <items id="description">True if during the acquisition, pupil diameter is smaller than normal (3,3mm)</items>
          <items id="text">Small pupil</items>
        </term_definitions>
        <term_definitions code="at0055">
          <items id="description">True if cataract obstructs the visualization of eye fundus</items>
          <items id="text">Cataract artifact</items>
        </term_definitions>
        <term_definitions code="at0056">
          <items id="description">True if shadow artifact is present on the border of the image</items>
          <items id="text">Shadow artifact</items>
        </term_definitions>
        <term_definitions code="at0057">
          <items id="description">Details about image quality related to ease of visualization of structures on eye fundus</items>
          <items id="text">Visualization</items>
        </term_definitions>
        <term_definitions code="at0058">
          <items id="description">Comment, especially if not fully visualised</items>
          <items id="text">Comment</items>
        </term_definitions>
        <term_definitions code="at0059">
          <items id="description">Levels quantifying the quality of each acquisition, based in the ease to visualize the structures on the eye fundus</items>
          <items id="text">Quality</items>
        </term_definitions>
        <term_definitions code="at0060">
          <items id="description">*</items>
          <items id="text">Quality inadequate for any diagnostic purpose</items>
        </term_definitions>
        <term_definitions code="at0061">
          <items id="description">*</items>
          <items id="text">Unable to exclude all emergent findings</items>
        </term_definitions>
        <term_definitions code="at0062">
          <items id="description">*</items>
          <items id="text">Only able to exclude emergent findings</items>
        </term_definitions>
        <term_definitions code="at0063">
          <items id="description">*</items>
          <items id="text">Quality not ideal, but is possible to exclude subtle findings</items>
        </term_definitions>
        <term_definitions code="at0064">
          <items id="description">*</items>
          <items id="text">Ideal quality</items>
        </term_definitions>
        <term_definitions code="at0065">
          <items id="description">General description of the structures in the eye fundus</items>
          <items id="text">Structural description</items>
        </term_definitions>
        <term_definitions code="at0066">
          <items id="description">Information of diagnostic interest obtained in the test</items>
          <items id="text">Clinical results</items>
        </term_definitions>
        <term_definitions code="at0067">
          <items id="description">Describes the optical acceptance angle of the lens used during the test</items>
          <items id="text">Field angle</items>
        </term_definitions>
        <term_definitions code="at0068">
          <items id="description">30º angle used for small pupil (SP) capture (for patients with pupil diameter &lt;3.3mm)</items>
          <items id="text">30º</items>
        </term_definitions>
        <term_definitions code="at0069">
          <items id="description">45º angle used to acquire eye fundus of normal pupils</items>
          <items id="text">45º</items>
        </term_definitions>
        <term_definitions code="at0070">
          <items id="description">Wide angle acquisition</items>
          <items id="text">100º</items>
        </term_definitions>
        <term_definitions code="at0071">
          <items id="description">Ultra-wide angle acquisition</items>
          <items id="text">200º</items>
        </term_definitions>
        <term_definitions code="at0072">
          <items id="description">Number of attempts before obtaining the acquisition (doesn't compute if test is repeated by a specific recognized technical failure)</items>
          <items id="text">Attempts</items>
        </term_definitions>
        <term_definitions code="at0073">
          <items id="description">Subdivision of the retina identifying eye fundus image locations</items>
          <items id="text">Subdivision of the retina</items>
        </term_definitions>
        <term_definitions code="at0074">
          <items id="description">Subdivision of the retina based on Diabetic Retinopathy Study fields</items>
          <items id="text">ETRDS fields</items>
        </term_definitions>
        <term_definitions code="at0075">
          <items id="description">*</items>
          <items id="text">Study field 1</items>
        </term_definitions>
        <term_definitions code="at0076">
          <items id="description">*</items>
          <items id="text">Study field 2</items>
        </term_definitions>
        <term_definitions code="at0077">
          <items id="description">*</items>
          <items id="text">Study field 3</items>
        </term_definitions>
        <term_definitions code="at0078">
          <items id="description">*</items>
          <items id="text">Study field 4</items>
        </term_definitions>
        <term_definitions code="at0079">
          <items id="description">*</items>
          <items id="text">Study field 5</items>
        </term_definitions>
        <term_definitions code="at0080">
          <items id="description">*</items>
          <items id="text">Study field 6</items>
        </term_definitions>
        <term_definitions code="at0081">
          <items id="description">*</items>
          <items id="text">Study field 7</items>
        </term_definitions>
        <term_definitions code="at0082">
          <items id="description">Division of the retina in quadrants + mosaic obtained from the combination of them</items>
          <items id="text">Mosaic and peripherals</items>
        </term_definitions>
        <term_definitions code="at0083">
          <items id="description">Mosaic obtained from combining every peripheral acquisitions and the center one</items>
          <items id="text">Mosaic</items>
        </term_definitions>
        <term_definitions code="at0084">
          <items id="description">Image centered on the macula</items>
          <items id="text">Central</items>
        </term_definitions>
        <term_definitions code="at0085">
          <items id="description">Image centered on the optic nerve or papila</items>
          <items id="text">Nasal</items>
        </term_definitions>
        <term_definitions code="at0086">
          <items id="description">Image centered on the temporal quadrant of the retina</items>
          <items id="text">Temporal</items>
        </term_definitions>
        <term_definitions code="at0087">
          <items id="description">Image centered on the superior half of the retina</items>
          <items id="text">Superior</items>
        </term_definitions>
        <term_definitions code="at0088">
          <items id="description">Image centered on the inferior half of the retina</items>
          <items id="text">Inferior</items>
        </term_definitions>
        <term_definitions code="at0089">
          <items id="description">Details of the device used to acquire eye fundus images</items>
          <items id="text">Device details</items>
        </term_definitions>
        <term_definitions code="at0090">
          <items id="description">Description of macula</items>
          <items id="text">Macula</items>
        </term_definitions>
        <term_definitions code="at0091">
          <items id="description">Description of optic disc</items>
          <items id="text">Optic Disc</items>
        </term_definitions>
        <term_definitions code="at0092">
          <items id="description">Description of retinal arteries</items>
          <items id="text">Retinal arteries</items>
        </term_definitions>
        <term_definitions code="at0093">
          <items id="description">Description of retinal veins</items>
          <items id="text">Retinal veins</items>
        </term_definitions>
        <term_definitions code="at0094">
          <items id="description">Description of retinal background</items>
          <items id="text">Retinal background</items>
        </term_definitions>
        <term_definitions code="at0098">
          <items id="description">Description of vitreous humour</items>
          <items id="text">Vitreous</items>
        </term_definitions>
        <term_definitions code="at0122">
          <items id="description">60º angle used to acquire eye fundus in some DR screening studies</items>
          <items id="text">60º</items>
        </term_definitions>
        <term_definitions code="at0123">
          <items id="description">True if the refraction of the eye exceeds the range from -12D to +15D</items>
          <items id="text">High refraction</items>
        </term_definitions>
        <term_definitions code="at0124">
          <items id="description">True if patient doesn't collaborate during the image acquisition</items>
          <items id="text">Uncooperative patient</items>
        </term_definitions>
        <term_definitions code="at0126">
          <items id="description">Narrative description of clinical findings not considered in the SLOT</items>
          <items id="text">Other findings</items>
        </term_definitions>
        <term_definitions code="at0128">
          <items id="description">Other details identified during the acquisition which may affect the results from reviewing the test</items>
          <items id="text">Others</items>
        </term_definitions>
        <term_definitions code="at0129">
          <items id="description">Observation of retina through funduscopic images acquired by previous dilatation of patient's pupils</items>
          <items id="text">Mydriatic retinography</items>
        </term_definitions>
        <term_definitions code="at0130">
          <items id="description">Observation of retina through funduscopic images acquired without previous dilatation of patient's pupils</items>
          <items id="text">Non-mydriatic retinography</items>
        </term_definitions>
        <term_definitions code="at0131">
          <items id="description">Eye fundus viewing through biomicroscopy lens in contact to patient's eye surface</items>
          <items id="text">Contact lens biomicroscopy</items>
        </term_definitions>
        <term_definitions code="at0132">
          <items id="description">Eye fundus viewing through biomicroscopy lens without contact to patient's eye surface</items>
          <items id="text">Non-contact lens biomicroscopy</items>
        </term_definitions>
        <term_definitions code="at0135">
          <items id="description">Observation of the eye fundus using a fluorescent dye inyected to emphasize the blood vessels in the eye retina</items>
          <items id="text">Angiography</items>
        </term_definitions>
        <term_definitions code="at0136">
          <items id="description">Details of the funduscopic examination test result for each eye.</items>
          <items id="text">Test Result</items>
        </term_definitions>
        <term_definitions code="at0137">
          <items id="description">The left eye was examined.</items>
          <items id="text">Left eye</items>
        </term_definitions>
        <term_definitions code="at0138">
          <items id="description">The right eye was examined.</items>
          <items id="text">Right eye</items>
        </term_definitions>
        <term_definitions code="at0139">
          <items id="description">Abnormalities of diagnostic interest found in the eye fundus</items>
          <items id="text">Clinical findings</items>
        </term_definitions>
