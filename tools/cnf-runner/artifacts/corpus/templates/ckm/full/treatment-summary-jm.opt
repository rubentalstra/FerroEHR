    <archetype_id>
      <value>openEHR-EHR-EVALUATION.intervention_summary.v1</value>
    </archetype_id>
    <template_id>
      <value>Treatment summary - JM</value>
    </template_id>
    <term_definitions code="at0000">
      <items id="description">A summary about a therapeutic activity intended to prevent, diagnose, treat, or manage health conditions, support mental or physical well-being, or address social and environmental factors that influence health outcomes.</items>
      <items id="text">Intervention summary</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="description">@ internal @</items>
      <items id="text">Item tree</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="description">@ internal @</items>
      <items id="text">Item tree</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="comment">For example: 'Radiotherapy', 'Smoking cessation brief intervention' or 'Appendectomy'. Coding with an external terminology is preferred, where possible.</items>
      <items id="description">The name of the intervention.</items>
      <items id="text">Intervention name</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="comment">For example the date when the last in a series of chemotherapy infusions was administered.</items>
      <items id="description">The date/time when the identified intervention was completed, or stopped prior to the completion.</items>
      <items id="text">Stop date</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="comment">This element should only be used when the intervention has ended. "As originally intended" as mentioned in the description of this element may range from the unstated intent of a single clinician responding to an acute situation, to a formal and evidence-based clinical protocol or pathway.</items>
      <items id="description">The outcome of the intervention based on whether it was delivered as originally intended.</items>
      <items id="text">Delivery outcome</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="comment">Coding with an external terminology is preferred, where possible.</items>
      <items id="description">Description of the reason for the delivery outcome.</items>
      <items id="text">Reason for delivery outcome</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="comment">For example: successful, failed, indeterminate. 
Coding with an external terminology is preferred, where possible.</items>
      <items id="description">The outcome of the intervention based on its therapeutic effectiveness.</items>
      <items id="text">Therapeutic outcome</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="description">Date of the most recent contact between the individual and a healthcare provider or service, whether clinical or non-clinical, including formal encounters, consultations, outreach, or other forms of communication.</items>
      <items id="text">Date of last interaction</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="description">Narrative description about the intervention, not captured in other fields.</items>
      <items id="text">Comment</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items>
      <items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items>
      <items id="text">Extension</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="description">The date this intervention summary was last updated.</items>
      <items id="text">Last updated</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="comment">For example: drug resistance profile; clinical evidence.</items>
      <items id="description">Additional structured details about the intervention.</items>
      <items id="text">Additional details</items>
    </term_definitions>
    <term_definitions code="at0021">
      <items id="description">The intervention was delivered in full and as originally intended.</items>
      <items id="text">Delivered as intended</items>
    </term_definitions>
    <term_definitions code="at0022">
      <items id="description">The intervention was delivered in full, but not as originally intended.</items>
      <items id="text">Delivered with deviations</items>
    </term_definitions>
    <term_definitions code="at0027">
      <items id="comment">For example: 'Drug resistance', 'Tumour responded to treatment' and 'Tumour did not respond to treatment'.</items>
      <items id="description">Description of the reason for the therapeutic outcome.</items>
      <items id="text">Reason for therapeutic outcome</items>
    </term_definitions>
    <term_definitions code="at0028">
      <items id="description">Narrative description about the intervention.</items>
      <items id="text">Description</items>
    </term_definitions>
    <term_definitions code="at0032">
      <items id="comment">For example the date when the first in a series of chemotherapy infusions started.</items>
      <items id="description">The date/time when the identified intervention first commenced.</items>
      <items id="text">Start date</items>
    </term_definitions>
    <term_definitions code="at0033">
      <items id="comment">Coding of the 'Clinical indication' with an external terminology is recommended, if available. This data element has multiple occurrences to allow the recording of more than one clinical indication per intervention.</items>
      <items id="description">The symptom, sign, problem or diagnosis that necessitates the intervention.</items>
      <items id="text">Clinical indication</items>
    </term_definitions>
    <term_definitions code="at0034">
      <items id="comment">For example preventive, diagnostic, curative or palliative intent. Coding of the 'Intent" with an external terminology is recommended, if available. This data element has multiple occurrences to allow the recording of more than one intent.</items>
      <items id="description">Description of the intent for the intervention.</items>
      <items id="text">Intent</items>
    </term_definitions>
    <term_definitions code="at0051">
      <items id="comment">For example: First-line, second-line, or rescue/salvage treatments.</items>
      <items id="description">The position of this 'Intervention' within a sequence defined by a broader treatment protocol.</items>
      <items id="text">Therapeutic sequence</items>
    </term_definitions>
    <term_definitions code="at0054">
      <items id="description">Identification of the clinical protocol, guideline, or authoritative reference that supports or justifies the intervention.</items>
      <items id="text">Clinical protocol</items>
    </term_definitions>
    <term_definitions code="at0055">
      <items id="comment">For example main treatment, neoadjuvant, concomitant, adjuvant, preoperative or postoperative, acute, continuation, maintenance.</items>
      <items id="description">The clinical purpose of an intervention within the context of a broader treatment protocol, specifying its intended timing or function in relation to the overall therapeutic strategy.</items>
      <items id="text">Therapeutic role</items>
    </term_definitions>
    <term_definitions code="at0057">
      <items id="comment">The identifier assigned to the intervention by the clinical system requesting or performing the intervention. This can be from the local EHR in a INSTRUCTION or ACTION archetype, or from an external requester or health service provider.</items>
      <items id="description">Identification of the intervention.</items>
      <items id="text">Intervention ID</items>
    </term_definitions>
    <term_definitions code="at0058">
      <items id="comment">For example ‘Brachytherapy’, ‘Motivational interviewing technique’ or ‘Laparoscopic’.</items>
      <items id="description">A more specific method or process for delivering the intervention identified in ‘Intervention name’.</items>
      <items id="text">Intervention type</items>
    </term_definitions>
    <term_definitions code="at0059">
      <items id="comment">For example 'Cancer treatment', 'Psychosocial' or ‘Surgical'.</items>
      <items id="description">An overarching grouping for the intervention identified in 'Intervention name'.</items>
      <items id="text">Intervention category</items>
    </term_definitions>
    <term_definitions code="at0060">
      <items id="description">It is unknown whether the intervention was delivered as originally intended.</items>
      <items id="text">Unknown</items>
    </term_definitions>
    <term_definitions code="at0061">
      <items id="description">The intervention was commenced, but not all parts were delivered as originally intended.</items>
      <items id="text">Partially delivered</items>
    </term_definitions>
  </definition>
  <view/>
</template>