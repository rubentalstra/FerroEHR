    <term_definitions code="at0000">
      <items id="description">Details about menstrual bleeding and associated symptoms within a specified single cycle or specified group of cycles.</items>
      <items id="text">Menstruation</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="description">@ internal @</items>
      <items id="text">Event Series</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="description">Default, unspecified interval event which may be explicitly defined in a template or at run-time.</items>
      <items id="text">Any interval</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="description">@ internal @</items>
      <items id="text">Tree</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="comment">When recorded against the 'Last normal period' event, this data point captures the 'Last Normal Menstrual Period (LNMP)'.</items>
      <items id="description">Date of onset of menstrual bleeding in a single cycle.</items>
      <items id="text">Start of menses</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="description">Duration of menstrual bleeding in this cycle.</items>
      <items id="text">Duration of menses</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="description">Narrative description of the menstrual bleeding.</items>
      <items id="text">Description of menses</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="description">Relative description of amount of menstrual flow.</items>
      <items id="text">Relative flow</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="description">Very heavy menstrual flow, often causing additional problems such as flooding and clotting.</items>
      <items id="text">Very heavy flow</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="description">Heavy menstrual flow.</items>
      <items id="text">Heavy flow</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="description">Normal menstrual flow.</items>
      <items id="text">Normal, or typical, flow</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="description">Light menstrual flow.</items>
      <items id="text">Light flow</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="description">Menstrual spotting only.</items>
      <items id="text">Spotting only</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="description">Presence of blood clots in the menstrual flow.</items>
      <items id="text">Blood clots</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="description">Blood clots occurred during the menstrual flow.</items>
      <items id="text">Present</items>
    </term_definitions>
    <term_definitions code="at0015">
      <items id="description">Blood clots did not occur during the menstrual flow.</items>
      <items id="text">Absent</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="description">Presence of heavy menstrual flow that exceeded capacity of sanitary napkins and other menstrual products to absorb the menstrual flow.</items>
      <items id="text">Flooding</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="description">Flooding occurred during the menstrual flow.</items>
      <items id="text">Present</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="description">Flooding did not occur during the menstrual flow.</items>
      <items id="text">Absent</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="comment">For example: menstrual cramps or headaches.</items>
      <items id="description">Details about symptoms related to menses.</items>
      <items id="text">Associated symptoms</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="description">@ internal @</items>
      <items id="text">Tree</items>
    </term_definitions>
    <term_definitions code="at0021">
      <items id="comment">Coding with a terminology is preferred, where possible.</items>
      <items id="description">Identify concurrent hormone or intrauterine contraception use.</items>
      <items id="text">Contraception use</items>
    </term_definitions>
