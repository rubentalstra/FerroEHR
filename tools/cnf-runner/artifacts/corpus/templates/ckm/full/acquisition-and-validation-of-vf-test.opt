        <term_definitions code="at0000">
          <items id="description">Results of visual field testing / perimetry.</items>
          <items id="text">Visual field measurement</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Event Series</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">Any measurement event.</items>
          <items id="text">Any event</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0005">
          <items id="description">A term, commonly coded, expressing an overall interpretation of the visual field test.</items>
          <items id="text">Clinical Description</items>
        </term_definitions>
        <term_definitions code="at0006">
          <items id="description">A multimedia representaion of the visual field test.</items>
          <items id="text">Image</items>
        </term_definitions>
        <term_definitions code="at0007">
          <items id="description">Details of the visual field test result for each eye.</items>
          <items id="text">Test Result</items>
        </term_definitions>
        <term_definitions code="at0008">
          <items id="description">The eye which is being examined.</items>
          <items id="text">Eye</items>
        </term_definitions>
        <term_definitions code="at0009">
          <items id="description">The test result expressed as a qualitative term, normally coded.</items>
          <items id="text">Clinical Interpretation</items>
        </term_definitions>
        <term_definitions code="at0010">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0011">
          <items id="description">The method used to record the perimetry result.</items>
          <items id="text">Perimetry Method</items>
        </term_definitions>
        <term_definitions code="at0012">
          <items id="description">Goldman perimetry was used to measure the visual fields.</items>
          <items id="text">Goldman perimetry</items>
        </term_definitions>
        <term_definitions code="at0013">
          <items id="description">The Dicon device was used to measure the visual fields.</items>
          <items id="text">Dicon</items>
        </term_definitions>
        <term_definitions code="at0014">
          <items id="description">A Henson device was used to measure the visual fields.</items>
          <items id="text">Henson</items>
        </term_definitions>
        <term_definitions code="at0015">
          <items id="description">An Octopus device was used to measure the visual fields.</items>
          <items id="text">Octopus</items>
        </term_definitions>
        <term_definitions code="at0016">
          <items id="description">A Humphrey device was used to measure the visual fields.</items>
          <items id="text">Humphrey</items>
        </term_definitions>
        <term_definitions code="at0017">
          <items id="description">Frequency Doubling Perimetry was used to measure the visual fields.</items>
          <items id="text">Frequency Doubling Perimetry (FDP)</items>
        </term_definitions>
        <term_definitions code="at0019">
          <items id="description">The left eye was examined.</items>
          <items id="text">Left eye</items>
        </term_definitions>
        <term_definitions code="at0020">
          <items id="description">The right eye was examined.</items>
          <items id="text">Right eye</items>
        </term_definitions>
        <term_definitions code="at0022">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0023">
          <items id="description">Patient circumstances which may affect interpretation of the result.</items>
          <items id="text">Confounding Factors</items>
        </term_definitions>
        <term_definitions code="at0024">
          <items id="description">Any additional narrative comment about the visual field test.</items>
          <items id="text">Additional Comment</items>
        </term_definitions>
        <term_definitions code="at0025">
          <items id="description">A term, commonly coded, expressing an overall interpretation of the visual field test.</items>
          <items id="text">Overall Interpretation</items>
        </term_definitions>
        <term_definitions code="at0026">
          <items id="description">Details of the device used to measure visual fields.</items>
          <items id="text">Device Details</items>
        </term_definitions>
        <term_definitions code="at0027">
          <items id="description">A coded intepretation of the Glaucoma Hemifield Test (GHT).</items>
          <items id="text">Glaucoma Hemifield Test (GHT)</items>
        </term_definitions>
        <term_definitions code="at0028">
          <items id="description">Differences between a matched pair of corresponding zones exceeds the difference found in 99% of the normal population, or when both members of a pair of zones are more abnormal than 99.5% of the individuals with the normative population.</items>
          <items id="text">Outside normal limits</items>
        </term_definitions>
        <term_definitions code="at0029">
          <items id="description">Matched pairs of zones are abnormal at the 97th percentile within the normative database.</items>
          <items id="text">Borderline</items>
        </term_definitions>
        <term_definitions code="at0030">
          <items id="description">Conditions for “outside normal limits” are not met, and the best region of the visual field is at or below the 99.5th percentile of the normative population.</items>
          <items id="text">General reduction of sensitivity</items>
        </term_definitions>
        <term_definitions code="at0031">
          <items id="description">Overall sensitivity in the affected  region of the VF is better than 99.5% of individuals within the normative population.</items>
          <items id="text">Abnormally high sensitivity</items>
        </term_definitions>
        <term_definitions code="at0032">
          <items id="description">None of the abnormal conditions are met.</items>
          <items id="text">Within normal limits</items>
        </term_definitions>
        <term_definitions code="at0034">
          <items id="description">The average of deviation in vusual field across all test areas.</items>
          <items id="text">Mean deviation</items>
        </term_definitions>
        <term_definitions code="at0035">
          <items id="description">Average of non-uniform visual field loss.</items>
          <items id="text">Pattern Standard deviation</items>
        </term_definitions>
        <term_definitions code="at0036">
          <items id="description">Details of refractive correction applied to each eye.</items>
          <items id="text">Refractive correction</items>
        </term_definitions>
        <term_definitions code="at0037">
          <items id="description">Visual Field Index result.</items>
          <items id="text">Visual Field Index</items>
        </term_definitions>
        <term_definitions code="at0038">
          <items id="description">The P value of the Mean Deviation result.</items>
          <items id="text">Mean deviation P</items>
        </term_definitions>
        <term_definitions code="at0039">
          <items id="description">The P value of the Pattern Standard deviation result.</items>
          <items id="text">Pattern Standard deviation P</items>
        </term_definitions>
        <term_definitions code="at0040">
          <items id="description">FASTPAC automated standard perimetry was used to measure the visual fields.</items>
          <items id="text">FASTPAC automated standard perimetry</items>
        </term_definitions>
