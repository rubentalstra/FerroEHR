        <archetype_id>
          <value>openEHR-EHR-EVALUATION.infectious_investigation_classification.v0</value>
        </archetype_id>
        <term_definitions code="at0000">
          <items id="description">Classification for an identified infectious disease as part of a disease surveillance investigation.</items>
          <items id="text">Infectious disease investigation classification</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Item tree</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="comment">Not to be used to record the 'Final classification' after completion of a case investigation.</items>
          <items id="description">Classification of the likelihood of the 'Index disease' as causal at the initiation of a case investigation.</items>
          <items id="text">Initial classification</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">A case is 'Probable' when common, relevant symptoms and/or signs are exhibited and there is an epidemiological link.</items>
          <items id="text">Probable</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="description">A case is 'Not suspected' if the clinical or laboratory findings do not meet the criteria to suspect disease.</items>
          <items id="text">Not suspected</items>
        </term_definitions>
        <term_definitions code="at0007">
          <items id="comment">This data element may be redundant if the index disease has been identified elsewhere within a template.</items>
          <items id="description">The name of the infectious disease under investigation.</items>
          <items id="text">Index disease</items>
        </term_definitions>
        <term_definitions code="at0008">
          <items id="comment">For example: lost to follow-up, child of an infected mother.</items>
          <items id="description">The broad category of the reason for the classification.</items>
          <items id="text">Reason for classification</items>
        </term_definitions>
        <term_definitions code="at0009">
          <items id="comment">For example: description of clinical findings and/or conclusive laboratory test results; or alternate diagnosis made.</items>
          <items id="description">Narrative description about the reason for the classification.</items>
          <items id="text">Reason description</items>
        </term_definitions>
        <term_definitions code="at0011">
          <items id="comment">For example: imported, import-related, endemic, vaccine-associated, congenital or unknown.</items>
          <items id="description">The category for the cause of infection.</items>
          <items id="text">Aetiology category</items>
        </term_definitions>
        <term_definitions code="at0013">
          <items id="description">@ internal @</items>
          <items id="text">Item tree</items>
        </term_definitions>
        <term_definitions code="at0014">
          <items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items>
          <items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items>
          <items id="text">Extension</items>
        </term_definitions>
        <term_definitions code="at0015">
          <items id="description">The date when this infectious disease investigation classification was last updated.</items>
          <items id="text">Last updated</items>
        </term_definitions>
        <term_definitions code="at0016">
          <items id="comment">For example: details about the clinical evidenct confirming or excluding this disease as the cause of the infection</items>
          <items id="description">Additional structured details about the classification.</items>
          <items id="text">Additional details</items>
        </term_definitions>
        <term_definitions code="at0017">
          <items id="description">Additional narrative about the classification, not captured in other fields.</items>
          <items id="text">Comment</items>
        </term_definitions>
        <term_definitions code="at0021">
          <items id="description">Country identified as the (likely or probable) source for an imported or import-related case.</items>
          <items id="text">Source country</items>
        </term_definitions>
        <term_definitions code="at0035">
          <items id="description">A case is 'Suspected' when common, relevant symptoms and/or signs are exhibited.</items>
          <items id="text">Suspected</items>
        </term_definitions>
        <term_definitions code="at0036">
          <items id="description">Narrative description about the cause of infection.</items>
          <items id="text">Aetiology description</items>
        </term_definitions>
        <term_definitions code="at0045">
          <items id="description">Exposure occurred outside of the country.</items>
          <items id="text">Imported case</items>
        </term_definitions>
        <term_definitions code="at0046">
          <items id="description">Exposure occurred locally, but is directly associated to an imported case.</items>
          <items id="text">Import-related case</items>
        </term_definitions>
        <term_definitions code="at0047">
          <items id="description">Exposure occurred locally, as part of a chain of endemic transmission.</items>
          <items id="text">Endemic case</items>
        </term_definitions>
        <term_definitions code="at0048">
          <items id="description">Exposure occurred as an adverse event following exposure to a vaccine.</items>
          <items id="text">Vaccine-associated case</items>
        </term_definitions>
        <term_definitions code="at0049">
          <items id="description">Exposure occurred during pregnancy.</items>
          <items id="text">Congenital case</items>
        </term_definitions>
        <term_definitions code="at0050">
          <items id="description">The exposure event has not been identified.</items>
          <items id="text">Unknown</items>
        </term_definitions>
        <term_definitions code="at0051">
          <items id="comment">For example: household contact, community, or unknown.</items>
          <items id="description">The category for the source of an endemic case.</items>
          <items id="text">Endemic source category</items>
        </term_definitions>
        <term_definitions code="at0052">
          <items id="comment">For example: identification of the reservoir or carrier.</items>
          <items id="description">Narrative description about the source of an endemic case.</items>
          <items id="text">Endemic source description</items>
        </term_definitions>
        <term_definitions code="at0054">
          <items id="description">Identification of the cause or source of transmission.</items>
          <items id="text">Epidemiological link</items>
        </term_definitions>
        <term_definitions code="at0055">
          <items id="description">*</items>
          <items id="text">Animal to human transmission</items>
        </term_definitions>
        <term_definitions code="at0056">
          <items id="description">*</items>
          <items id="text">Exposure to a common source</items>
        </term_definitions>
        <term_definitions code="at0057">
          <items id="description">*</items>
          <items id="text">Exposure to contaminated food/drinking water</items>
        </term_definitions>
        <term_definitions code="at0058">
          <items id="description">*</items>
          <items id="text">Environmental exposure</items>
        </term_definitions>
        <term_definitions code="at0059">
          <items id="description">*</items>
          <items id="text">Laboratory exposure</items>
        </term_definitions>
        <term_definitions code="at0060">
          <items id="comment">Not to be used to record the 'Initial classification' at the initiation of a case investigation.</items>
          <items id="description">Classification of the likelihood of the 'Index disease' as causal after completion of a case investigation.</items>
          <items id="text">Final classification</items>
        </term_definitions>
        <term_definitions code="at0061">
          <items id="description">A case is 'Pending' at the completion of an adequate investigation when it is not possible to confirm or discard due to inadequate information, and further information is anticipated. It is usually a temporary classification.</items>
          <items id="text">Pending</items>
        </term_definitions>
        <term_definitions code="at0062">
          <items id="description">A case is 'Probable' at the completion of an adequate investigation when clinical evidence criteria are met and/or an epidemiological link has been identified, with laboratory test results suggesting causality rather than being conclusive.</items>
          <items id="text">Probable</items>
        </term_definitions>
        <term_definitions code="at0063">
          <items id="description">A case is 'Laboratory confirmed' at the completion of an adequate investigation when positive laboratory test results confirm the clinical evidence and/or epidemiological link.</items>
          <items id="text">Laboratory confirmed</items>
        </term_definitions>
        <term_definitions code="at0064">
          <items id="description">A case is 'Discarded' or 'Excluded' at the completion of an adequate investigation due to negative laboratory test results that exclude causality.</items>
          <items id="text">Discarded</items>
        </term_definitions>
        <term_definitions code="at0065">
          <items id="description">A case is 'Inconclusive' at the completion of an adequate investigation when it is not possible to confirm or discard due to inadequate information, and no further information is anticipated. It is not a temporary classification.</items>
          <items id="text">Inconclusive</items>
        </term_definitions>
        <term_definitions code="at0066">
          <items id="description">A case is 'Clinically confirmed' at the completion of an adequate investigation on the basis of clinical evidence alone.</items>
          <items id="text">Clinically confirmed</items>
        </term_definitions>
        <term_definitions code="at0067">
          <items id="description">*</items>
          <items id="text">Human to human transmission</items>
        </term_definitions>
        <term_definitions code="at0068">
          <items id="description">Assessment of the relationship between the index disease and the death of the individual.</items>
          <items id="text">Contribution to death</items>
        </term_definitions>
        <term_definitions code="at0072">
          <items id="description">It has been confirmed that the index disease is related to the death of the infected individual.</items>
          <items id="text">Confirmed</items>
        </term_definitions>
        <term_definitions code="at0073">
          <items id="description">It is probable that the index disease is related to the death of the infected individual.</items>
          <items id="text">Probable</items>
        </term_definitions>
        <term_definitions code="at0074">
          <items id="description">It is suspected that the index disease is related to the death of the infected individual.</items>
          <items id="text">Suspected</items>
        </term_definitions>
        <term_definitions code="at0075">
          <items id="description">It has been determined that the index disease is not related to the death of the infected individual.</items>
          <items id="text">Discarded</items>
        </term_definitions>
        <term_definitions code="at0076">
          <items id="description">It is not yet known whether the index disease is related to the death of the infected individual.</items>
          <items id="text">Under investigation</items>
        </term_definitions>
        <term_definitions code="at0077">
          <items id="description">It is not possible to determine whether the index disease was related to the death of the infected individual.</items>
          <items id="text">Cannot be classified</items>
        </term_definitions>
      </children>
      <cardinality>
        <is_ordered>false</is_ordered>
        <is_unique>false</is_unique>
        <interval>
          <lower_included>true</lower_included>
          <lower_unbounded>false</lower_unbounded>
          <upper_unbounded>true</upper_unbounded>
          <lower>0</lower>
        </interval>
      </cardinality>
    </attributes>
    <archetype_id>
      <value>openEHR-EHR-SECTION.adhoc.v1</value>
    </archetype_id>
    <template_id>
      <value>Field investigator classification - JM</value>
    </template_id>
    <term_definitions code="at0000">
      <items id="description">A generic section header which should be renamed in a template to suit a specific clinical context.</items>
      <items id="text">Ad hoc heading</items>
    </term_definitions>
  </definition>
  <view/>
</template>