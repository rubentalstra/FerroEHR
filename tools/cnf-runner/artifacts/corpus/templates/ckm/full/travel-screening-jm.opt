    <term_definitions code="at0040">
      <items id="comment">This data element is intended to provide collection context for the question/answer groups when queried at a later date. It is not expected that this data element will be exposed to the individual, but only stored in data. For example: pre-admission screening, the name of the actual questionnaire or screening for potential exposures.</items>
      <items id="description">The context or reason for screening.</items>
      <items id="text">Screening purpose</items>
    </term_definitions>
    <term_definitions code="at0041">
      <items id="description">Structured details or questions about the specific travel activity.</items>
      <items id="text">Additional details</items>
    </term_definitions>
    <term_definitions code="at0043">
      <items id="description">Narrative description about the history of any travel activity relevant for the screening purpose.</items>
      <items id="text">Description</items>
    </term_definitions>
    <term_definitions code="at0044">
      <items id="description">Structured details or questions about screening for all travel activities.</items>
      <items id="text">Additional details</items>
    </term_definitions>
    <term_definitions code="at0045">
      <items id="description">Travel occurred to places or regions within the usual country of residence.</items>
      <items id="text">National travel</items>
    </term_definitions>
    <term_definitions code="at0046">
      <items id="description">Travel occurred to places or regions within countries other than the usual country of residence.</items>
      <items id="text">International travel</items>
