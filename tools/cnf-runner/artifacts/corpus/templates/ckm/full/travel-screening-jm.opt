    <term_definitions code="at0000">
      <items id="comment">The answers may be self-reported.</items>
      <items id="description">Series of questions and associated answers used to screen for movement to or from one or more geographic locations outside of the individual’s usual place of residence.</items>
      <items id="text">Travel screening questionnaire</items>
    </term_definitions>
