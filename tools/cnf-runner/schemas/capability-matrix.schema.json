{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openehr:cnf:schema:capability-matrix:0.1.0",
  "title": "CNF 2.0 capability matrix",
  "description": "The machine-readable capability→family→tier matrix — the Profiles book's capability×tier tables as data, the input the verdict machinery computes from.",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "family",
      "tier",
      "required",
      "min_cases"
    ],
    "properties": {
      "family": {
        "enum": [
          "Platform",
          "Enterprise",
          "Security"
        ]
      },
      "tier": {
        "enum": [
          "CORE",
          "STANDARD",
          "OPTIONS",
          "SEC-BASIC",
          "D",
          "M",
          "X"
        ]
      },
      "required": {
        "type": "boolean"
      },
      "realization": {
        "enum": [
          "released-wire",
          "extension"
        ]
      },
      "min_cases": {
        "type": "integer",
        "minimum": 0
      },
      "evidence_exception": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "register",
          "reason"
        ],
        "properties": {
          "register": {
            "type": "string",
            "pattern": "^AMB-[0-9]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "workload_exclusion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "register",
          "reason"
        ],
        "properties": {
          "register": {
            "type": "string",
            "pattern": "^AMB-[0-9]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "source": {
        "type": "string"
      }
    },
    "oneOf": [
      {
        "properties": {
          "family": {
            "const": "Platform"
          },
          "tier": {
            "enum": [
              "CORE",
              "STANDARD",
              "OPTIONS"
            ]
          }
        }
      },
      {
        "properties": {
          "family": {
            "const": "Security"
          },
          "tier": {
            "enum": [
              "SEC-BASIC"
            ]
          }
        }
      },
      {
        "properties": {
          "family": {
            "const": "Enterprise"
          },
          "tier": {
            "enum": [
              "D",
              "M",
              "X"
            ]
          }
        }
      }
    ]
  }
}
