# Rust
/target
# defensive: a *relative* CARGO_TARGET_DIR (e.g. an IDE env misconfig) creates
# per-crate nested target dirs — never let them pollute the tree
**/target/
**/*.rs.bk
*.pdb

# Cargo.lock IS committed: this workspace ships a server binary (not a library),
# so a pinned lockfile gives reproducible `--locked` container builds.

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store

# Claude Code local overrides
CLAUDE.local.md
.claude/settings.local.json
.claude/.session-start-head

# Coverage / bench artifacts
/coverage
lcov.info
*.profraw

# sccache
.sccache/

.claude/worktrees

# Docs website build artifacts (assembled by scripts/build-site.sh; never committed)
/_site
/website/book/book
/docs-dist
/.latest-src
_check/
