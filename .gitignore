# Rust
/target
# defensive: a *relative* CARGO_TARGET_DIR (e.g. an IDE env misconfig) creates
# per-crate nested target dirs — never let them pollute the tree
**/target/
**/*.rs.bk
*.pdb

# Cargo.lock IS committed: this workspace ships a server binary (not a library),
# so a pinned lockfile gives reproducible `--locked` container builds.

# Env / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store

# Claude Code local overrides
CLAUDE.local.md
.claude/settings.local.json
.claude/.session-start-head
.claude/.session-start-time

# Coverage / bench artifacts
/coverage
lcov.info
*.profraw

# sccache
.sccache/

.claude/worktrees

# Docs website build artifacts (assembled by scripts/build-site.sh; never committed)
/_site
/website/book/book
/docs-dist
/.latest-src
_check/

# Stray local build artifacts
*.rlib
website/book/generated/
website/book/src/comparison-assets/*
# The upstream conformance visuals are COMMITTED (README + book embeds),
# drift-guarded in the docs workflow like the ehrbase-rs set.
!website/book/src/comparison-assets/conformance-heat-grid-java.svg
!website/book/src/comparison-assets/conformance-chapter-bars-java.svg
__pycache__/
docs/conformance/*/perf-corpus-*.json
