  <ontology>
    <term_definitions language="en">
      <items code="at0000">
        <items id="text">Pregnancy care context</items>
        <items id="description">The current pregnancy care context of an individual, used to support safe and appropriate clinical decision-making.</items>
      </items>
      <items code="at0001">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0002">
        <items id="text">Care context</items>
        <items id="description">A category that identifies the level of pregnancy-related precautions applicable to an individual.</items>
        <items id="comment">The context may be assigned by a clinician or automatically updated by a clinical system when a qualifying clinical event is documented. Examples where 'Not applicable' is appropriate include premenarchal individuals, postmenopausal individuals, and those who do not have a uterus.</items>
      </items>
      <items code="at0004">
        <items id="text">Baseline precautions</items>
        <items id="description">The default state, which applies to individuals for whom pregnancy is physiologically possible but none of the other defined states apply, requiring routine pregnancy-related precautions because an unrecognised pregnancy cannot be excluded.</items>
      </items>
      <items code="at0005">
        <items id="text">Planning pregnancy</items>
        <items id="description">Applies when the individual is actively planning or preparing for pregnancy, and elevated pregnancy-related precautions are required beyond those of the 'Baseline precautions' state to support safe conception and early pregnancy.</items>
      </items>
      <items code="at0006">
        <items id="text">Pregnant</items>
        <items id="description">Applies when pregnancy has been clinically confirmed and pregnancy-specific precautions apply.</items>
      </items>
      <items code="at0007">
        <items id="text">Post-pregnant</items>
        <items id="description">Applies during the recovery period following the end of a pregnancy, regardless of gestational age or outcome, during which 'Baseline precautions' apply in addition to any specific post-pregnancy care considerations.</items>
      </items>
      <items code="at0008">
        <items id="text">Applicable from</items>
        <items id="description">The date from when the current care context applies.</items>
        <items id="comment">For example: the date of delivery when initiating a 'Post-pregnant' context; the date of a menopause diagnosis for a 'Not applicable' context; and the date of menarche when recording the 'Baseline precautions' context.</items>
      </items>
      <items code="at0009">
        <items id="text">Applicable until</items>
        <items id="description">The date until which the current care context applies.</items>
        <items id="comment">This date represents the anticipated end of the current context and does not imply that the state has been reviewed or changed. For example: 28 days after birth for a 'Post-pregnant' context.</items>
      </items>
      <items code="at0010">
        <items id="text">Review date</items>
        <items id="description">The date when the care context should be reviewed and reassessed.</items>
        <items id="comment">Review of the current 'Care context' may confirm that the current context remains applicable or result in a change to a different context. For example: a scheduled follow-up after commencing fertility treatment for a 'Planning pregnancy' context; or a postnatal review date for a 'Post-pregnant' context.</items>
      </items>
      <items code="at0012">
        <items id="text">Comment</items>
        <items id="description">Additional narrative about the pregnancy care context not captured in other fields.</items>
      </items>
      <items code="at0013">
        <items id="text">Item tree</items>
        <items id="description">@ internal @</items>
      </items>
      <items code="at0014">
        <items id="text">Extension</items>
        <items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items>
        <items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items>
      </items>
      <items code="at0015">
        <items id="text">Last updated</items>
        <items id="description">The date when this pregnancy care context was last updated.</items>
      </items>
      <items code="at0016">
        <items id="text">Not applicable</items>
        <items id="description">Applies when pregnancy is physiologically impossible and pregnancy-related precautions are not required in the individual's current circumstances.</items>
      </items>
    </term_definitions>
  </ontology>
</archetype>

