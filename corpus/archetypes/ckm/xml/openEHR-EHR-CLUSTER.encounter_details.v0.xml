        <items id="comment">Coding with an external terminology is preferred, where possible. For example: diagnosis, elective surgery, or childbirth.</items>
      </items>
      <items code="at0004">
        <items id="text">Start</items>
        <items id="description">The date/date-time when the encounter started.</items>
        <items id="comment">For example: admitted to inpatient facility, transferred to different ward.</items>
      </items>
      <items code="at0005">
