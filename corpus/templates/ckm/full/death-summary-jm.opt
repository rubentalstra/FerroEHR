    </template_id>
    <term_definitions code="at0000">
      <items id="description">Summary information about the circumstances and context of the death of an individual, excluding the cause(s) of death.</items>
      <items id="text">Death summary</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="description">@ internal @</items>
      <items id="text">Item tree</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="description">@ internal @</items>
      <items id="text">Item tree</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="comment">For example: 'Disease'; 'Accident'; 'Assault'; 'Poisoning'; 'Homicide'; 'Suicide'; and 'Indeterminate'.
It is recommended that 'Manner of death' be coded with an external terminology.</items>
      <items id="description">Context or setting of the death.</items>
      <items id="text">Manner of death</items>
    </term_definitions>
    <term_definitions code="at0021">
      <items id="comment">This data element has multiple occurrences to allow more than one level of category, including subcategories about the place of death. It is recommended that 'Place category' be coded with an external terminology. For example: hospital or home; or, within the context of a hospital: 'delivery suite'; 'ward'; or 'operating theatre'.</items>
      <items id="description">The category of the place where the individual died.</items>
      <items id="text">Place category</items>
    </term_definitions>
    <term_definitions code="at0042">
      <items id="description">Additional structured details related to the death.</items>
      <items id="text">Additional details</items>
    </term_definitions>
    <term_definitions code="at0044">
      <items id="description">Number of completed weeks of gestation of the foetus at the time of foetal death.</items>
      <items id="text">Gestation at death</items>
    </term_definitions>
    <term_definitions code="at0054">
      <items id="comment">If the age is ≤28 days, the death may be categorised as a neonatal death.</items>
      <items id="description">The age of the individual at the time of death.</items>
      <items id="text">Age at death</items>
    </term_definitions>
    <term_definitions code="at0092">
      <items id="comment">Partial dates and an absence of time of death are allowed, if necessary. For example: based on findings pertaining to examination of the body and the pathologist's reconstruction of time of death based on post-mortem changes, temperature, etc. May also be known as DOD (date of death). If more than one 'Date of death alternatives' have been proposed, this data element could be renamed in a template as the 'Confirmed/Agreed date of death'.</items>
      <items id="description">The known, or assumed, date and time of death.</items>
      <items id="text">Date/time of death</items>
    </term_definitions>
    <term_definitions code="at0093">
      <items id="description">Narrative description about the context or setting of the death.</items>
      <items id="text">Manner description</items>
    </term_definitions>
    <term_definitions code="at0100">
      <items id="comment">For example: details about a facility or institution; or a landmark or a road intersection.</items>
      <items id="description">Structured detail about the place where the individual died.</items>
      <items id="text">Structured place of death</items>
    </term_definitions>
    <term_definitions code="at0101">
      <items id="description">The date when the death summary was last updated.</items>
      <items id="text">Last updated</items>
    </term_definitions>
    <term_definitions code="at0102">
      <items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items>
      <items id="description">Additional information required to extend the model with local content or to align with other reference models/formalisms.</items>
      <items id="text">Extension</items>
    </term_definitions>
    <term_definitions code="at0103">
      <items id="comment">For example: capturing information about one or more sources for this information, including their contribution. This may be useful if there is potentially conflicting sources of information and to enable consideration of their credibility/reliability.</items>
      <items id="description">Narrative description about source(s) of information.</items>
      <items id="text">Information source(s)</items>
    </term_definitions>
    <term_definitions code="at0104">
      <items id="comment">For example: In situations where there is no authoritative single source of death, there may be potentially conflicting dates &amp; times of death from different sources.</items>
      <items id="description">Additional details about possible alternative dates of death.</items>
      <items id="text">Date of death alternatives</items>
    </term_definitions>
    <term_definitions code="at0105">
      <items id="comment">For example: Recording the degree of certainty for place of death.</items>
      <items id="description">Additional narrative about the death, not captured in other fields.</items>
      <items id="text">Comment</items>
    </term_definitions>
    <term_definitions code="at0106">
      <items id="comment">While the post partum period is usually regarded as 42 days, the late post natal period used in reporting lasts until 1 year after birth.</items>
      <items id="description">The number of days after birth to the death of a mother.</items>
      <items id="text">Days post partum</items>
    </term_definitions>
    <term_definitions code="at0109">
      <items id="comment">For example: 'City Hospital'; 'Mother's house'; or 'Mt Vesuvius crater'; or 'Corner of Smith &amp; Brown Streets'. This data element has multiple occurrences to allow more than one level of detail about the place of death, such as recording both 'City Hospital' and 'Ward 6 North'.</items>
      <items id="description">The simple name, address or landmark of the place where the individual died.</items>
      <items id="text">Place of death</items>
    </term_definitions>
    <term_definitions code="at0110">
      <items id="description">Timing of a woman's death categorised as a phase of the active pregnancy.</items>
      <items id="text">Pregnancy context</items>
    </term_definitions>
    <term_definitions code="at0112">
      <items id="description">The woman died while pregnant and before labour commenced.</items>
      <items id="text">Antenatal</items>
    </term_definitions>
    <term_definitions code="at0113">
      <items id="description">The woman died during labour or delivery.</items>
      <items id="text">During labour/delivery</items>
    </term_definitions>
    <term_definitions code="at0114">
      <items id="description">The woman died ≤42 days after delivery.</items>
      <items id="text">Postnatal</items>
    </term_definitions>
    <term_definitions code="at0115">
      <items id="description">The woman died >42 days and ≤1 year after delivery.</items>
      <items id="text">Late postnatal</items>
    </term_definitions>
    <term_definitions code="at0116">
      <items id="description">Timing of a stillborn foetus' death categorised as a phase of pregnancy.</items>
      <items id="text">Stillbirth context</items>
    </term_definitions>
    <term_definitions code="at0117">
      <items id="description">The foetus died before labour commenced.</items>
      <items id="text">Antenatal</items>
    </term_definitions>
    <term_definitions code="at0118">
      <items id="description">The foetus died during labour or delivery.</items>
      <items id="text">During labour/delivery</items>
    </term_definitions>
    <term_definitions code="at0119">
      <items id="comment">Use this data element to record additional details if an external cause or poisoning has been recorded using the 'Manner of death'.
For example: 'Residential institution'; ' At home'; 'Street and highway'; 'Farm' and 'Sports and athletics area'.</items>
      <items id="description">The category of the place where the injury contributing to death occurred.</items>
      <items id="text">Place of injury</items>
    </term_definitions>
    <term_definitions code="at0120">
      <items id="comment">Use this data element to record additional details if an external cause or poisoning has been recorded using the 'Manner of death'.</items>
      <items id="description">The known, or assumed, date and time of injury.</items>
      <items id="text">Date of injury</items>
    </term_definitions>
    <term_definitions code="at0121">
      <items id="comment">Use this data element to record additional details if an external cause or poisoning has been recorded using the 'Manner of death'.
For example: 'Driving a car'; 'Skiing' and 'Showering'.</items>
      <items id="description">Type of activity at the time of injury.</items>
      <items id="text">Activity at the time of injury</items>
    </term_definitions>
  </definition>
  <view/>
</template>