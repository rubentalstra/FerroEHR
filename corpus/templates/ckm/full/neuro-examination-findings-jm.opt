                    <term_definitions code="at0000">
                      <items id="description">The observed response of applying a vibratory stimulus to an identified bony protuberance.</items>
                      <items id="text">Vibration finding</items>
                    </term_definitions>
                    <term_definitions code="at0001">
                      <items id="description">Identification of the bony prominence or body site being tested.</items>
                      <items id="text">Body site</items>
                    </term_definitions>
                    <term_definitions code="at0002">
                      <items id="comment">For example: 128 Hz tuning fork.</items>
                      <items id="description">Description of the stimulus used.</items>
                      <items id="text">Stimulus</items>
                    </term_definitions>
                    <term_definitions code="at0003">
                      <items id="description">The elicited response to the stimulus.</items>
                      <items id="text">Response</items>
                    </term_definitions>
                    <term_definitions code="at0004">
                      <items id="description">Vibration is not noted. May be recorded as '0' or '-'.</items>
                      <items id="text">Absent</items>
                    </term_definitions>
                    <term_definitions code="at0005">
                      <items id="description">Vibration is noted as present and less than baseline. May be recorded as '+' or '1+'.</items>
                      <items id="text">Decreased</items>
                    </term_definitions>
                    <term_definitions code="at0006">
                      <items id="description">Vibration is noted as present and consistent with baseline. May be recorded as '++' or '2+'.</items>
                      <items id="text">Normal</items>
                    </term_definitions>
                    <term_definitions code="at0008">
                      <items id="description">Vibration is noted.</items>
                      <items id="text">Present</items>
                    </term_definitions>
                    <term_definitions code="at0009">
                      <items id="description">Vibration is not noted.</items>
                      <items id="text">Absent</items>
                    </term_definitions>
                    <term_definitions code="at0010">
                      <items id="description">Additional narrative about the vibration finding, not captured in other fields.</items>
                      <items id="text">Comment</items>
                    </term_definitions>
