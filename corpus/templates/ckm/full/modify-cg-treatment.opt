                        <term_definitions code="at0000">
                          <items id="description">Specific details concerning ophthalmic therapies involving the use of laser.</items>
                          <items id="text">Ophthalmic laser procedure details</items>
                        </term_definitions>
                        <term_definitions code="at0001">
                          <items id="description">Eyes in which the laser-based treatment is applied.</items>
                          <items id="text">Laterality</items>
                        </term_definitions>
                        <term_definitions code="at0002">
                          <items id="description">Left eye observation.</items>
                          <items id="text">Left eye</items>
                        </term_definitions>
                        <term_definitions code="at0003">
                          <items id="description">Right eye observation.</items>
                          <items id="text">Right eye</items>
                        </term_definitions>
                        <term_definitions code="at0004">
                          <items id="description">Treatment performed on both eyes of the patient.</items>
                          <items id="text">Both eyes</items>
                        </term_definitions>
                        <term_definitions code="at0008">
                          <items id="description">Identifies the type of laser device needed to perform the treatment.</items>
                          <items id="text">Laser device</items>
                        </term_definitions>
                        <term_definitions code="at0012">
                          <items id="description">Details of the laser procedure.</items>
                          <items id="text">Laser procedure</items>
                        </term_definitions>
                        <term_definitions code="at0013">
                          <items id="description">Method chosen for the laser treatment.</items>
                          <items id="text">Laser technique</items>
                        </term_definitions>
                        <term_definitions code="at0014">
                          <items id="description">How laser burns are distributed along eye surface.</items>
                          <items id="text">Laser type</items>
                        </term_definitions>
                        <term_definitions code="at0016">
                          <items id="description">Focal laser.</items>
                          <items id="text">Focal laser</items>
                        </term_definitions>
                        <term_definitions code="at0017">
                          <items id="description">Grid photocoagulation.</items>
                          <items id="text">Grid photocoagulation</items>
                        </term_definitions>
                        <term_definitions code="at0018">
                          <items id="description">Panretinal laser photocoagulation focused on a specific sector of posterior pole.</items>
                          <items id="text">Sector PRP</items>
                        </term_definitions>
                        <term_definitions code="at0019">
                          <items id="description">Photocoagulation delimits a ring around a specific eye structure.</items>
                          <items id="text">Circle of laser</items>
                        </term_definitions>
                        <term_definitions code="at0020">
                          <items id="description">Laser demarcation.</items>
                          <items id="text">Laser demarcation</items>
                        </term_definitions>
                        <term_definitions code="at0021">
                          <items id="description">Panretinal laser photocoagulation.</items>
                          <items id="text">PRP</items>
                        </term_definitions>
                        <term_definitions code="at0022">
                          <items id="description">Focal macular laser therapy.</items>
                          <items id="text">Focal macular</items>
                        </term_definitions>
                        <term_definitions code="at0023">
                          <items id="description">Grid macular laser therapy.</items>
                          <items id="text">Grid macular</items>
                        </term_definitions>
                        <term_definitions code="at0024">
                          <items id="description">Another type of laser therapy.</items>
                          <items id="text">Other</items>
                        </term_definitions>
