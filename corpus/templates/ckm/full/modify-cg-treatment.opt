            <archetype_id>
              <value>openEHR-EHR-INSTRUCTION.medication_order.v0</value>
            </archetype_id>
            <term_definitions code="at0000">
              <items id="description">Instructions for use of a medication, vaccine or other therapeutic item.</items>
              <items id="text">Medication order</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">Order.</items>
              <items id="text">Order</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="description">@ internal @</items>
              <items id="text">Tree</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="description">Unique identifier for the medication order.</items>
              <items id="text">Order identifier</items>
            </term_definitions>
            <term_definitions code="at0005">
              <items id="description">The amount and units of the medication, vaccine or other therapeutic good to be used or administered at one time.</items>
              <items id="text">Dose amount description</items>
            </term_definitions>
            <term_definitions code="at0008">
              <items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items>
              <items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items>
              <items id="text">Extension</items>
            </term_definitions>
            <term_definitions code="at0009">
              <items id="comment">Including the amount, when to take it and additional instructions for use. Where the medication dose directions are fully carried by the structured, computable dose directions, this element should carry the narrative equivalent, generally auto-generated. If it is not possible to represent the intended dosage directions fully in computable form, partial representation is not recommended, and the directions should be only recorded in narrative form using this data element.</items>
              <items id="description">Complete narrative description about how the medication is to be used.</items>
              <items id="text">Dose directions description</items>
            </term_definitions>
            <term_definitions code="at0011">
              <items id="comment">For example: 'Start if symptoms recur'.</items>
              <items id="description">A condition which, when met, requires the commencement of administration or use.</items>
              <items id="text">Order start criterion</items>
            </term_definitions>
            <term_definitions code="at0012">
              <items id="description">The date and optional time to commence use of the medication, vaccine or other therapeutic good.</items>
              <items id="text">Order start date/time</items>
            </term_definitions>
            <term_definitions code="at0013">
              <items id="description">The date and optional time to cease use of the medication, vaccine or other therapeutic good.</items>
              <items id="text">Order stop date/time</items>
            </term_definitions>
            <term_definitions code="at0016">
              <items id="comment">For example: 'Stop after symptoms disappear''.</items>
              <items id="description">A condition which, when met, requires the cessation of administration or use.</items>
              <items id="text">Order stop criterion</items>
            </term_definitions>
            <term_definitions code="at0018">
              <items id="comment">For example: 'Angina'. Coding of the clinical indication with a terminology is preferred, where possible. This data element allows multiple occurrences.</items>
              <items id="description">The clinical reason for ordering the medication, vaccine or other therapeutic good.</items>
              <items id="text">Clinical indication</items>
            </term_definitions>
            <term_definitions code="at0037">
              <items id="comment">For example: 'in the morning', 'at 0600, 1400, 2100'.</items>
              <items id="description">Structured details about the timing of a single use or administration.</items>
              <items id="text">Dose timing</items>
            </term_definitions>
            <term_definitions code="at0044">
              <items id="comment">For example: precautions as 'take with food', 'Avoid grapefruit', 'Dissolve in water'. This data element allows multiple occurrences and should be coded with a reference terminology, where possible.</items>
              <items id="description">An additional instruction on how to use the medication, vaccine or other therapeutic good.</items>
              <items id="text">Additional instruction</items>
            </term_definitions>
            <term_definitions code="at0047">
              <items id="comment">Generally this is only used when passing information between legacy systems. For example: '10mg bd; 20mg n' as used by the NHS Dose syntax (in development).</items>
              <items id="description">The structured, parsable and computable representation of the dose directions.</items>
              <items id="text">Parsable dose directions</items>
            </term_definitions>
            <term_definitions code="at0050">
              <items id="comment">For example: To record that the patient had been taking antibiotics 3 days prior to hospital admission, in the context of a 7 day course.</items>
              <items id="description">The time period during which the patient has already been using the medication, vaccine or other therapeutic good, as a part of the proposed overall course but prior to the issue of this order.</items>
              <items id="text">Duration of course already complete</items>
            </term_definitions>
            <term_definitions code="at0051">
              <items id="comment">For example: 'up to 1gram per day'. This cluster allows multiple occurrences to enable representation of multiple maximum doses that apply to different time periods.</items>
              <items id="description">Details about the maximum dose allowed over a defined period.</items>
              <items id="text">Maximum dose</items>
            </term_definitions>
            <term_definitions code="at0053">
              <items id="description">The period of time during which the maximum dose is calculated.</items>
              <items id="text">Allowed period</items>
            </term_definitions>
            <term_definitions code="at0055">
              <items id="comment">Will generally only be used for legacy formats where dose directions are simply split between textual representations of dose and amount.</items>
              <items id="description">The narrative description of the dose frequency and other timing of the medication, vaccine or other therapeutic item.</items>
              <items id="text">Dose timing description</items>
            </term_definitions>
            <term_definitions code="at0056">
              <items id="comment">For example: '1 tab in the morning, 1 tab at night, for 3 weeks, on Mondays, Wednesdays and Fridays'. This cluster allows multiple occurrences to enable representation of a complete set of dose directions for a single medication order.</items>
              <items id="description">Details about a dose direction for the medication order.</items>
              <items id="text">Dose direction</items>
            </term_definitions>
            <term_definitions code="at0057">
              <items id="comment">For example: ''1' '2', '3'.
Where multiple dose directions are expressed, the 'Direction sequence' makes the order in which they should be executed explicit. For example: (1) 1 tab daily for 3 days, (2) 1 tab twice daily for 4 days, (3) 1 tablet for 7 days.</items>
              <items id="description">The intended sequence of this dose direction within the overall sequence of dose directions.</items>
              <items id="text">Direction sequence</items>
            </term_definitions>
            <term_definitions code="at0058">
              <items id="comment">For example: '2 tablets at 6pm' or '20mg three times per day'. Please note: this cluster allows multiple occurrences to enable representation of a complete set of dose patterns for a single dose direction.</items>
              <items id="description">The combination of a medication amount associated with a single medication timing.</items>
              <items id="text">Dose pattern</items>
            </term_definitions>
            <term_definitions code="at0060">
              <items id="comment">For example: To record that the patient had been taking antibiotics three days prior to hospital admission, in the context of a 7-day course.</items>
              <items id="description">The number of administrations of the medication, vaccine or other therapeutic good that have been completed, as part of the proposed overall course but prior to the issue of this order.</items>
              <items id="text">Administrations already complete</items>
            </term_definitions>
            <term_definitions code="at0062">
              <items id="description">Details about medication safety for the medication, vaccine or other therapeutic item.</items>
              <items id="text">Medication safety</items>
            </term_definitions>
            <term_definitions code="at0064">
              <items id="description">Confirmation by the prescriber that the normal dose has been overridden due to exceptional circumstances?</items>
              <items id="text">Exceptional dose override?</items>
            </term_definitions>
            <term_definitions code="at0065">
              <items id="comment">This SLOT allows for local variation in the different jurisdictions regarding medication dispensing amount to be managed.</items>
              <items id="description">Details about the amount of the medication, vaccine or other therapeutic good to be dispensed.</items>
              <items id="text">Dispense amount</items>
            </term_definitions>
            <term_definitions code="at0066">
              <items id="comment">For example: 'for 7 days','Indefinite'.</items>
              <items id="description">The duration of this dose direction.</items>
              <items id="text">Direction duration</items>
            </term_definitions>
            <term_definitions code="at0067">
              <items id="description">The direction should be continued indefinitely.</items>
              <items id="text">Indefinite</items>
            </term_definitions>
            <term_definitions code="at0068">
              <items id="description">The direction should be continued indefinitely and discontinuation is not recommended.</items>
              <items id="text">Indefinite - Do not discontinue</items>
            </term_definitions>
            <term_definitions code="at0069">
              <items id="comment">For example: details of repeat supply. This SLOT allows for local variation in the different jurisdictions regarding medication authorisation and re-authorisation to be managed.</items>
              <items id="description">Details of authorisation of the medication, vaccine or other therapeutic good.</items>
              <items id="text">Authorisation directions</items>
            </term_definitions>
            <term_definitions code="at0070">
              <items id="comment">It is strongly recommended that the 'Medication item' be coded with a terminology capable of triggering decision support, where possible. The extent of coding may vary from the simple name of the medication item through to structured details about the actual medication pack to be used. Free text entry should only be used if there is no appropriate terminology available.</items>
              <items id="description">Identification of the medication, vaccine or other therapeutic item being ordered.</items>
              <items id="text">Medication item</items>
            </term_definitions>
            <term_definitions code="at0090">
              <items id="comment">For example: 'every 3 days', 'on Thursdays and Sundays', '3 days after onset of menstruation'.</items>
              <items id="description">Structured details about pattern of repetition for each set of daily dose directions.</items>
              <items id="text">Direction repetition</items>
            </term_definitions>
            <term_definitions code="at0091">
              <items id="comment">For example: 'oral', 'intravenous', or 'topical'. 
Coding of the route with a terminology is preferred, where possible. Multiple potential routes may be specified.</items>
              <items id="description">The route of administration.</items>
              <items id="text">Route</items>
            </term_definitions>
            <term_definitions code="at0092">
              <items id="comment">For example: 'left upper arm', 'intravenous catheter right hand'.
Coding of the body site with a terminology is preferred, where possible.</items>
              <items id="description">Identification of the site of administration of the medication, vaccine or therapeutic good.</items>
              <items id="text">Body site</items>
            </term_definitions>
            <term_definitions code="at0093">
              <items id="description">Structured description of the site of administration  of the medication, vaccine or therapeutic good.</items>
              <items id="text">Structured body site</items>
            </term_definitions>
            <term_definitions code="at0094">
              <items id="comment">For example: 'via nebuliser'.</items>
              <items id="description">The method by which the medication is to be delivered.</items>
              <items id="text">Delivery method</items>
            </term_definitions>
            <term_definitions code="at0095">
              <items id="description">Details of the medical device used to assist delivery of the medication.</items>
              <items id="text">Delivery device details</items>
            </term_definitions>
            <term_definitions code="at0102">
              <items id="comment">For example: 'Administer over 10 minutes'.</items>
              <items id="description">The period of time over which a single dose of the medication or vaccine should be administered.</items>
              <items id="text">Dose administration duration</items>
            </term_definitions>
            <term_definitions code="at0105">
              <items id="comment">For example: 'To reduce your blood pressure', 'To thin your blood'. This data element allows multiple occurrences and should be coded with a reference terminology, where possible. If required it is possible to use a LINK attribute to associate this element with, for example, the 'original diagnosis' in a separate Problem list composition but the indication should be explicitly recorded here, as the link target may change over time.</items>
              <items id="description">An additional instruction directed primarily at the patient or carers.</items>
              <items id="text">Patient guidance</items>
            </term_definitions>
            <term_definitions code="at0106">
              <items id="description">An additional instruction directed primarily at the person dispensing the medication, vaccine or therapeutic good.</items>
              <items id="text">Dispense instruction</items>
            </term_definitions>
            <term_definitions code="at0107">
              <items id="comment">For example: 'Please check renal function in 2 weeks'. This data element allows multiple occurrences.</items>
              <items id="description">An additional instruction which gives advice on appropriate monitoring of the medication.</items>
              <items id="text">Monitoring instruction</items>
            </term_definitions>
            <term_definitions code="at0108">
              <items id="comment">For example: 'Give slowly', 'Avoid right arm - risk of lymphoedema'.
This data element allows multiple occurrences.</items>
              <items id="description">An additional instruction directed primarily at the person administering the medication, vaccine or therapeutic good.</items>
              <items id="text">Administration instruction</items>
            </term_definitions>
            <term_definitions code="at0109">
              <items id="comment">Will generally only be used for legacy formats where dose directions are simply split between textual representations of dose and amount.</items>
              <items id="description">The narrative description of the dose amount of the medication, vaccine or other therapeutic item.</items>
              <items id="text">Dose amount description</items>
            </term_definitions>
            <term_definitions code="at0112">
              <items id="comment">Course summary may be required when transmitting medication information between systems. For example: as part of a referral, emergency patient summary or discharge communication.</items>
              <items id="description">Summary information about the medication, such as current status or key dates, generally used in non-prescription contexts.</items>
              <items id="text">Course summary</items>
            </term_definitions>
            <term_definitions code="at0113">
              <items id="description">Details about the intended course of the medication.</items>
              <items id="text">Order details</items>
            </term_definitions>
            <term_definitions code="at0129">
              <items id="description">Directions about the dispensing of the medication, vaccine or other therapeutic good.</items>
              <items id="text">Dispense directions</items>
            </term_definitions>
            <term_definitions code="at0130">
              <items id="comment">For example: 1, 1.5, 0.125.</items>
              <items id="description">The maximum amount of medication allowed in the allowed period.</items>
              <items id="text">Maximum amount</items>
            </term_definitions>
            <term_definitions code="at0132">
              <items id="comment">In many jurisdictions, substitution of a prescribed medication, vaccine or other therapeutic good as a generic form or with a different brand name, which has been determined as bioequivalent, is allowed at the point of dispense or supply. In other cases subsitution is assumed and the clinician has to explicitly request non-substitution.</items>
              <items id="description">Permission for substitution with a bioequivalent medication.</items>
              <items id="text">Substitution direction</items>
            </term_definitions>
            <term_definitions code="at0133">
              <items id="description">Details about the administration of the medication, vaccine or other therapeutic good.</items>
              <items id="text">Administration directions</items>
            </term_definitions>
            <term_definitions code="at0134">
              <items id="comment">For example: 1 drop per minute. Use the text data type to record non- or semi-quantifiable instructions.</items>
              <items id="description">The rate at which the medication infusion is to be administered.</items>
              <items id="text">Infusion administration rate</items>
            </term_definitions>
            <term_definitions code="at0135">
              <items id="description">The formula used to calculate the Dose amount or administration rate where this is dependent on some other factor such as patient weight. For example: 10mg/kg/day.</items>
              <items id="text">Dosage formula</items>
            </term_definitions>
            <term_definitions code="at0136">
              <items id="description">The purpose of the infusion.</items>
              <items id="text">Infusion purpose</items>
            </term_definitions>
            <term_definitions code="at0137">
              <items id="description">The infusion provides baseline hydration.</items>
              <items id="text">Baseline electrolyte infusion</items>
            </term_definitions>
            <term_definitions code="at0138">
              <items id="description">The infusion carries an active pharmaceutical ingredient.</items>
              <items id="text">Active medication infusion</items>
            </term_definitions>
            <term_definitions code="at0139">
              <items id="description">An indicator of the urgency with which the medication should be dispensed.</items>
              <items id="text">Priority</items>
            </term_definitions>
            <term_definitions code="at0143">
              <items id="comment">For example: the form, strength, any diluents or mixture of ingredients.</items>
              <items id="description">Structured details about the strength and form of the overall preparation.</items>
              <items id="text">Preparation details</items>
            </term_definitions>
            <term_definitions code="at0144">
              <items id="comment">For example: 1, 1.5, 0.125 or 1-2, 12.5-20.5</items>
              <items id="description">The value of the amount of medication as a real number.</items>
              <items id="text">Dose amount</items>
            </term_definitions>
            <term_definitions code="at0145">
              <items id="comment">For example: 'tablet','mg'. Coding of the dose unit with a terminology is preferred, where possible.</items>
              <items id="description">The dose unit of the amount of medication.</items>
              <items id="text">Dose unit</items>
            </term_definitions>
            <term_definitions code="at0146">
              <items id="comment">For example: 'tablet','mg'. Coding of the dose unit with a terminology is preferred, where possible.</items>
              <items id="description">The dose unit for the maximum amount allowed.</items>
              <items id="text">Maximum amount dose unit</items>
            </term_definitions>
            <term_definitions code="at0148">
              <items id="comment">For example: 'palliative care', 'low-dose propylaxis'.</items>
              <items id="description">The overall therapeutic intent of the medication.</items>
              <items id="text">Therapeutic intent</items>
            </term_definitions>
            <term_definitions code="at0150">
              <items id="comment">The dose goal will record the expected effective dose, and thus support titration of an initial low dose towards the effective dose over a period of time.</items>
              <items id="description">Details about the proposed total daily amount of medication.</items>
              <items id="text">Dose goal</items>
            </term_definitions>
            <term_definitions code="at0151">
              <items id="description">The amount of medication which is intended to be taken each day if the medication is administered as intended.</items>
              <items id="text">Total daily dose amount</items>
            </term_definitions>
            <term_definitions code="at0152">
              <items id="comment">The dose units are normally scientific units such as mg, ml rather than 'tablets'.</items>
              <items id="description">The dose unit associated with the total daily dose amount.</items>
              <items id="text">Total daily dose unit</items>
            </term_definitions>
            <term_definitions code="at0154">
              <items id="description">The reason why a medication should not be substituted at dispense.</items>
              <items id="text">Non-substitution reason</items>
            </term_definitions>
            <term_definitions code="at0155">
              <items id="comment">May be used to control the time of dispensing of medications with potential for abuse. For example: benzodiazepines or analgesics.</items>
              <items id="description">The date after which the medication is permitted to be dispensed for the first time.</items>
              <items id="text">Start date</items>
            </term_definitions>
            <term_definitions code="at0156">
              <items id="description">Details of dose amount / administration rate dependent on specific conditions.</items>
              <items id="text">Conditional administration</items>
            </term_definitions>
            <term_definitions code="at0161">
              <items id="description">The date after which the prescription is no longer valid to be dispensed.</items>
              <items id="text">Expiry date</items>
            </term_definitions>
            <term_definitions code="at0162">
              <items id="comment">For example: 'Not responsive at maximum recommended dose. Critical situation.'</items>
              <items id="description">The reason for a maximum dose override.</items>
              <items id="text">Override reason</items>
            </term_definitions>
            <term_definitions code="at0163">
              <items id="description">The infusion provides parenteral nutrition.</items>
              <items id="text">Nutritional infusion</items>
            </term_definitions>
            <term_definitions code="at0164">
              <items id="description">The intended sequence of this dose pattern within the overall sequence of dose directions.</items>
              <items id="text">Pattern sequence</items>
            </term_definitions>
            <term_definitions code="at0165">
              <items id="comment">The description could be used to identify a name, phrase or paragraph about the goal.</items>
              <items id="description">Description of the goal.</items>
              <items id="text">Goal</items>
            </term_definitions>
            <term_definitions code="at0166">
              <items id="description">Additional structured details about the medication order not captured in other fields.</items>
              <items id="text">Additional details</items>
            </term_definitions>
            <term_definitions code="at0167">
              <items id="description">Additional narrative about the medication order not captured in other fields.</items>
              <items id="text">Comment</items>
            </term_definitions>
            <term_definitions code="at0168">
              <items id="description">Substitution of the Medication with a bioequivalent medication is allowed.</items>
              <items id="text">Permitted</items>
            </term_definitions>
            <term_definitions code="at0169">
              <items id="description">Substitution of the Medication with a bioequivalent medication is not allowed.</items>
              <items id="text">Not permitted</items>
            </term_definitions>
            <term_definitions code="at0170">
              <items id="comment">This SLOT allows for local variation in the different jurisdictions regarding medication dispensing.</items>
              <items id="description">Further details related to dispense directions.</items>
              <items id="text">Dispense details</items>
            </term_definitions>
