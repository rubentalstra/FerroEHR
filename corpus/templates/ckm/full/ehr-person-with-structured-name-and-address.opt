    <term_definitions code="at0000">
      <items id="description">An identified human being.</items>
      <items id="text">Person</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="comment">The content of this data element may be derived from a concatenation of one or more components from CLUSTER.structured.address. For example: 'John Markham', 'Professor Sir John Markham', 'John Markham Jnr MP' or 'Neighbour in the house with the red door'.</items>
      <items id="description">The unstructured name or label for the person.</items>
      <items id="text">Name</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="description">Additional structured details about the name of a person that can be concatenated to form the 'Name line' entry.</items>
      <items id="text">Structured name</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="description">Identifier associated with the person.</items>
      <items id="text">Identifier</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="comment">For example: Witness; member of a care team; relative; contact person; neighbour or guardian.</items>
      <items id="description">The relationship or role of the person to the individual or subject of care.</items>
      <items id="text">Role</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="description">Details about an address for the person.</items>
      <items id="text">Address</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="description">Details about a specific type of electronic communication for the person.</items>
      <items id="text">Electronic communication</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="comment">The range of electronic communication mediums includes, but is not limited to use of : telephone, cellular phone, email, pager, fax, conferencing tool or social media.</items>
      <items id="description">The type or medium for electronic communication.</items>
      <items id="text">Type</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="description">*</items>
      <items id="text">Mobile (cellular) telephone</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="description">*</items>
      <items id="text">Telephone (excluding mobile telephone)</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="description">*</items>
      <items id="text">Email</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="description">*</items>
      <items id="text">Pager</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="description">The purpose or use for the identified type of electronic communication.</items>
      <items id="text">Purpose</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="description">*</items>
      <items id="text">Business use</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="description">*</items>
      <items id="text">Personal use</items>
    </term_definitions>
    <term_definitions code="at0015">
      <items id="description">*</items>
      <items id="text">Both business and personal use</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="comment">For example: area code + landline phone/pager number; country code + mobile phone number; email address; or skype contact name.</items>
      <items id="description">The unique combination of alphanumeric characters, meaningful for the identified type or medium of electronic communication.</items>
      <items id="text">Value</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="description">Additional details about the person.</items>
      <items id="text">Additional details</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="description">Additional narrative about the electronic communication not captured in other fields.</items>
      <items id="text">Comment</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="description">Additional narrative about the person not captured in other fields.</items>
      <items id="text">Comment</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="comment">For example: identifying the legal firm that holds the Advance care plan, where the lawyer works; or the school where a teacher works.</items>
      <items id="description">Details about the organisational context for this person.</items>
      <items id="text">Organisation</items>
    </term_definitions>
  </definition>
  <view>
    <constraints path="[openEHR-EHR-CLUSTER.person.v0]/items[openEHR-EHR-CLUSTER.address.v0]/items[openEHR-EHR-CLUSTER.structured_address.v0]">
      <items id="pass_through">
        <value>true</value>
      </items>
    </constraints>
  </view>
</template>