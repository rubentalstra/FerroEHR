        <term_definitions code="at0000">
          <items id="description">Details about the discrete components of a person's name, for use within a health record.</items>
          <items id="text">Structured name</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="comment">Coding with an external terminology is preferred, where possible. For example: 'Doctor'; 'Ms'; 'Mx'; or 'Professor Dr'.</items>
          <items id="description">An honorific form of address placed before all other name components.</items>
          <items id="text">Title</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="comment">Also known as a specific type of 'Given name'.</items>
          <items id="description">The person's identifying first name(s) within the family group or by which they are uniquely socially identified.</items>
          <items id="text">First name</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="comment">Also known as a specific type of 'Given name'.</items>
          <items id="description">The person's identifying middle name(s) within the family group or by which they are uniquely socially identified.</items>
          <items id="text">Middle name</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="comment">Also known as a specific type of 'Given name'.</items>
          <items id="description">The person's identifying pet name or nickname(s) within the family group or by which they are uniquely socially identified.</items>
          <items id="text">Nickname</items>
        </term_definitions>
        <term_definitions code="at0005">
          <items id="comment">Also known as 'Family name' or 'Surname'.</items>
          <items id="description">The part of a name a person usually has in common with some other members of their family, as distinguished from their own given names.</items>
          <items id="text">Last name</items>
        </term_definitions>
        <term_definitions code="at0006">
          <items id="comment">Coding with an external terminology is preferred, where possible. For example: 'Junior (Jr)'; 'Senior (Sr)'; 'Second (II)'.</items>
          <items id="description">An additional term placed after all other name components, usually to differentiate the individual from a family member with identical name components.</items>
          <items id="text">Suffix</items>
        </term_definitions>
