                        <archetype_id>
                          <value>openEHR-EHR-CLUSTER.device_details.v1</value>
                        </archetype_id>
                        <term_definitions code="at0000">
                          <items id="description">Specific details that relate to asset management for any medical device that is designed for more than a single use.</items>
                          <items id="text">Medical device details</items>
                        </term_definitions>
                        <term_definitions code="at0001">
                          <items id="comment">May be a text string or an IEEE EUI-64 identifier.</items>
                          <items id="description">Organisation identifier for device.</items>
                          <items id="text">Organisation identifier</items>
                        </term_definitions>
                        <term_definitions code="at0002">
                          <items id="comment">May be a simple string or contain simple markup e.g. for Continua PHMR reports:
"Pulse Master 2000||584216|69854|2.1|1.1|1.0|"
repesenting Model, Unspecified, SerialNumber, PartNumber, HardwareRevision, SoftwareRevision, ProtocolRevision, and ProdSpecGMDN.</items>
                          <items id="description">HL7 CDA compatible representation of device manufacture details.</items>
                          <items id="text">Manufacturer model name</items>
                        </term_definitions>
                        <term_definitions code="at0007">
                          <items id="description">The part number of the device.</items>
                          <items id="text">Part number</items>
                        </term_definitions>
                        <term_definitions code="at0008">
                          <items id="description">The hardware revision number.</items>
                          <items id="text">Hardware revision</items>
                        </term_definitions>
                        <term_definitions code="at0010">
                          <items id="description">The protocol revision number.</items>
                          <items id="text">Protocol revision</items>
                        </term_definitions>
                        <term_definitions code="at0011">
                          <items id="description">The sampling frequency limits of the device.</items>
                          <items id="text">Sampling frequency</items>
                        </term_definitions>
                        <term_definitions code="at0012">
                          <items id="description">The range limits of the device.</items>
                          <items id="text">Range</items>
                        </term_definitions>
                        <term_definitions code="at0013">
                          <items id="description">The accuracy limits of the device.</items>
                          <items id="text">Accuracy</items>
                        </term_definitions>
                        <term_definitions code="at0014">
                          <items id="description">The resolution limits of the device.</items>
                          <items id="text">Resolution</items>
                        </term_definitions>
                        <term_definitions code="at0015">
                          <items id="description">Whether device is regulated or otherwise.</items>
                          <items id="text">Regulatory status</items>
                        </term_definitions>
                        <term_definitions code="at0016">
                          <items id="description">The date the device was last serviced.</items>
                          <items id="text">Date last serviced</items>
                        </term_definitions>
                        <term_definitions code="at0017">
                          <items id="description">Date the device was last calibrated.</items>
                          <items id="text">Date last calibrated</items>
                        </term_definitions>
                        <term_definitions code="at0018">
                          <items id="description">Details of agent who performed the servicing.</items>
                          <items id="text">Serviced by</items>
                        </term_definitions>
                        <term_definitions code="at0019">
                          <items id="description">Details about formulae or algorithms used by the device in order to generate results/output.</items>
                          <items id="text">Formulae</items>
                        </term_definitions>
                        <term_definitions code="at0020">
                          <items id="description">Data element which is calculated or derived.</items>
                          <items id="text">Formula name</items>
                        </term_definitions>
                        <term_definitions code="at0021">
                          <items id="description">Formula used to calculate or derive the Calculated field.</items>
                          <items id="text">Formula</items>
                        </term_definitions>
                        <term_definitions code="at0022">
                          <items id="description">Date the device was last cleaned or sterilized.</items>
                          <items id="text">Date last cleaned/sterilized</items>
                        </term_definitions>
                        <term_definitions code="at0023">
                          <items id="description">Organisation responsible for the medical device.</items>
                          <items id="text">Owner</items>
                        </term_definitions>
                        <term_definitions code="at0024">
                          <items id="description">Physical location where device is kept.</items>
                          <items id="text">Location</items>
                        </term_definitions>
                        <term_definitions code="at0025">
                          <items id="description">Network address to contact the device.</items>
                          <items id="text">Network address</items>
                        </term_definitions>
                        <term_definitions code="at0026">
                          <items id="description">Details for human/organisation support for the medical device.</items>
                          <items id="text">Contact</items>
                        </term_definitions>
                        <term_definitions code="at0027">
                          <items id="description">Additional information required to capture local context or to align with other reference models/formalisms.</items>
                          <items id="text">Extension</items>
                        </term_definitions>
                      </children>
