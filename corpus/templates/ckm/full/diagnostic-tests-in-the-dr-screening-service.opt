            <archetype_id>
              <value>openEHR-EHR-OBSERVATION.fundoscopic_examination.v1</value>
            </archetype_id>
            <term_definitions code="at0000">
              <items id="description">Record of clinical findings on fundoscopy of eyes</items>
              <items id="text">Fundoscopic examination of eyes</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">@ internal @</items>
              <items id="text">Event Series</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="description">*</items>
              <items id="text">Any event</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="description">@ internal @</items>
              <items id="text">Tree</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="description">Determines the eye on which the test was performed.Matches to DICOM Laterality (0020,0060) attribute.</items>
              <items id="text">Side</items>
            </term_definitions>
            <term_definitions code="at0008">
              <items id="description">Descriptive overview of examination findings</items>
              <items id="text">Clinical Description</items>
            </term_definitions>
            <term_definitions code="at0013">
              <items id="description">@ internal @</items>
              <items id="text">Tree</items>
            </term_definitions>
            <term_definitions code="at0014">
              <items id="description">True if mydriatic is used</items>
              <items id="text">Mydriatic used</items>
            </term_definitions>
            <term_definitions code="at0028">
              <items id="description">@ internal @</items>
              <items id="text">Tree</items>
            </term_definitions>
            <term_definitions code="at0029">
              <items id="description">Method chosen to perform the funduscopic examination</items>
              <items id="text">Method</items>
            </term_definitions>
            <term_definitions code="at0030">
              <items id="description">Study performed by direct ophthalmoscopy</items>
              <items id="text">Direct</items>
            </term_definitions>
            <term_definitions code="at0031">
              <items id="description">Study of eye fundus by indirect ophthalmoscopy method</items>
              <items id="text">Indirect</items>
            </term_definitions>
            <term_definitions code="at0051">
              <items id="description">Details about acquisition obtained during the examination of eye fundus</items>
              <items id="text">Acquisition details</items>
            </term_definitions>
            <term_definitions code="at0053">
              <items id="description">True if Red Reflex is present</items>
              <items id="text">Red reflex</items>
            </term_definitions>
            <term_definitions code="at0054">
              <items id="description">True if during the acquisition, pupil diameter is smaller than normal (3,3mm)</items>
              <items id="text">Small pupil</items>
            </term_definitions>
            <term_definitions code="at0055">
              <items id="description">True if cataract obstructs the visualization of eye fundus</items>
              <items id="text">Cataract artifact</items>
            </term_definitions>
            <term_definitions code="at0056">
              <items id="description">True if shadow artifact is present on the border of the image</items>
              <items id="text">Shadow artifact</items>
            </term_definitions>
            <term_definitions code="at0057">
              <items id="description">Details about image quality related to ease of visualization of structures on eye fundus</items>
              <items id="text">Visualization</items>
            </term_definitions>
            <term_definitions code="at0058">
              <items id="description">Comment, especially if not fully visualised</items>
              <items id="text">Comment</items>
            </term_definitions>
            <term_definitions code="at0059">
              <items id="description">Levels quantifying the quality of each acquisition, based in the ease to visualize the structures on the eye fundus</items>
              <items id="text">Quality</items>
            </term_definitions>
            <term_definitions code="at0060">
              <items id="description">*</items>
              <items id="text">Quality inadequate for any diagnostic purpose</items>
            </term_definitions>
            <term_definitions code="at0061">
              <items id="description">*</items>
              <items id="text">Unable to exclude all emergent findings</items>
            </term_definitions>
            <term_definitions code="at0062">
              <items id="description">*</items>
              <items id="text">Only able to exclude emergent findings</items>
            </term_definitions>
            <term_definitions code="at0063">
              <items id="description">*</items>
              <items id="text">Quality not ideal, but is possible to exclude subtle findings</items>
            </term_definitions>
            <term_definitions code="at0064">
              <items id="description">*</items>
              <items id="text">Ideal quality</items>
            </term_definitions>
            <term_definitions code="at0065">
