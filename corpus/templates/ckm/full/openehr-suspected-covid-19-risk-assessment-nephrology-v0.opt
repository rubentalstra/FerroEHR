        <term_definitions code="at0000">
          <items id="description">Un questionario individuale o autodichiarato per lo screening dei sintomi e dei segni.</items>
          <items id="text">Questionario di screening dei sintomi/segni</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">History</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">Evento predefinito, non specificato nel tempo o nell'intervallo di tempo, che può essere definito esplicitamente in un modello o in fase di esecuzione.</items>
          <items id="text">Qualsiasi evento</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="description">Nome del sintomo o del segno sottoposto a screening.</items>
          <items id="text">Nome del sintomo o del segno</items>
        </term_definitions>
        <term_definitions code="at0005">
          <items id="description">Presenza del sintomo o del segno</items>
          <items id="text">Presenza?</items>
        </term_definitions>
        <term_definitions code="at0007">
          <items id="description">@ internal @</items>
          <items id="text">Item tree</items>
        </term_definitions>
        <term_definitions code="at0021">
          <items id="comment">Ad esempio: requisiti informativi locali o metadati aggiuntivi per allinearsi agli equivalenti FHIR o CIMI.</items>
          <items id="description">Informazioni aggiuntive necessarie per raccogliere contenuti locali o per allinearsi con altri modelli/formalismi di riferimento.</items>
          <items id="text">Estensione</items>
        </term_definitions>
        <term_definitions code="at0022">
          <items id="description">Raggruppamento di elementi di dati relativi allo screening per un singolo sintomo o segno.</items>
          <items id="text">Sintomo/segno specifico</items>
        </term_definitions>
        <term_definitions code="at0023">
          <items id="description">Il sintomo o segno specifico è presente.</items>
          <items id="text">Presenza</items>
        </term_definitions>
        <term_definitions code="at0024">
          <items id="description">Il sintomo o segno specifico non è presente.</items>
          <items id="text">Assenza</items>
        </term_definitions>
        <term_definitions code="at0025">
          <items id="description">Descrizione aggiuntiva dei sintomi e dei segni, non rilevata in altri campi.</items>
          <items id="text">Commento</items>
        </term_definitions>
        <term_definitions code="at0026">
          <items id="description">Ulteriori dettagli strutturati relativi allo screening dei sintomi.</items>
          <items id="text">Dettagli aggiuntivi</items>
        </term_definitions>
        <term_definitions code="at0027">
          <items id="description">Non è possibile sapere se il sintomo o il segno è presente o assente.</items>
          <items id="text">Indeterminato</items>
        </term_definitions>
        <term_definitions code="at0028">
          <items id="description">Presenza di sintomi o segni rilevanti.</items>
          <items id="text">Presenza di sintomi o segni?</items>
        </term_definitions>
        <term_definitions code="at0029">
          <items id="comment">Sono ammesse date parziali</items>
          <items id="description">La data e l'ora in cui i sintomi o i segni sono stati notati per la prima volta.</items>
          <items id="text">Inizio di qualsiasi sintomo o segno</items>
        </term_definitions>
        <term_definitions code="at0031">
          <items id="description">Sono presenti sintomi o segni.</items>
          <items id="text">Presenza</items>
        </term_definitions>
        <term_definitions code="at0032">
          <items id="description">Non sono presenti sintomi o segni.</items>
          <items id="text">Assenza</items>
        </term_definitions>
        <term_definitions code="at0033">
          <items id="description">Non è possibile sapere se sono presenti o assenti sintomi o segni.</items>
          <items id="text">Indeterminato</items>
        </term_definitions>
        <term_definitions code="at0034">
          <items id="comment">Ad esempio: screening per una malattia infettiva, come la SARS-COV-2.</items>
          <items id="description">Motivazione dello screening complessivo.</items>
