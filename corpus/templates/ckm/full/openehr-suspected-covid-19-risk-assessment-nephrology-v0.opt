        <archetype_id>
          <value>openEHR-EHR-EVALUATION.living_arrangement.v0</value>
        </archetype_id>
        <term_definitions code="at0000">
          <items id="comment">Queste informazioni forniranno un'idea del livello di supporto, sia fisico che emotivo, a cui un individuo può avere accesso.</items>
          <items id="description">Le circostanze di un individuo che vive da solo o con altri.</items>
          <items id="text">Disposizione abitativa</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Item tree</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">@ internal @</items>
          <items id="text">Item tree</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">Descrizione narrativa della sistemazione abitativa.</items>
          <items id="text">Descrizione</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="comment">Si preferisce, ove possibile, la codifica della sistemazione abitativa con una terminologia. I set di valori per questo elemento di dati possono variare da una giurisdizione all'altra - si prevede che saranno di solito impostati all'interno di un modello specifico per il caso d'uso. Ad esempio: "vive da solo", "vive con la famiglia" o "vive con altri".</items>
          <items id="description">Singola parola o frase che descrive se un individuo risiede solitamente da solo o con altri.</items>
          <items id="text">Disposizione abitativa</items>
        </term_definitions>
        <term_definitions code="at0005">
          <items id="comment">Si preferisce, ove possibile, la codifica della composizione della famiglia con una terminologia. Ad esempio: single; genitore unico con figli di età inferiore ai 16 anni; coppia; coppia con figli di età inferiore ai 16 anni; famiglia; famiglia con altri membri non imparentati presenti; o gruppo di adulti non imparentati.</items>
          <items id="description">Singola parola o frase che descrive il rapporto tra le persone che risiedono insieme.</items>
          <items id="text">Composizione della casa</items>
        </term_definitions>
        <term_definitions code="at0006">
          <items id="description">Descrizione narrativa del rapporto tra le persone che risiedono insieme.</items>
          <items id="text">Descrizione della casa</items>
        </term_definitions>
        <term_definitions code="at0007">
          <items id="description">Il numero di individui che fanno parte della famiglia.</items>
          <items id="text">Numero di componenti della famiglia</items>
        </term_definitions>
        <term_definitions code="at0008">
          <items id="comment">Questo SLOT può essere utilizzato per annidare ulteriori archetipi che descrivono ulteriori dettagli sulla sistemazione abitativa che possono essere locali in una giurisdizione.</items>
          <items id="description">Altri dettagli sulla sistemazione abitativa.</items>
          <items id="text">Dettagli aggiuntivi</items>
        </term_definitions>
        <term_definitions code="at0009">
          <items id="description">Descrizione narrativa degli animali domestici che risiedono con un individuo.</items>
          <items id="text">Animali domestici</items>
        </term_definitions>
        <term_definitions code="at0010">
          <items id="description">Narrativa aggiuntiva sulla sistemazione abitativa non catturata in altri campi.</items>
          <items id="text">Commento</items>
        </term_definitions>
        <term_definitions code="at0011">
          <items id="comment">Per esempio: requisiti informativi locali; o metadati aggiuntivi per allinearsi a FHIR.</items>
          <items id="description">Informazioni aggiuntive necessarie per estendere il modello con contenuti locali o per allinearlo ad altri modelli/formalismi di riferimento.</items>
          <items id="text">Extension</items>
        </term_definitions>
        <term_definitions code="at0012">
          <items id="description">La data di questo riepilogo è stata aggiornata per l'ultima volta.</items>
          <items id="text">Ultimo aggiornamento</items>
        </term_definitions>
      </children>
