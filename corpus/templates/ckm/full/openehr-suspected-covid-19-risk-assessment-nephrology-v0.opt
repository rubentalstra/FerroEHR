        <term_definitions code="at0000">
          <items id="description">La storia clinica soggettiva del persona assistita come registrata direttamente dal soggetto, o riportata ad un clinico dal soggetto o da chi lo assiste.</items>
          <items id="text">Storia/Cronologia</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Serie di eventi</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">Evento predefinito, non specificato nel tempo o nell'intervallo di tempo, che può essere definito esplicitamente in un modello o in fase di esecuzione.</items>
          <items id="text">Qualsiasi evento</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="description">Descrizione narrativa della storia o dell'anamnesi clinica del soggetto da curare.</items>
          <items id="text">Storia</items>
        </term_definitions>
        <term_definitions code="at0006">
          <items id="comment">Per esempio: un sintomo specifico come la nausea o il dolore; un evento come una caduta dalla bicicletta; o un fenomeno come il desiderio di smettere di usare il tabacco.</items>
          <items id="description">Dettagli strutturati sulla storia dell'individuo o sull'anamnesi del paziente.</items>
          <items id="text">Dettaglio strutturato</items>
        </term_definitions>
        <term_definitions code="at0007">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0008">
          <items id="comment">Per esempio: Requisiti locali di informazione o metadati aggiuntivi per allinearsi con gli equivalenti FHIR o CIMI.</items>
          <items id="description">Informazioni aggiuntive necessarie per acquisire contenuti locali o per allinearsi con altri modelli/formalismi di riferimento.</items>
          <items id="text">Estensione</items>
        </term_definitions>
