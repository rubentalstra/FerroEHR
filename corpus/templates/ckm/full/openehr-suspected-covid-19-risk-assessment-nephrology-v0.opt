        <archetype_id>
          <value>openEHR-EHR-OBSERVATION.travel_event.v0</value>
        </archetype_id>
        <term_definitions code="at0000">
          <items id="description">Dettagli sul viaggio durante un intervallo di tempo.</items>
          <items id="text">Viaggio</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">History</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">Evento di intervallo predefinito, non specificato, che può essere definito esplicitamente in un modello o in fase di esecuzione.</items>
          <items id="text">Ogni evento di intervallo</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="comment">Utilizzare l'evento per impostare il relativo intervallo.</items>
          <items id="description">L'individuo ha viaggiato durante l'intervallo specificato?</items>
          <items id="text">Viaggio?</items>
        </term_definitions>
        <term_definitions code="at0005">
          <items id="description">*The individual has not travelled within the specified interval of time.(en)</items>
          <items id="text">*No(en)</items>
        </term_definitions>
        <term_definitions code="at0006">
          <items id="description">L'individuo ha viaggiato a livello nazionale entro l'intervallo di tempo specificato.</items>
          <items id="text">Sì - nazionale</items>
        </term_definitions>
        <term_definitions code="at0007">
          <items id="description">@ internal @</items>
          <items id="text">Item tree</items>
        </term_definitions>
        <term_definitions code="at0008">
          <items id="comment">Il viaggio ha una sola data di partenza e di ritorno alla loro base. Un viaggio può includere la visita di molti luoghi individuali, e questi dettagli dovrebbero essere registrati nell'Itinerario.</items>
          <items id="description">Dettaglio di un singolo viaggio lontano dalla casa base.</items>
          <items id="text">Dettaglio viaggio</items>
        </term_definitions>
        <term_definitions code="at0009">
          <items id="description">La data in cui l'individuo ha lasciato la sua casa base.</items>
          <items id="text">Data di partenza</items>
        </term_definitions>
        <term_definitions code="at0010">
          <items id="description">Dettagli su una singola località visitata durante un viaggio.</items>
          <items id="text">Destinazione al viaggio</items>
        </term_definitions>
        <term_definitions code="at0011">
          <items id="description">Il Paese visitato</items>
          <items id="text">Paese</items>
        </term_definitions>
        <term_definitions code="at0012">
          <items id="comment">Le diverse regioni all'interno dello stesso paese possono essere identificate se potenzialmente presentano rischi sanitari diversi.</items>
          <items id="description">La regione visitata.</items>
          <items id="text">Stato/regione</items>
        </term_definitions>
        <term_definitions code="at0013">
          <items id="comment">Differenti città all'interno dello stesso paese o regione possono essere identificate se potenzialmente presentano rischi sanitari diversi.</items>
          <items id="description">La città visitata</items>
          <items id="text">Città</items>
        </term_definitions>
        <term_definitions code="at0014">
          <items id="description">Data di entrata nel luogo identificato.</items>
          <items id="text">Data di entrata</items>
        </term_definitions>
        <term_definitions code="at0015">
          <items id="description">Data di uscita dal luogo identificato.</items>
          <items id="text">Data di uscita</items>
        </term_definitions>
        <term_definitions code="at0016">
          <items id="description">Descrizione narrativa della visita al luogo, in particolare sulla potenziale esposizione ai rischi per la salute.</items>
          <items id="text">Descrizione</items>
        </term_definitions>
        <term_definitions code="at0017">
          <items id="description">Narrativa aggiuntiva sul soggiorno nel luogo identificato, non catturata in altri campi.</items>
          <items id="text">Commento</items>
        </term_definitions>
        <term_definitions code="at0018">
          <items id="comment">Questo può essere utile se è necessario utilizzare la ricerca di contatti. Ad esempio: il vettore e l'ID di un volo o di una nave.</items>
          <items id="description">Dettagli su come l'individuo è tornato alla sua base.</items>
          <items id="text">Trasporto di ritorno</items>
        </term_definitions>
        <term_definitions code="at0019">
          <items id="description">La data in cui l'individuo è tornato alla sua base.</items>
          <items id="text">Data di ritorno</items>
        </term_definitions>
        <term_definitions code="at0020">
          <items id="description">Narrativa aggiuntiva sull'intero viaggio, non catturata in altri campi.</items>
          <items id="text">Commento</items>
        </term_definitions>
        <term_definitions code="at0021">
          <items id="comment">Per esempio: requisiti informativi locali; o metadati aggiuntivi per allinearsi a FHIR.</items>
          <items id="description">Informazioni aggiuntive necessarie per estendere il modello con contenuti locali o per allinearlo ad altri modelli di riferimento o formalismi.</items>
          <items id="text">Extension</items>
        </term_definitions>
        <term_definitions code="at0022">
          <items id="description">Descrizione narrativa dell'intero viaggio, in particolare della potenziale esposizione ai rischi per la salute.</items>
          <items id="text">Descrizione</items>
        </term_definitions>
        <term_definitions code="at0024">
          <items id="description">Dettagli strutturati aggiuntivi sul viaggio da, per e verso la destinazione.</items>
          <items id="text">Dettagli aggiuntivi sulla destinazione</items>
        </term_definitions>
        <term_definitions code="at0025">
          <items id="description">Altri dettagli strutturati sull'intero viaggio.</items>
          <items id="text">Dettagli di viaggio aggiuntivi</items>
        </term_definitions>
        <term_definitions code="at0026">
          <items id="description">*Was the travel domestic, international, or both?(en)</items>
          <items id="text">*Domestic/international(en)</items>
        </term_definitions>
        <term_definitions code="at0027">
          <items id="description">*It is unknown whether the individual has travelled within the specified interval of time.(en)</items>
          <items id="text">*Unknown(en)</items>
        </term_definitions>
        <term_definitions code="at0028">
          <items id="description">*The individual has travelled domestically within the specified interval of time.(en)</items>
          <items id="text">*Domestic travel(en)</items>
        </term_definitions>
        <term_definitions code="at0029">
          <items id="description">*The individual has travelled internationally within the specified interval of time.(en)</items>
          <items id="text">*International travel(en)</items>
        </term_definitions>
        <term_definitions code="at0030">
          <items id="description">*The individual has travelled both domestically and internationally within the specified interval of time.(en)</items>
          <items id="text">*Domestic and international travel(en)</items>
        </term_definitions>
        <term_definitions code="at0031">
          <items id="comment">*For example: airport, cruise ship, conference centre, hotel or sports arena.(en)</items>
          <items id="description">*A specific place visited.(en)</items>
          <items id="text">*Specific place(en)</items>
        </term_definitions>
      </children>
