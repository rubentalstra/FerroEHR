        <term_definitions code="at0000">
          <items id="description">Una misura della temperatura corporea, che è un surrogato della temperatura corporea del corpo centrale dell'individuo.</items>
          <items id="text">Febbre</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">@ internal @</items>
          <items id="text">History</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">Evento predefinito, non specificato nel tempo o nell'intervallo di tempo, che può essere definito esplicitamente in un modello o in fase di esecuzione.</items>
          <items id="text">Qualsiasi evento</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="description">La temperatura corporea misurata (come surrogato del nucleo del corpo).</items>
          <items id="text">Temperatura</items>
        </term_definitions>
        <term_definitions code="at0020">
          <items id="description">@ internal @</items>
          <items id="text">Protocol</items>
        </term_definitions>
        <term_definitions code="at0021">
          <items id="description">Il sito anatomico di misurazione della temperatura.</items>
          <items id="text">Posizione della misura</items>
        </term_definitions>
        <term_definitions code="at0022">
          <items id="description">La temperatura viene misurata all'interno della bocca.</items>
          <items id="text">Bocca</items>
        </term_definitions>
        <term_definitions code="at0023">
          <items id="description">La temperatura viene misurata dall'interno del canale uditivo esterno.</items>
          <items id="text">Canale uditivo</items>
        </term_definitions>
        <term_definitions code="at0024">
          <items id="description">La temperatura viene misurata dalla pelle dell'ascella con il braccio posizionato lateralmente.</items>
          <items id="text">Ascella</items>
        </term_definitions>
        <term_definitions code="at0025">
          <items id="description">Temperatura misurata all'interno del retto.</items>
          <items id="text">Retto</items>
        </term_definitions>
        <term_definitions code="at0026">
          <items id="description">La temperatura viene misurata all'interno del rinofaringe.</items>
          <items id="text">Rinofaringe</items>
        </term_definitions>
        <term_definitions code="at0027">
          <items id="description">La temperatura viene misurata nella vescica urinaria.</items>
          <items id="text">Vescica urinaria</items>
        </term_definitions>
        <term_definitions code="at0028">
          <items id="description">La temperatura viene misurata all'interno del sistema vascolare.</items>
          <items id="text">Intravascolare</items>
        </term_definitions>
        <term_definitions code="at0043">
          <items id="description">La temperatura viene misurata dalla pelle esposta.</items>
          <items id="text">Pelle</items>
        </term_definitions>
        <term_definitions code="at0051">
          <items id="description">La temperatura viene misurata all'interno della vagina.</items>
          <items id="text">Vagina</items>
        </term_definitions>
        <term_definitions code="at0054">
          <items id="description">La temperatura viene misurata all'interno dell'esofago.</items>
          <items id="text">Esofago</items>
        </term_definitions>
        <term_definitions code="at0055">
          <items id="description">La temperatura viene misurata nella piega inguinale della pelle tra la gamba e la parete addominale.</items>
          <items id="text">Piega della pelle inguinale</items>
        </term_definitions>
        <term_definitions code="at0059">
          <items id="description">Dettagli sull'uso del dispositivo per misurare la temperatura corporea.</items>
          <items id="text">Dispositivo</items>
        </term_definitions>
        <term_definitions code="at0060">
          <items id="description">La temperatura viene misurata alle tempie, sopra l'arteria temporale superficiale.</items>
          <items id="text">Tempie</items>
        </term_definitions>
        <term_definitions code="at0061">
          <items id="description">La temperatura viene misurata sulla fronte.</items>
          <items id="text">Fronte</items>
        </term_definitions>
        <term_definitions code="at0062">
          <items id="comment">Ad esempio: requisiti informativi locali o metadati aggiuntivi per allinearsi agli equivalenti FHIR o CIMI.</items>
          <items id="description">Informazioni aggiuntive necessarie per catturare contenuti locali o per allinearsi con altri modelli/formalismi di riferimento.</items>
          <items id="text">Estensione</items>
        </term_definitions>
        <term_definitions code="at0063">
          <items id="description">Commento aggiuntivo sulla misurazione della temperatura corporea non catturato in altri campi.</items>
          <items id="text">Commento</items>
        </term_definitions>
        <term_definitions code="at0064">
          <items id="description">Posizione anatomica strutturata del luogo in cui è stata effettuata la misurazione.</items>
          <items id="text">Luogo di misura strutturato</items>
        </term_definitions>
        <term_definitions code="at0066">
          <items id="description">*</items>
          <items id="text">Inizio</items>
        </term_definitions>
