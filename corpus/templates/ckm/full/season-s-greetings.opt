    <archetype_id>
      <value>openEHR-EHR-COMPOSITION.notification.v0</value>
    </archetype_id>
    <template_id>
      <value>Season's Greetings!</value>
    </template_id>
    <term_definitions code="at0000">
      <items id="description">This is a generic composition used for all sorts of notifications, such as an infection event and surgical site surveillance event.  
Document to communicate notifications to healthcare providers or be used as triggers for automated business rules.</items>
      <items id="text">Notification</items>
    </term_definitions>
