    <template_id>
      <value>CSF blood cell count and differential</value>
    </template_id>
    <term_definitions code="at0000">
      <items id="comment">For example: whole blood; urine; or CSF.</items>
      <items id="description">Relative and absolute amounts of blood cells identified within an identified specimen.</items>
      <items id="text">Blood cell count and differential finding</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="description">Total number of erythrocytes per volume unit of the specimen.</items>
      <items id="text">Red cell count (RCC)</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="description">Total number of leucocytes per volume unit of the specimen.</items>
      <items id="text">White cell count (WCC)</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="description">Number of lymphocytes per volume unit of the specimen.</items>
      <items id="text">Lymphocyte count</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="description">Number of neutrophils per volume unit of the specimen.</items>
      <items id="text">Neutrophil count</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="description">Number of eosinophils per volume unit of the specimen.</items>
      <items id="text">Eosinophil count</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="description">Number of basophils per volume unit of the specimen.</items>
      <items id="text">Basophil count</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="description">Number of monocytes per volume unit of the specimen.</items>
      <items id="text">Monocyte count</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="description">Number of platelets per volume unit of the specimen.</items>
      <items id="text">Platelet count</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="description">Number of blast cells per volume unit of the specimen.</items>
      <items id="text">Blast count</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="comment">Most commonly, the specimen analysed is blood, as part of a complete blood count (or full blood examination) but other body fluids, such as cerebrospinal fluid or urine, may also be tested to identify and quantify the blood cells present. If the tissue specimen has previously been identified in a a higher level archetype level archetype, such as the OBSERVATION.laboratory_test_result, this SLOT may be redundant.

Most often, the specimen is blood, but other body fluids like cerebrospinal fluid or urine can also be analyzed to identify and quantify the blood cells present.

Typically, the sample used is blood, but other body fluids like cerebrospinal fluid or urine may also be tested to identify and count the blood cells present.</items>
      <items id="description">Identification of the specimen examined.</items>
      <items id="text">Specimen</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="description">Additional narrative about the blood cell count, not captured in other fields.</items>
      <items id="text">Comment</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="description">The proportion of neutrophils compared to the total white blood cell count.</items>
      <items id="text">Neutrophil %</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="description">The proportion of lymphocytes compared to the total white blood cell count.</items>
      <items id="text">Lymphocyte %</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="description">The proportion of monocytes compared to the total white blood cell count.</items>
      <items id="text">Monocyte %</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="description">The proportion of eosinophils compared to the white blood cell count.</items>
      <items id="text">Eosinophil %</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="description">The proportion of basophils observed compared to the total white blood cell count.</items>
      <items id="text">Basophil %</items>
    </term_definitions>
    <term_definitions code="at0021">
      <items id="description">The proportion of blast cells compared to the total white blood cell count.</items>
      <items id="text">Blast %</items>
    </term_definitions>
  </definition>
  <view/>
</template>