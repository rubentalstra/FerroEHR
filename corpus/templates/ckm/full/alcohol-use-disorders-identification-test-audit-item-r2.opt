    <term_definitions code="at0000">
      <items id="description">Ten question screening test to identify harmful alcohol consumption.</items>
      <items id="text">Alcohol Use Disorders Identification Test (AUDIT)</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="description">@ internal @</items>
      <items id="text">Event Series</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="description">Default, unspecified point in time event which may be explicitly defined in a template or at run-time.</items>
      <items id="text">Any point in time</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="description">@ internal @</items>
      <items id="text">Tree</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="description">How often did you have a drink containing alcohol in the past year?</items>
      <items id="text">Frequency of consumption</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="description">No drinking of alcohol in the past year.</items>
      <items id="text">Never</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="description">Drinking alcohol monthly or less frequently during the past year.</items>
      <items id="text">Monthly or Less</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="description">Drinking alcohol two to four times a month during the past year.</items>
      <items id="text">2 to 4 Times a Month</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="description">Drinking alcohol two to three times a week during the past year.</items>
      <items id="text">2 to 3 Times a Week</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="description">Drinking alcohol four or more times a week during the past year.</items>
      <items id="text">4 or More Times a Week</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="description">How many drinks did you have on a typical day when you were drinking in the past year?</items>
      <items id="text">Typical consumption</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="description">One or two drinks of alcohol on a typical day in the past year.</items>
      <items id="text">1 or 2</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="description">Three or four drinks of alcohol on a typical day in the past year.</items>
      <items id="text">3 or 4</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="description">Five or six drinks of alcohol on a typical day in the past year.</items>
      <items id="text">5 or 6</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="description">Seven, eight or nine drinks of alcohol on a typical day in the past year.</items>
      <items id="text">7 to 9</items>
    </term_definitions>
    <term_definitions code="at0015">
      <items id="description">Ten or more drinks of alcohol on a typical day in the past year.</items>
      <items id="text">10 or More</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="description">How often did you have six or more drinks on one occasion in the past year?</items>
      <items id="text">Binge drinking</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="description">Never, in the past year.</items>
      <items id="text">Never</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="description">Less than monthly, during the past year.</items>
      <items id="text">Less than Monthly</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="description">Monthly, during the past year.</items>
      <items id="text">Monthly</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="description">Weekly, during the past year.</items>
      <items id="text">Weekly</items>
    </term_definitions>
    <term_definitions code="at0021">
      <items id="description">Daily, or almost daily, during the past year.</items>
      <items id="text">Daily or Almost Daily</items>
    </term_definitions>
    <term_definitions code="at0022">
      <items id="description">Total Score calculated from the 10 AUDIT questions.</items>
      <items id="text">AUDIT total score</items>
    </term_definitions>
    <term_definitions code="at0023">
      <items id="description">How often during the last year have you found that you were not able to stop drinking once you had started?</items>
      <items id="text">Inability to stop</items>
    </term_definitions>
    <term_definitions code="at0024">
      <items id="description">How often during the last year have you failed to do what was normally expected of you because of drinking?</items>
      <items id="text">Failed expectations</items>
    </term_definitions>
    <term_definitions code="at0025">
      <items id="description">How often during the last year have you needed a first drink in the morning to get yourself going after a heavy drinking session?</items>
      <items id="text">Morning drinking</items>
    </term_definitions>
    <term_definitions code="at0026">
      <items id="description">How often during the last year have you had a feeling of guilt or remorse after drinking?</items>
      <items id="text">Guilt/remorse</items>
    </term_definitions>
    <term_definitions code="at0027">
      <items id="description">How often during the last year have you been unable to remember what happened the night before because of your drinking?</items>
      <items id="text">Loss of memory</items>
    </term_definitions>
    <term_definitions code="at0028">
      <items id="description">Have you or someone else been injured because of your drinking?</items>
      <items id="text">Injuries</items>
    </term_definitions>
    <term_definitions code="at0029">
      <items id="description">Has a relative, friend, doctor, or other health care worker been concerned about your drinking or suggested you cut down?</items>
      <items id="text">External concern</items>
    </term_definitions>
    <term_definitions code="at0030">
      <items id="description">No occurrence.</items>
      <items id="text">No</items>
    </term_definitions>
    <term_definitions code="at0031">
      <items id="description">Yes, this has occurred, but not in the last year.</items>
      <items id="text">Yes, but not in the last year.</items>
    </term_definitions>
    <term_definitions code="at0032">
      <items id="description">Yes this has occurred during the last year.</items>
      <items id="text">Yes, during the last year.</items>
    </term_definitions>
    <term_definitions code="at0033">
      <items id="description">Total Score calculated from the first 3 questions only.</items>
      <items id="text">AUDIT-C total score</items>
    </term_definitions>
    <term_definitions code="at0034">
      <items id="description">Additional narrative about the screening test, not captured in other fields.</items>
      <items id="text">Comment</items>
    </term_definitions>
    <term_definitions code="at0035">
      <items id="description">@ internal @</items>
      <items id="text">Tree</items>
    </term_definitions>
    <term_definitions code="at0036">
      <items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items>
      <items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items>
      <items id="text">Extension</items>
    </term_definitions>
  </definition>
