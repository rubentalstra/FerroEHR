                    <archetype_id>
                      <value>openEHR-EHR-CLUSTER.findings_glaucoma.v0</value>
                    </archetype_id>
                    <term_definitions code="at0000">
                      <items id="description">Clinical findings on eye related with the diagnose of glaucoma.</items>
                      <items id="text">Findings in glaucoma</items>
                    </term_definitions>
                    <term_definitions code="at0002">
                      <items id="description">Findings on RNFL supporting the current study of glaucoma.</items>
                      <items id="text">Retinal nerve fiber layer</items>
                    </term_definitions>
                    <term_definitions code="at0004">
                      <items id="description">Findings on optic disc supporting the current study of glaucoma.</items>
                      <items id="text">Optic disc</items>
                    </term_definitions>
                    <term_definitions code="at0005">
                      <items id="description">Identification of hemorrhages on or bordering the optic disc.</items>
                      <items id="text">Hemorrhages optic disc</items>
                    </term_definitions>
                    <term_definitions code="at0006">
                      <items id="description">Narrative description of diffuse or localized abnormalities of the peripapillary retinal nerve fiber layer, especially at the inferior or superior poles.</items>
                      <items id="text">Parapapillary atrophy</items>
                    </term_definitions>
                    <term_definitions code="at0008">
                      <items id="description">Visual field damage consistent with retinal nerve fiber layer damage.</items>
                      <items id="text">Visual field defects</items>
                    </term_definitions>
                    <term_definitions code="at0009">
                      <items id="description">Findings on visual field supporting the current study of glaucoma.</items>
                      <items id="text">Visual field</items>
                    </term_definitions>
                    <term_definitions code="at0010">
                      <items id="description">Mean defect &lt; -6dB; Fewer than 18 points depressed below the 5% probability level; Fewer than 10 points below the p &lt; 1% level; No point in the central 5 degrees with a sensitivity of less than 15 dB.</items>
                      <items id="text">Early glaucomatous loss</items>
                    </term_definitions>
                    <term_definitions code="at0011">
                      <items id="description">Mean defect &lt; -12dB; Fewer than 37 points depressed below the 5% probability level; Fewer than 20 points below the p &lt; 1% level; Only one hemifield with a sensitivity of less than 15 dB.</items>
                      <items id="text">Moderate glaucomatous loss</items>
                    </term_definitions>
                    <term_definitions code="at0012">
                      <items id="description">Mean defect > -12dB; More than 37 points depressed below the 5% probability level; More than 20 points below the p &lt; 1% level; Absolute deficit (0dB) in the 5 central degrees; Sensitivity &lt;15dB in the 5 central degrees in both hemifields.</items>
                      <items id="text">Advanced glaucomatous loss</items>
                    </term_definitions>
                    <term_definitions code="at0013">
                      <items id="description">Visual field loss in one hemifield that is different from the other hemifield, i.e., across the horizontal midline (in early/moderate cases).</items>
                      <items id="text">Asymmetric loss</items>
                    </term_definitions>
                    <term_definitions code="at0014">
                      <items id="description">Document the insertion level of the iris root before and during compression dynamic gonioscopy.</items>
                      <items id="text">Anterior segment</items>
                    </term_definitions>
                    <term_definitions code="at0015">
                      <items id="description">Insertion of iris root.</items>
                      <items id="text">Iris root</items>
                    </term_definitions>
                    <term_definitions code="at0016">
                      <items id="description">Anterior to Schwalbe's line.</items>
                      <items id="text">Anterior to Schwalbe</items>
                    </term_definitions>
                    <term_definitions code="at0017">
                      <items id="description">Behind Schwalbe's line.</items>
                      <items id="text">Behind Schwalbe</items>
                    </term_definitions>
                    <term_definitions code="at0018">
                      <items id="description">On the Scleral Spur.</items>
                      <items id="text">Scleral Spur</items>
                    </term_definitions>
                    <term_definitions code="at0019">
                      <items id="description">Behind the Scleral Spur.</items>
                      <items id="text">Behind Scleral Spur</items>
                    </term_definitions>
                    <term_definitions code="at0020">
                      <items id="description">On the Cillary Band.</items>
                      <items id="text">Cillary Band</items>
                    </term_definitions>
                    <term_definitions code="at0021">
                      <items id="description">Angular width of angle recess.</items>
                      <items id="text">Angle recess</items>
                    </term_definitions>
                    <term_definitions code="at0022">
                      <items id="description">Configuration of the peripheral iris.</items>
                      <items id="text">Peripheral iris</items>
                    </term_definitions>
                    <term_definitions code="at0023">
                      <items id="description">Steep, anteriorly convex.</items>
                      <items id="text">Steep</items>
                    </term_definitions>
                    <term_definitions code="at0024">
                      <items id="description">Regular.</items>
                      <items id="text">Regular</items>
                    </term_definitions>
                    <term_definitions code="at0025">
                      <items id="description">Queer, anteriorly concave.</items>
                      <items id="text">Queer</items>
                    </term_definitions>
                    <term_definitions code="at0026">
                      <items id="description">Ratio of slit thickness of the cornea to the depth of the anterior chamber.</items>
                      <items id="text">Slit thickness</items>
                    </term_definitions>
                    <term_definitions code="at0027">
                      <items id="description">Ratio of slit thickness = 0.</items>
                      <items id="text">Angle closed</items>
                    </term_definitions>
                    <term_definitions code="at0028">
                      <items id="description">Ratio of slit thickness &lt; 1/4.</items>
                      <items id="text">Angle closure likely (angle 10°)</items>
                    </term_definitions>
                    <term_definitions code="at0029">
                      <items id="description">Ratio of slit thickness 1/4.</items>
                      <items id="text">Angle clossure possible (angle 20°)</items>
                    </term_definitions>
                    <term_definitions code="at0030">
                      <items id="description">Ratio of slit thickness 1/2.</items>
                      <items id="text">Angle closure unlikely</items>
                    </term_definitions>
                    <term_definitions code="at0031">
                      <items id="description">Ratio of slit thickness 1.</items>
                      <items id="text">Angle closure very unlikely</items>
                    </term_definitions>
                    <term_definitions code="at0032">
                      <items id="description">Description of the pattern of neuroretinal rim loss. It may take the form of diffuse thinning, focal narrowing, or localized notching of the optic disc rim, especially at the inferior or superior poles.</items>
                      <items id="text">Rim loss pattern</items>
                    </term_definitions>
                    <term_definitions code="at0040">
                      <items id="description">Identification of retinal nerve fiber layer thinning defects.</items>
                      <items id="text">RNFL thinning</items>
                    </term_definitions>
                    <term_definitions code="at0041">
                      <items id="description">Diffuse thinning of Retinal nerve fiber layer.</items>
                      <items id="text">Diffuse thinning</items>
                    </term_definitions>
                    <term_definitions code="at0042">
                      <items id="description">Identification of progressive thinning of the neuroretinal rim with an associated increase in cupping of the optic disc.</items>
                      <items id="text">Cupping</items>
                    </term_definitions>
                    <term_definitions code="at0043">
                      <items id="description">Description of any positional changes of the vessels at the optic disc with bending, bayoneting or baring of circumlinear vessels.</items>
                      <items id="text">Vessels</items>
                    </term_definitions>
                    <term_definitions code="at0044">
                      <items id="description">Narrative description of overall findings, inlcuding those not considered above.</items>
                      <items id="text">Comments</items>
                    </term_definitions>
                    <term_definitions code="at0047">
                      <items id="description">Description of features in optic nerve head (ONH).</items>
                      <items id="text">Optic nerve head</items>
                    </term_definitions>
                    <term_definitions code="at0048">
                      <items id="description">Identification of hemorrhages on the peripapillary retinal nerve fiber layer.</items>
                      <items id="text">Hemorrhages RNFL</items>
                    </term_definitions>
                    <term_definitions code="at0049">
                      <items id="description">Optic disc neural rim asymmetry of the two eyes consistent with loss of neural tissue.</items>
                      <items id="text">Asymmetric rim</items>
                    </term_definitions>
                    <term_definitions code="at0050">
                      <items id="description">Focal (wedge and slit) defects.</items>
                      <items id="text">Localized defects</items>
                    </term_definitions>
                  </children>
                  <children xsi:type="C_COMPLEX_OBJECT">
                    <rm_type_name>ELEMENT</rm_type_name>
                    <occurrences>
                      <lower_included>true</lower_included>
                      <upper_included>true</upper_included>
                      <lower_unbounded>false</lower_unbounded>
                      <upper_unbounded>false</upper_unbounded>
                      <lower>0</lower>
                      <upper>1</upper>
                    </occurrences>
                    <node_id>at0003</node_id>
                    <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                      <rm_attribute_name>value</rm_attribute_name>
                      <existence>
                        <lower_included>true</lower_included>
                        <upper_included>true</upper_included>
                        <lower_unbounded>false</lower_unbounded>
                        <upper_unbounded>false</upper_unbounded>
                        <lower>0</lower>
                        <upper>1</upper>
                      </existence>
                      <children xsi:type="C_COMPLEX_OBJECT">
                        <rm_type_name>DV_TEXT</rm_type_name>
