                <term_definitions code="at0000">
                  <items id="description">Measurement details about of the central corneal thickness.</items>
                  <items id="text">Central corneal thickness details</items>
                </term_definitions>
                <term_definitions code="at0001">
                  <items id="description">Value measured of the central corneal thickness.</items>
                  <items id="text">Central Corneal Thickness (CCT)</items>
                </term_definitions>
                <term_definitions code="at0002">
                  <items id="description">Method used to measure the corneal thickness parameter.</items>
                  <items id="text">Measurement Method</items>
                </term_definitions>
                <term_definitions code="at0003">
                  <items id="description">Parameter obtained from tables provided by manufacturers, to correct the intraocular pressure value according to the central corneal thickness obtained.</items>
                  <items id="text">Correction parameter</items>
                </term_definitions>
                <term_bindings terminology="SNOMED-CT">
