            <archetype_id>
              <value>openEHR-EHR-CLUSTER.organisation.v0</value>
            </archetype_id>
            <term_definitions code="at0000">
              <items id="comment">For example: a company, institution, corporation, department, community group, healthcare practice group, payer/insurer, care team, or a group of neighbours who will act as carers or support.</items>
              <items id="description">An identified formal entity or informal grouping of people.</items>
              <items id="text">Organisation</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="comment">For example: 'Royal Children's Hospital'; 'ABC District Nursing Service'; 'YNWA Oslo' or 'JB Smith Lawyers'.</items>
              <items id="description">The unstructured name or label for the organisation.</items>
              <items id="text">Name</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="description">Details about a contact person, or people, within the organisation.</items>
              <items id="text">Contact person</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="description">Identifier associated with the organisation.</items>
              <items id="text">Identifier</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="comment">For example: Lawyer, insurance company, school, health clinic, hospital, or informal support network.</items>
              <items id="description">The relationship or role of the organisation to the individual or subject of care.</items>
              <items id="text">Role</items>
            </term_definitions>
            <term_definitions code="at0005">
              <items id="description">Details about an address for the organisation.</items>
              <items id="text">Address</items>
            </term_definitions>
            <term_definitions code="at0006">
              <items id="description">Details about a specific type of electronic communication for the organisation.</items>
              <items id="text">Electronic communication</items>
            </term_definitions>
            <term_definitions code="at0007">
              <items id="comment">The range of electronic communication mediums includes, but is not limited to use of: telephone, cellular phone, email, pager, fax, conferencing tool or social media.</items>
              <items id="description">The type or medium for electronic communication.</items>
              <items id="text">Type</items>
            </term_definitions>
            <term_definitions code="at0008">
              <items id="description">*</items>
              <items id="text">Mobile (cellular) telephone</items>
            </term_definitions>
            <term_definitions code="at0009">
              <items id="description">*</items>
              <items id="text">Telephone (excluding mobile telephone)</items>
            </term_definitions>
            <term_definitions code="at0010">
              <items id="description">*</items>
              <items id="text">Email</items>
            </term_definitions>
            <term_definitions code="at0011">
              <items id="description">*</items>
              <items id="text">Pager</items>
            </term_definitions>
            <term_definitions code="at0016">
              <items id="comment">For example: area code + landline phone/pager number; country code + mobile phone number; email address; or skype contact name.</items>
              <items id="description">The unique combination of alphanumeric characters, meaningful for the identified type or medium of electronic communication.</items>
              <items id="text">Value</items>
            </term_definitions>
            <term_definitions code="at0017">
              <items id="description">Additional details about the organisation.</items>
              <items id="text">Additional details</items>
            </term_definitions>
            <term_definitions code="at0018">
              <items id="description">Additional narrative about the electronic communication not captured in other fields.</items>
              <items id="text">Comment</items>
            </term_definitions>
            <term_definitions code="at0019">
              <items id="description">Additional narrative about the organisation not captured in other fields.</items>
              <items id="text">Comment</items>
            </term_definitions>
            <term_definitions code="at0020">
              <items id="description">*</items>
              <items id="text">Fax</items>
            </term_definitions>
            <term_definitions code="at0021">
              <items id="description">A larger organisation of which this organisation is a child or subsidiary.</items>
              <items id="text">Parent organisation</items>
            </term_definitions>
          </children>
