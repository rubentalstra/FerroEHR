                    <archetype_id>
                      <value>openEHR-EHR-CLUSTER.art_container_details.v0</value>
                    </archetype_id>
                    <term_definitions code="at0000">
                      <items id="description">Details about the contents of a container stored for the purposes of assisted reproduction treatment.</items>
                      <items id="text">ART container details</items>
                    </term_definitions>
                    <term_definitions code="at0001">
                      <items id="comment">This data element has multiple occurrences to allow for more than one embryo per container.</items>
                      <items id="description">The unique identifier for the oocyte or embryo.</items>
                      <items id="text">Embryo ID</items>
                    </term_definitions>
                    <term_definitions code="at0002">
                      <items id="description">The date and/or time when the container and its' contents were frozen.</items>
                      <items id="text">Freeze date</items>
                    </term_definitions>
                    <term_definitions code="at0003">
                      <items id="description">The method of freezing.</items>
                      <items id="text">Freeze method</items>
                    </term_definitions>
                    <term_definitions code="at0004">
                      <items id="description">*</items>
                      <items id="text">Slow freeze</items>
                    </term_definitions>
                    <term_definitions code="at0005">
                      <items id="description">*</items>
                      <items id="text">Vitrification</items>
                    </term_definitions>
                    <term_definitions code="at0006">
                      <items id="description">The identifier for the freeze procedure.</items>
                      <items id="text">Freeze protocol ID</items>
                    </term_definitions>
                    <term_definitions code="at0007">
                      <items id="description">The post-insemination day on which the embryo was frozen.</items>
                      <items id="text">Freeze development day</items>
                    </term_definitions>
                    <term_definitions code="at0008">
                      <items id="description">The date and/or time when the container and its' contents were thawed.</items>
                      <items id="text">Thaw date</items>
                    </term_definitions>
                    <term_definitions code="at0009">
                      <items id="description">The reason for thawing the contents of the container.</items>
                      <items id="text">Thaw reason</items>
                    </term_definitions>
                    <term_definitions code="at0010">
                      <items id="description">The date beyond the contents are not to be used.</items>
                      <items id="text">Expiry date</items>
                    </term_definitions>
                    <term_definitions code="at0011">
                      <items id="description">The date on which the contents awere destroyed.</items>
                      <items id="text">Destruction date</items>
                    </term_definitions>
                    <term_definitions code="at0012">
                      <items id="description">Additional narrative about the ART straw contents, not captured in other fields.</items>
                      <items id="text">Comment</items>
                    </term_definitions>
