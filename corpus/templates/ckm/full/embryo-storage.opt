        </attributes>
        <archetype_id>
          <value>openEHR-EHR-CLUSTER.biobank_storage.v0</value>
        </archetype_id>
        <term_definitions code="at0000">
          <items id="description">Storage repository for human biological material and associated information.</items>
          <items id="text">Biobank storage</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">Name of the specimen or tissue repository.</items>
          <items id="text">Biobank name</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">Identifier of the biobank.</items>
          <items id="text">Biobank ID</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">Identifier of the specimen or tissue stored in the biobank.</items>
          <items id="text">Sample ID</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="description">Details about the organisation or location of the biobank.</items>
          <items id="text">Biobank details</items>
        </term_definitions>
        <term_definitions code="at0005">
          <items id="description">Identifier of the human source of the specimen or tissue sample.</items>
          <items id="text">Donor ID</items>
        </term_definitions>
        <term_definitions code="at0006">
          <items id="description">Additional narrative about the biobank, not captured in other fields.</items>
          <items id="text">Comment</items>
        </term_definitions>
