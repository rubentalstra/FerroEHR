    </term_definitions>
    <term_definitions code="at0002">
      <items id="comment">Coding with an external terminology is optional.</items>
      <items id="description">The name of the issue or concern as presented by the individual.</items>
      <items id="text">Issue name</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="description">Narrative description about the issue.</items>
      <items id="text">Description</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items>
