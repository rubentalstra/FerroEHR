                                    <node_id>at0012</node_id>
                                    <includes>
                                      <expression xsi:type="EXPR_BINARY_OPERATOR">
                                        <type>Boolean</type>
                                        <operator>2007</operator>
                                        <precedence_overridden>false</precedence_overridden>
                                        <left_operand xsi:type="EXPR_LEAF">
                                          <type>String</type>
                                          <item xsi:type="xsd:string">archetype_id/value</item>
                                          <reference_type>attribute</reference_type>
                                        </left_operand>
                                        <right_operand xsi:type="EXPR_LEAF">
                                          <type>C_STRING</type>
                                          <item xsi:type="C_STRING">
                                            <pattern>openEHR-EHR-CLUSTER\.person(-[a-zA-Z0-9_]+)*\.v1|openEHR-EHR-CLUSTER\.person(-[a-zA-Z0-9_]+)*\.v0</pattern>
                                          </item>
                                          <reference_type>constraint</reference_type>
                                        </right_operand>
                                      </expression>
                                    </includes>
                                  </children>
                                  <children xsi:type="ARCHETYPE_SLOT">
                                    <rm_type_name>CLUSTER</rm_type_name>
                                    <occurrences>
                                      <lower_included>true</lower_included>
                                      <lower_unbounded>false</lower_unbounded>
                                      <upper_unbounded>true</upper_unbounded>
                                      <lower>0</lower>
                                    </occurrences>
                                    <node_id>at0011</node_id>
                                    <includes>
                                      <expression xsi:type="EXPR_BINARY_OPERATOR">
                                        <type>Boolean</type>
                                        <operator>2007</operator>
                                        <precedence_overridden>false</precedence_overridden>
                                        <left_operand xsi:type="EXPR_LEAF">
                                          <type>String</type>
                                          <item xsi:type="xsd:string">archetype_id/value</item>
                                          <reference_type>attribute</reference_type>
                                        </left_operand>
                                        <right_operand xsi:type="EXPR_LEAF">
                                          <type>C_STRING</type>
                                          <item xsi:type="C_STRING">
                                            <pattern>openEHR-EHR-CLUSTER\.device\.v1</pattern>
                                          </item>
                                          <reference_type>constraint</reference_type>
                                        </right_operand>
                                      </expression>
                                    </includes>
                                  </children>
                                  <children xsi:type="ARCHETYPE_SLOT">
                                    <rm_type_name>CLUSTER</rm_type_name>
                                    <occurrences>
                                      <lower_included>true</lower_included>
                                      <lower_unbounded>false</lower_unbounded>
                                      <upper_unbounded>true</upper_unbounded>
                                      <lower>0</lower>
                                    </occurrences>
                                    <node_id>at0013</node_id>
                                    <includes>
                                      <expression xsi:type="EXPR_BINARY_OPERATOR">
                                        <type>Boolean</type>
                                        <operator>2007</operator>
                                        <precedence_overridden>false</precedence_overridden>
                                        <left_operand xsi:type="EXPR_LEAF">
                                          <type>String</type>
                                          <item xsi:type="xsd:string">archetype_id/value</item>
                                          <reference_type>attribute</reference_type>
                                        </left_operand>
                                        <right_operand xsi:type="EXPR_LEAF">
                                          <type>C_STRING</type>
                                          <item xsi:type="C_STRING">
                                            <pattern>.*</pattern>
                                          </item>
                                          <reference_type>constraint</reference_type>
                                        </right_operand>
                                      </expression>
                                    </includes>
                                  </children>
                                  <children xsi:type="C_COMPLEX_OBJECT">
                                    <rm_type_name>ELEMENT</rm_type_name>
                                    <occurrences>
                                      <lower_included>true</lower_included>
                                      <upper_included>true</upper_included>
                                      <lower_unbounded>false</lower_unbounded>
                                      <upper_unbounded>false</upper_unbounded>
                                      <lower>0</lower>
                                      <upper>1</upper>
                                    </occurrences>
                                    <node_id>at0007</node_id>
                                    <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                                      <rm_attribute_name>value</rm_attribute_name>
                                      <existence>
                                        <lower_included>true</lower_included>
                                        <upper_included>true</upper_included>
                                        <lower_unbounded>false</lower_unbounded>
                                        <upper_unbounded>false</upper_unbounded>
                                        <lower>0</lower>
                                        <upper>1</upper>
                                      </existence>
                                      <children xsi:type="C_COMPLEX_OBJECT">
                                        <rm_type_name>DV_TEXT</rm_type_name>
                                        <occurrences>
                                          <lower_included>true</lower_included>
                                          <upper_included>true</upper_included>
                                          <lower_unbounded>false</lower_unbounded>
                                          <upper_unbounded>false</upper_unbounded>
                                          <lower>1</lower>
                                          <upper>1</upper>
                                        </occurrences>
                                        <node_id/>
                                      </children>
                                    </attributes>
                                  </children>
                                  <cardinality>
                                    <is_ordered>false</is_ordered>
                                    <is_unique>false</is_unique>
                                    <interval>
                                      <lower_included>true</lower_included>
                                      <lower_unbounded>false</lower_unbounded>
                                      <upper_unbounded>true</upper_unbounded>
                                      <lower>1</lower>
                                    </interval>
                                  </cardinality>
                                </attributes>
                                <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                                  <rm_attribute_name>name</rm_attribute_name>
                                  <existence>
                                    <lower_included>true</lower_included>
                                    <upper_included>true</upper_included>
                                    <lower_unbounded>false</lower_unbounded>
                                    <upper_unbounded>false</upper_unbounded>
                                    <lower>1</lower>
                                    <upper>1</upper>
                                  </existence>
                                  <children xsi:type="C_COMPLEX_OBJECT">
                                    <rm_type_name>DV_TEXT</rm_type_name>
                                    <occurrences>
                                      <lower_included>true</lower_included>
                                      <upper_included>true</upper_included>
                                      <lower_unbounded>false</lower_unbounded>
                                      <upper_unbounded>false</upper_unbounded>
                                      <lower>1</lower>
                                      <upper>1</upper>
                                    </occurrences>
                                    <node_id/>
                                    <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                                      <rm_attribute_name>value</rm_attribute_name>
                                      <existence>
                                        <lower_included>true</lower_included>
                                        <upper_included>true</upper_included>
                                        <lower_unbounded>false</lower_unbounded>
                                        <upper_unbounded>false</upper_unbounded>
                                        <lower>1</lower>
                                        <upper>1</upper>
                                      </existence>
                                      <children xsi:type="C_PRIMITIVE_OBJECT">
                                        <rm_type_name>STRING</rm_type_name>
                                        <occurrences>
                                          <lower_included>true</lower_included>
                                          <upper_included>true</upper_included>
                                          <lower_unbounded>false</lower_unbounded>
                                          <upper_unbounded>false</upper_unbounded>
                                          <lower>1</lower>
                                          <upper>1</upper>
                                        </occurrences>
                                        <node_id/>
                                        <item xsi:type="C_STRING">
                                          <list>VRS attachment</list>
                                        </item>
                                      </children>
                                    </attributes>
                                  </children>
                                </attributes>
                                <archetype_id>
                                  <value>openEHR-EHR-CLUSTER.media_file.v1</value>
                                </archetype_id>
                                <term_definitions code="at0000">
                                  <items id="description">A media file that is acquired or used as part of the healthcare process, and associated metadata.</items>
                                  <items id="text">Media file</items>
                                </term_definitions>
                                <term_definitions code="at0001">
                                  <items id="comment">If the file is stored locally, the actual content will be captured and stored using the Multimedia data type. For example: RTF or PDF for a document; JPG for an image; MP4 for a video; or WAV for an audio file. If the file is stored at a location outside of the health record, the detailed path to the file is captured using the URI attribute in the Multimedia data type. The Multimedia data type has many RM attributes such as the size of file and URI to an external source - see https://specifications.openehr.org/releases/RM/latest/data_types.html#_dv_multimedia_class.</items>
                                  <items id="description">Digital representation of the media file.</items>
                                  <items id="text">Content</items>
                                </term_definitions>
                                <term_definitions code="at0002">
                                  <items id="comment">A description of the content of the media file. Use an agreed standardised naming convention, if available. For example: "Right hand burn #1" or "Cardiology video consultation on May 2".</items>
                                  <items id="description">Descriptive name or title for the media file.</items>
                                  <items id="text">Content name</items>
                                </term_definitions>
                                <term_definitions code="at0004">
                                  <items id="description">The date/time, partial date or period when the media file was generated or authored.</items>
                                  <items id="text">Created</items>
                                </term_definitions>
                                <term_definitions code="at0005">
                                  <items id="description">Narrative description about the media file.</items>
                                  <items id="text">Description</items>
                                </term_definitions>
                                <term_definitions code="at0007">
                                  <items id="description">Additional narrative about the media file not captured in other fields.</items>
                                  <items id="text">Comment</items>
                                </term_definitions>
                                <term_definitions code="at0010">
                                  <items id="description">Unique ID for the media file.</items>
                                  <items id="text">Identifier</items>
                                </term_definitions>
                                <term_definitions code="at0011">
                                  <items id="comment">For example: the camera used to capture an image.</items>
                                  <items id="description">Details about the device used to generate or author the media file.</items>
                                  <items id="text">Source device</items>
                                </term_definitions>
                                <term_definitions code="at0012">
                                  <items id="description">Details about the individual or organisation who generated or authored the media file.</items>
                                  <items id="text">Creator</items>
                                </term_definitions>
                                <term_definitions code="at0013">
                                  <items id="description">Additional structured details about the media file.</items>
                                  <items id="text">Additional details</items>
                                </term_definitions>
                              </children>
                              <cardinality>
                                <is_ordered>false</is_ordered>
                                <is_unique>false</is_unique>
                                <interval>
                                  <lower_included>true</lower_included>
                                  <lower_unbounded>false</lower_unbounded>
                                  <upper_unbounded>true</upper_unbounded>
                                  <lower>1</lower>
                                </interval>
                              </cardinality>
                            </attributes>
                            <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                              <rm_attribute_name>name</rm_attribute_name>
                              <existence>
                                <lower_included>true</lower_included>
                                <upper_included>true</upper_included>
                                <lower_unbounded>false</lower_unbounded>
                                <upper_unbounded>false</upper_unbounded>
                                <lower>1</lower>
                                <upper>1</upper>
                              </existence>
                              <children xsi:type="C_COMPLEX_OBJECT">
                                <rm_type_name>DV_TEXT</rm_type_name>
                                <occurrences>
                                  <lower_included>true</lower_included>
                                  <upper_included>true</upper_included>
                                  <lower_unbounded>false</lower_unbounded>
                                  <upper_unbounded>false</upper_unbounded>
                                  <lower>1</lower>
                                  <upper>1</upper>
                                </occurrences>
                                <node_id/>
                                <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                                  <rm_attribute_name>value</rm_attribute_name>
                                  <existence>
                                    <lower_included>true</lower_included>
                                    <upper_included>true</upper_included>
                                    <lower_unbounded>false</lower_unbounded>
                                    <upper_unbounded>false</upper_unbounded>
                                    <lower>1</lower>
                                    <upper>1</upper>
                                  </existence>
                                  <children xsi:type="C_PRIMITIVE_OBJECT">
                                    <rm_type_name>STRING</rm_type_name>
                                    <occurrences>
                                      <lower_included>true</lower_included>
                                      <upper_included>true</upper_included>
                                      <lower_unbounded>false</lower_unbounded>
                                      <upper_unbounded>false</upper_unbounded>
                                      <lower>1</lower>
                                      <upper>1</upper>
                                    </occurrences>
                                    <node_id/>
                                    <item xsi:type="C_STRING">
                                      <list>Variant detail</list>
                                    </item>
                                  </children>
                                </attributes>
                              </children>
                            </attributes>
                            <archetype_id>
                              <value>openEHR-EHR-CLUSTER.genomic_variant_result.v1</value>
                            </archetype_id>
                            <term_definitions code="at0000">
                              <items id="description">Findings and annotations related to one variant found in a human individual by a sequencing test.</items>
                              <items id="text">Genomic variant result</items>
                            </term_definitions>
                            <term_definitions code="at0001">
                              <items id="description">Structured details about the bioinformatic analysis workflow or the protocol that is used.</items>
                              <items id="text">Bioinformatic analysis workflow</items>
                            </term_definitions>
                            <term_definitions code="at0002">
                              <items id="comment">For example: 'GCF_000001405.38'.

Source name: 'NCBI'.
Accession number: 'GCF_000001405'.
Version number: 'GCF_000001405.38'.
URL: 'https://www.ncbi.nlm.nih.gov/assembly/GCF_000001405.38/'.</items>
                              <items id="description">Structured details about the specific version of the human sequence assembly used for annotation.</items>
                              <items id="text">Reference genome</items>
                            </term_definitions>
                            <term_definitions code="at0008">
                              <items id="description">Structured details about the transcript which is potentially affected by the variant.</items>
                              <items id="text">Transcript</items>
                            </term_definitions>
                            <term_definitions code="at0009">
                              <items id="comment">For example: 
Source name: 'NCBI'.
Accession number: 'NM_015557'.
Version number: 'NM_015557.2'.
URL: 'https://www.ncbi.nlm.nih.gov/nuccore/304361774'.</items>
                              <items id="description">Structured details about the transcribed reference sequence.</items>
                              <items id="text">Transcript reference sequence</items>
                            </term_definitions>
                            <term_definitions code="at0010">
                              <items id="comment">For example: 'exon number', 'intron number', 'splice site' or other.</items>
                              <items id="description">The human readable name for the region of interest.</items>
                              <items id="text">DNA region name</items>
                            </term_definitions>
                            <term_definitions code="at0011">
                              <items id="comment">For example: 'c.5249C>T'.</items>
                              <items id="description">Description of the variation at the DNA level following the HGVS nomenclature.</items>
                              <items id="text">DNA change</items>
                            </term_definitions>
                            <term_definitions code="at0012">
                              <items id="comment">For example: 'p.T1750M'.</items>
                              <items id="description">Description of the variation at the protein level following the HGVS nomenclature.</items>
                              <items id="text">Amino acid change</items>
                            </term_definitions>
                            <term_definitions code="at0013">
                              <items id="description">Codified type for associated amino acid marker.</items>
                              <items id="text">Amino acid change type</items>
                            </term_definitions>
                            <term_definitions code="at0015">
                              <items id="description">Estimate of the effects that the variant may have on the transcript.</items>
                              <items id="text">Predicted impact</items>
                            </term_definitions>
                            <term_definitions code="at0016">
                              <items id="comment">For example 'CADD', 'SIFT', etc.</items>
                              <items id="description">Structured details about the reference used to calculate the predicted impact.</items>
                              <items id="text">Predicted impact knowledge base</items>
                            </term_definitions>
                            <term_definitions code="at0017">
                              <items id="comment">For example: '30.2'.</items>
                              <items id="description">The calculated value.</items>
                              <items id="text">Score</items>
                            </term_definitions>
                            <term_definitions code="at0018">
                              <items id="comment">For example: 'probably damaging'.</items>
                              <items id="description">Human readable version of the predicted impact.</items>
                              <items id="text">Qualitative prediction</items>
                            </term_definitions>
                            <term_definitions code="at0019">
                              <items id="description">Structured details about the gene carrying the variant.</items>
                              <items id="text">Gene</items>
                            </term_definitions>
                            <term_definitions code="at0020">
                              <items id="comment">For example 'CHD5'.</items>
                              <items id="description">The official gene symbol approved by the HGNC, which is a short abbreviated form of the gene name.</items>
                              <items id="text">Gene symbol</items>
                            </term_definitions>
                            <term_definitions code="at0021">
                              <items id="comment">For example 'Chromodomain helicase DNA binding protein 5'.</items>
                              <items id="description">The full gene name approved by the HGNC that conveys the character or function of the gene.</items>
                              <items id="text">Gene name</items>
                            </term_definitions>
                            <term_definitions code="at0023">
                              <items id="comment">For example: 'ENST00000413998.7'.</items>
                              <items id="description">The ID of the transcript with the highest predicted impact.</items>
                              <items id="text">Best transcript candidate</items>
                            </term_definitions>
                            <term_definitions code="at0024">
                              <items id="description">Structured details about the evolutionary conservation.</items>
                              <items id="text">Conservation</items>
                            </term_definitions>
                            <term_definitions code="at0025">
                              <items id="comment">For example 'PhastCons7-way'.</items>
                              <items id="description">Structured details about the reference used to calculate the conservation score.</items>
                              <items id="text">Conservation score knowledge base</items>
                            </term_definitions>
                            <term_definitions code="at0026">
                              <items id="description">The conservation score.</items>
                              <items id="text">Score</items>
                            </term_definitions>
                            <term_definitions code="at0028">
                              <items id="description">The number of reads that support the reported variant.</items>
                              <items id="text">Allele depth</items>
                            </term_definitions>
                            <term_definitions code="at0029">
                              <items id="description">The relative frequency of a particular allele in the population.</items>
                              <items id="text">Population allele frequency details</items>
                            </term_definitions>
                            <term_definitions code="at0030">
                              <items id="description">Structured details about the database used to calculate the allele frequency.</items>
                              <items id="text">Population allele frequency knowledge base</items>
                            </term_definitions>
                            <term_definitions code="at0031">
                              <items id="comment">For example: '0.43'.</items>
                              <items id="description">The population allele frequency.</items>
                              <items id="text">Population allele frequency</items>
                            </term_definitions>
                            <term_definitions code="at0039">
                              <items id="comment">The format for the genotype should be value separated by either of / or | (0 for the reference allele, 1 for the first alternate, etc.). For example: '1 | 0' or '0/0/1'.</items>
                              <items id="description">Genotype encoded as allele values.</items>
                              <items id="text">Genotype</items>
                            </term_definitions>
                            <term_definitions code="at0040">
                              <items id="comment">This is the human readable version of genotype, e.g.: 'Heterozygous', 'Homozygous'.</items>
                              <items id="description">The level of occurrence of a single DNA marker within a set of chromosomes.</items>
                              <items id="text">Allelic state</items>
                            </term_definitions>
                            <term_definitions code="at0041">
                              <items id="description">Conditional genotype quality, encoded as a Phred quality.</items>
                              <items id="text">Genotype quality</items>
                            </term_definitions>
                            <term_definitions code="at0045">
                              <items id="comment">This element is set to multiple occurrence to allow templates to be built with several different variant types allowed. However, when storing data, there should never be more than one CLUSTER archetype inserted here.

If both this SLOT and the 'Variant' data element are used simultaneously, they need to represent identical data.</items>
                              <items id="description">Structured description of the genomic variant.</items>
                              <items id="text">Structured variant</items>
                            </term_definitions>
                            <term_definitions code="at0047">
                              <items id="comment">For example: '0.63'.</items>
                              <items id="description">The relative frequency of an allele at a particular locus.</items>
                              <items id="text">Allele frequency</items>
                            </term_definitions>
                            <term_definitions code="at0052">
                              <items id="description">Interpretation of the variation linked to a specific paper.</items>
                              <items id="text">Functional impact</items>
                            </term_definitions>
                            <term_definitions code="at0053">
                              <items id="description">The reference to the specific research paper.</items>
                              <items id="text">Source</items>
                            </term_definitions>
                            <term_definitions code="at0054">
                              <items id="comment">For example: 'activating', 'deactivating', 'dysfunction', 'gain of function'. Coding with a terminology is preferred, where possible.</items>
                              <items id="description">Single word or phrase describing the reported impact of the specific variant.</items>
                              <items id="text">Impact</items>
                            </term_definitions>
                            <term_definitions code="at0056">
                              <items id="description">The fraction of gene region covered by copy number.</items>
                              <items id="text">Copy number overlap</items>
                            </term_definitions>
                            <term_definitions code="at0057">
                              <items id="description">States if the gene is part of a fusion gene and if it is the first or second part of the fusion gene.</items>
                              <items id="text">Part of fusion</items>
                            </term_definitions>
                            <term_definitions code="at0058">
                              <items id="description">The clinical significance according to the ACMG recommendations.</items>
                              <items id="text">ACMG classification</items>
                            </term_definitions>
                            <term_definitions code="at0059">
                              <items id="description">The number of the exon which is part of the fusion.</items>
                              <items id="text">Fusion exon</items>
                            </term_definitions>
                            <term_definitions code="at0060">
                              <items id="description">The total number of reads mapped at this specific location.</items>
                              <items id="text">Read depth</items>
                            </term_definitions>
                            <term_definitions code="at0061">
                              <items id="comment">This field is derived from the FILTER column of VCF.</items>
                              <items id="description">Structured details about the quality filters that have been applied to the data.</items>
                              <items id="text">VCF quality filter</items>
                            </term_definitions>
                            <term_definitions code="at0062">
                              <items id="comment">For example: 'q10'.</items>
                              <items id="description">Name of the quality filter.</items>
                              <items id="text">Filter name</items>
                            </term_definitions>
                            <term_definitions code="at0063">
                              <items id="comment">For example: 'at this site the quality is below 10'.</items>
                              <items id="description">Quality filter extended description.</items>
                              <items id="text">Description</items>
                            </term_definitions>
                            <term_definitions code="at0064">
                              <items id="comment">Record as 'True' if the filter was passed.</items>
                              <items id="description">Did the variant pass the quality filter?</items>
                              <items id="text">Filter passed</items>
                            </term_definitions>
                            <term_definitions code="at0067">
                              <items id="description">The ratio of the strand bias.</items>
                              <items id="text">Strand bias ratio</items>
                            </term_definitions>
                            <term_definitions code="at0068">
                              <items id="description">The Phred-scaled p-value of the strand bias.</items>
                              <items id="text">Strand bias p-value</items>
                            </term_definitions>
                            <term_definitions code="at0069">
                              <items id="description">A comma separated list of the log10-scaled genotype likelihoods for all possible genotypes, given the reference and the alternate alleles.</items>
                              <items id="text">Genotype probability</items>
                            </term_definitions>
                            <term_definitions code="at0070">
                              <items id="comment">In some situations, a single OBSERVATION.laboratory_test_result archetype will contain multiple CLUSTER.specimen archetypes and multiple CLUSTER.genomic_variant_result archetypes. In these situations, this 'Specimen identifier' data element is needed to be able to connect the results with the correct specimens.</items>
                              <items id="description">Identification of the specimen used for the genomic result.</items>
                              <items id="text">Specimen identifier</items>
                            </term_definitions>
                            <term_definitions code="at0071">
                              <items id="description">Pathogenic variant.</items>
                              <items id="text">Pathogenic</items>
                            </term_definitions>
                            <term_definitions code="at0072">
                              <items id="description">Likely pathogenic variant.</items>
                              <items id="text">Likely pathogenic</items>
                            </term_definitions>
                            <term_definitions code="at0073">
                              <items id="description">Variant of uncertain significance.</items>
                              <items id="text">Uncertain significance</items>
                            </term_definitions>
                            <term_definitions code="at0074">
                              <items id="description">Likely benign variant.</items>
                              <items id="text">Likely benign</items>
                            </term_definitions>
                            <term_definitions code="at0075">
                              <items id="description">Benign variant.</items>
                              <items id="text">Benign</items>
                            </term_definitions>
                            <term_definitions code="at0076">
                              <items id="description">Heteroplasmic.</items>
                              <items id="text">Heteroplasmic</items>
                            </term_definitions>
                            <term_definitions code="at0077">
                              <items id="description">Homoplasmic.</items>
                              <items id="text">Homoplasmic</items>
                            </term_definitions>
                            <term_definitions code="at0078">
                              <items id="description">Homozygous.</items>
                              <items id="text">Homozygous</items>
                            </term_definitions>
                            <term_definitions code="at0079">
                              <items id="description">Heterozygous.</items>
                              <items id="text">Heterozygous</items>
                            </term_definitions>
                            <term_definitions code="at0080">
                              <items id="description">Hemizygous.</items>
                              <items id="text">Hemizygous</items>
                            </term_definitions>
                            <term_definitions code="at0085">
                              <items id="description">The sequence at a given position is identical to the reference sequence.</items>
                              <items id="text">Wild type</items>
                            </term_definitions>
                            <term_definitions code="at0086">
                              <items id="description">A deletion in the amino acid sequence.</items>
                              <items id="text">Deletion</items>
                            </term_definitions>
                            <term_definitions code="at0087">
                              <items id="description">A duplication in the amino acid sequence.</items>
                              <items id="text">Duplication</items>
                            </term_definitions>
                            <term_definitions code="at0088">
                              <items id="description">A frameshift in the amino acid sequence.</items>
                              <items id="text">Frameshift</items>
                            </term_definitions>
                            <term_definitions code="at0089">
                              <items id="description">A variant in a sequence affecting the translation initiation codon.</items>
                              <items id="text">Initiating methionine</items>
                            </term_definitions>
                            <term_definitions code="at0090">
                              <items id="description">An insertion in the amino acid sequence.</items>
                              <items id="text">Insertion</items>
                            </term_definitions>
                            <term_definitions code="at0091">
                              <items id="description">An insertion/deletion in the amino acid sequence.</items>
                              <items id="text">Insertion and deletion</items>
                            </term_definitions>
                            <term_definitions code="at0092">
                              <items id="description">One amino acid is replaced by another amino acid.</items>
                              <items id="text">Missense</items>
                            </term_definitions>
                            <term_definitions code="at0093">
                              <items id="description">An amino acid is replaced by a translational stop codon (termination codon).</items>
                              <items id="text">Nonsense</items>
                            </term_definitions>
                            <term_definitions code="at0094">
                              <items id="description">A variant in a DNA sequence that does not change the amino acid sequence of the encoded protein.</items>
                              <items id="text">Silent</items>
                            </term_definitions>
                            <term_definitions code="at0095">
                              <items id="description">A variant in a sequence affecting the translational stop codon.</items>
                              <items id="text">Stop codon mutation</items>
                            </term_definitions>
                            <term_definitions code="at0096">
                              <items id="description">First part of a fusion gene.</items>
                              <items id="text">First</items>
                            </term_definitions>
                            <term_definitions code="at0097">
                              <items id="description">Second part of a fusion gene.</items>
                              <items id="text">Second</items>
                            </term_definitions>
                            <term_definitions code="at0098">
                              <items id="description">Additional details to be captured.</items>
                              <items id="text">Additional details</items>
                            </term_definitions>
                            <term_definitions code="at0099">
                              <items id="description">Distance in nucleotides between mutation and exon–intron junction.</items>
                              <items id="text">Distance from splicing site</items>
                            </term_definitions>
                            <term_definitions code="at0100">
                              <items id="comment">For example: 'r.76a>u'.</items>
                              <items id="description">Description of the variation at the RNA level following the HGVS nomenclature.</items>
                              <items id="text">RNA change</items>
                            </term_definitions>
                            <term_definitions code="at0101">
                              <items id="comment">For example: 'g.33038255C>A'.

If both this element and the 'Structured variant' SLOT are used simultaneously, they need to represent identical data.</items>
                              <items id="description">Description of the variation at the genomic level following the HGVS nomenclature.</items>
                              <items id="text">Variant</items>
                            </term_definitions>
                            <term_definitions code="at0102">
                              <items id="comment">For example: 'rs123456' (Item name) from 'dbSNP' (Knowledge base name) 'version 151' (Knowledge base version). This CLUSTER.knowledge_base_reference archetype is repeatable to allow several different IDs from different databases for the same variant.</items>
                              <items id="description">A reference to a specific variation recorded into an external biological variation database.</items>
                              <items id="text">Variant identification</items>
                            </term_definitions>
