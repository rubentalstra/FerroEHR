                        <archetype_id>
                          <value>openEHR-EHR-CLUSTER.pharmacogenetic_result.v0</value>
                        </archetype_id>
                        <term_definitions code="at0000">
                          <items id="description">Findings on pharmacogenetic testing for a single gene.</items>
                          <items id="text">Pharmacogenetic result</items>
                        </term_definitions>
                        <term_definitions code="at0003">
                          <items id="comment">Coding with an external terminology is preferred, where possible.

Preferably this should be coded with terms from the HGNC (HUGO Gene Nomenclature Committee) nomenclature, using 'http://www.genenames.org' as the terminology identifier.

For example: 'http://www.genenames.org::CYP2C9 | CYP2C9 |'.</items>
                          <items id="description">The official gene symbol approved by the HGNC, which is a short abbreviated form of the gene name.</items>
                          <items id="text">Gene symbol</items>
                        </term_definitions>
                        <term_definitions code="at0004">
                          <items id="comment">For example: 'g.94938683A>G' (Gene changes) or '*1/*36' (Star allele diplotype).</items>
                          <items id="description">A textual representation of the diplotype, normally as string of characters, either as as gene change descriptors or star allele diplotypes.</items>
                          <items id="text">Diplotype</items>
                        </term_definitions>
                        <term_definitions code="at0052">
                          <items id="comment">The coded text values are based on CPIC phenotype recommendations - see https://www.ncbi.nlm.nih.gov/pmc/articles/PMC5253119/.

It is possible to add other coded text values when they are required.</items>
                          <items id="description">The estimated pharmacological impact of the identified genotype.</items>
                          <items id="text">Phenotype</items>
                        </term_definitions>
                        <term_definitions code="at0053">
                          <items id="description">The metaboliser status is normal.</items>
                          <items id="text">Normal metaboliser</items>
                        </term_definitions>
                        <term_definitions code="at0054">
                          <items id="description">The metaboliser status is rapid.</items>
                          <items id="text">Rapid metaboliser</items>
                        </term_definitions>
                        <term_definitions code="at0055">
                          <items id="description">The metaboliser status is ultrarapid.</items>
                          <items id="text">Ultrarapid metaboliser</items>
                        </term_definitions>
                        <term_definitions code="at0056">
                          <items id="description">The metaboliser status is intermediate.</items>
                          <items id="text">Intermediate metaboliser</items>
                        </term_definitions>
                        <term_definitions code="at0057">
                          <items id="description">The metaboliser status is poor.</items>
                          <items id="text">Poor metaboliser</items>
                        </term_definitions>
                        <term_definitions code="at0080">
                          <items id="comment">For example: '0.5'.</items>
                          <items id="description">An associated derived activity score, based on known association with specific genotypes and individual allele activity values, which is required to assess metaboliser status for some phenotypes.</items>
                          <items id="text">Overall activity score</items>
                        </term_definitions>
                        <term_definitions code="at0084">
                          <items id="description">A list of enzyme activity values each associated with a specific allele, which are used to derive the Overall activity score.</items>
                          <items id="text">Individual activity value</items>
                        </term_definitions>
                        <term_definitions code="at0085">
                          <items id="comment">For example: '0.5'.</items>
                          <items id="description">An associated derived activity score, based on known association with specific genotypes, which is required to assess metaboliser status for some phenotypes.</items>
                          <items id="text">Activity value</items>
                        </term_definitions>
                        <term_definitions code="at0086">
                          <items id="comment">For example: '*36'.</items>
                          <items id="description">The allele haplotype descriptor associated with the activity value.</items>
                          <items id="text">Allele haplotype</items>
                        </term_definitions>
                        <term_definitions code="at0087">
                          <items id="description">Functional activity is increased.</items>
                          <items id="text">Increased function</items>
                        </term_definitions>
                        <term_definitions code="at0088">
                          <items id="description">Functional activity is decreased.</items>
                          <items id="text">Decreased function</items>
                        </term_definitions>
                        <term_definitions code="at0089">
                          <items id="description">Functional activity is normal.</items>
                          <items id="text">Normal function</items>
                        </term_definitions>
                        <term_definitions code="at0090">
                          <items id="description">Functional activity is poor.</items>
                          <items id="text">Poor function</items>
                        </term_definitions>
                        <term_definitions code="at0091">
                          <items id="description">Negative test for risk alleles.</items>
                          <items id="text">Negative</items>
                        </term_definitions>
                        <term_definitions code="at0092">
                          <items id="description">Positive test for risk alleles.</items>
                          <items id="text">Positive</items>
                        </term_definitions>
                        <term_definitions code="at0093">
                          <items id="description">Normal risk of aminoglycoside-induced hearing loss.</items>
                          <items id="text">Normal risk of aminoglycoside-induced hearing loss</items>
                        </term_definitions>
                        <term_definitions code="at0094">
                          <items id="description">Increased risk of aminoglycoside-induced hearing loss.</items>
                          <items id="text">Increased risk of aminoglycoside-induced hearing loss</items>
                        </term_definitions>
                        <term_definitions code="at0095">
                          <items id="description">Uncertain risk of aminoglycoside-induced hearing loss.</items>
                          <items id="text">Uncertain risk of aminoglycoside-induced hearing loss</items>
                        </term_definitions>
                        <term_definitions code="at0096">
                          <items id="description">Details of variant findings.</items>
                          <items id="text">Variant detail</items>
                        </term_definitions>
                        <term_definitions code="at0097">
                          <items id="description">A list of the specific alleles tested by this pharmacogenetic test, as the specific alleles may vary between tests.</items>
                          <items id="text">Per-allele tested</items>
                        </term_definitions>
                        <term_definitions code="at0102">
                          <items id="comment">It is recommended to use the openEHR-EHR-CLUSTER.knowledge_base_reference.v1 archetype to carry the SNP rsNumber.

For example:

Knowledge base name: 'http://terminology.hl7.org/NamingSystem/v3-dbSNP'.

Item name: 'rs3918290'.</items>
                          <items id="description">The rsNumber (rs ID) of the allele tested, based on the dbSNP identifier.</items>
                          <items id="text">SNP rsNumber</items>
                        </term_definitions>
