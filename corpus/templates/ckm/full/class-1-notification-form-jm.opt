                                      <terminology_id>
                                        <value>SNOMED-CT</value>
                                      </terminology_id>
                                      <code_string>162434008</code_string>
                                    </value>
                                  </items>
                                  <items code="at0152">
                                    <value>
                                      <terminology_id>
                                        <value>SNOMED-CT</value>
                                      </terminology_id>
                                      <code_string>405795006</code_string>
                                    </value>
                                  </items>
                                </term_bindings>
                              </children>
                              <cardinality>
                                <is_ordered>false</is_ordered>
