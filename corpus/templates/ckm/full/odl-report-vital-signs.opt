          <items id="text">Intravenous</items>
        </term_definitions>
        <term_definitions code="at0.113">
          <items id="description">The insulin was administered subcutaneously.</items>
          <items id="text">Subcutaneous</items>
        </term_definitions>
        <term_definitions code="at0.89">
