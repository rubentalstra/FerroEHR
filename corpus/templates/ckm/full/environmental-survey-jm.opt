    <term_definitions code="at0000">
      <items id="description">Details about environmental factors related to the local community and built environment that impact health.</items>
      <items id="text">Environmental survey</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="description">*</items>
      <items id="text">ITEM_TREE</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="description">The type of setting in which an individual lives or works.</items>
      <items id="text">Urban setting</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="description">Within an area of high population density relative to other areas, often characterised by a relatively high presence of administrative structures, government services and other infrastructure.</items>
      <items id="text">Urban</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="description">Location with mixed urban and rural characteristics, often on the outskirts of cities or large urban areas.</items>
      <items id="text">Peri-urban</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="description">Within an area of low population density relative to other areas, often characterised by low presence of administrative structures, government services and other infrastructure. Livelihood is predominantly centred on agricultural production.</items>
      <items id="text">Rural</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="description">The type of water supply to the local area.</items>
      <items id="text">Water supply</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="description">*</items>
      <items id="text">Piped</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="description">*</items>
      <items id="text">Stored</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="description">Indication of solid waste collection frequency.</items>
      <items id="text">Waste collection frequency</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="description">At least once weekly.</items>
      <items id="text">Frequent</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="description">Less than once weekly.</items>
      <items id="text">Infrequent</items>
    </term_definitions>
    <term_definitions code="at0012">
      <items id="comment">For example: the genus, subgenus or species, such as Aedes or, more specifically Aeded aegypti and Aedes albopictus.</items>
      <items id="description">Type of mosquitoes found in the local area.</items>
      <items id="text">Mosquito population</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="description">The level of planning in the local area or community.</items>
      <items id="text">Community planning</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="description">*</items>
      <items id="text">Planned</items>
    </term_definitions>
    <term_definitions code="at0015">
      <items id="description">*</items>
      <items id="text">Unplanned</items>
    </term_definitions>
    <term_definitions code="at0016">
      <items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items>
      <items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items>
      <items id="text">Extension</items>
    </term_definitions>
    <term_definitions code="at0017">
      <items id="description">The date when the environmental survey was last updated.</items>
      <items id="text">Last updated</items>
    </term_definitions>
    <term_definitions code="at0018">
      <items id="comment">For example, community facilities, infrastructure, or the built environment.</items>
      <items id="description">Narrative description about the local environment.</items>
      <items id="text">Description</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="description">Narrative description about the environmental survey, not captured in other fields.</items>
      <items id="text">Comment</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="description">*</items>
      <items id="text">ITEM_TREE</items>
    </term_definitions>
  </definition>
