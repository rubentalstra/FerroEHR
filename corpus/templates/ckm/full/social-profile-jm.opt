                    <archetype_id>
                      <value>openEHR-EHR-CLUSTER.structured_name.v1</value>
                    </archetype_id>
                    <template_id>
                      <value>Structured name - JM Full</value>
                    </template_id>
                    <term_definitions code="at0000">
                      <items id="description">Discrete components of an individual's name.</items>
                      <items id="text">Structured name of a person</items>
                    </term_definitions>
                    <term_definitions code="at0001">
                      <items id="comment">Occurrences for this data element are set to 0..* to allow for more than one Title to be recorded. Coding with an external terminology is preferred, where possible. For example: 'Doctor'; 'Ms'; 'Mx'; or 'Professor Dr'.</items>
                      <items id="description">One or more honorific form(s) of address commencing a name.</items>
                      <items id="text">Title</items>
                    </term_definitions>
                    <term_definitions code="at0002">
                      <items id="comment">Occurrences for this data element are set to 0..* to allow for more than one Given name to be recorded. In addition, this data element may be cloned and renamed within a template to allow discrete recording of different types of Given name - for example 'First name', 'Middle name', 'Preferred name' or 'Nickname', as required for a specific use case.</items>
                      <items id="description">One or more unique name(s) used to identify an individual within a family group.</items>
                      <items id="text">Given name</items>
                    </term_definitions>
                    <term_definitions code="at0005">
                      <items id="comment">Also known as 'Last name' or 'Surname'. Occurrences for this data element are set to 0..* to allow for more than one Family name to be recorded. Complex names such as 'El Haddad' or 'van der Heyden' can be recorded using this naming pattern, as identified in ISO 22220 (Annex F), but for the intended use case for this archetype it is most likely that the full family name will be recorded as a string.</items>
                      <items id="description">One or more name(s) that an individual has in common with a family group.</items>
                      <items id="text">Family name</items>
                    </term_definitions>
                    <term_definitions code="at0006">
                      <items id="comment">Occurrences for this data element are set to 0..* to allow for more than one Suffix to be recorded. Coding with an external terminology is preferred, where possible. For example: 'Junior (Jr)'; 'Senior (Sr)'; 'Second (II)'.</items>
                      <items id="description">One or more term(s) placed after all other name components, usually to differentiate an individual from a family member with identical Given and Family name components.</items>
                      <items id="text">Suffix</items>
                    </term_definitions>
                  </children>
