        <archetype_id>
          <value>openEHR-EHR-EVALUATION.education_summary.v1</value>
        </archetype_id>
        <template_id>
          <value>Education summary - JM</value>
        </template_id>
        <term_definitions code="at0000">
          <items id="description">Summary or persistent information about an individual's current and past education or training.</items>
          <items id="text">Education summary</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="comment">Coding with a terminology is desirable, where possible. For example: the ISCED classification, such as upper secondary vocational education; post-secondary non-tertiary vocational education; Bachelor’s or equivalent level, professional; Doctoral or equivalent level, academic; post-secondary non-tertiary vocational education; or never attended an educational program.</items>
          <items id="description">Description of highest category of education or training completed.</items>
          <items id="text">Highest level completed</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="comment">In the context of this archetype, formal education includes all education that is based on a structured curriculum and delivered by trained professionals.</items>
          <items id="description">Age when an individual first commenced formal education.</items>
          <items id="text">Age started</items>
        </term_definitions>
        <term_definitions code="at0007">
          <items id="description">Additional narrative about an individual's education, not captured in other fields.</items>
          <items id="text">Comment</items>
        </term_definitions>
        <term_definitions code="at0018">
          <items id="description">Narrative description about the overall education or training history of an individual.</items>
          <items id="text">Description</items>
        </term_definitions>
        <term_definitions code="at0026">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0027">
          <items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items>
          <items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items>
          <items id="text">Extension</items>
        </term_definitions>
        <term_definitions code="at0028">
          <items id="comment">At implementation, it is assumed that if an associated education record is added or updated then this date will also be updated.</items>
          <items id="description">The date that this education summary was last updated.</items>
          <items id="text">Last updated</items>
        </term_definitions>
        <term_definitions code="at0029">
          <items id="description">Structured details about each education or training, both current and past.</items>
          <items id="text">Education record</items>
        </term_definitions>
        <term_definitions code="at0030">
          <items id="comment">For example: 'Special education needs'.</items>
          <items id="description">Additional details about the education or training, or previous education history of an individual.</items>
          <items id="text">Additional details</items>
        </term_definitions>
        <term_definitions code="at0031">
          <items id="comment">Usually only recorded when an individual has not achieved a recognized level of formal education, such as an individual who left school at the age of 13.</items>
          <items id="description">Age when an individual last attended formal education.</items>
          <items id="text">Age ended</items>
        </term_definitions>
      </children>
