    <term_definitions code="at0000">
      <items id="description">Details about the gender of an individual.</items>
      <items id="text">Gender</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="comment">For example: 'male'; 'female'; or 'non-binary'. Coding with a terminology is recommended, where possible.</items>
      <items id="description">The individual's perception of their own gender.</items>
      <items id="text">Gender identity</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="description">@ internal @</items>
      <items id="text">Tree</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="description">@ internal @</items>
      <items id="text">Tree</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="description">The date this gender data was last updated.</items>
      <items id="text">Last updated</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items>
      <items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items>
      <items id="text">Extension</items>
    </term_definitions>
    <term_definitions code="at0014">
      <items id="description">Additional narrative about the individual's gender not captured in other data elements.</items>
      <items id="text">Comment</items>
    </term_definitions>
    <term_definitions code="at0019">
      <items id="comment">For example: 'Male', 'Female', 'Intersex'. Coding with a terminology is recommended, where possible. Use the element 'Comment' or the SLOT 'Details' if needed to register more specific details of the individuals gender.</items>
      <items id="description">The sex of an individual determined by anatomical characteristics observed and registered at birth.</items>
      <items id="text">Sex assigned at birth</items>
    </term_definitions>
    <term_definitions code="at0020">
      <items id="comment">For example: 'she'; 'he'; 'they'; or 'ze'. Coding with a terminology is recommended, where possible.</items>
      <items id="description">The pronoun an individual chooses to identify with, and would prefer others to use when talking to or about that individual.</items>
      <items id="text">Preferred pronoun</items>
    </term_definitions>
    <term_definitions code="at0022">
      <items id="comment">This element is what most systems today describes as 'Sex' or 'Gender'. For example 'Male', 'Female', 'Other'. This aligns with HL7 FHIR 'Person.gender'. Coding with a terminology is recommended, where possible.</items>
      <items id="description">The gender of an individual used for administrative purposes.</items>
      <items id="text">Administrative gender</items>
    </term_definitions>
    <term_definitions code="at0023">
      <items id="comment">Additional structured details about the gender of an individual.</items>
      <items id="description">Additional structured details about the individuals gender.</items>
      <items id="text">Additional details</items>
    </term_definitions>
    <term_definitions code="at0025">
      <items id="comment">For example 'Masculine', 'Feminine', 'Androgynous' or 'Alternating'. Alternatively, a narrative description.</items>
      <items id="description">The expression of the gender by the individual as demonstrated by behaviour, speech, clothes or other external characteristics.</items>
      <items id="text">Gender expression</items>
    </term_definitions>
    <term_definitions code="at0026">
      <items id="comment">For example: identification documents such as birth certificate or passport.</items>
      <items id="description">The gender of an individual used for official or legal purposes.</items>
      <items id="text">Legal gender</items>
    </term_definitions>
  </definition>
