                      <items id="text">Sclera small</items>
                    </term_definitions>
                    <term_definitions code="at0034">
                      <items id="description">*</items>
                      <items id="text">Sclera vol. bleb</items>
                    </term_definitions>
                    <term_definitions code="at0035">
                      <items id="description">*</items>
                      <items id="text">Glaucoma dense</items>
                    </term_definitions>
                    <term_definitions code="at0036">
                      <items id="description">*</items>
                      <items id="text">Glaucoma Fast</items>
                    </term_definitions>
                    <term_definitions code="at0037">
                      <items id="description">Glaucoma optic nerve head.</items>
                      <items id="text">Glaucoma ONH</items>
                    </term_definitions>
                    <term_definitions code="at0038">
                      <items id="description">Glaucoma posterior pole.</items>
                      <items id="text">Glaucoma P. Pole</items>
                    </term_definitions>
                    <term_definitions code="at0039">
                      <items id="description">Glaucoma retinal nerve fiber layer.</items>
                      <items id="text">Glaucoma RNFL</items>
                    </term_definitions>
                    <term_definitions code="at0040">
                      <items id="description">*</items>
                      <items id="text">Retina 7 lines</items>
                    </term_definitions>
                    <term_definitions code="at0041">
                      <items id="description">*</items>
                      <items id="text">Retina dense</items>
                    </term_definitions>
                    <term_definitions code="at0042">
                      <items id="description">*</items>
                      <items id="text">Retina detail</items>
                    </term_definitions>
                    <term_definitions code="at0043">
                      <items id="description">*</items>
                      <items id="text">Retina fast</items>
                    </term_definitions>
                    <term_definitions code="at0044">
                      <items id="description">Retina fast high resolution.</items>
                      <items id="text">Retina Fast HR</items>
                    </term_definitions>
                    <term_definitions code="at0045">
                      <items id="description">Retina Lin HR.</items>
                      <items id="text">Retina Lin HR</items>
                    </term_definitions>
                    <term_definitions code="at0046">
                      <items id="description">Retina posterior pole.</items>
                      <items id="text">Retina P. Pole</items>
                    </term_definitions>
                    <term_definitions code="at0047">
                      <items id="description">Description of characteristics for a personalized scan.</items>
                      <items id="text">Custom scan</items>
                    </term_definitions>
                    <term_definitions code="at0048">
                      <items id="description">Defines the pattern used to scan structures inside the eye.</items>
                      <items id="text">Scan pattern</items>
                    </term_definitions>
                    <term_definitions code="at0049">
                      <items id="description">The scan depicts a circle around the eye structure to be studied.</items>
                      <items id="text">Radial</items>
                    </term_definitions>
                    <term_definitions code="at0050">
                      <items id="description">The scan is composed by a single section strategically acquired on the eye structure to be studied.</items>
                      <items id="text">Single</items>
                    </term_definitions>
                    <term_definitions code="at0051">
                      <items id="description">The scan it is comprised of multiple parallel frames. So that, it is possible to reconstruct volumetric structures.</items>
                      <items id="text">High speed multi-frame</items>
                    </term_definitions>
                    <term_definitions code="at0052">
                      <items id="description">Increases resolution of the scan. It is useful to analyze eye structures that provide many information in a small area, such as fovea or the optic nerve head.</items>
                      <items id="text">High resolution multi-frame</items>
                    </term_definitions>
                    <term_definitions code="at0053">
                      <items id="description">The scan comprises of several slices with the eye structure to be studied as axis in common. Those are uniformly distributed with different angles, so they describe the shape of a star.</items>
                      <items id="text">Star</items>
                    </term_definitions>
                    <term_definitions code="at0054">
                      <items id="description">Width of the frame (or diameter in case of circle scan pattern).</items>
                      <items id="text">Scan size (width or diameter)</items>
                    </term_definitions>
                    <term_definitions code="at0056">
                      <items id="description">Height of the frame.</items>
                      <items id="text">Scan size (height)</items>
                    </term_definitions>
                    <term_definitions code="at0057">
                      <items id="description">Number of sections included in the scan.</items>
                      <items id="text">Section scans</items>
                    </term_definitions>
                    <term_definitions code="at0058">
                      <items id="description">Eye structure in which the scan is centred.</items>
                      <items id="text">Position of scan pattern</items>
                    </term_definitions>
                    <term_definitions code="at0062">
                      <items id="description">Distance between sections scanned consecutively.</items>
                      <items id="text">Distance between sections</items>
                    </term_definitions>
                    <term_definitions code="at0064">
                      <items id="description">Identifies the type of analyses which must be obtained from the study.</items>
                      <items id="text">Study outcome</items>
                    </term_definitions>
                    <term_definitions code="at0065">
                      <items id="description">While the majority of ophthalmic tomography imagingconsists of sets of longitudinal images (also known as B scans or line scans), transverse images (also known as coronal or “en face” images) can also provide useful information in determining the full extent of the volume affected by pathology.</items>
                      <items id="text">Transverse image overview</items>
                    </term_definitions>
                    <term_definitions code="at0066">
                      <items id="description">The prognosis of some pathologies can be aided by a 3D visualization of the affected areas of the eye.</items>
                      <items id="text">3D reconstruction image analysis</items>
                    </term_definitions>
                    <term_definitions code="at0067">
                      <items id="description">Acquistion of simultaneous angiographies and OCT images.</items>
                      <items id="text">Video angiography</items>
                    </term_definitions>
                    <term_definitions code="at0068">
                      <items id="description">Thickness measurements of specific anatomic structures might be useful for detection of areas of the eye affected by inflamation or tissue loss.</items>
                      <items id="text">Thickness analysis</items>
                    </term_definitions>
                    <term_definitions code="at0069">
                      <items id="description">The study of the evolution on thickness from an eye structure can warn us about the progress of a specific disease.</items>
                      <items id="text">Thickness evolution along-time (follow-up)</items>
                    </term_definitions>
                    <term_definitions code="at0070">
                      <items id="description">Classification of measured thickness values, compared to a reference data defined by normative.</items>
                      <items id="text">Thickness classification (measured vs normative)</items>
                    </term_definitions>
                    <term_definitions code="at0071">
                      <items id="description">Comparison of thickness between different but symmetric eye structures.</items>
                      <items id="text">Asymmetry analysis</items>
                    </term_definitions>
                    <term_definitions code="at0072">
                      <items id="description">Acquisition method chosen to perform the ophthalmic tomography study. It is based on the Table CID 4210 of DICOM standard.</items>
                      <items id="text">Acquisition method</items>
                    </term_definitions>
                    <term_definitions code="at0073">
                      <items id="description">Corresponds to DICOM Code value A-00FBE.</items>
                      <items id="text">Optical Coherence Tomography Scanner</items>
                    </term_definitions>
                    <term_definitions code="at0074">
                      <items id="description">Corresponds to DICOM Code value R-FAB5A.</items>
                      <items id="text">Retinal Thickness Analyzer</items>
                    </term_definitions>
                    <term_definitions code="at0075">
                      <items id="description">Corresponds to DICOM Code value A-00E8B.</items>
                      <items id="text">Confocal Scanning Laser Ophthalmoscope</items>
                    </term_definitions>
                    <term_definitions code="at0076">
                      <items id="description">A slit reflected light microscope, which has the ability to form an image of the back scattered light from the eye in a sagittal plane. Scheimpflug cameras are able to achieve a wide depth of focus by employing the “Sheimpflug principle” where the lens and image planes are not parallel with each other. Rotating Sheimplug cameras are able to generate three-dimensional images and calculate measurements of the anterior chamber of the eye. Corresponds to DICOM Code value 111626.</items>
                      <items id="text">Scheimpflug Camera</items>
                    </term_definitions>
                    <term_definitions code="at0077">
                      <items id="description">Corresponds to DICOM Code value A-00E8C.</items>
                      <items id="text">Scanning Laser Polarimeter</items>
                    </term_definitions>
                    <term_definitions code="at0078">
                      <items id="description">A device that measures corneal anterior surface shape using elevation-based methods (stereographic and light slit-based). Rasterstereography images a grid pattern illuminating the fluorescein dyed tear film with 2 cameras to produce 3D. Slit-based devices scan the cornea, usually by rotation about the instrument axis centered on the cornea vertex. Corresponds to DICOM Code value 111945.</items>
                      <items id="text">Elevation-based corneal tomographer</items>
                    </term_definitions>
                    <term_definitions code="at0079">
                      <items id="description">A reflection-based device that projects a pattern of light onto the cornea and an image of the reflection of that pattern from the tear film is recorded in one video frame. Light patterns include the circular mire pattern (Placido disc) and spot matrix patterns. Sequential scanning of light spots reflected from the corneal surface is also used requiring multiple video frames for recording. Corresponds to DICOM Code value 111946.</items>
                      <items id="text">Reflection-based corneal topographer</items>
                    </term_definitions>
                    <term_definitions code="at0080">
                      <items id="description">An Interference-based device that projects a beam of light onto and through the cornea. Light reflected from within the cornea is combined with a reference beam giving rise to an interference pattern. Appropriately scanned, this imaging is used to construct 3-dimensional images of the cornea from anterior to posterior surfaces. E.g., swept source OCT. Corresponds to DICOM Code value 111947.</items>
                      <items id="text">Interferometry-based corneal tomographer</items>
                    </term_definitions>
