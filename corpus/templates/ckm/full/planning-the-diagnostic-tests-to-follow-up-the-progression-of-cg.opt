                    <term_definitions code="at0000">
                      <items id="description">Defines specific details about ophthalmic tomography studies.</items>
                      <items id="text">Acquisition details on ophthalmic tomography</items>
                    </term_definitions>
                    <term_definitions code="at0001">
                      <items id="description">Eye/s included in the study.</items>
                      <items id="text">Laterality</items>
                    </term_definitions>
                    <term_definitions code="at0002">
                      <items id="description">Left eye observation.</items>
                      <items id="text">Left eye</items>
                    </term_definitions>
                    <term_definitions code="at0003">
                      <items id="description">Right eye observation.</items>
                      <items id="text">Right eye</items>
                    </term_definitions>
                    <term_definitions code="at0004">
                      <items id="description">Test acquired on both eyes of the patient.</items>
                      <items id="text">Both eyes</items>
                    </term_definitions>
                    <term_definitions code="at0005">
                      <items id="description">Choice of a predefined scan patterns from the device to conduct the study.</items>
                      <items id="text">Predefined scans</items>
                    </term_definitions>
                    <term_definitions code="at0011">
                      <items id="description">Subject of study of the ophthalmic tomography.</items>
                      <items id="text">Study type</items>
                    </term_definitions>
                    <term_definitions code="at0012">
                      <items id="description">Study of anterior chamber angles.</items>
                      <items id="text">Angle</items>
                    </term_definitions>
                    <term_definitions code="at0013">
                      <items id="description">Study focusing on cornea of the eye.</items>
                      <items id="text">Cornea</items>
                    </term_definitions>
                    <term_definitions code="at0014">
                      <items id="description">Study focusing on eye sclera.</items>
                      <items id="text">Sclera</items>
                    </term_definitions>
                    <term_definitions code="at0015">
                      <items id="description">Study focusing on search glaucomatous defects.</items>
                      <items id="text">Glaucoma</items>
                    </term_definitions>
                    <term_definitions code="at0016">
                      <items id="description">Study focusing on eye retina.</items>
                      <items id="text">Retina</items>
                    </term_definitions>
                    <term_definitions code="at0017">
                      <items id="description">Study focusing on iris of the eye.</items>
                      <items id="text">Iris</items>
                    </term_definitions>
                    <term_definitions code="at0019">
                      <items id="description">Choice among predefined settings provided by the ophthalmic tomography for scanning the eye structure.</items>
                      <items id="text">Predefined scan</items>
                    </term_definitions>
                    <term_definitions code="at0020">
                      <items id="description">Anterior chamber angle: Angle 1.</items>
                      <items id="text">Angle 1 ACA</items>
                    </term_definitions>
                    <term_definitions code="at0021">
                      <items id="description">Anterior chamber angle: Angle 2.</items>
                      <items id="text">Angle 2 ACA</items>
                    </term_definitions>
                    <term_definitions code="at0022">
                      <items id="description">*</items>
                      <items id="text">Angle small</items>
                    </term_definitions>
                    <term_definitions code="at0023">
