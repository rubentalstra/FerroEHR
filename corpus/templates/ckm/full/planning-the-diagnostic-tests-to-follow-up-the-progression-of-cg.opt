                    <archetype_id>
                      <value>openEHR-EHR-CLUSTER.acquisition_details_on_eye_fundus_images.v0</value>
                    </archetype_id>
                    <term_definitions code="at0000">
                      <items id="description">Defines specific details about the acquisition of images from eye fundus.</items>
                      <items id="text">Acquisition details on eye fundus images</items>
                    </term_definitions>
                    <term_definitions code="at0001">
                      <items id="description">Method chosen to perform the funduscopic examination.</items>
                      <items id="text">Method</items>
                    </term_definitions>
                    <term_definitions code="at0002">
                      <items id="description">Study performed by direct ophthalmoscopy.</items>
                      <items id="text">Direct</items>
                    </term_definitions>
                    <term_definitions code="at0003">
                      <items id="description">Study of eye fundus by indirect ophthalmoscopy method.</items>
                      <items id="text">Indirect</items>
                    </term_definitions>
                    <term_definitions code="at0004">
                      <items id="description">Eye fundus viewing through biomicroscopy lens in contact to patient's eye surface.</items>
                      <items id="text">Contact lens biomicroscopy</items>
                    </term_definitions>
                    <term_definitions code="at0005">
                      <items id="description">Eye fundus viewing through biomicroscopy lens without contact to patient's eye surface.</items>
                      <items id="text">Non-contact lens biomicroscopy</items>
                    </term_definitions>
                    <term_definitions code="at0006">
                      <items id="description">Observation of retina through funduscopic images acquired by previous dilatation of patient's pupils.</items>
                      <items id="text">Mydriatic retinography</items>
                    </term_definitions>
                    <term_definitions code="at0007">
                      <items id="description">Observation of retina through funduscopic images acquired without previous dilatation of patient's pupils.</items>
                      <items id="text">Non-mydriatic retinography</items>
                    </term_definitions>
                    <term_definitions code="at0008">
                      <items id="description">Observation of the eye fundus using a fluorescent dye inyected to emphasize the blood vessels in the eye retina.</items>
                      <items id="text">Angiography</items>
                    </term_definitions>
                    <term_definitions code="at0011">
                      <items id="description">Limit on the number of attempts allowed to conduct the acquisition (doesn't compute if test is repeated by a specific recognized technical failure).</items>
                      <items id="text">Attempts Allowed</items>
                    </term_definitions>
                    <term_definitions code="at0020">
                      <items id="description">If true, the study includes a mosaic image that combines all eye fundus fields acquired into a single picture.</items>
                      <items id="text">Mosaic</items>
                    </term_definitions>
                    <term_definitions code="at0023">
                      <items id="description">Eye/s from which the eye fundus is examined.</items>
                      <items id="text">Laterality</items>
                    </term_definitions>
                    <term_definitions code="at0024">
                      <items id="description">Left eye observation.</items>
                      <items id="text">Left eye</items>
                    </term_definitions>
                    <term_definitions code="at0025">
                      <items id="description">Right eye observation.</items>
                      <items id="text">Right eye</items>
                    </term_definitions>
                    <term_definitions code="at0026">
                      <items id="description">Test acquired on both eyes of the patient.</items>
                      <items id="text">Both eyes</items>
                    </term_definitions>
                    <term_definitions code="at0027">
                      <items id="description">Anatomical structures from retina in which the study of eye fundus is focused.</items>
                      <items id="text">Zone of Retina</items>
                    </term_definitions>
                    <term_definitions code="at0029">
                      <items id="description">Specifies which fields from a specific subdivision of the retina are photographed in the study of eye fundus.</items>
                      <items id="text">Study Fields Photographed</items>
                    </term_definitions>
                    <term_bindings terminology="SNOMED-CT">
                      <items code="at0023">
