                      <items id="text">Sclera scan 08</items>
                    </term_definitions>
                    <term_definitions code="at0032">
                      <items id="description">*</items>
                      <items id="text">Sclera scan 11</items>
                    </term_definitions>
                    <term_definitions code="at0033">
