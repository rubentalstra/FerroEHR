    <term_definitions code="at0.1">
      <items id="description">The left eye was examined.</items>
      <items id="text">Left eye</items>
    </term_definitions>
    <term_definitions code="at0.10">
      <items id="description">Movement of the eye downward and laterally, towards the same side.</items>
      <items id="text">Abduction and depression</items>
    </term_definitions>
    <term_definitions code="at0.11">
      <items id="description">Movement of the eye medially, towards the opposite side.</items>
      <items id="text">Adduction</items>
    </term_definitions>
    <term_definitions code="at0.12">
      <items id="description">Movement of the eye upward and medially, towards the opposite side.</items>
      <items id="text">Adduction and elevation</items>
    </term_definitions>
    <term_definitions code="at0.13">
      <items id="description">Movement of the eye downward and medially, towards the opposite side.</items>
      <items id="text">Adduction and depression</items>
    </term_definitions>
    <term_definitions code="at0.14">
      <items id="description">Description of the range of movement in the identified direction of gaze.</items>
      <items id="text">Range</items>
    </term_definitions>
    <term_definitions code="at0.15">
      <items id="description">Description of the speed of movement in the identified direction of gaze.</items>
      <items id="text">Speed</items>
    </term_definitions>
    <term_definitions code="at0.16">
      <items id="description">Description of the smoothness of movement in the identified direction of gaze.</items>
      <items id="text">Smoothness</items>
    </term_definitions>
    <term_definitions code="at0.17">
      <items id="description">Presence of the red reflex.</items>
      <items id="text">Red reflex</items>
    </term_definitions>
    <term_definitions code="at0.18">
      <items id="description">The red reflex is observed.</items>
      <items id="text">Present</items>
    </term_definitions>
    <term_definitions code="at0.19">
      <items id="description">The red reflex is not present.</items>
      <items id="text">Absent</items>
    </term_definitions>
    <term_definitions code="at0.2">
      <items id="description">The right eye was examined.</items>
      <items id="text">Right eye</items>
    </term_definitions>
    <term_definitions code="at0.20">
      <items id="description">Presence of a squint.</items>
      <items id="text">Squint</items>
    </term_definitions>
    <term_definitions code="at0.21">
      <items id="description">A squint is observed.</items>
      <items id="text">Present</items>
    </term_definitions>
    <term_definitions code="at0.22">
      <items id="description">A squint is not present.</items>
      <items id="text">Absent</items>
    </term_definitions>
    <term_definitions code="at0.3">
      <items id="description">Narrative description about the extraocular muscle function.</items>
      <items id="text">Eye movement description</items>
    </term_definitions>
    <term_definitions code="at0.4">
      <items id="description">Detailed information about eye movement.</items>
      <items id="text">Movement detail</items>
    </term_definitions>
    <term_definitions code="at0.5">
      <items id="description">The direction of single eye movement.</items>
      <items id="text">Direction of gaze</items>
    </term_definitions>
    <term_definitions code="at0.6">
      <items id="description">Upward movement of the eye.</items>
      <items id="text">Elevation</items>
    </term_definitions>
    <term_definitions code="at0.7">
      <items id="description">Downward movement of the eye.</items>
      <items id="text">Depression</items>
    </term_definitions>
    <term_definitions code="at0.8">
      <items id="description">Movement of the eye laterally, towards the same side.</items>
      <items id="text">Abduction</items>
    </term_definitions>
    <term_definitions code="at0.9">
      <items id="description">Movement of the eye upward and laterally, towards the same side.</items>
      <items id="text">Abduction and elevation</items>
    </term_definitions>
    <term_definitions code="at0000">
      <items id="description">Findings observed during the physical examination of a body system or anatomical structure.</items>
      <items id="text">Examination findings</items>
    </term_definitions>
    <term_definitions code="at0000.1">
      <items id="description">Findings observed during the physical examination of a single eye.</items>
      <items id="text">Examination of an eye</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="comment">Coding of the system or structure examined with a terminology is preferred, where possible.</items>
      <items id="description">Identification of the examined body system or anatomical structure.</items>
      <items id="text">System or structure examined</items>
    </term_definitions>
    <term_definitions code="at0001.1">
      <items id="comment">Coding of the system or structure examined with a terminology is preferred, where possible.</items>
