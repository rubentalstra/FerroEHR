                    <term_definitions code="at0000">
                      <items id="description">Morphological findings obtained by microscopy of the human zygote during assisted reproduction treatment.</items>
                      <items id="text">Examination of a zygote</items>
                    </term_definitions>
                    <term_definitions code="at0001">
                      <items id="description">Size symmetry of pronuclei in a zygote.</items>
                      <items id="text">Pronuclear symmetry</items>
                    </term_definitions>
                    <term_definitions code="at0002">
                      <items id="description">Morphology of pronuclei in a zygote.</items>
                      <items id="text">Pronuclear morphology</items>
                    </term_definitions>
                    <term_definitions code="at0003">
                      <items id="description">Morphology of polar bodies in a zygote.</items>
                      <items id="text">Polar body morphology</items>
                    </term_definitions>
                    <term_definitions code="at0004">
                      <items id="description">Morphology of the cytoplasm in a zygote.</items>
                      <items id="text">Cytoplasmic morphology</items>
                    </term_definitions>
                    <term_definitions code="at0005">
                      <items id="description">Number of visible pronuclei in a zygote.</items>
                      <items id="text">Number of pronuclei</items>
                    </term_definitions>
                    <term_definitions code="at0011">
                      <items id="description">Evenly sized pronuclei.</items>
                      <items id="text">Symmetrical</items>
                    </term_definitions>
                    <term_definitions code="at0012">
                      <items id="description">Difference between pronuclear size.</items>
                      <items id="text">Non-symmetrical</items>
                    </term_definitions>
                    <term_definitions code="at0014">
                      <items id="description">Centrally located, juxtaposed pronuclei.</items>
                      <items id="text">Centrally juxtaposed</items>
                    </term_definitions>
                    <term_definitions code="at0015">
                      <items id="description">Separated pronuclei.</items>
                      <items id="text">Separated</items>
                    </term_definitions>
                    <term_definitions code="at0016">
                      <items id="description">Peripherally located pronuclei.</items>
                      <items id="text">Peripherally positioned</items>
                    </term_definitions>
                    <term_definitions code="at0017">
                      <items id="description">Juxtaposed polar bodies.</items>
                      <items id="text">Normal</items>
                    </term_definitions>
                    <term_definitions code="at0018">
                      <items id="description">Large angle between polar bodies.</items>
                      <items id="text">Separated</items>
                    </term_definitions>
                    <term_definitions code="at0019">
                      <items id="description">Distribution of nuclear precursor bodies in a zygote.</items>
                      <items id="text">Nucleolar precursor bodies</items>
                    </term_definitions>
                    <term_definitions code="at0020">
                      <items id="description">Several nuclear precursor bodies.</items>
                      <items id="text">Normal</items>
                    </term_definitions>
                    <term_definitions code="at0021">
                      <items id="description">Absent nuclear precursor body.</items>
                      <items id="text">Absent</items>
                    </term_definitions>
                    <term_definitions code="at0023">
                      <items id="description">Pronuclei with 1 nuclear precursor body.</items>
                      <items id="text">Bull's eye</items>
                    </term_definitions>
                    <term_definitions code="at0024">
                      <items id="description">Homogeneous cytoplasm.</items>
                      <items id="text">Homogeneous</items>
                    </term_definitions>
                    <term_definitions code="at0025">
                      <items id="description">Granular cytoplasm.</items>
                      <items id="text">Granular</items>
                    </term_definitions>
                    <term_definitions code="at0026">
                      <items id="description">Vacuolated cytoplasm, including small and large vacuoles.</items>
                      <items id="text">Vacuolated</items>
                    </term_definitions>
                    <term_definitions code="at0027">
                      <items id="description">Dysmorphic cytoplasm, including clustered organelles.</items>
                      <items id="text">Dysmorphic</items>
                    </term_definitions>
                    <term_definitions code="at0028">
                      <items id="description">Additional morphological features not captured by specific parameters.</items>
                      <items id="text">Other morphological features</items>
                    </term_definitions>
                    <term_definitions code="at0030">
                      <items id="description">Fragmented polar bodies.</items>
                      <items id="text">Fragmented</items>
                    </term_definitions>
                    <term_definitions code="at0031">
                      <items id="description">Degenerated or atretic polar bodies.</items>
                      <items id="text">Degenerated</items>
                    </term_definitions>
