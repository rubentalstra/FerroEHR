    <template_id>
      <value>Oocyte and Embryo assessment</value>
    </template_id>
    <term_definitions code="at0000">
      <items id="description">Timed assessment of morphological features and development of a single oocyte or embryo during assisted reproduction treatment.</items>
      <items id="text">Oocyte and embryo assessment</items>
    </term_definitions>
    <term_definitions code="at0001">
      <items id="description">@ internal @</items>
      <items id="text">History</items>
    </term_definitions>
    <term_definitions code="at0002">
      <items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items>
      <items id="text">Any event</items>
    </term_definitions>
    <term_definitions code="at0003">
      <items id="description">@ internal @</items>
      <items id="text">Tree</items>
    </term_definitions>
    <term_definitions code="at0004">
      <items id="description">@ internal @</items>
      <items id="text">Item tree</items>
    </term_definitions>
    <term_definitions code="at0005">
      <items id="description">Details of the device used to assess morphology and development of the oocyte or embryo.</items>
      <items id="text">Device</items>
    </term_definitions>
    <term_definitions code="at0006">
      <items id="description">The unique identifier for the culture dish containing the oocyte or embryo.</items>
      <items id="text">Culture dish ID</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="description">Method for assessment of morphology and development of the oocyte or embryo.</items>
      <items id="text">Method</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="description">Morphology and development were assessed by manual microscopy.</items>
      <items id="text">Manual</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="description">Morphology and development were assessed by automated device.</items>
      <items id="text">Time-lapse</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="description">Label or name identifying an oocyte or embryo.</items>
      <items id="text">Label</items>
    </term_definitions>
    <term_definitions code="at0011">
      <items id="comment">For example: the "Single European Code” or “SEC” identifier.</items>
      <items id="description">The unique identifier for the oocyte or embryo.</items>
      <items id="text">ID</items>
    </term_definitions>
    <term_definitions code="at0013">
      <items id="description">Structured morphological findings appropriate for the developmental stage of the oocyte or embryo.</items>
      <items id="text">Morphological findings</items>
    </term_definitions>
    <term_definitions code="at0022">
      <items id="description">Digital image, video or diagram representing morphology and development of the oocyte or embryo.</items>
      <items id="text">Image representation</items>
    </term_definitions>
    <term_definitions code="at0023">
      <items id="description">The duration since insemination.</items>
      <items id="text">Time post-insemination</items>
    </term_definitions>
    <term_definitions code="at0024">
      <items id="description">Clinical interpretation of the morphological and developmental assessment of the oocyte or embryo.</items>
      <items id="text">Interpretation</items>
    </term_definitions>
    <term_definitions code="at0025">
      <items id="description">The oocyte or embryo is suitable for clinical use.</items>
      <items id="text">Suitable for clinical use</items>
    </term_definitions>
    <term_definitions code="at0026">
      <items id="description">The oocyte or embryo is unsuitable for clinical use.</items>
      <items id="text">Unsuitable for clinical use</items>
    </term_definitions>
    <term_definitions code="at0027">
      <items id="description">Observation of the inseminated oocyte to assess fertilization.</items>
      <items id="text">Fertilisation check</items>
    </term_definitions>
    <term_definitions code="at0028">
      <items id="description">Observation of the inseminated oocyte to assess syngamy.</items>
      <items id="text">Syngamy check</items>
    </term_definitions>
    <term_definitions code="at0029">
      <items id="description">Observation of the embryo to assess early first cell cleavage.</items>
      <items id="text">Early cleavage check</items>
    </term_definitions>
    <term_definitions code="at0030">
      <items id="description">Embryo observation on Day 2 post insemination.</items>
      <items id="text">Day-2 embryo assessment</items>
    </term_definitions>
    <term_definitions code="at0031">
      <items id="description">Embryo observation on Day 3 post insemination.</items>
      <items id="text">Day-3 embryo assessment</items>
    </term_definitions>
    <term_definitions code="at0032">
      <items id="description">Embryo observation on Day 4 post insemination.</items>
      <items id="text">Day-4 embryo assessment</items>
    </term_definitions>
    <term_definitions code="at0033">
      <items id="description">Embryo observation on Day 5 post insemination.</items>
      <items id="text">Day-5 embryo assessment</items>
    </term_definitions>
    <term_definitions code="at0034">
      <items id="description">General description of the oocyte or embryo.</items>
      <items id="text">Description</items>
    </term_definitions>
    <term_definitions code="at0035">
      <items id="comment">For example: difficulties in visualisation.</items>
      <items id="description">Additional narrative about the oocyte or embryo assessment, not captured in other fields.</items>
      <items id="text">Comment</items>
    </term_definitions>
    <term_definitions code="at0036">
      <items id="description">Developmental stage of the oocyte or embryo.</items>
      <items id="text">Developmental stage</items>
    </term_definitions>
    <term_definitions code="at0037">
      <items id="description">Pronuclear zygote stage.</items>
      <items id="text">Pronuclear stage</items>
    </term_definitions>
    <term_definitions code="at0038">
      <items id="description">2-cell stage.</items>
      <items id="text">2-cell stage</items>
    </term_definitions>
    <term_definitions code="at0039">
      <items id="description">4-cell stage.</items>
      <items id="text">4-cell stage</items>
    </term_definitions>
    <term_definitions code="at0040">
      <items id="description">8-cell stage.</items>
      <items id="text">8-cell stage</items>
    </term_definitions>
    <term_definitions code="at0041">
      <items id="description">Morula stage.</items>
      <items id="text">Morula</items>
    </term_definitions>
    <term_definitions code="at0042">
      <items id="description">Blastocyst stage.</items>
      <items id="text">Blastocyst</items>
    </term_definitions>
    <term_definitions code="at0043">
      <items id="description">Oocyte stage.</items>
      <items id="text">Oocyte</items>
    </term_definitions>
    <term_definitions code="at0044">
      <items id="comment">May record timed events, like extrusion of second polar body, appearance and fading of pronuclei, cell divisions, or compaction.</items>
      <items id="description">Recording of a developmental event observed during time-lapse microscopy.</items>
      <items id="text">Developmental event</items>
    </term_definitions>
    <term_definitions code="at0045">
      <items id="description">The second polar body is completely detached from the oolemma.</items>
      <items id="text">tPB2 extrusion</items>
    </term_definitions>
    <term_definitions code="at0046">
      <items id="description">Appearance of individual pronuclei.</items>
      <items id="text">tPNa</items>
    </term_definitions>
    <term_definitions code="at0047">
      <items id="description">Fading of pronuclei.</items>
      <items id="text">tPNf</items>
    </term_definitions>
    <term_definitions code="at0048">
      <items id="description">The embryo reaches 2 blastomeres.</items>
      <items id="text">t2</items>
    </term_definitions>
    <term_definitions code="at0049">
      <items id="description">The embryo reaches 3 blastomeres.</items>
      <items id="text">t3</items>
    </term_definitions>
    <term_definitions code="at0050">
      <items id="description">The embryo reaches 4 blastomeres.</items>
      <items id="text">t4</items>
    </term_definitions>
    <term_definitions code="at0051">
      <items id="description">The embryo reaches 5 blastomeres.</items>
      <items id="text">t5</items>
    </term_definitions>
    <term_definitions code="at0052">
      <items id="description">The embryo reaches 6 blastomeres.</items>
      <items id="text">t6</items>
    </term_definitions>
    <term_definitions code="at0053">
      <items id="description">The embryo reaches 7 blastomeres.</items>
      <items id="text">t7</items>
    </term_definitions>
    <term_definitions code="at0054">
      <items id="description">The embryo reaches 8 blastomeres.</items>
      <items id="text">t8</items>
    </term_definitions>
    <term_definitions code="at0055">
      <items id="description">Evidence of compaction.</items>
      <items id="text">tSC</items>
    </term_definitions>
    <term_definitions code="at0056">
      <items id="description">Completion of compaction process.</items>
      <items id="text">tM</items>
    </term_definitions>
    <term_definitions code="at0057">
      <items id="description">Initiation of blastulation.</items>
      <items id="text">tSB</items>
    </term_definitions>
    <term_definitions code="at0058">
      <items id="description">Full blastocyst.</items>
      <items id="text">tB</items>
    </term_definitions>
    <term_definitions code="at0059">
      <items id="description">Initiation of expansion.</items>
      <items id="text">tE</items>
    </term_definitions>
    <term_definitions code="at0060">
      <items id="description">Herniation.</items>
      <items id="text">tHN</items>
    </term_definitions>
    <term_definitions code="at0061">
      <items id="description">Fully hatched blastocyst.</items>
      <items id="text">tHB</items>
    </term_definitions>
    <term_definitions code="at0062">
      <items id="description">Oocyte or embryo observation at cryopreservation.</items>
      <items id="text">Freezing assessment</items>
