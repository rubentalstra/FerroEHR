                    <archetype_id>
                      <value>openEHR-EHR-CLUSTER.exam_blastocyst.v0</value>
                    </archetype_id>
                    <term_definitions code="at0000">
                      <items id="description">Morphological findings obtained by microscopy of the human blastocyst during assisted reproduction treatment.</items>
                      <items id="text">Examination of a blastocyst</items>
                    </term_definitions>
                    <term_definitions code="at0049">
                      <items id="description">Degree of expansion of the blastocyst.</items>
                      <items id="text">Degree of expansion</items>
                    </term_definitions>
                    <term_definitions code="at0050">
                      <items id="description">The blastocoel cavity is less than the half of the embryo volume.</items>
                      <items id="text">Grade 1</items>
                    </term_definitions>
                    <term_definitions code="at0051">
                      <items id="description">The blastocoel cavity is > 50% of the embryo volume.</items>
                      <items id="text">Grade 2</items>
                    </term_definitions>
                    <term_definitions code="at0052">
                      <items id="description">The blastocoel cavity completely fills the embryo volume.</items>
                      <items id="text">Grade 3</items>
                    </term_definitions>
                    <term_definitions code="at0053">
                      <items id="description">The blastocoel cavity is larger than the original volume of the embryo, thinned zona pellucida.</items>
                      <items id="text">Grade 4</items>
                    </term_definitions>
                    <term_definitions code="at0054">
                      <items id="description">Hatching blastocyst.</items>
                      <items id="text">Grade 5</items>
                    </term_definitions>
                    <term_definitions code="at0055">
                      <items id="description">Completely hatched blastocyst.</items>
                      <items id="text">Grade 6</items>
                    </term_definitions>
                    <term_definitions code="at0056">
                      <items id="description">Morphology of the inner cell mass.</items>
                      <items id="text">Inner cell mass morphology</items>
                    </term_definitions>
                    <term_definitions code="at0057">
                      <items id="description">The inner call mass contains many tightly packed cells.</items>
                      <items id="text">A</items>
                    </term_definitions>
                    <term_definitions code="at0058">
                      <items id="description">The inner call mass contains several loosely grouped cells.</items>
                      <items id="text">B</items>
                    </term_definitions>
                    <term_definitions code="at0059">
                      <items id="description">The inner call mass contains few loosely bound cells.</items>
                      <items id="text">C</items>
                    </term_definitions>
                    <term_definitions code="at0060">
                      <items id="description">Morphology of the trophectoderm of the blastocyst.</items>
                      <items id="text">Trophectoderm morphology</items>
                    </term_definitions>
                    <term_definitions code="at0061">
                      <items id="description">Trophectoderm contains many cells that form a cohesive epithelium.</items>
                      <items id="text">A</items>
                    </term_definitions>
                    <term_definitions code="at0062">
                      <items id="description">Trophectoderm contains few cells that form a loose epithelium.</items>
                      <items id="text">B</items>
                    </term_definitions>
                    <term_definitions code="at0063">
                      <items id="description">Trophectoderm contains very few large cells that struggle to form a cohesive epithelium.</items>
                      <items id="text">C</items>
                    </term_definitions>
                    <term_definitions code="at0064">
                      <items id="comment">May include signs of degeneration, such as presence of necrosis and exclusion of cells, cellular bridges, vacuolation, multiple hatching points.</items>
                      <items id="description">Additional morphological features of the blastocyst not captured by specific parameters.</items>
                      <items id="text">Other morphological features</items>
                    </term_definitions>
                    <term_definitions code="at0067">
                      <items id="description">Inner cell mass morphology is not accessible.</items>
                      <items id="text">Not accessible</items>
                    </term_definitions>
                  </children>
