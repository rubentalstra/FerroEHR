                    <archetype_id>
                      <value>openEHR-EHR-CLUSTER.exam_oocyte.v0</value>
                    </archetype_id>
                    <term_definitions code="at0000">
                      <items id="description">Morphological findings obtained by microscopy of the human oocyte during assisted reproduction treatment.</items>
                      <items id="text">Examination of an oocyte</items>
                    </term_definitions>
                    <term_definitions code="at0028">
                      <items id="description">Maturity of the entire intact cumulus-oocyte complex.</items>
                      <items id="text">Maturity of cumulus-oocyte complex</items>
                    </term_definitions>
                    <term_definitions code="at0031">
                      <items id="description">Mature, expanded corona cell complex.</items>
                      <items id="text">Mature</items>
                    </term_definitions>
                    <term_definitions code="at0032">
                      <items id="description">Immature, unexpanded compact cumulus and corona cells.</items>
                      <items id="text">Immature</items>
                    </term_definitions>
                    <term_definitions code="at0033">
                      <items id="description">Absent corona.</items>
                      <items id="text">Postmature</items>
                    </term_definitions>
                    <term_definitions code="at0034">
                      <items id="description">Small oocyte and corona.</items>
                      <items id="text">Very immature</items>
                    </term_definitions>
                    <term_definitions code="at0035">
                      <items id="description">Nuclear maturity of oocyte after removal of the  cumulus-corona cell mass.</items>
                      <items id="text">Oocyte maturation stage</items>
                    </term_definitions>
                    <term_definitions code="at0036">
                      <items id="description">Ooocyte in the metaphase 2 (M2) of the meiotic cell division.</items>
                      <items id="text">Metaphase 2</items>
                    </term_definitions>
                    <term_definitions code="at0037">
                      <items id="description">Ooocyte in meiosis 1.</items>
                      <items id="text">Meiosis 1</items>
                    </term_definitions>
                    <term_definitions code="at0038">
                      <items id="description">Ooocyte still displaying an intact nucleus, the germinal vesicle (GV), in prophase 1 of meiosis.</items>
                      <items id="text">Germinal vesicle</items>
                    </term_definitions>
                    <term_definitions code="at0039">
                      <items id="description">Apparent size of the oocyte.</items>
                      <items id="text">Oocyte size</items>
                    </term_definitions>
                    <term_definitions code="at0040">
                      <items id="description">Shape of the oocyte.</items>
                      <items id="text">Oocyte shape</items>
                    </term_definitions>
                    <term_definitions code="at0041">
                      <items id="description">Morphology of the oocyte cytoplasm.</items>
                      <items id="text">Cytoplasmic morphology</items>
                    </term_definitions>
                    <term_definitions code="at0042">
                      <items id="description">Thickness of the zona pellucida.</items>
                      <items id="text">Zona pellucida thickness</items>
                    </term_definitions>
                    <term_definitions code="at0043">
                      <items id="description">Morphology of the perivitelline space.</items>
                      <items id="text">Perivitelline space morphology</items>
                    </term_definitions>
                    <term_definitions code="at0044">
                      <items id="description">Morphology of the first polar body.</items>
                      <items id="text">First polar body morphology</items>
                    </term_definitions>
                    <term_definitions code="at0045">
                      <items id="description">Morphology and position of the metaphase spindle obtained by polarized light microscopy.</items>
                      <items id="text">Metaphase spindle</items>
                    </term_definitions>
                    <term_definitions code="at0046">
                      <items id="description">Additional morphological features not captured by specific parameters.</items>
                      <items id="text">Other morphological features</items>
                    </term_definitions>
                    <term_definitions code="at0047">
                      <items id="description">Normal sized oocyte.</items>
                      <items id="text">Normal</items>
                    </term_definitions>
                    <term_definitions code="at0048">
