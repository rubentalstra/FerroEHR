        <archetype_id>
          <value>openEHR-EHR-EVALUATION.pregnancy_summary.v0</value>
        </archetype_id>
        <term_definitions code="at0000">
          <items id="description">Overview or summary record of a pregnancy and outcome, including the antenatal period, labour, birth and the immediate postnatal period.</items>
          <items id="text">Pregnancy summary</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0007">
          <items id="description">Number of fetuses identified in utero.</items>
          <items id="text">Number of fetuses</items>
        </term_definitions>
        <term_definitions code="at0008">
          <items id="description">Manner in which labour started.</items>
          <items id="text">Onset of labour</items>
        </term_definitions>
        <term_definitions code="at0009">
          <items id="description">Onset without intervention.</items>
          <items id="text">Spontaneous</items>
        </term_definitions>
        <term_definitions code="at0010">
          <items id="description">Onset through intervention.</items>
          <items id="text">Induced</items>
        </term_definitions>
        <term_definitions code="at0016">
          <items id="description">Total duration of all three stages of labour.</items>
          <items id="text">Total duration of labor</items>
        </term_definitions>
        <term_definitions code="at0022">
          <items id="comment">Coding of the 'Augmentation Method' with a terminology is desirable, where possible.</items>
          <items id="description">Method of labour augmentation.</items>
          <items id="text">Augmentation method</items>
        </term_definitions>
        <term_definitions code="at0028">
          <items id="comment">These data elements may be used to record details about live births or stillborn infants.</items>
          <items id="description">Information about an single newborn infant.</items>
          <items id="text">Per newborn</items>
        </term_definitions>
        <term_definitions code="at0029">
          <items id="comment">This data element may be used to populate the newborn's health record using the 'Date of birth' data element within the EVALUATION.birth_details archetype.</items>
          <items id="description">Date and time of delivery for the newborn.</items>
          <items id="text">Date/time of delivery</items>
        </term_definitions>
        <term_definitions code="at0036">
          <items id="comment">Identification might be by the name of the neonate or a label given to a non-viable fetus.</items>
          <items id="description">Identification of the newborn.</items>
          <items id="text">Label/name</items>
        </term_definitions>
        <term_definitions code="at0037">
          <items id="comment">Coding with a terminology is preferred, where possible. For example: Male; female; intersex; indeterminate. Indeterminate is to be used in the situation where the infant has ambiguous external genitalia. This data element may be used to populate the newborn health record using the 'Sex assigned at birth' data element within the EVALUATION.gender archetype.</items>
          <items id="description">Sex of the newborn assigned at, or near delivery, by direct observation of external genitalia.</items>
          <items id="text">Assigned sex</items>
        </term_definitions>
        <term_definitions code="at0038">
          <items id="comment">This data element may be used to populate the newborn health record using both the 'Weight' data element and 'Birth' EVENT within the OBSERVATION.body_weight archetype.</items>
          <items id="description">Weight of the newborn at delivery.</items>
          <items id="text">Weight</items>
        </term_definitions>
        <term_definitions code="at0045">
          <items id="comment">The clinical context for recording this data element is only presentation at delivery, not at any other phase of labour.</items>
          <items id="description">Presenting part of the newborn at delivery.</items>
          <items id="text">Presenting part</items>
        </term_definitions>
        <term_definitions code="at0046">
          <items id="description">The vertext is the presenting part.</items>
          <items id="text">Vertex</items>
        </term_definitions>
        <term_definitions code="at0047">
          <items id="description">The breech is the presenting part.</items>
          <items id="text">Breech</items>
        </term_definitions>
        <term_definitions code="at0048">
          <items id="description">The fact is the presenting part.</items>
          <items id="text">Face</items>
        </term_definitions>
        <term_definitions code="at0049">
          <items id="description">The brow is the presenting part.</items>
          <items id="text">Brow</items>
        </term_definitions>
        <term_definitions code="at0061">
          <items id="comment">Newborn complications recorded within this maternal 'Pregnancy summary' archetype may be used to populate EVALUATION.problem_diagnosis or ACTION.procedure archetypes to initiate a Problem list, or similar, within a newborn health record.</items>
          <items id="description">Details about any complications affecting the newborn.</items>
          <items id="text">Newborn complication</items>
        </term_definitions>
        <term_definitions code="at0062">
          <items id="comment">Coding of the 'Complication' with a terminology is desirable, where possible. For example, neonatal hypoglycaemia or hypothermia.</items>
          <items id="description">Identification of the complication after birth.</items>
          <items id="text">Complication</items>
        </term_definitions>
        <term_definitions code="at0063">
          <items id="description">Date and/or time of onset of the complication.</items>
          <items id="text">Date/time of onset</items>
        </term_definitions>
        <term_definitions code="at0064">
          <items id="description">Narrative description of complication.</items>
          <items id="text">Description</items>
        </term_definitions>
        <term_definitions code="at0065">
          <items id="comment">Maternal complications recorded within this maternal 'Pregnancy summary' archetype may be used to populate EVALUATION.problem_diagnosis or ACTION.procedure archetypes as part of a maternal Problem list, or similar. Alternatively these complications may be derived from relevant entries previously documented in the maternal health record using EVALUATION.problem_diagnosis or ACTION.procedure archetypes.</items>
          <items id="description">Details about pregnancy complications or birth complications affecting the mother.</items>
          <items id="text">Maternal complication</items>
        </term_definitions>
        <term_definitions code="at0066">
          <items id="comment">Coding of the 'Complication' with a terminology is desirable, where possible. For example, post partum haemorrhage or pre-eclampsia.</items>
          <items id="description">Identification of the complication.</items>
          <items id="text">Complication</items>
        </term_definitions>
        <term_definitions code="at0067">
          <items id="comment">If only a partial date is available, this is acceptable.</items>
          <items id="description">Date of onset of complication, as assessed by a clinician.</items>
          <items id="text">Date/Time of onset</items>
        </term_definitions>
        <term_definitions code="at0068">
          <items id="description">Narrative description of the maternal complication.</items>
          <items id="text">Description</items>
        </term_definitions>
        <term_definitions code="at0081">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0082">
          <items id="description">The date/time the pregnancy summary was last updated.</items>
          <items id="text">Last updated</items>
        </term_definitions>
        <term_definitions code="at0083">
          <items id="comment">This data element may be used to populate the 'Pregnancy/birth synopsis' data element within the EVALUATION.birth_details archetype in an infant health record.</items>
          <items id="description">Narrative description about the entire pregnancy, labour and delivery, including complications.</items>
          <items id="text">Pregnancy synopsis</items>
        </term_definitions>
        <term_definitions code="at0094">
          <items id="comment">Coding of the 'Pregnancy outcome' with an external terminology is recommended. This data element is redundant if 'Delivery outcome' has been recorded. If it is necessary to record outcome information per fetus post delivery use the 'Delivery outcome' data element.  Please note - in some existing situations the possible value sets for 'Pregnancy outcome' and 'Delivery outcome' may overlap, and it may be necessary for the user interface in an application to present a merged value set.</items>
          <items id="description">Outcome of the pregnancy as a whole.</items>
          <items id="text">Pregnancy outcome</items>
        </term_definitions>
        <term_definitions code="at0096">
          <items id="comment">Coding of the 'Induction Method' with a terminology is desirable, where possible.</items>
          <items id="description">Method of labour induction.</items>
          <items id="text">Induction method</items>
        </term_definitions>
        <term_definitions code="at0097">
          <items id="description">Reason for induction of labour.</items>
          <items id="text">Reason for induction</items>
        </term_definitions>
        <term_definitions code="at0104">
          <items id="comment">True, if assisted reproduction was required to achieve the pregnancy.</items>
          <items id="description">Was the pregnancy a result of assisted reproductive technology?</items>
          <items id="text">Assisted reproduction?</items>
        </term_definitions>
        <term_definitions code="at0105">
          <items id="comment">Coding with a terminology is preferred, where possible.</items>
          <items id="description">Type of assisted reproductive technology used to achieve pregnancy.</items>
          <items id="text">Assisted reproduction type</items>
        </term_definitions>
        <term_definitions code="at0106">
          <items id="description">A foot is the presenting part.</items>
          <items id="text">Foot</items>
        </term_definitions>
        <term_definitions code="at0107">
          <items id="description">An arm is the presenting part.</items>
          <items id="text">Arm</items>
        </term_definitions>
        <term_definitions code="at0109">
          <items id="description">Narrative description about feeding of the newborn.</items>
          <items id="text">Feeding</items>
        </term_definitions>
        <term_definitions code="at0112">
          <items id="description">No onset of labour.</items>
          <items id="text">No labour</items>
        </term_definitions>
        <term_definitions code="at0113">
          <items id="description">Baby appears physically male.</items>
          <items id="text">Male</items>
        </term_definitions>
        <term_definitions code="at0114">
          <items id="description">Baby appears physically female.</items>
          <items id="text">Female</items>
        </term_definitions>
        <term_definitions code="at0115">
          <items id="description">Sex of the baby has not yet been able to be determined from observation of physical characteristics.</items>
          <items id="text">Indeterminate</items>
        </term_definitions>
        <term_definitions code="at0118">
          <items id="description">Coded or narrative description about the condition of the perineum after birth, including injuries and repairs.</items>
          <items id="text">Perineum</items>
        </term_definitions>
        <term_definitions code="at0119">
          <items id="description">Estimation of total maternal blood loss during birth and immediately postpartum.</items>
          <items id="text">Estimated blood loss</items>
        </term_definitions>
        <term_definitions code="at0133">
          <items id="description">A shoulder is the presenting part.</items>
          <items id="text">Shoulder</items>
        </term_definitions>
        <term_definitions code="at0146">
          <items id="description">*</items>
          <items id="text">Pregnancy label</items>
        </term_definitions>
        <term_definitions code="at0149">
          <items id="description">Position of the newborn at delivery.</items>
          <items id="text">Position</items>
        </term_definitions>
        <term_definitions code="at0150">
          <items id="description">The baby's back was toward the left side of the uterus at onset of labour.</items>
          <items id="text">Left occiput anterior/transverse</items>
        </term_definitions>
        <term_definitions code="at0151">
          <items id="description">The baby's back was toward the right side of the uterus at onset of labour.</items>
          <items id="text">Right occiput anterior/transverse</items>
        </term_definitions>
        <term_definitions code="at0152">
          <items id="description">It is not known which side the baby's back was positioned by onset of labour.</items>
          <items id="text">Unknown</items>
        </term_definitions>
        <term_definitions code="at0153">
          <items id="description">Involve just the skin of the vaginal opening and perineum.</items>
          <items id="text">First degree vaginal tear</items>
        </term_definitions>
        <term_definitions code="at0154">
          <items id="description">Involve the skin and muscle of the perineum and might extend deep into the vagina.</items>
          <items id="text">Second degree vaginal tear</items>
        </term_definitions>
        <term_definitions code="at0155">
          <items id="description">Tear in the vaginal tissue, perineal skin, and perineal muscles that extends into the anal sphincter.</items>
          <items id="text">Third degree vaginal tear</items>
        </term_definitions>
        <term_definitions code="at0156">
          <items id="description">Extend through the anal sphincter and into the mucous membrane that lines the rectum.</items>
          <items id="text">Fourth degree vaginal tear</items>
        </term_definitions>
        <term_definitions code="at0157">
          <items id="description">Was an episiotomy performed?</items>
          <items id="text">Episiotomy</items>
        </term_definitions>
        <term_definitions code="at0158">
          <items id="comment">Confirmation may be documented either by date, boolean selection or a link to a confirmatory test result within the health record. This data element may be used to trigger a 'Current' 'Pregnancy status' within the EVALUATION.pregnancy_status archetype.</items>
          <items id="description">Confirmation of the pregnancy.</items>
          <items id="text">Pregnancy confirmed</items>
        </term_definitions>
        <term_definitions code="at0159">
          <items id="comment">Also known as 'Gestation at birth' for pregnancies resulting in viable outcomes.</items>
          <items id="description">The length of the pregnancy until the pregnancy has ended.</items>
          <items id="text">Pregnancy duration</items>
        </term_definitions>
        <term_definitions code="at0160">
          <items id="description">A subset of persistent or summary information about the pregnancy and birth of an infant, selected for utility of use within both the maternal and infant health records.</items>
          <items id="text">Birth summary</items>
        </term_definitions>
        <term_definitions code="at0161">
          <items id="comment">For example: findings from examination of the placenta.</items>
          <items id="description">Structured details about additional information related to the pregnancy summary.</items>
          <items id="text">Additional details</items>
        </term_definitions>
        <term_definitions code="at0163">
          <items id="comment">Coding of the 'Delivery outcome' with an external terminology is recommended. For example: 'Live birth'; 'Stillbirth'; or 'Neonatal death'. This data element is redundant if 'Pregnancy outcome' has been recorded. Please note - in some existing situations the possible value sets for 'Delivery outcome' and 'Pregnancy outcome' may overlap, and it may be necessary for the user interface in an application to present a merged value set.</items>
          <items id="description">Description of the outcome delivery per newborn infant.</items>
          <items id="text">Delivery outcome</items>
        </term_definitions>
        <term_definitions code="at0164">
          <items id="description">*</items>
          <items id="text">Extension</items>
        </term_definitions>
      </children>
