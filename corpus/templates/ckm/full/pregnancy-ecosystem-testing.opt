        <term_definitions code="at0000">
          <items id="description">An assertion about the current pregnant condition of an individual.</items>
          <items id="text">Pregnancy finding</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">History</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">The current state of pregnancy for the individual.</items>
          <items id="text">Current status</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="description">Is there a pregnancy present?</items>
          <items id="text">Finding</items>
        </term_definitions>
        <term_definitions code="at0005">
          <items id="description">The individual is pregnant.</items>
          <items id="text">Pregnant</items>
        </term_definitions>
        <term_definitions code="at0006">
          <items id="description">The individual thinks they may be pregnant.</items>
          <items id="text">Possible pregnancy</items>
        </term_definitions>
        <term_definitions code="at0007">
          <items id="description">The individual is not pregnant.</items>
          <items id="text">Not pregnant</items>
        </term_definitions>
        <term_definitions code="at0008">
          <items id="description">It is not known whether the individual is pregnant or not.</items>
          <items id="text">Unknown</items>
        </term_definitions>
        <term_definitions code="at0009">
          <items id="description">Description of the evidence identified.</items>
          <items id="text">Evidence</items>
        </term_definitions>
        <term_definitions code="at0010">
          <items id="description">The individual's narrative confirms pregnancy.</items>
          <items id="text">On history</items>
        </term_definitions>
        <term_definitions code="at0011">
          <items id="description">Urine test confirms pregnancy.</items>
          <items id="text">Urine test</items>
        </term_definitions>
        <term_definitions code="at0012">
          <items id="description">Blood test confirms pregnancy.</items>
          <items id="text">Blood test</items>
        </term_definitions>
        <term_definitions code="at0013">
          <items id="description">Abdominal palpation confirms pregnancy.</items>
          <items id="text">Abdominal palpation</items>
        </term_definitions>
        <term_definitions code="at0014">
          <items id="description">Vaginal examination confirms pregnancy.</items>
          <items id="text">Vaginal examination</items>
        </term_definitions>
        <term_definitions code="at0015">
          <items id="description">Additional narrative about the pregnancy, not captured in other fields.</items>
          <items id="text">Comment</items>
        </term_definitions>
        <term_definitions code="at0016">
          <items id="description">*</items>
          <items id="text">Any event</items>
