                    <term_definitions code="at0.1">
                      <items id="description">The rectouterine pouch was examined.</items>
                      <items id="text">Rectouterine pouch</items>
                    </term_definitions>
                    <term_definitions code="at0.2">
                      <items id="description">*</items>
                      <items id="text">Free fluid presence</items>
                    </term_definitions>
                    <term_definitions code="at0.3">
                      <items id="description">Free fluid is observed in the rectouterine pouch.</items>
                      <items id="text">Present</items>
                    </term_definitions>
                    <term_definitions code="at0.4">
                      <items id="description">No free fluid is observed in the rectouterine pouch.</items>
                      <items id="text">Absent</items>
                    </term_definitions>
                    <term_definitions code="at0.5">
                      <items id="description">The amount of fluid observed.</items>
                      <items id="text">Amount of free fluid</items>
                    </term_definitions>
                    <term_definitions code="at0.6">
                      <items id="description">*</items>
                      <items id="text">Small</items>
                    </term_definitions>
                    <term_definitions code="at0.7">
