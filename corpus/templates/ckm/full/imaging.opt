                      <items id="text">Imaging findings</items>
                    </term_definitions>
                    <term_definitions code="at0005">
                      <items id="description">Additional structured details about imaging findings for the identified body structure or region, or findings for related substructures.</items>
                      <items id="text">SLOT: Additional details</items>
                    </term_definitions>
                    <term_definitions code="at0006">
                      <items id="comment">Also referred to as 'Opinion'. May include a comparison with previous studies of the identified body structure, where appropriate.</items>
                      <items id="description">Narrative concise, clinically relevant impression of all imaging findings for the identified body structure.</items>
                      <items id="text">Impression</items>
                    </term_definitions>
                    <term_definitions code="at0007">
                      <items id="description">Additional narrative about the imaging findings, not captured in other fields.</items>
