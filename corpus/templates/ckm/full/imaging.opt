                      <items id="text">Medium</items>
                    </term_definitions>
                    <term_definitions code="at0.8">
                      <items id="description">*</items>
                      <items id="text">Large</items>
                    </term_definitions>
                    <term_definitions code="at0.9">
                      <items id="comment">This data element has 3 occurrences to allow for measurements in 3 different axes.</items>
                      <items id="description">A measured diameter of the recto-uterine pouch.</items>
                      <items id="text">Diameter</items>
                    </term_definitions>
                    <term_definitions code="at0000">
                      <items id="description">Findings observed in an imaging examination targeting a specified structure or region, using radiographic techniques.</items>
                      <items id="text">Imaging examination</items>
                    </term_definitions>
                    <term_definitions code="at0000.1">
                      <items id="description">Findings observed in an imaging examination targeting the rectouterine pouch, using radiographic techniques.</items>
                      <items id="text">Imaging examination of the rectouterine pouch</items>
                    </term_definitions>
                    <term_definitions code="at0001">
                      <items id="description">Identification of the body structure or region examined.</items>
                      <items id="text">Body structure</items>
                    </term_definitions>
                    <term_definitions code="at0001.1">
                      <items id="description">Identification of the body structure or region examined.</items>
                      <items id="text">Body structure</items>
                    </term_definitions>
                    <term_definitions code="at0002">
                      <items id="comment">If the anatomical location of the identified body structure is known, this data element is redundant.</items>
                      <items id="description">Simple body site for the identified structure.</items>
                      <items id="text">Anatomical location</items>
                    </term_definitions>
                    <term_definitions code="at0003">
                      <items id="comment">If the anatomical location of the identified body structure is known or it has been identified in the 'Anatomical location' data element, this data element is redundant.</items>
                      <items id="description">Structured details about the anatomical location of the identified body structure.</items>
                      <items id="text">Structured anatomical location</items>
                    </term_definitions>
                    <term_definitions code="at0004">
