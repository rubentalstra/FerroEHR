                    <archetype_id>
                      <value>openEHR-EHR-CLUSTER.imaging_exam-uterine_body.v0</value>
                    </archetype_id>
                    <term_definitions code="at0.1">
                      <items id="description">The uterine body was examined.</items>
                      <items id="text">Uterine body</items>
                    </term_definitions>
                    <term_definitions code="at0.10">
                      <items id="description">A single gestation is observed.</items>
                      <items id="text">Single</items>
                    </term_definitions>
                    <term_definitions code="at0.11">
                      <items id="description">More than one gestation is observed.</items>
                      <items id="text">Multiple</items>
                    </term_definitions>
                    <term_definitions code="at0.12">
                      <items id="description">Intrauterine pregnancy is observed, with no associated cardiac activity.</items>
                      <items id="text">Present, non-viable</items>
                    </term_definitions>
                    <term_definitions code="at0.13">
                      <items id="comment">Usually measured in the midsagittal plane, from the outer serosal surface of the fundus to the external os of the cervix.</items>
                      <items id="description">The length of the uterus.</items>
                      <items id="text">Length</items>
                    </term_definitions>
                    <term_definitions code="at0.14">
                      <items id="comment">Usually measured at the widest dimension in the transverse or coronal plane, perpendicular to the length.</items>
                      <items id="description">The width of the uterus.</items>
                      <items id="text">Width</items>
                    </term_definitions>
                    <term_definitions code="at0.15">
                      <items id="comment">Usually measured in the sagittal plane, from the anterior to posterior walls, perpendicular to the length. Also known as 'antero-posterior diameter'.</items>
                      <items id="description">The depth or height of the uterus.</items>
                      <items id="text">Depth</items>
                    </term_definitions>
                    <term_definitions code="at0.16">
                      <items id="comment">For example: thickness, focal abnormalities, echogenicity, and the presence and characteristics of fluid or masses in the cavity. Record structured details about any morphological abnormality using CLUSTER.imaging_exam-abnormality nested within the 'Additional details' SLOT.</items>
                      <items id="description">Narrative description about the endometrium.</items>
                      <items id="text">Endometrium description</items>
                    </term_definitions>
                    <term_definitions code="at0.17">
                      <items id="comment">Also known as the endometrial stripe.</items>
                      <items id="description">Maximal measured thickness of the endometrium.</items>
                      <items id="text">Endometrial thickness</items>
                    </term_definitions>
                    <term_definitions code="at0.18">
                      <items id="comment">For example: homogeneous or heterogeneous; or describing ultrasound echogenicity as hypoechoic, isoechoic, or hyperechoic.</items>
                      <items id="description">Description about the endometrial texture.</items>
                      <items id="text">Endometrial texture</items>
                    </term_definitions>
                    <term_definitions code="at0.19">
                      <items id="comment">For example: contour changes, texture, masses, and cysts as well as symmetry between the anterior and posterior segments of the myometrium. Record structured details about any morphological abnormality using CLUSTER.imaging_exam-abnormality nested within the 'Additional details' SLOT.</items>
                      <items id="description">Narrative description about the myometrium.</items>
                      <items id="text">Myometrium description</items>
                    </term_definitions>
                    <term_definitions code="at0.2">
                      <items id="description">Number of gestations observed.</items>
                      <items id="text">Number of gestations</items>
                    </term_definitions>
                    <term_definitions code="at0.20">
                      <items id="description">Description of the relative thickness of the endometrial walls.</items>
                      <items id="text">Myometrial walls</items>
                    </term_definitions>
                    <term_definitions code="at0.21">
                      <items id="description">The thickness of the myometrial walls are symmetrical.</items>
                      <items id="text">Symmetrical</items>
                    </term_definitions>
                    <term_definitions code="at0.22">
                      <items id="description">The thickness of the myometrial walls are not symmetrical.</items>
                      <items id="text">Asymmetrical</items>
                    </term_definitions>
                    <term_definitions code="at0.23">
                      <items id="comment">For example: homogeneous or heterogeneous.</items>
                      <items id="description">Description about the myometrial texture.</items>
                      <items id="text">Myometrial texture</items>
                    </term_definitions>
                    <term_definitions code="at0.24">
                      <items id="comment">For example: regular, interrupted, or not visible.</items>
                      <items id="description">Description about the junctional zone of the myometrium.</items>
                      <items id="text">Junctional zone</items>
                    </term_definitions>
                    <term_definitions code="at0.25">
                      <items id="comment">Also known as 'position'.</items>
                      <items id="description">The axis of the cervix relative to the vagina.</items>
                      <items id="text">Uterine axis</items>
                    </term_definitions>
                    <term_definitions code="at0.26">
                      <items id="description">The vagina-cervix angle faces anteriorly.</items>
                      <items id="text">Anteverted</items>
                    </term_definitions>
                    <term_definitions code="at0.27">
                      <items id="description">The cervix is in the same axis as the vagina.</items>
                      <items id="text">Axial</items>
                    </term_definitions>
                    <term_definitions code="at0.28">
                      <items id="description">The vagina-cervix angle faces posteriorly.</items>
                      <items id="text">Retroverted</items>
                    </term_definitions>
                    <term_definitions code="at0.29">
                      <items id="description">The axis of the uterine fundus relative to the axis of the cervix.</items>
                      <items id="text">Uterine flexion</items>
                    </term_definitions>
                    <term_definitions code="at0.3">
                      <items id="description">The number of chorionic (outer) membranes or placentas observed in a multiple pregnancy.</items>
                      <items id="text">Chorionicity</items>
                    </term_definitions>
                    <term_definitions code="at0.30">
                      <items id="description">The cervix-body angle faces anteriorly.</items>
                      <items id="text">Anteflexed</items>
                    </term_definitions>
                    <term_definitions code="at0.31">
                      <items id="description">The cervix-body angle faces posteriorly.</items>
                      <items id="text">Retroflexed</items>
                    </term_definitions>
                    <term_definitions code="at0.32">
                      <items id="description">The presence or absence of an intrauterine contraceptive device.</items>
                      <items id="text">IUD presence</items>
                    </term_definitions>
                    <term_definitions code="at0.33">
                      <items id="description">An IUD is observed in the uterus.</items>
                      <items id="text">Present</items>
                    </term_definitions>
                    <term_definitions code="at0.34">
                      <items id="description">No IUD is observed in the uterus.</items>
                      <items id="text">Absent</items>
                    </term_definitions>
                    <term_definitions code="at0.35">
                      <items id="description">It is not possible to determine if an IUD is present or absent.</items>
                      <items id="text">Indeterminate</items>
                    </term_definitions>
                    <term_definitions code="at0.36">
                      <items id="description">Narrative description about an observed IUD in the uterus.</items>
                      <items id="text">IUD description</items>
                    </term_definitions>
                    <term_definitions code="at0.37">
                      <items id="description">Measured thickness of the junctional zone.</items>
                      <items id="text">Junctional zone thickness</items>
                    </term_definitions>
                    <term_definitions code="at0.4">
                      <items id="description">The number of amnions (inner membranes) or yolk sacs observed in a multiple pregnancy.</items>
                      <items id="text">Amnionicity</items>
                    </term_definitions>
                    <term_definitions code="at0.41">
                      <items id="description">One chorion or placenta is observed.</items>
                      <items id="text">Monochorionic</items>
                    </term_definitions>
                    <term_definitions code="at0.42">
                      <items id="description">Two chorions or placentae are observed.</items>
                      <items id="text">Dichorionic</items>
                    </term_definitions>
                    <term_definitions code="at0.43">
                      <items id="description">One amniotic sac is observed.</items>
                      <items id="text">Monoamnionic</items>
                    </term_definitions>
                    <term_definitions code="at0.44">
                      <items id="description">Two amniotic sacs are observed.</items>
                      <items id="text">Diamnionic</items>
                    </term_definitions>
                    <term_definitions code="at0.5">
                      <items id="description">The presence or absence of an intrauterine pregnancy.</items>
                      <items id="text">Intrauterine pregnancy</items>
                    </term_definitions>
                    <term_definitions code="at0.6">
                      <items id="description">Intrauterine pregnancy is observed, with associated cardiac activity.</items>
                      <items id="text">Present, viable</items>
                    </term_definitions>
                    <term_definitions code="at0.7">
                      <items id="description">No intrauterine pregnancy is observed.</items>
                      <items id="text">Absent</items>
                    </term_definitions>
                    <term_definitions code="at0.8">
                      <items id="description">It is not possible to determine if an intrauterine pregnancy is present of absent.</items>
                      <items id="text">Indeterminate</items>
                    </term_definitions>
                    <term_definitions code="at0000">
                      <items id="description">Findings observed in an imaging examination targeting a specified structure or region, using radiographic techniques.</items>
                      <items id="text">Imaging examination</items>
                    </term_definitions>
                    <term_definitions code="at0000.1">
                      <items id="description">Findings observed in an imaging examination targeting the uterine body, using radiographic techniques.</items>
                      <items id="text">Imaging examination of the uterine body</items>
                    </term_definitions>
                    <term_definitions code="at0001">
                      <items id="description">Identification of the body structure or region examined.</items>
                      <items id="text">Body structure</items>
                    </term_definitions>
                    <term_definitions code="at0001.1">
                      <items id="description">Identification of the body structure or region examined.</items>
                      <items id="text">Body structure</items>
                    </term_definitions>
                    <term_definitions code="at0002">
                      <items id="comment">If the anatomical location of the identified body structure is known, this data element is redundant.</items>
                      <items id="description">Simple body site for the identified structure.</items>
                      <items id="text">Anatomical location</items>
                    </term_definitions>
                    <term_definitions code="at0003">
                      <items id="comment">If the anatomical location of the identified body structure is known or it has been identified in the 'Anatomical location' data element, this data element is redundant.</items>
                      <items id="description">Structured details about the anatomical location of the identified body structure.</items>
                      <items id="text">Structured anatomical location</items>
                    </term_definitions>
                    <term_definitions code="at0004">
                      <items id="description">Narrative description of the imaging findings observed during this examination.</items>
                      <items id="text">Imaging findings</items>
                    </term_definitions>
                    <term_definitions code="at0005">
                      <items id="description">Additional structured details about imaging findings for the identified body structure or region, or findings for related substructures.</items>
                      <items id="text">SLOT: Additional details</items>
                    </term_definitions>
                    <term_definitions code="at0006">
                      <items id="comment">Also referred to as 'Opinion'. May include a comparison with previous studies of the identified body structure, where appropriate.</items>
                      <items id="description">Narrative concise, clinically relevant impression of all imaging findings for the identified body structure.</items>
                      <items id="text">Impression</items>
                    </term_definitions>
                    <term_definitions code="at0007">
                      <items id="description">Additional narrative about the imaging findings, not captured in other fields.</items>
                      <items id="text">Comment</items>
                    </term_definitions>
                    <term_bindings terminology="SNOMED-CT">
                      <items code="at0.1">
                        <value>
                          <terminology_id>
                            <value>SNOMED-CT</value>
                          </terminology_id>
                          <code_string>23952005</code_string>
                        </value>
                      </items>
                    </term_bindings>
