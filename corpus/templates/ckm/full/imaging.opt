                        <archetype_id>
                          <value>openEHR-EHR-CLUSTER.imaging_exam-abnormality-adnexal_mass.v0</value>
                        </archetype_id>
                        <term_definitions code="at0.0.1">
                          <items id="description">An adnexal mass was examined.</items>
                          <items id="text">Adnexal mass</items>
                        </term_definitions>
                        <term_definitions code="at0.0.13">
                          <items id="description">The number of papillary projections in the adnexal mass.</items>
                          <items id="text">Number of papillary projections</items>
                        </term_definitions>
                        <term_definitions code="at0.0.14">
                          <items id="description">The measured width of the thickest septum.</items>
                          <items id="text">Maximal septum width</items>
                        </term_definitions>
                        <term_definitions code="at0.0.15">
                          <items id="comment">This data element has 3 occurrences to allow for 3 measurements in different axes.</items>
                          <items id="description">A measured diameter of the largest solid tissue component.</items>
                          <items id="text">Solid diameter</items>
                        </term_definitions>
                        <term_definitions code="at0.0.2">
                          <items id="description">A unilocular cyst without septa, solid parts or papillary structures.</items>
                          <items id="text">Unilocular cyst</items>
                        </term_definitions>
                        <term_definitions code="at0.0.3">
                          <items id="description">A unilocular cyst with a measurable solid component or at least one papillary structure.</items>
                          <items id="text">Unilocular-solid cyst</items>
                        </term_definitions>
                        <term_definitions code="at0.0.4">
                          <items id="description">A cyst with at least one septum but no measurable solid components or papillary projections.</items>
                          <items id="text">Multilocular cyst</items>
                        </term_definitions>
                        <term_definitions code="at0.0.5">
                          <items id="description">A cyst with at least one septum and a measurable solid component or at least one papillary projection.</items>
                          <items id="text">Multilocular-solid cyst</items>
                        </term_definitions>
                        <term_definitions code="at0.0.6">
                          <items id="description">A tumor where the solid components comprise 80% or more of the tumour when assessed in a two-dimensional section.</items>
                          <items id="text">Solid tumour</items>
                        </term_definitions>
                        <term_definitions code="at0.0.7">
                          <items id="description">It is not possible to determine the type of mass.</items>
                          <items id="text">Indeterminate</items>
                        </term_definitions>
                        <term_definitions code="at0.0.8">
                          <items id="description">The number of cyst locules in the adnexal mass.</items>
                          <items id="text">Number of cyst locules</items>
                        </term_definitions>
                        <term_definitions code="at0.1">
                          <items id="description">A morphological abnormality was examined.</items>
                          <items id="text">Morphological abnormality</items>
                        </term_definitions>
                        <term_definitions code="at0.10">
                          <items id="description">The texture of the abnormality.</items>
                          <items id="text">Texture</items>
                        </term_definitions>
                        <term_definitions code="at0.11">
                          <items id="description">The definition of the abnormality.</items>
                          <items id="text">Definition</items>
                        </term_definitions>
                        <term_definitions code="at0.12">
                          <items id="description">The abnormality is well-defined.</items>
                          <items id="text">Well-defined</items>
                        </term_definitions>
                        <term_definitions code="at0.13">
                          <items id="description">The abnormality is poorly-defined.</items>
                          <items id="text">Poorly-defined</items>
                        </term_definitions>
                        <term_definitions code="at0.14">
                          <items id="description">The contour of the abnormality.</items>
                          <items id="text">Contour</items>
                        </term_definitions>
                        <term_definitions code="at0.15">
                          <items id="description">The margin of the abnormality.</items>
                          <items id="text">Margin</items>
                        </term_definitions>
                        <term_definitions code="at0.16">
                          <items id="description">Presence of calcification in the abnormality.</items>
                          <items id="text">Calcification</items>
                        </term_definitions>
                        <term_definitions code="at0.17">
                          <items id="description">Calcification is observed.</items>
                          <items id="text">Present</items>
                        </term_definitions>
                        <term_definitions code="at0.18">
                          <items id="description">Calcification is not observed.</items>
                          <items id="text">Absent</items>
                        </term_definitions>
                        <term_definitions code="at0.19">
                          <items id="comment">For example: 'pressing on blood vessel'.</items>
                          <items id="description">Narrative description about the effect of the abnormality on surrounding structures.</items>
                          <items id="text">Effect</items>
                        </term_definitions>
                        <term_definitions code="at0.2">
                          <items id="comment">Use to differentiate one abnormality from another when there is more than one present at the same site.</items>
                          <items id="description">A label for the abnormality.</items>
                          <items id="text">Label</items>
                        </term_definitions>
                        <term_definitions code="at0.20">
                          <items id="comment">Often determined by colour doppler or similar.</items>
                          <items id="description">Assessment of the blood flow to the abnormality.</items>
                          <items id="text">Vascularisation</items>
                        </term_definitions>
                        <term_definitions code="at0.21">
                          <items id="description">No blood flow can be detected.</items>
                          <items id="text">None</items>
                        </term_definitions>
                        <term_definitions code="at0.22">
                          <items id="description">Minimal blood flow can be detected.</items>
                          <items id="text">Mild</items>
                        </term_definitions>
                        <term_definitions code="at0.23">
                          <items id="description">Moderate blood flow can be detected.</items>
                          <items id="text">Moderate</items>
                        </term_definitions>
                        <term_definitions code="at0.24">
                          <items id="description">Marked blood flow can be detected.</items>
                          <items id="text">Marked</items>
                        </term_definitions>
                        <term_definitions code="at0.3">
                          <items id="comment">Coding of the morphological type with an external terminology is preferred, where possible. For example, a cyst or nodule from the SNOMED 4147007 | Mass (morphologic abnormality) | hierarchy.</items>
                          <items id="description">The type of abnormality.</items>
                          <items id="text">Type</items>
                        </term_definitions>
                        <term_definitions code="at0.3.1">
                          <items id="comment">Coding of the morphological type with an external terminology is preferred, where possible. For example, a cyst or nodule from the SNOMED 4147007 | Mass (morphologic abnormality) | hierarchy.</items>
                          <items id="description">The type of abnormality.</items>
                          <items id="text">Type</items>
                        </term_definitions>
                        <term_definitions code="at0.4">
                          <items id="comment">This data element has 3 occurrences to allow for 3 measurements in different axes.</items>
                          <items id="description">A measured diameter of the abnormality.</items>
                          <items id="text">Diameter</items>
                        </term_definitions>
                        <term_definitions code="at0.5">
                          <items id="description">A measured diameter of the abnormality.</items>
                          <items id="text">Diameter</items>
                        </term_definitions>
                        <term_definitions code="at0.6">
                          <items id="description">The measured length of the longest axis of the abnormality.</items>
                          <items id="text">Dimension 1</items>
                        </term_definitions>
                        <term_definitions code="at0.7">
                          <items id="description">The measured length of an axis of the abnormality perpendicular to Dimension 1.</items>
                          <items id="text">Dimension 2</items>
                        </term_definitions>
                        <term_definitions code="at0.8">
                          <items id="description">The measured length of an axis of the abnormality perpendicular to Dimension 1 and Dimension 2..</items>
                          <items id="text">Dimension 3</items>
                        </term_definitions>
                        <term_definitions code="at0.9">
                          <items id="description">The shape of the abnormality.</items>
                          <items id="text">Shape</items>
                        </term_definitions>
                        <term_definitions code="at0000">
                          <items id="description">Findings observed in an imaging examination targeting a specified structure or region, using radiographic techniques.</items>
                          <items id="text">Imaging examination</items>
                        </term_definitions>
                        <term_definitions code="at0000.1">
                          <items id="description">Findings of a morphological abnormality observed in an imaging examination targeting a specified structure or region, using radiographic techniques.</items>
                          <items id="text">Imaging examination of an abnormality</items>
                        </term_definitions>
                        <term_definitions code="at0000.1.1">
                          <items id="description">Findings of a morphological abnormality observed in an imaging examination targeting a mass near the uterus, including the ovaries, fallopian tubes, and connecting tissues, using radiographic techniques.</items>
                          <items id="text">Imaging examination of an adnexal mass</items>
                        </term_definitions>
                        <term_definitions code="at0001">
                          <items id="description">Identification of the body structure or region examined.</items>
                          <items id="text">Body structure</items>
                        </term_definitions>
                        <term_definitions code="at0001.1">
                          <items id="description">Identification of the body structure or region examined.</items>
                          <items id="text">Body structure</items>
                        </term_definitions>
                        <term_definitions code="at0001.1.1">
                          <items id="description">Identification of the body structure or region examined.</items>
                          <items id="text">Body structure</items>
                        </term_definitions>
                        <term_definitions code="at0002">
                          <items id="comment">If the anatomical location of the identified body structure is known, this data element is redundant.</items>
                          <items id="description">Simple body site for the identified structure.</items>
                          <items id="text">Anatomical location</items>
                        </term_definitions>
                        <term_definitions code="at0003">
                          <items id="comment">If the anatomical location of the identified body structure is known or it has been identified in the 'Anatomical location' data element, this data element is redundant.</items>
                          <items id="description">Structured details about the anatomical location of the identified body structure.</items>
                          <items id="text">Structured anatomical location</items>
                        </term_definitions>
                        <term_definitions code="at0004">
                          <items id="description">Narrative description of the imaging findings observed during this examination.</items>
                          <items id="text">Imaging findings</items>
                        </term_definitions>
                        <term_definitions code="at0005">
                          <items id="description">Additional structured details about imaging findings for the identified body structure or region, or findings for related substructures.</items>
                          <items id="text">SLOT: Additional details</items>
                        </term_definitions>
                        <term_definitions code="at0006">
                          <items id="comment">Also referred to as 'Opinion'. May include a comparison with previous studies of the identified body structure, where appropriate.</items>
                          <items id="description">Narrative concise, clinically relevant impression of all imaging findings for the identified body structure.</items>
                          <items id="text">Impression</items>
                        </term_definitions>
                        <term_definitions code="at0007">
                          <items id="description">Additional narrative about the imaging findings, not captured in other fields.</items>
                          <items id="text">Comment</items>
                        </term_definitions>
