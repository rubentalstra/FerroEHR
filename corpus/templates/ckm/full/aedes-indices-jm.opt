      <items id="comment">Calculated as (number of positive containers / number of houses inspected) * 100.</items>
      <items id="description">The number of positive containers per 100 houses.</items>
      <items id="text">Breteau index (BI)</items>
    </term_definitions>
    <term_definitions code="at0007">
      <items id="comment">Calculated as (number of positive containers / number of houses inspected) * 100.</items>
      <items id="description">The percentage of houses or premises infested with larvae and/or pupae.</items>
      <items id="text">House index (HI)</items>
    </term_definitions>
    <term_definitions code="at0008">
      <items id="comment">Calculated as (number of positive containers / total number of containers inspected) * 100.</items>
      <items id="description">The percentage of water-holding containers infested with larvae or pupae.</items>
      <items id="text">Container index (CI)</items>
    </term_definitions>
    <term_definitions code="at0009">
      <items id="description">The percentage of ovitrap devices that contain eggs or larvae.</items>
      <items id="text">Ovitrap index (OI)</items>
    </term_definitions>
    <term_definitions code="at0010">
      <items id="description">*</items>
      <items id="text">Extension</items>
    </term_definitions>
  </definition>
