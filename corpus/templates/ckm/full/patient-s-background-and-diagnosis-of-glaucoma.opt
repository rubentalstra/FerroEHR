          <items id="text">Tono-Pen</items>
        </term_definitions>
        <term_definitions code="at0050">
          <items id="description">Icare (Rebound) tonometry.</items>
          <items id="text">Icare (Rebound)</items>
        </term_definitions>
        <term_definitions code="at0051">
          <items id="description">Dynamic Contour tonometry.</items>
          <items id="text">Dynamic Contour</items>
        </term_definitions>
        <term_definitions code="at0052">
          <items id="description">Ocular Response Analyzer.</items>
          <items id="text">Ocular Response Analyzer</items>
        </term_definitions>
        <term_definitions code="at0053">
          <items id="description">A TGDc-01 device was used to perform the test.</items>
          <items id="text">TGDc-01</items>
        </term_definitions>
        <term_definitions code="at0055">
          <items id="description">Details about the tonometry device used to measure intraocular pressure.</items>
          <items id="text">Device details</items>
        </term_definitions>
        <term_definitions code="at0057">
          <items id="description">Identification of the eye under examination.</items>
          <items id="text">Eye examined</items>
        </term_definitions>
