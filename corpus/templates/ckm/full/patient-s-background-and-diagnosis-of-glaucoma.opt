        <term_definitions code="at0027">
          <items id="description">A coded intepretation of the Glaucoma Hemifield Test (GHT).</items>
          <items id="text">Glaucoma Hemifield Test (GHT)</items>
        </term_definitions>
        <term_definitions code="at0028">
          <items id="description">Differences between a matched pair of corresponding zones exceeds the difference found in 99% of the normal population, or when both members of a pair of zones are more abnormal than 99.5% of the individuals with the normative population.</items>
          <items id="text">Outside normal limits</items>
        </term_definitions>
        <term_definitions code="at0029">
          <items id="description">Matched pairs of zones are abnormal at the 97th percentile within the normative database.</items>
          <items id="text">Borderline</items>
        </term_definitions>
        <term_definitions code="at0030">
          <items id="description">Conditions for “outside normal limits” are not met, and the best region of the visual field is at or below the 99.5th percentile of the normative population.</items>
          <items id="text">General reduction of sensitivity</items>
        </term_definitions>
        <term_definitions code="at0031">
          <items id="description">Overall sensitivity in the affected  region of the VF is better than 99.5% of individuals within the normative population.</items>
          <items id="text">Abnormally high sensitivity</items>
        </term_definitions>
        <term_definitions code="at0032">
          <items id="description">None of the abnormal conditions are met.</items>
          <items id="text">Within normal limits</items>
        </term_definitions>
        <term_definitions code="at0034">
          <items id="description">The average of deviation in vusual field across all test areas.</items>
          <items id="text">Mean deviation</items>
        </term_definitions>
        <term_definitions code="at0035">
          <items id="description">Average of non-uniform visual field loss.</items>
          <items id="text">Pattern Standard deviation</items>
        </term_definitions>
        <term_definitions code="at0036">
          <items id="description">Details of refractive correction applied to each eye.</items>
          <items id="text">Refractive correction</items>
        </term_definitions>
        <term_definitions code="at0037">
          <items id="description">Visual Field Index result.</items>
          <items id="text">Visual Field Index</items>
        </term_definitions>
        <term_definitions code="at0038">
          <items id="description">The P value of the Mean Deviation result.</items>
          <items id="text">Mean deviation P</items>
        </term_definitions>
        <term_definitions code="at0039">
          <items id="description">The P value of the Pattern Standard deviation result.</items>
          <items id="text">Pattern Standard deviation P</items>
        </term_definitions>
        <term_definitions code="at0040">
          <items id="description">FASTPAC automated standard perimetry was used to measure the visual fields.</items>
          <items id="text">FASTPAC automated standard perimetry</items>
        </term_definitions>
