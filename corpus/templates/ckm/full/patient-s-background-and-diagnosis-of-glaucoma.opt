          <items id="description">Goldmann tonometry.</items>
          <items id="text">Goldmann</items>
        </term_definitions>
        <term_definitions code="at0048">
          <items id="description">Perkins tonometry.</items>
          <items id="text">Perkins</items>
        </term_definitions>
        <term_definitions code="at0049">
