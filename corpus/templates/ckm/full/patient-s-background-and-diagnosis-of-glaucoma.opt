        <term_definitions code="at0000">
          <items id="description">Record of clinical findings using optical coherence tomography with ophthalmic purposes.</items>
          <items id="text">Ophthalmic tomography examination</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Event Series</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items>
          <items id="text">Any event</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">@ internal @</items>
          <items id="text">Arbol</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="description">@ internal @</items>
          <items id="text">Arbol</items>
        </term_definitions>
        <term_definitions code="at0008">
          <items id="description">@ internal @</items>
          <items id="text">Arbol</items>
        </term_definitions>
        <term_definitions code="at0011">
          <items id="description">Details of the device used to acquire OCT images.</items>
          <items id="text">Device details</items>
        </term_definitions>
        <term_definitions code="at0038">
          <items id="description">A term, commonly coded, expressing an overall interpretation of the OCT test.</items>
          <items id="text">Clinical description</items>
        </term_definitions>
        <term_definitions code="at0039">
          <items id="description">Details of the ophthalmic tomography examination test result for each eye.</items>
          <items id="text">Test result</items>
        </term_definitions>
        <term_definitions code="at0040">
          <items id="comment">Matches to DICOM Laterality (0020,0060) attribute.</items>
          <items id="description">Determines the eye on which the test was performed.Matches to DICOM Laterality (0020,0060) attribute.</items>
          <items id="text">Side</items>
        </term_definitions>
        <term_definitions code="at0045">
          <items id="comment">Matches to DICOM Anatomic Region Sequence (0008,2218) attribute. Values permitted are defined by DICOM standard (PS 3.16) inside the table with Context ID 4211 (Ophthalmic OCT Anatomic Structure Imaged).</items>
          <items id="description">The anatomic structure analyzed in this study.</items>
          <items id="text">Structure analyzed</items>
        </term_definitions>
        <term_definitions code="at0046">
          <items id="comment">Corresponds to the value 4 of the DICOM image type attribute (0008,0008).</items>
          <items id="description">Identifies the fundus imaging modalities obtained from the acquisition of the reference image.</items>
          <items id="text">Image type</items>
        </term_definitions>
        <term_definitions code="at0047">
          <items id="description">Information about the slices of the retina obtained by OCT the test.</items>
          <items id="text">Multiframe properties</items>
        </term_definitions>
        <term_definitions code="at0048">
          <items id="comment">Matches to DICOM (0028,0008) attribute.</items>
          <items id="description">Number of slices in the study (from 1 to n).</items>
          <items id="text">Number of frames</items>
        </term_definitions>
        <term_definitions code="at0049">
          <items id="comment">Matches to DICOM (0028,0009) attribute.</items>
          <items id="description">Number identifying a frame among the rest in the study, to highlight its relevance on diagnosis.</items>
          <items id="text">Frame pointer</items>
        </term_definitions>
        <term_definitions code="at0054">
          <items id="description">Current slice of the retina regarding the image of reference.</items>
          <items id="text">OCT slice</items>
        </term_definitions>
        <term_definitions code="at0055">
          <items id="description">Information about image reports related to the current OCT study.</items>
          <items id="text">Reports</items>
        </term_definitions>
        <term_definitions code="at0056">
          <items id="description">Defines the purpose of the report built from data acquired on the OCT device.</items>
          <items id="text">Report type</items>
        </term_definitions>
        <term_definitions code="at0088">
          <items id="description">Report related to the current OCT study.</items>
          <items id="text">Report</items>
        </term_definitions>
        <term_definitions code="at0090">
          <items id="description">Information about the image on which the position of OCT acquisitions/slices will be referenced.</items>
          <items id="text">Reference image</items>
        </term_definitions>
        <term_definitions code="at0091">
          <items id="comment">Matches to DICOM Anatomic Region Sequence (0022,0015) attribute. Values permitted are defined by DICOM standard (PS 3.16) inside the table with Context ID 4202 (Ophthalmic Photography Acquisition Device).</items>
          <items id="description">Ophthalmic photography acquisition method chosen to obtain the reference image.</items>
          <items id="text">Acquisition method</items>
        </term_definitions>
        <term_definitions code="at0093">
          <items id="description">Narrative description of clinically relevant information identifiable on the reference image.</items>
          <items id="text">Comment</items>
        </term_definitions>
        <term_definitions code="at0094">
          <items id="description">Details about a study of thickness of ophthalmic structures.</items>
          <items id="text">Ophthalmic thickness details</items>
        </term_definitions>
        <term_definitions code="at0115">
          <items id="description">Patient circumstances which may affect interpretation of the result.</items>
          <items id="text">Confounding factors</items>
        </term_definitions>
        <term_definitions code="at0123">
          <items id="comment">Matches to DICOM (0022,000B) attribute.</items>
          <items id="description">Value of intraocular pressure in mmHg.</items>
          <items id="text">Intraocular pressure</items>
        </term_definitions>
        <term_definitions code="at0124">
          <items id="comment">Matches to DICOM (0022,0030) attribute.</items>
          <items id="description">Axial length of the eye in mm.</items>
          <items id="text">Axial length of the eye</items>
        </term_definitions>
        <term_definitions code="at0125">
          <items id="comment">Matches to DICOM (0022,000C) attribute.</items>
          <items id="description">The horizontal field of view in degrees.</items>
          <items id="text">Horizontal field of view</items>
        </term_definitions>
        <term_definitions code="at0130">
          <items id="comment">Matches to DICOM (0018,0012) attribute.</items>
          <items id="description">Information about the contrast agents administered prior to or during the acquisition.</items>
          <items id="text">Contrast/Bolus</items>
        </term_definitions>
        <term_definitions code="at0131">
          <items id="comment">Matches to DICOM (0018,0012) attribute. Values permitted are defined by DICOM standard (PS 3.16) inside the table with Context ID 4200 (Ophthalmic Imaging Agent).</items>
          <items id="description">Identification of the contrast agent.</items>
          <items id="text">Contrast/bolus agent</items>
        </term_definitions>
        <term_definitions code="at0132">
          <items id="comment">Matches to DICOM (0018,1041) attribute.</items>
          <items id="description">Volume injected in milliliters of diluted contrast agent.</items>
          <items id="text">Contrast/bolus volume</items>
        </term_definitions>
        <term_definitions code="at0133">
          <items id="comment">Matches to DICOM (0018,1049) attribute.</items>
          <items id="description">Milligrams of active ingredient per milliliter of (diluted) agent.</items>
          <items id="text">Contrast/bolus volume ingredient concentration</items>
        </term_definitions>
        <term_definitions code="at0134">
          <items id="description">Details of refractive correction applied to each eye.</items>
          <items id="text">Refraction details</items>
        </term_definitions>
        <term_definitions code="at0135">
          <items id="description">The left eye was examined.</items>
          <items id="text">Left eye</items>
        </term_definitions>
        <term_definitions code="at0136">
          <items id="description">The right eye was examined.</items>
          <items id="text">Right eye</items>
        </term_definitions>
        <term_definitions code="at0186">
          <items id="description">Information related to retinal thickness measurement.</items>
          <items id="text">Retinal thickness</items>
        </term_definitions>
        <term_definitions code="at0187">
          <items id="description">Fluorescein Angiography.</items>
          <items id="text">FA</items>
        </term_definitions>
        <term_definitions code="at0188">
          <items id="description">Indocyanine green angiography.</items>
          <items id="text">ICGA</items>
        </term_definitions>
        <term_definitions code="at0190">
          <items id="description">BluePeak blue laser autofluorescence imaging.</items>
          <items id="text">AF</items>
        </term_definitions>
        <term_definitions code="at0191">
          <items id="description">Infrared reflectance imaging.</items>
          <items id="text">IR</items>
        </term_definitions>
        <term_definitions code="at0192">
          <items id="description">Red-free imaging.</items>
          <items id="text">RF</items>
        </term_definitions>
        <term_definitions code="at0204">
          <items id="description">Image on which the position of OCT acquisitions/slices will be referenced.</items>
          <items id="text">Reference image</items>
        </term_definitions>
        <term_definitions code="at0205">
          <items id="description">Details about slice/s of the retina regarding its/their position in the reference image.</items>
          <items id="text">OCT overview</items>
        </term_definitions>
        <term_definitions code="at0206">
          <items id="description">Study of a slice of the retina and measurement of its thickness profile.</items>
          <items id="text">Retina exam</items>
        </term_definitions>
        <term_definitions code="at0207">
          <items id="description">Measurement of the thickness profile for each slice of retina in study and comparison of thickness progression in time during a follow-up.</items>
          <items id="text">Retina change</items>
        </term_definitions>
        <term_definitions code="at0208">
          <items id="description">Study of a 3D recontruction of the retina.</items>
          <items id="text">3D view</items>
        </term_definitions>
        <term_definitions code="at0209">
          <items id="description">Thickness study over the image of reference for multi-frame acquisition.</items>
          <items id="text">Thickness map exam</items>
        </term_definitions>
        <term_definitions code="at0210">
          <items id="description">Thickness progression study between several images of reference using different multi-frame acquisitions taken along time.</items>
          <items id="text">Thickness map change</items>
        </term_definitions>
        <term_definitions code="at0211">
          <items id="description">Measurement of thickness for retinal nerve fiber layer and comparison regarding the values from an age-adjusted normative database.</items>
          <items id="text">RNFL thickness exam</items>
        </term_definitions>
        <term_definitions code="at0212">
          <items id="description">Measurement of thickness for retinal nerve fiber layer and comparison regarding other measures obtained during a follow-up process.</items>
          <items id="text">RNFL thickness change</items>
        </term_definitions>
        <term_definitions code="at0213">
          <items id="description">Trend study for the evolution of retinal nerve fiber layer thickness.</items>
          <items id="text">RNFL thickness trend</items>
        </term_definitions>
        <term_definitions code="at0214">
          <items id="description">Study of difference in thickness comparing: values in different eyes (OD-OS), and superior-inferior hemispheres of the same eye.</items>
          <items id="text">Asymmetry analysis</items>
        </term_definitions>
        <term_definitions code="at0215">
          <items id="description">Study centered in retinal nerve fiber layer thickness and asymmetry of the retina.</items>
          <items id="text">RNFL &amp; asymmetry analysis</items>
        </term_definitions>
        <term_definitions code="at0216">
          <items id="description">Study centered in thickness around the optic nerve and macula.</items>
          <items id="text">Posterior pole assessment</items>
        </term_definitions>
        <term_definitions code="at0217">
          <items id="description">Other type of report.</items>
          <items id="text">Other</items>
        </term_definitions>
        <term_definitions code="at0230">
          <items id="description">Corresponds to DICOM Code value C-B02CC.</items>
          <items id="text">Fluorescein</items>
        </term_definitions>
        <term_definitions code="at0231">
          <items id="description">Corresponds to DICOM Code value C-B0156.</items>
          <items id="text">Indocyanine green</items>
        </term_definitions>
        <term_definitions code="at0232">
          <items id="description">Corresponds to DICOM Code value C-B0295.</items>
          <items id="text">Rose Bengal</items>
        </term_definitions>
        <term_definitions code="at0233">
          <items id="description">Corresponds to DICOM Code value C-22853.</items>
          <items id="text">Trypan blue</items>
        </term_definitions>
        <term_definitions code="at0234">
          <items id="description">Corresponds to DICOM Code value C-B02C5.</items>
          <items id="text">Methylene blue</items>
        </term_definitions>
        <term_definitions code="at0251">
          <items id="description">Details of any mydriatic procedure carried out whenever necessary.</items>
          <items id="text">Mydriasis Details</items>
        </term_definitions>
        <term_definitions code="at0252">
          <items id="description">Details about the strategy to conduct acquisitions using ophthalmic tomography.</items>
          <items id="text">Acquisition details</items>
        </term_definitions>
        <term_definitions code="at0253">
          <items id="description">Which kind of graphs are included in the report.</items>
          <items id="text">Report content</items>
        </term_definitions>
        <term_definitions code="at0254">
          <items id="description">The image of the retina used to indicate the position of OCT slices.</items>
          <items id="text">Reference image</items>
        </term_definitions>
        <term_definitions code="at0255">
          <items id="description">Report including a specific OCT scan.</items>
          <items id="text">Single OCT scan</items>
        </term_definitions>
        <term_definitions code="at0256">
          <items id="description">A 3D reconstruction of eye structure using several OCT frames.</items>
          <items id="text">OCT volume scan</items>
        </term_definitions>
        <term_definitions code="at0257">
          <items id="description">Graph showing the thickness of retina for a specific OCT scan.</items>
          <items id="text">Retinal thickness profile</items>
        </term_definitions>
        <term_definitions code="at0258">
          <items id="description">Coloured map showing the thickness of retina over the reference image.</items>
          <items id="text">Retinal thickness map</items>
        </term_definitions>
        <term_definitions code="at0259">
          <items id="description">Graph representing the thickness of the retinal nerve fiber layer around the optic nerve.</items>
          <items id="text">RNFL thickness profile</items>
        </term_definitions>
        <term_definitions code="at0260">
          <items id="description">Retinal nerve fiber layer thickness profile measured, compared to normal thickness values for different sections around the optic nerve.</items>
          <items id="text">RNFL thickness map</items>
        </term_definitions>
        <term_definitions code="at0262">
          <items id="description">Graph showing the thickness of retina from a specific OCT slice and compares them to values obtained in different acquisitions during a follow-up.</items>
          <items id="text">Thickness profile change</items>
        </term_definitions>
        <term_definitions code="at0263">
          <items id="description">Retinal thickness map obtained from the comparison of thickness values obtained in different acquisitions during a follow-up.</items>
          <items id="text">Thickness map change</items>
        </term_definitions>
        <term_definitions code="at0264">
          <items id="description">Classification of total thickness measured for different sections around the papilla according to an age-adjusted normative database.</items>
          <items id="text">Periapillary RNFL thickness classification</items>
        </term_definitions>
        <term_definitions code="at0265">
          <items id="description">Average thickness values in sections of retina located close to the macula.</items>
          <items id="text">Retinal average thickness</items>
        </term_definitions>
        <term_definitions code="at0266">
          <items id="description">Asymmetry map comparing thickness values from different eyes in the same locations.</items>
          <items id="text">Asymmetry OD-OS</items>
        </term_definitions>
        <term_definitions code="at0267">
          <items id="description">Asymmetry map comparing thickness at superior and inferior hemispheres in retina.</items>
          <items id="text">Hemisphere asymmetry</items>
        </term_definitions>
        <term_definitions code="at0268">
          <items id="description">Graph that represents the evolution along time of the thickness in retinal nerve fiber layer.</items>
          <items id="text">RNFL thickness trend</items>
        </term_definitions>
        <term_definitions code="at0269">
          <items id="description">Narrative description of clinically relevant information identifiable on the current report.</items>
          <items id="text">Comment</items>
        </term_definitions>
        <term_definitions code="at0270">
          <items id="description">Narrative description of clinically relevant information identifiable on the specific frames selected from the acquisition.</items>
          <items id="text">Comment</items>
        </term_definitions>
        <term_definitions code="at0271">
          <items id="description">Every finding considered clinically relevant, found on posterior chamber of the eye.</items>
          <items id="text">Clinical findings</items>
        </term_definitions>
        <term_definitions code="at0272">
          <items id="description">Narrative description of clinically relevant information identifiable on the analysis of ophthalmic thickness measurements.</items>
          <items id="text">Comment</items>
        </term_definitions>
        <term_definitions code="at0277">
          <items id="description">Analysis of OCT slices considered relevant in the study.</items>
          <items id="text">OCT slice analysis</items>
        </term_definitions>
