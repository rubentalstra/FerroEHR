        <archetype_id>
          <value>openEHR-EHR-OBSERVATION.child_growth_indicator.v0</value>
        </archetype_id>
        <term_definitions code="at0000">
          <items id="description">Details about parameters plotted on a growth chart to allow monitoring of a child's growth over time, relative to a reference population.</items>
          <items id="text">Child growth indicator</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Event Series</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">Default, unspecified point in time or interval event which may be explicitly defined in a template or at run-time.</items>
          <items id="text">Any event</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0010">
          <items id="description">Percentile calculated using standard normal distribution for the age (or adjusted age).</items>
          <items id="text">Percentile</items>
        </term_definitions>
        <term_definitions code="at0011">
          <items id="comment">Also known as the Standard deviation score (SD).</items>
          <items id="description">The deviation of an individual's value from the median value for a reference population, divided by the standard deviation of the reference population.</items>
          <items id="text">Z-score</items>
        </term_definitions>
        <term_definitions code="at0014">
          <items id="description">The name of the growth parameter.</items>
          <items id="text">Growth indicator</items>
        </term_definitions>
        <term_definitions code="at0019">
          <items id="description">A comment about the growth indicator, not captured in other fields.</items>
          <items id="text">Comment</items>
        </term_definitions>
        <term_definitions code="at0020">
          <items id="description">Length or height plotted against age, or adjusted age.</items>
          <items id="text">Length/height-for-age</items>
        </term_definitions>
        <term_definitions code="at0021">
          <items id="description">Sitting height plotted against age, or adjusted age.</items>
          <items id="text">Sitting height-for-age</items>
        </term_definitions>
        <term_definitions code="at0022">
          <items id="description">Subischial leg length plotted against age, or adjusted age.</items>
          <items id="text">Leg length-for-age</items>
        </term_definitions>
        <term_definitions code="at0023">
          <items id="description">Weight plotted against age, or adjusted age.</items>
          <items id="text">Weight-for-age</items>
        </term_definitions>
        <term_definitions code="at0024">
          <items id="description">Head circumference plotted against age, or adjusted age.</items>
          <items id="text">Head circumference-for-age</items>
        </term_definitions>
        <term_definitions code="at0025">
          <items id="description">Weight plotted against height/length.</items>
          <items id="text">Weight-for-length/height</items>
        </term_definitions>
        <term_definitions code="at0026">
          <items id="description">Systolic blood pressure plotted against age (or adjusted age) and height/length.</items>
          <items id="text">Systolic blood pressure-for-age-and-height</items>
        </term_definitions>
        <term_definitions code="at0027">
          <items id="description">Diastolic blood pressure plotted against age (or adjusted age) and height/length.</items>
          <items id="text">Diastolic blood pressure-for-age-and-height</items>
        </term_definitions>
        <term_definitions code="at0029">
          <items id="description">Body mass index plotted against age, or adjusted age.</items>
          <items id="text">Body mass index-for-age (BMI-for-age)</items>
        </term_definitions>
        <term_definitions code="at0031">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0032">
          <items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items>
          <items id="description">Additional information required to capture local content or to align with other reference models/formalisms.</items>
          <items id="text">Extension</items>
        </term_definitions>
        <term_definitions code="at0034">
          <items id="description">Arm circumference plotted against age, or adjusted age.</items>
          <items id="text">Arm circumference-for-age</items>
        </term_definitions>
        <term_definitions code="at0035">
          <items id="description">Link to the original measurement.</items>
          <items id="text">URI to original measurement</items>
        </term_definitions>
        <term_definitions code="at0036">
          <items id="description">Subscapular skinfold plotted against age, or adjusted age.</items>
          <items id="text">Subscapular skinfold-for-age</items>
        </term_definitions>
        <term_definitions code="at0037">
          <items id="description">Triceps skinfold plotted against age, or adjusted age.</items>
          <items id="text">Triceps skinfold-for-age</items>
        </term_definitions>
        <term_definitions code="at0038">
          <items id="description">Weight velocity plotted against age, or adjusted age.</items>
          <items id="text">Weight velocity</items>
        </term_definitions>
        <term_definitions code="at0039">
          <items id="description">Length velociy plotted against age, or adjusted age.</items>
          <items id="text">Length velocity</items>
        </term_definitions>
        <term_definitions code="at0040">
          <items id="description">Head circumference velocity plotted against age, or adjusted age.</items>
          <items id="text">Head circumference velocity</items>
        </term_definitions>
        <term_definitions code="at0041">
          <items id="description">Clinical interpretation of the growth indicator chart.</items>
          <items id="text">Clinical interpretation</items>
        </term_definitions>
        <term_definitions code="at0042">
          <items id="comment">For example, for a typical height assessment, 'WHO' might be used, whereas for children diagnosed with Turner Syndrome, the 'Turner' standard would be applicable (see the Royal College of Paediatrics and Child Health API (https://growth.rcpch.ac.uk/).</items>
          <items id="description">Specifies the standard or syndrome-specific reference charts used to calculate the growth indicator data.</items>
          <items id="text">Growth reference chart</items>
        </term_definitions>
        <term_definitions code="at0043">
          <items id="comment">For example:  a choice between &lt;-3, &lt;-2, or Normal.</items>
          <items id="description">The category or grouping of the Z score.</items>
          <items id="text">Z-score category</items>
        </term_definitions>
      </children>
