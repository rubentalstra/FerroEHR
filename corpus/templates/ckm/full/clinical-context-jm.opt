        <term_definitions code="at0000">
          <items id="description">A summary of donation events made by an individual, for biological products including blood, plasma, stem cells, semen, ova or other human-derived materials.</items>
          <items id="text">Biological donation summary</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
