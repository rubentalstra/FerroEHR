            <archetype_id>
              <value>openEHR-EHR-EVALUATION.vaccination_summary.v0</value>
            </archetype_id>
            <term_definitions code="at0000">
              <items id="description">Summary of vaccination administration for a single infectious disease or agent, or a group of infectious diseases or agents that are vaccinated simultaneously using a combination vaccine.</items>
              <items id="text">Vaccination summary</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">@ internal @</items>
              <items id="text">Tree</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="comment">If the 'Vaccine name' is a combination vaccine this data element may contain more than one target disease. Coding with an external terminology is preferred, where possible.</items>
              <items id="description">Name of the infectious disease or agent targeted by the vaccine.</items>
              <items id="text">Targeted disease or agent</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="comment">This status should be revised if the course has not been completed and the 'Next vaccination due' date or 'Next review due' has passed.</items>
              <items id="description">Status of the primary (or catch up) course of vaccinations.</items>
              <items id="text">Primary course status</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="description">A course of vaccinations is planned but not commenced.</items>
              <items id="text">Course not commenced</items>
            </term_definitions>
            <term_definitions code="at0005">
              <items id="description">A course of vaccinations has been commenced but not completed.</items>
              <items id="text">Course incomplete</items>
            </term_definitions>
            <term_definitions code="at0006">
              <items id="description">A course of vaccinations has been completed.</items>
              <items id="text">Course complete</items>
            </term_definitions>
            <term_definitions code="at0007">
              <items id="description">It is not possible to determine if the primary course has been completed.</items>
              <items id="text">Unknown</items>
            </term_definitions>
            <term_definitions code="at0008">
              <items id="description">The date on which the (primary or catch-up) course of vaccines was completed.</items>
              <items id="text">Date course completed</items>
            </term_definitions>
            <term_definitions code="at0009">
              <items id="comment">Can be a partial date, for example, only a year.</items>
              <items id="description">The date when the most recent vaccine was administered.</items>
              <items id="text">Date of last vaccination</items>
            </term_definitions>
            <term_definitions code="at0013">
              <items id="description">@ internal @</items>
              <items id="text">Tree</items>
            </term_definitions>
            <term_definitions code="at0015">
              <items id="description">The date on which the immunisation summary was last updated.</items>
              <items id="text">Last updated</items>
            </term_definitions>
            <term_definitions code="at0016">
              <items id="description">Additional narrative about the vaccine administration for the identified vaccinet, not captured in other fields.</items>
              <items id="text">Administration comment</items>
            </term_definitions>
            <term_definitions code="at0022">
              <items id="description">Details about a specific vaccine administration.</items>
              <items id="text">Per vaccine administration</items>
            </term_definitions>
            <term_definitions code="at0023">
              <items id="comment">For example: a trade name that may be more specific than  the index 'Vaccine name'.</items>
              <items id="description">Name of the specific vaccine administered.</items>
              <items id="text">Specific vaccine name</items>
            </term_definitions>
            <term_definitions code="at0024">
              <items id="comment">Can be a partial date, for example, only a year.</items>
              <items id="description">Date of administration of the specified vaccine.</items>
              <items id="text">Date of administration</items>
            </term_definitions>
            <term_definitions code="at0027">
              <items id="description">*</items>
              <items id="text">Administration location</items>
            </term_definitions>
            <term_definitions code="at0031">
              <items id="comment">For example: 1/2 for first vaccination in a series of 2.</items>
              <items id="description">The sequence of the vaccine administered within a primary course or series.</items>
              <items id="text">Sequence in series</items>
            </term_definitions>
            <term_definitions code="at0033">
              <items id="description">The date when the next vaccine is due to be administered.</items>
              <items id="text">Next vaccination due</items>
            </term_definitions>
            <term_definitions code="at0034">
              <items id="description">Details about the vaccine, including generic components and batch number if required.</items>
              <items id="text">Vaccine details</items>
            </term_definitions>
            <term_definitions code="at0035">
              <items id="description">Narrative description about vaccination activity and experiences related to the targeted disease or agent.</items>
              <items id="text">Description</items>
            </term_definitions>
            <term_definitions code="at0038">
              <items id="comment">For example: primary vaccination; or booster.</items>
              <items id="description">Category of the vaccine administered.</items>
              <items id="text">Administration category</items>
            </term_definitions>
            <term_definitions code="at0039">
              <items id="description">*</items>
              <items id="text">Primary course</items>
            </term_definitions>
            <term_definitions code="at0040">
              <items id="description">*</items>
              <items id="text">Booster</items>
            </term_definitions>
            <term_definitions code="at0042">
              <items id="description">Narrative description about the vaccine administration.</items>
              <items id="text">Description</items>
            </term_definitions>
            <term_definitions code="at0044">
              <items id="description">Additional details about the specific vaccine administration.</items>
              <items id="text">Additional details</items>
            </term_definitions>
            <term_definitions code="at0045">
              <items id="comment">Coding with an external terminology is preferred, where possible. For example: a reaction such as rash or shortness of breath.</items>
              <items id="description">The observed response to the administration of vaccine.</items>
              <items id="text">Administration outcome</items>
            </term_definitions>
            <term_definitions code="at0046">
              <items id="comment">For example: child health book, clinic record, or parent.</items>
              <items id="description">Identification of the source of the vaccine administration information.</items>
              <items id="text">Information source</items>
            </term_definitions>
            <term_definitions code="at0047">
              <items id="comment">May be manually calculated or extracted from EHR sources.</items>
              <items id="description">Total number of vaccine doses administered over the lifetime of the individual.</items>
              <items id="text">Total number of administrations</items>
            </term_definitions>
            <term_definitions code="at0048">
              <items id="description">*</items>
              <items id="text">Unknown</items>
            </term_definitions>
            <term_definitions code="at0049">
              <items id="description">Additional narrative about vaccination administrationfor the identified disease or agent, not captured in other fields.</items>
              <items id="text">Comment</items>
            </term_definitions>
            <term_definitions code="at0050">
              <items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items>
              <items id="description">Additional information required to extend the model with local content or to align with other reference models/formalisms.</items>
              <items id="text">Extension</items>
            </term_definitions>
            <term_definitions code="at0051">
              <items id="description">Additional details about vaccinations related to the targeted disease or agent.</items>
              <items id="text">Additional details</items>
            </term_definitions>
            <term_definitions code="at0052">
              <items id="comment">The vaccine name may contain a generic or trade name for a vaccine, the name of a combination vaccine, or a category of vaccine. For example: Measles vaccine; Measles Mumps Rubella (MMR) or 'Measles-containing vaccine'. Coding with an external terminology is preferred, where possible.</items>
              <items id="description">Name of the vaccine administered.</items>
              <items id="text">Vaccine name</items>
            </term_definitions>
            <term_definitions code="at0053">
              <items id="comment">For example: child health book, clinic record, or parent.</items>
              <items id="description">Identification of the source of all vaccination information.</items>
              <items id="text">Information source</items>
            </term_definitions>
          </children>
