        <archetype_id>
          <value>openEHR-EHR-EVALUATION.food_nutrition_summary.v0</value>
        </archetype_id>
        <template_id>
          <value>Food and nutrition summary - JM</value>
        </template_id>
        <term_definitions code="at0000">
          <items id="description">Summary of the food and nutritional situation for an individual.</items>
          <items id="text">Food and nutrition summary</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">Description of the individual's nutritional status as assessed by a clinician, for example, malnourished or well nourished. Coding with a terminology is desirable, where possible.</items>
          <items id="text">Nutrition status</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">Assessment of the individual's weight status.</items>
          <items id="text">Weight status</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="description">Is underweight for age and sex according to BMI or other measure.</items>
          <items id="text">Underweight</items>
        </term_definitions>
        <term_definitions code="at0005">
          <items id="description">Is overweight for age and sex according to BMI or other measure.</items>
          <items id="text">Overweight</items>
        </term_definitions>
        <term_definitions code="at0006">
          <items id="description">Is obese for age and sex according to BMI or other measure.</items>
          <items id="text">Obese</items>
        </term_definitions>
        <term_definitions code="at0007">
          <items id="description">Is normal weight for age and sex according to BMI or other measure.</items>
          <items id="text">Normal</items>
        </term_definitions>
        <term_definitions code="at0008">
          <items id="comment">For example: omnivore; vegetarian or vegan. Coding with a terminology is desirable, where possible.</items>
          <items id="description">A description of an individual's dietary preference.</items>
          <items id="text">Dietary preference</items>
        </term_definitions>
        <term_definitions code="at0009">
          <items id="comment">For example: lactose or gluten free; low sodium. Coding with a terminology is desirable, where possible.</items>
          <items id="description">Description of a special dietary requirements or constraints.</items>
          <items id="text">Dietary constraints</items>
        </term_definitions>
        <term_definitions code="at0010">
          <items id="description">Comment about the individual's nutrition.</items>
          <items id="text">Comment</items>
        </term_definitions>
        <term_definitions code="at0011">
          <items id="description">Narrative description about the individual's diet and eating patterns.</items>
          <items id="text">Description</items>
        </term_definitions>
        <term_definitions code="at0012">
          <items id="description">@ internal @</items>
          <items id="text">Item tree</items>
        </term_definitions>
        <term_definitions code="at0013">
          <items id="description">Category describing the individual's perception about about secure and reliable access to food that is adequate in quantity and nutritional quality; culturally acceptable; safe; and acquired in socially acceptable ways.</items>
          <items id="text">Food security status</items>
        </term_definitions>
        <term_definitions code="at0014">
          <items id="description">The individual has a sense of certainty and peace of mind about their access to appropriate food.</items>
          <items id="text">Secure</items>
        </term_definitions>
        <term_definitions code="at0015">
          <items id="description">The individual has a sense of uncertainty about reliable and consistent access to appropriate food.</items>
          <items id="text">Changeable</items>
        </term_definitions>
        <term_definitions code="at0016">
          <items id="description">The individual has a sense of worry and concern about their access to appropriate food.</items>
          <items id="text">Insecure</items>
        </term_definitions>
        <term_definitions code="at0018">
          <items id="description">The date this summary was last updated.</items>
          <items id="text">Last updated</items>
        </term_definitions>
        <term_definitions code="at0019">
          <items id="comment">For example: local information requirements or additional metadata to align with FHIR or CIMI equivalents.</items>
          <items id="description">Additional information required to extend the model with local content or to align with other reference models/formalisms.</items>
          <items id="text">Extension</items>
        </term_definitions>
        <term_definitions code="at0020">
          <items id="description">Narrative description about the individual's ability to access appropriate food.</items>
          <items id="text">Food security description</items>
        </term_definitions>
        <term_definitions code="at0021">
          <items id="description">The type of milk available for consumption.</items>
          <items id="text">Milk supply</items>
        </term_definitions>
        <term_definitions code="at0022">
          <items id="description">Available milk is pasteurised.</items>
          <items id="text">Pasteurised</items>
        </term_definitions>
        <term_definitions code="at0023">
          <items id="description">Available milk is non-pasteurised.</items>
          <items id="text">Non-pasteurised</items>
        </term_definitions>
      </children>
