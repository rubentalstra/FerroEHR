        <term_definitions code="at0040">
          <items id="comment">This data element is intended to provide collection context for the question/answer groups when queried at a later date. It is not expected that this data element will be exposed to the individual, but only stored in data. For example: pre-admission screening, the name of the actual questionnaire or screening for previous use of a class of medications, such as bisphosphonates.</items>
          <items id="description">The context or reason for screening.</items>
          <items id="text">Screening purpose</items>
        </term_definitions>
        <term_definitions code="at0041">
          <items id="description">Structured details or questions about the specific vaccine or grouping of vaccines.</items>
          <items id="text">Additional details</items>
        </term_definitions>
        <term_definitions code="at0042">
          <items id="description">Structured details or questions about vaccination screening.</items>
          <items id="text">Additional details</items>
        </term_definitions>
        <term_definitions code="at0043">
          <items id="description">Narrative description about the history of administration of any vaccinations relevant for the screening purpose.</items>
          <items id="text">Description</items>
        </term_definitions>
        <term_definitions code="at0044">
          <items id="description">Name of the vaccination.</items>
          <items id="text">Vaccine name</items>
        </term_definitions>
        <term_definitions code="at0045">
          <items id="description">Name of the targeted infectious disease.</items>
          <items id="text">Disease name</items>
        </term_definitions>
        <term_definitions code="at0046">
          <items id="description">Presence or absence of an observed vaccine-related scar.</items>
          <items id="text">Scar present?</items>
        </term_definitions>
