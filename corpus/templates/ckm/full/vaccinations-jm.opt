        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="comment">For example: 'Fully vaccinated', 'Partially vaccinated' and 'Unvaccinated'; or 'Up-to-date' and 'Not up-to-date'.The recommendations will vary for each individual depending on the targeted disease/s or agent/s, age, geographical location and relevant health considerations.</items>
          <items id="description">An assertion about whether the individual has received all recommended vaccines for the targeted disease or agent.</items>
          <items id="text">Vaccination status</items>
        </term_definitions>
        <term_definitions code="at0005">
          <items id="comment">If the 'Vaccine name' is a combination vaccine this data element may contain more than one target disease. Coding with an external terminology is preferred, where possible.</items>
          <items id="description">Name of the infectious disease or agent targeted by a vaccine.</items>
          <items id="text">Targeted disease or agent</items>
        </term_definitions>
