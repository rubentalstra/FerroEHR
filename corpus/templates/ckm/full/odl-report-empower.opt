        <archetype_id>
          <value>openEHR-EHR-OBSERVATION.empower_sleep.v0</value>
        </archetype_id>
        <term_definitions code="at0000">
          <items id="description">Recording observations regarding sleep.</items>
          <items id="text">Sleep (EMPOWER)</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Event Series</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">Any sleep event during a single day.</items>
          <items id="text">Any event</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="description">@ internal @</items>
          <items id="text">Tree</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="description">Any comment related to the cause of sleep disturbance.</items>
          <items id="text">Comment</items>
        </term_definitions>
        <term_definitions code="at0005">
          <items id="description">The duration of a sleep event, in hours.</items>
          <items id="text">Sleep slot duration</items>
        </term_definitions>
        <term_definitions code="at0017">
          <items id="description">Percetpion of sleep quality by the subject him/herself.</items>
          <items id="text">Perceived Sleep Quality</items>
        </term_definitions>
        <term_definitions code="at0018">
          <items id="description">Very Bad.</items>
          <items id="text">Very Bad</items>
        </term_definitions>
        <term_definitions code="at0019">
          <items id="description">Fairly Bad.</items>
          <items id="text">Fairly Bad</items>
        </term_definitions>
        <term_definitions code="at0020">
          <items id="description">Neutral.</items>
          <items id="text">Neutral</items>
        </term_definitions>
        <term_definitions code="at0021">
          <items id="description">Fairly Good.</items>
          <items id="text">Fairly Good</items>
        </term_definitions>
        <term_definitions code="at0022">
          <items id="description">Very Good.</items>
          <items id="text">Very Good</items>
        </term_definitions>
        <term_definitions code="at0025">
          <items id="description">Symptoms related to recorded sleep session.</items>
          <items id="text">Related Symptom</items>
        </term_definitions>
