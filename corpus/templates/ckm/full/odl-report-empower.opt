                        <archetype_id>
                          <value>openEHR-EHR-CLUSTER.symptom.v1</value>
                        </archetype_id>
                        <term_definitions code="at0000">
                          <items id="description">A subjective observation of a physical or mental disturbance in the body of an individual.</items>
                          <items id="text">Symptom</items>
                        </term_definitions>
                        <term_definitions code="at0001">
                          <items id="comment">Symptom name should be coded with a terminology, where possible.</items>
                          <items id="description">The symptom experienced by the subject of care.</items>
                          <items id="text">Symptom name</items>
                        </term_definitions>
                        <term_definitions code="at0002">
                          <items id="description">Narrative description of the symptom as perceived by the subject of care.</items>
                          <items id="text">Description</items>
                        </term_definitions>
                        <term_definitions code="at0003">
                          <items id="description">The variation of the symptom during its course since onset.</items>
                          <items id="text">Variation</items>
                        </term_definitions>
                        <term_definitions code="at0004">
                          <items id="description">The symptom is constantly present.</items>
                          <items id="text">Constant</items>
                        </term_definitions>
                        <term_definitions code="at0005">
                          <items id="description">The symptom is present at times and not at others.</items>
                          <items id="text">Intermittent</items>
                        </term_definitions>
                        <term_definitions code="at0006">
                          <items id="description">The symptom varys considerably but is almost always present.</items>
                          <items id="text">Fluctuating</items>
                        </term_definitions>
                        <term_definitions code="at0017">
                          <items id="description">Perceived outcome after exposure of the variable on the symptom.</items>
                          <items id="text">Effect</items>
                        </term_definitions>
                        <term_definitions code="at0018">
                          <items id="description">Detail about how a specific factor impacts the symptom.</items>
                          <items id="text">Modifying Factor</items>
                        </term_definitions>
                        <term_definitions code="at0019">
                          <items id="comment">Examples of activities: lying on multiple pillows, eating or administration of medication.</items>
                          <items id="description">Name of an activity which might impact on the symptom.</items>
                          <items id="text">Factor</items>
                        </term_definitions>
                        <term_definitions code="at0021">
                          <items id="comment">Defining values such as mild, moderate or severe in such a way that is applicable to multiple symptoms plus allows multiple users to interpret and record them consistently is not easy. To extend the value set further with inclusion of additional values such as 'Trivial' and 'Very severe', and/or 'Mild-Moderate' and 'Moderate-Severe', adds to the definitional difficulty and may also worsen inter-recorder reliability issues. Use of 'Life-threatening' and 'Fatal' is also often considered as part of this value set, although from a pure point of view it may actually reflect an outcome rather than a severity. In view of the above, keeping to a well-defined but smaller list is preferred. Note: more specific grading of severity can be recorded using the 'Specific details' SLOT.</items>
                          <items id="description">The overall intensity of the symptom as reported by the individual.</items>
                          <items id="text">Severity</items>
                        </term_definitions>
                        <term_definitions code="at0023">
                          <items id="description">The intensity of the symptom does not cause interference with normal activity.</items>
                          <items id="text">Mild</items>
                        </term_definitions>
                        <term_definitions code="at0024">
                          <items id="description">The intensity of the symptom causes interference with normal activity.</items>
                          <items id="text">Moderate</items>
                        </term_definitions>
                        <term_definitions code="at0025">
                          <items id="description">The intensity of the symptom causes prevents normal activity.</items>
                          <items id="text">Severe</items>
                        </term_definitions>
                        <term_definitions code="at0026">
                          <items id="comment">Symptom severity can be rated by the individual by recording a score from 0 (symptom not present) to 10.0 (symptom is as severe as the individual can imagine).</items>
                          <items id="description">Rating scale for severity of the symptom.</items>
                          <items id="text">Visual analogue score</items>
                        </term_definitions>
                        <term_definitions code="at0028">
                          <items id="comment">If 'Date/time of onset' and 'Date/time of resolution' are used in systems, this data element may be calculated, or alternatively, considered redundant.</items>
                          <items id="description">The duration of the symptom since onset.</items>
                          <items id="text">Duration</items>
                        </term_definitions>
                        <term_definitions code="at0031">
                          <items id="description">The number of times this symptom has previously occurred.</items>
                          <items id="text">Number of previous episodes</items>
                        </term_definitions>
                        <term_definitions code="at0035">
                          <items id="comment">Record as True if the subject of care has not experienced the symptom.</items>
                          <items id="description">The individual has not experienced the symptom.</items>
                          <items id="text">Not present</items>
                        </term_definitions>
                        <term_definitions code="at0037">
                          <items id="comment">For example: a text description of the immediate onset of the symptom, activities that worsened or relieved the symptom, whether it is improving or worsening and how it resolved over weeks.</items>
                          <items id="description">Narrative description about the course of the symptom since onset.</items>
                          <items id="text">Course description</items>
                        </term_definitions>
                        <term_definitions code="at0056">
                          <items id="description">Narrative description of the effect of the modifying factor on the symptom.</items>
                          <items id="text">Description</items>
                        </term_definitions>
                        <term_definitions code="at0057">
                          <items id="comment">May include a comparison to this episode.</items>
                          <items id="description">Narrative description of any or all previous episodes.</items>
                          <items id="text">Description of previous episodes</items>
                        </term_definitions>
                        <term_definitions code="at0063">
                          <items id="description">Structured details about any associated symptoms that are concurrent.</items>
                          <items id="text">Associated symptoms</items>
                        </term_definitions>
                        <term_definitions code="at0146">
                          <items id="comment">In linked clinical systems, it is possible that previous epsiodes are already recorded within the EHR. Systems can allow the clinician to link to relevant previous episodes.
In an unlinked system or with a new patient, no previous episodes will be available and additional instances of the symptom archetype could be used to record the previous episodes.</items>
                          <items id="description">Structured details of the symptom during a previous episode.</items>
                          <items id="text">Previous episode</items>
                        </term_definitions>
                        <term_definitions code="at0147">
                          <items id="comment">If the anatomical location is included in the Symptom name via precoordinated codes, use of this SLOT becomes redundant.</items>
                          <items id="description">Slot to contain detailed and structured anatomical location details.</items>
                          <items id="text">Detailed anatomical location</items>
                        </term_definitions>
                        <term_definitions code="at0151">
                          <items id="comment">Occurrences for this data element are unbounded to allow for clinical scenarios such as describing a pain in multiple locations but where all of the other attributes such as impact and duration are identical. If the requirements for recording the body site are determined at run-time by the application or require more complex modelling such as relative locations then use the CLUSTER.anatomical_location or CLUSTER.relative_location within the Detailed anatomical location' SLOT in this archetype. 
If the anatomical location is included in the Symptom name via precoordinated codes, this data element becomes redundant.</items>
                          <items id="description">Record of a simple site on the body where the symptom was located.</items>
                          <items id="text">Anatomical location</items>
                        </term_definitions>
                        <term_definitions code="at0152">
                          <items id="comment">While partial dates are permitted, the exact date and time of onset can be recorded, if appropriate.</items>
                          <items id="description">The timing of the onset for this episode of the symptom.</items>
                          <items id="text">Date/time of onset</items>
                        </term_definitions>
                        <term_definitions code="at0153">
                          <items id="comment">For example: description of pain can require additional data elements describing the radiation and visual analogue rating scales; description of sore throat may include presence of fever or rigors, and difficulty swallowing.</items>
                          <items id="description">Specific data elements that are additionally required to record as unique attributes of the identified symptom.</items>
                          <items id="text">Specific details</items>
                        </term_definitions>
                        <term_definitions code="at0154">
                          <items id="description">Structured details about any associated symptoms that are concurrent.</items>
                          <items id="text">Associated events</items>
                        </term_definitions>
                        <term_definitions code="at0155">
                          <items id="comment">Assessment of impact should consider the severity, duration and frequency of the symptom. Examples for hearing loss may include: 'Difficulty Hearing in Quiet Environment'; 'Difficulty Hearing the TV or Radio'; 'Difficulty Hearing Group Conversation'; and 'Difficulty Hearing on Phone'.</items>
                          <items id="description">Description of the functional impact of this symptom.</items>
                          <items id="text">Impact</items>
                        </term_definitions>
                        <term_definitions code="at0156">
                          <items id="description">Presence of the factor has no impact on the symptom.</items>
                          <items id="text">No effect</items>
                        </term_definitions>
                        <term_definitions code="at0157">
                          <items id="description">Presence of the factor causes onset of the symptom.</items>
                          <items id="text">Precipitates</items>
                        </term_definitions>
                        <term_definitions code="at0158">
                          <items id="description">Presence of the factor exaccerbates the severity or impact of the symptom.</items>
                          <items id="text">Worsens</items>
                        </term_definitions>
                        <term_definitions code="at0159">
                          <items id="description">Presence of the factor reduces the severity or impact of the symptom.</items>
                          <items id="text">Relieves</items>
                        </term_definitions>
                        <term_definitions code="at0161">
                          <items id="comment">If 'Date/time of onset' and 'Duration' are used in systems, this data element may be calculated, or alternatively, considered redundant. While partial dates are permitted, the exact date and time of resolution can be recorded, if appropriate.</items>
                          <items id="description">The timing of the cessation of this episode of the symptom.</items>
                          <items id="text">Date/time of resolution</items>
                        </term_definitions>
                        <term_definitions code="at0162">
                          <items id="description">Presence of the factor resolves the symptom.</items>
                          <items id="text">Resolves</items>
                        </term_definitions>
                        <term_definitions code="at0163">
                          <items id="description">Additional narrative about the symptom not captured in other fields.</items>
                          <items id="text">Comment</items>
                        </term_definitions>
