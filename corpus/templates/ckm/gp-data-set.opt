            <term_definitions code="at0000">
              <items id="description">Summary of the immunisation status for an identified infectious disease or agent.</items>
              <items id="text">Immunisation summary</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">@ internal @</items>
              <items id="text">Tree</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="comment">There may be multiple diseases or agents that are vaccinated together - for example: diptheria, tetanus and pertussis or measles, mumps and rubella.</items>
              <items id="description">Identification of the infectious disease or agent.</items>
              <items id="text">Infectious disease or agent</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="description">Status of the primary course of immunisations.</items>
              <items id="text">Primary course status</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="description">Primary course was not commenced.</items>
              <items id="text">Not commenced</items>
            </term_definitions>
            <term_definitions code="at0005">
              <items id="description">Primary course was commenced but not completed.</items>
              <items id="text">Incomplete</items>
            </term_definitions>
            <term_definitions code="at0006">
              <items id="description">Primary course was completed.</items>
              <items id="text">Complete</items>
            </term_definitions>
            <term_definitions code="at0007">
              <items id="description">The available information is inadequate to determin the status of the primary course.</items>
              <items id="text">Indeterminate</items>
            </term_definitions>
            <term_definitions code="at0008">
              <items id="description">The date on which the primary  (or catch-up) course of vaccines was completed.</items>
              <items id="text">Date primary course completed</items>
            </term_definitions>
            <term_definitions code="at0009">
              <items id="description">The date of which the last vaccine booster was administered.</items>
              <items id="text">Date of last booster</items>
            </term_definitions>
            <term_definitions code="at0010">
              <items id="description">An assertion about whether the immunisation course is up-to-date.</items>
              <items id="text">Immunisation status</items>
            </term_definitions>
            <term_definitions code="at0011">
              <items id="description">The immunisation course is up-to-date.</items>
              <items id="text">Immunisation up-to-date</items>
            </term_definitions>
            <term_definitions code="at0012">
              <items id="description">The immunisation course is not up-to-date.</items>
              <items id="text">Immunisation not up-to-date</items>
            </term_definitions>
            <term_definitions code="at0013">
              <items id="description">@ internal @</items>
              <items id="text">Tree</items>
            </term_definitions>
            <term_definitions code="at0014">
              <items id="description">The date at which the immunisation summary should be reviewed and possibly updated.</items>
              <items id="text">Next review due</items>
            </term_definitions>
            <term_definitions code="at0015">
              <items id="description">The date on which the immunisation summary was last updated.</items>
              <items id="text">Last updated</items>
            </term_definitions>
            <term_definitions code="at0016">
              <items id="description">Additional narrative about the immunisation summary for the identified disease or agent, not captured in other fields.</items>
              <items id="text">Comment</items>
            </term_definitions>
          </children>
