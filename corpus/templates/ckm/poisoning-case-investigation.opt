        <archetype_id>
          <value>openEHR-EHR-EVALUATION.poisoning_summary.v0</value>
        </archetype_id>
        <term_definitions code="at0000">
          <items id="description">Summary details about a single poisoning event, including accidental exposure to a substance at home, in the workplace, or within the broader community or environment, as well as deliberate self-poisoning.</items>
          <items id="text">Poisoning event summary</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Item tree</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="description">Name of the substance or agent causally linked with the poisoning.</items>
          <items id="text">Substance name</items>
        </term_definitions>
        <term_definitions code="at0009">
          <items id="comment">The state of the substance or agent may be different in its' stored form, for example a liquid that is inhaled as a gas.</items>
          <items id="description">The physical form or presentation of the substance at the time of exposure.</items>
          <items id="text">Substance state</items>
        </term_definitions>
        <term_definitions code="at0015">
          <items id="description">Category of packaging for the substance.</items>
          <items id="text">Packaging context</items>
        </term_definitions>
        <term_definitions code="at0016">
          <items id="description">The route of exposure for the affected individual.</items>
          <items id="text">Route of exposure</items>
        </term_definitions>
        <term_definitions code="at0017">
          <items id="description">*</items>
          <items id="text">Ingested</items>
        </term_definitions>
        <term_definitions code="at0018">
          <items id="description">*</items>
          <items id="text">Injected</items>
        </term_definitions>
        <term_definitions code="at0019">
          <items id="description">*</items>
          <items id="text">Inhaled</items>
        </term_definitions>
        <term_definitions code="at0020">
          <items id="description">Contact via skin or mucosa.</items>
          <items id="text">Direct contact</items>
        </term_definitions>
        <term_definitions code="at0022">
          <items id="description">The amount, or estimate of the amount, of substance ingested, inhaled or absorbed by the individual.</items>
          <items id="text">Amount</items>
        </term_definitions>
        <term_definitions code="at0023">
          <items id="description">An unknown amount was ingested.</items>
          <items id="text">Unknown</items>
        </term_definitions>
        <term_definitions code="at0024">
          <items id="description">Narrative or category of the physical location where the poisoning event took place.</items>
          <items id="text">Location context</items>
        </term_definitions>
        <term_definitions code="at0025">
          <items id="description">Home of the poisoned individual or another person.</items>
          <items id="text">Residential</items>
        </term_definitions>
        <term_definitions code="at0027">
          <items id="description">Educational institution, such as a school, kindergarten, or university.</items>
          <items id="text">School</items>
        </term_definitions>
        <term_definitions code="at0028">
          <items id="description">Place of employment where the individual was working or present in a professional capacity.</items>
          <items id="text">Workplace</items>
        </term_definitions>
        <term_definitions code="at0029">
          <items id="description">Specific details about the organisation or physical address where the poisoning event took place.</items>
          <items id="text">Specific location</items>
        </term_definitions>
        <term_definitions code="at0034">
          <items id="comment">For example: well ventilated or enclosed space; indoors or outdoors.</items>
          <items id="description">Narrative or category describing of the physical or environmental context where the poisoning event occurred.</items>
          <items id="text">Physical context</items>
        </term_definitions>
        <term_definitions code="at0035">
          <items id="description">*</items>
          <items id="text">Well ventilated</items>
        </term_definitions>
        <term_definitions code="at0036">
          <items id="description">*</items>
          <items id="text">Poorly ventilated</items>
        </term_definitions>
        <term_definitions code="at0037">
          <items id="description">@ internal @</items>
          <items id="text">Item tree</items>
        </term_definitions>
        <term_definitions code="at0039">
          <items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items>
          <items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items>
          <items id="text">Extension</items>
        </term_definitions>
        <term_definitions code="at0040">
          <items id="description">Narrative description about the poisoning event.</items>
          <items id="text">Description</items>
        </term_definitions>
        <term_definitions code="at0042">
          <items id="description">The date and optional time of exposure to the substance or, for exposures extending over a period, the start of the exposure.</items>
          <items id="text">Date/time of exposure</items>
        </term_definitions>
        <term_definitions code="at0043">
          <items id="comment">More than one occurrence to record date/time for each level of medical service provided.</items>
          <items id="description">Date and time when the individual first attended a medical service after exposure.</items>
          <items id="text">Date/time of healthcare encounter</items>
        </term_definitions>
        <term_definitions code="at0044">
          <items id="comment">For example: first event or subsequent episode of poisoning</items>
          <items id="description">The type of occurrence of the poisoning event.</items>
          <items id="text">Event occurrence</items>
        </term_definitions>
        <term_definitions code="at0045">
          <items id="description">The event is the first ever exposure for the individual.</items>
          <items id="text">First occurrence</items>
        </term_definitions>
        <term_definitions code="at0046">
          <items id="description">The event is a second or subsequent exposure for the individual.</items>
          <items id="text">Subsequent occurrence</items>
        </term_definitions>
        <term_definitions code="at0047">
          <items id="description">The sequence number of this event within a series of related poisoning events.</items>
          <items id="text">Occurrence number</items>
        </term_definitions>
        <term_definitions code="at0048">
          <items id="description">Date/time this poisoning event summary was last updated.</items>
          <items id="text">Last updated</items>
        </term_definitions>
        <term_definitions code="at0053">
          <items id="description">Substance was stored in the manufacturer's original packaging and container.</items>
          <items id="text">Original packaging/container</items>
        </term_definitions>
        <term_definitions code="at0054">
          <items id="description">Substance was not stored in the manufacturer's original packaging or container.</items>
          <items id="text">Other packaging/container</items>
        </term_definitions>
        <term_definitions code="at0055">
          <items id="comment">For example: if the substance was labelled or packaged inappropriately.</items>
          <items id="description">Narrative description about the packaging of the substance.</items>
          <items id="text">Packaging description</items>
        </term_definitions>
        <term_definitions code="at0057">
          <items id="description">The colour of the substance at the time of exposure.</items>
          <items id="text">Substance colour</items>
        </term_definitions>
        <term_definitions code="at0058">
          <items id="comment">For example: occupational or non-occupational.</items>
          <items id="description">Narrative or category describing the occupational context of the poisoning event.</items>
          <items id="text">Occupational context</items>
        </term_definitions>
        <term_definitions code="at0060">
          <items id="comment">This data element has multiple occurrences to allow more than one risk factor to be recorded. Coding with an external terminology is recommended, if available.</items>
          <items id="description">Identification of a risk factor that contributed to the occurrence of the poisoning event.</items>
          <items id="text">Risk factor</items>
        </term_definitions>
        <term_definitions code="at0062">
          <items id="description">Another site other than residential, educational or workplace.</items>
          <items id="text">Other</items>
        </term_definitions>
        <term_definitions code="at0064">
          <items id="description">Substance flows to take the shape of its container; exposure by ingestion, dermal absorption, or accidental splashes.</items>
          <items id="text">Liquid</items>
        </term_definitions>
        <term_definitions code="at0065">
          <items id="description">Substance exists in a gaseous state, often invisible; exposure primarily by inhalation.</items>
          <items id="text">Gas</items>
        </term_definitions>
        <term_definitions code="at0066">
          <items id="description">Substance is a suspension of fine particles or liquid droplets dispersed in a gas.</items>
          <items id="text">Aerosol</items>
        </term_definitions>
        <term_definitions code="at0067">
          <items id="description">Substance is a fixed shape and volume; exposure by ingestion, inhalation as a dust or skin absorption.</items>
          <items id="text">Solid</items>
        </term_definitions>
        <term_definitions code="at0073">
          <items id="description">Specific type of solid form or presentation of the substance at the time of exposure.</items>
          <items id="text">Solid state type</items>
        </term_definitions>
        <term_definitions code="at0074">
          <items id="description">A solid dosage form of a substance, often compacted into a small, flat, or slightly rounded shape for oral administration.</items>
          <items id="text">Tablet</items>
        </term_definitions>
        <term_definitions code="at0075">
          <items id="description">A solid dosage form consisting of a substance enclosed within a soluble gelatin or similar shell for oral consumption.</items>
          <items id="text">Capsule</items>
        </term_definitions>
        <term_definitions code="at0076">
          <items id="description">A small, solid, rounded or cylindrical mass of a substance, typically used for controlled release or specific applications (e.g., pesticide pellets).</items>
          <items id="text">Pellet</items>
        </term_definitions>
        <term_definitions code="at0077">
          <items id="description">A large, solid mass of a substance, typically uniform in shape, used in bulk applications (e.g., rat poison blocks).</items>
          <items id="text">Block</items>
        </term_definitions>
        <term_definitions code="at0078">
          <items id="description">A finely ground, loose, dry substance consisting of small particles (e.g., talcum powder, powdered drugs).</items>
          <items id="text">Powder</items>
        </term_definitions>
        <term_definitions code="at0079">
          <items id="description">Small, irregularly shaped particles larger than powder but smaller than pellets (e.g., granular fertilizers or detergents).</items>
          <items id="text">Granule</items>
        </term_definitions>
        <term_definitions code="at0080">
          <items id="description">Solid substances with a defined geometric shape and internal structure due to their molecular arrangement  (e.g., salt crystals, methamphetamine).</items>
          <items id="text">Crystal</items>
        </term_definitions>
        <term_definitions code="at0081">
          <items id="description">Sharp, irregular fragments of a brittle solid.</items>
          <items id="text">Shard</items>
        </term_definitions>
        <term_definitions code="at0082">
          <items id="description">Thin, flat pieces of a substance, often irregularly shaped (e.g., paint flakes, graphite flakes).</items>
          <items id="text">Flake</items>
        </term_definitions>
        <term_definitions code="at0083">
          <items id="description">Thin, thread-like structures that may be woven or used individually (e.g., fiberglass, asbestos fibers).</items>
          <items id="text">Fibre</items>
        </term_definitions>
        <term_definitions code="at0084">
          <items id="description">Specific type of liquid form or presentation of the substance at the time of exposure.</items>
          <items id="text">Liquid state type</items>
        </term_definitions>
        <term_definitions code="at0085">
          <items id="description">Homogeneous mixtures where the poison is fully dissolved in a solvent, such as water or alcohol. For example: antifreeze (ethylene glycol) and certain cleaning agents.</items>
          <items id="text">Solution</items>
        </term_definitions>
        <term_definitions code="at0086">
          <items id="description">Heterogeneous mixtures containing solid particles dispersed in a liquid medium. For example, liquid pesticides with suspended active ingredients.</items>
          <items id="text">Suspension</items>
        </term_definitions>
        <term_definitions code="at0087">
          <items id="description">Mixtures of two immiscible liquids where one is dispersed in the other, often stabilized by emulsifiers. For example: medicinal creams and lotions.</items>
          <items id="text">Emulsion/Cream</items>
        </term_definitions>
        <term_definitions code="at0088">
          <items id="description">Semi-solid systems where a liquid is entrapped within a three-dimensional polymeric network, giving a jelly-like consistency. For example, hand sanitizers and certain topical medications.</items>
          <items id="text">Gel</items>
        </term_definitions>
        <term_definitions code="at0089">
          <items id="description">Irregular, larger solid pieces, not uniform in shape or size (e.g., broken pieces of solid chemicals).</items>
          <items id="text">Chunk</items>
        </term_definitions>
        <term_definitions code="at0090">
          <items id="description">Small, spherical particles, often uniform in size, used in industrial or pharmaceutical applications (e.g., silica gel beads, bead-based medications).</items>
          <items id="text">Bead</items>
        </term_definitions>
        <term_definitions code="at0091">
          <items id="description">Fine, dry particulate matter suspended in air or settled on surface.</items>
          <items id="text">Dust</items>
        </term_definitions>
        <term_definitions code="at0092">
          <items id="description">Colloidal systems where gas bubbles are dispersed in a liquid matrix. For example, some cleaning agents and cosmetic products.</items>
          <items id="text">Foam</items>
        </term_definitions>
        <term_definitions code="at0093">
          <items id="description">The exposure occurred in an occupational context.</items>
          <items id="text">Occupational</items>
        </term_definitions>
        <term_definitions code="at0094">
          <items id="description">The exposure did not occur in an occupational context.</items>
          <items id="text">Non-occupational context</items>
        </term_definitions>
        <term_definitions code="at0095">
          <items id="description">Additional narrative about the poisoning event not captured in other fields.</items>
          <items id="text">Comment</items>
        </term_definitions>
        <term_definitions code="at0096">
          <items id="comment">For example: supervised or unsupervised.</items>
          <items id="description">Narrative or category describing the safety context of the poisoning event.</items>
          <items id="text">Safety context</items>
        </term_definitions>
      </children>
