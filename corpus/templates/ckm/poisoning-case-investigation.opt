            <term_definitions code="at0000">
              <items id="description">Summary or persistent details about a treatment course or protocol for an identified condition.</items>
              <items id="text">Treatment summary</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">@ internal @</items>
              <items id="text">Item tree</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="description">@ internal @</items>
              <items id="text">Item tree</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="description">The name of the (main) treatment or course of treatment.</items>
              <items id="text">Treatment name</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="description">The date when the treatment or course of treatment was completed or stopped.</items>
              <items id="text">Date treatment stopped</items>
            </term_definitions>
            <term_definitions code="at0005">
              <items id="comment">For example: completed or not completed.</items>
              <items id="description">Description about the status of the treatment or treatment course.</items>
              <items id="text">Treatment status</items>
            </term_definitions>
            <term_definitions code="at0006">
              <items id="description">The name of the index disease, condition or injury.</items>
              <items id="text">Index problem</items>
            </term_definitions>
            <term_definitions code="at0007">
              <items id="description">Description of the reason why the course of treatment was not completed.</items>
              <items id="text">Reason for non-completion</items>
            </term_definitions>
            <term_definitions code="at0008">
              <items id="description">Category of the treatment outcome for the individual.</items>
              <items id="text">Treatment outcome</items>
            </term_definitions>
            <term_definitions code="at0010">
              <items id="comment">May be useful, for example, when the individual is lost to follow-up.</items>
              <items id="description">The date when the individual last attended for treatment.</items>
              <items id="text">Date last seen</items>
            </term_definitions>
            <term_definitions code="at0016">
              <items id="description">Narrative description about the overall treatment, not captured in other data elements.</items>
              <items id="text">Comment</items>
            </term_definitions>
            <term_definitions code="at0017">
              <items id="comment">For example: local information requirements; or additional metadata to align with FHIR.</items>
              <items id="description">Additional information required to extend the model with local content or to align with other reference models or formalisms.</items>
              <items id="text">Extension</items>
            </term_definitions>
            <term_definitions code="at0018">
              <items id="description">The date this treatment summary was last updated.</items>
              <items id="text">Last updated</items>
            </term_definitions>
            <term_definitions code="at0019">
              <items id="comment">For example: drug resistance profile; clinical evidence.</items>
              <items id="description">Additional structured details about the treatment.</items>
              <items id="text">Additional details</items>
            </term_definitions>
            <term_definitions code="at0021">
              <items id="description">The treatment or treatment course was completed.</items>
              <items id="text">Completed</items>
            </term_definitions>
            <term_definitions code="at0022">
              <items id="description">The treatment or treatment course was not completed.</items>
              <items id="text">Not completed</items>
            </term_definitions>
            <term_definitions code="at0023">
              <items id="description">Individual is considered cured; there is no ongoing evidence of the index problem.</items>
              <items id="text">Treatment successful</items>
            </term_definitions>
            <term_definitions code="at0024">
              <items id="description">Treatment was not successful; there is ongoing evidence of the index problem.</items>
              <items id="text">Treatment failed</items>
            </term_definitions>
            <term_definitions code="at0025">
              <items id="description">It is not known if the treatment was successful or unsuccessful.</items>
              <items id="text">Indeterminate</items>
            </term_definitions>
            <term_definitions code="at0027">
              <items id="comment">For example: drug resistance.</items>
              <items id="description">Reason for a failed treatment outcome.</items>
              <items id="text">Reason for failed outcome</items>
            </term_definitions>
            <term_definitions code="at0028">
              <items id="description">Narrative description about the treatment.</items>
              <items id="text">Description</items>
            </term_definitions>
            <term_definitions code="at0029">
              <items id="description">It is not known if the treatment or treatment course was completed or not.</items>
              <items id="text">Indeterminate</items>
            </term_definitions>
            <term_definitions code="at0032">
              <items id="description">The date when the treatment or course of treatment was started.</items>
              <items id="text">Date treatment started</items>
            </term_definitions>
            <term_definitions code="at0033">
              <items id="comment">Coding of the clinical indication with a terminology is preferred, where possible. For example: 'Cancer treatment' 'Angina' or 'Type 1 Diabetes mellitus'. 
This data element allows multiple occurrences to enable the user to record multiple responses, if required.</items>
              <items id="description">The clinical reason for the treatment.</items>
              <items id="text">Clinical indication</items>
            </term_definitions>
            <term_definitions code="at0034">
              <items id="comment">For example: Kurativ, palliative or preventiv intent.
Coding of the 'Intent' with a coding system is desirable, if available. 
This data element allows multiple occurrences to enable the user to record multiple responses, if required.</items>
              <items id="description">Description of the intent for the treatment.</items>
              <items id="text">Intent</items>
            </term_definitions>
            <term_definitions code="at0036">
              <items id="comment">For example: Chemotherapy before surgery in cancer treatment line (neoadjuvant chemotherapy).</items>
              <items id="description">Internal cluster to support documentation of complex, multicomponent treatments.</items>
              <items id="text">Additional treatment</items>
            </term_definitions>
            <term_definitions code="at0041">
              <items id="comment">For example: drug resistance profile; clinical evidence.</items>
              <items id="description">Additional structured details about the treatment.</items>
              <items id="text">Additional details</items>
            </term_definitions>
            <term_definitions code="at0042">
              <items id="description">The name of the additional treatment or the additional course of treatment.</items>
              <items id="text">Treatment name</items>
            </term_definitions>
            <term_definitions code="at0043">
              <items id="description">Narrative description about the additional treatment.</items>
              <items id="text">Description</items>
            </term_definitions>
            <term_definitions code="at0045">
              <items id="comment">For example: completed or not completed.</items>
              <items id="description">Description about the status of the additional treatment course.</items>
              <items id="text">Treatment status</items>
            </term_definitions>
            <term_definitions code="at0046">
              <items id="description">The treatment course was completed.</items>
              <items id="text">Completed</items>
            </term_definitions>
            <term_definitions code="at0047">
              <items id="description">The treatment course was not completed.</items>
              <items id="text">Not completed</items>
            </term_definitions>
            <term_definitions code="at0048">
              <items id="description">It is not known if the treatment course was completed or not.</items>
              <items id="text">Indeterminate</items>
            </term_definitions>
            <term_definitions code="at0049">
              <items id="description">The date when the additional treatment or course of the additional treatment was started.</items>
              <items id="text">Date treatment started</items>
            </term_definitions>
            <term_definitions code="at0050">
              <items id="description">The date when the additional treatment or course of additional treatment was completed.</items>
              <items id="text">Date treatment stopped</items>
            </term_definitions>
            <term_definitions code="at0051">
              <items id="description">Order of onset of the identified 'Additional treatment' in the sequence of treatments.</items>
              <items id="text">Treatment order</items>
            </term_definitions>
            <term_definitions code="at0052">
              <items id="description">The treatment or treatment course was partly completed.</items>
              <items id="text">Partly completed</items>
            </term_definitions>
            <term_definitions code="at0053">
              <items id="description">The treatment course was partly completed.</items>
              <items id="text">Partly completed</items>
            </term_definitions>
          </children>
