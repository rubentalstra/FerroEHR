            <term_definitions code="at0000">
              <items id="description">POEM (Patient-Oriented Eczema Measure).</items>
              <items id="text">Poem score</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">@ internal @</items>
              <items id="text">Event Series</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="description">Any event.</items>
              <items id="text">Any event</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="description">@ internal @</items>
              <items id="text">Tree</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="description">The symptom score.</items>
              <items id="text">Symptom score</items>
            </term_definitions>
            <term_definitions code="at0005">
              <items id="description">Frequency of the symptom.</items>
              <items id="text">Frequency</items>
            </term_definitions>
            <term_definitions code="at0006">
              <items id="description">The symptom was not experienced in the past week.</items>
              <items id="text">0 days</items>
            </term_definitions>
            <term_definitions code="at0007">
              <items id="description">The symptom was experienced on 1 or 2 days of the last week.</items>
              <items id="text">1-2 days</items>
            </term_definitions>
            <term_definitions code="at0008">
              <items id="description">The symptom was experienced on 3 or 4 days of the last week.</items>
              <items id="text">3-4 days</items>
            </term_definitions>
            <term_definitions code="at0009">
              <items id="description">The symptom was experienced on 5 or 6 days of the last week.</items>
              <items id="text">5-6 days</items>
            </term_definitions>
            <term_definitions code="at0010">
              <items id="description">The symptom was experienced every day of the past week.</items>
              <items id="text">Every day</items>
            </term_definitions>
            <term_definitions code="at0013">
              <items id="description">Symptom experienced by the patient in the past week.</items>
              <items id="text">Symptom name</items>
            </term_definitions>
            <term_definitions code="at0014">
              <items id="description">The patient experienced itch.</items>
              <items id="text">Itch</items>
            </term_definitions>
            <term_definitions code="at0015">
              <items id="description">The patient experienced sleep loss.</items>
              <items id="text">Sleep loss</items>
            </term_definitions>
            <term_definitions code="at0016">
              <items id="description">The patient experienced weeping skin.</items>
              <items id="text">Weeping</items>
            </term_definitions>
            <term_definitions code="at0017">
              <items id="description">The patient experienced cracking of skin.</items>
              <items id="text">Cracking</items>
            </term_definitions>
            <term_definitions code="at0018">
              <items id="description">The patient experienced flaking skin.</items>
              <items id="text">Flaking</items>
            </term_definitions>
            <term_definitions code="at0019">
              <items id="description">The patient experienced dry or rough skin.</items>
              <items id="text">Dry or rough skin</items>
            </term_definitions>
            <term_definitions code="at0020">
              <items id="comment">The score is the sum of the frequencies with which all of the symptoms are experienced in the past week.</items>
              <items id="description">The total Poem score.</items>
              <items id="text">Total Poem score</items>
            </term_definitions>
          </children>
