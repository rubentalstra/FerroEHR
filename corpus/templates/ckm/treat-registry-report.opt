            </archetype_id>
            <term_definitions code="at0000">
              <items id="description">The Investigators Global Assessment (IGA) is a 6 point scale.  It is a severity measure intended to provide a clinically meaningful snapshot of atopic dermatitis severity that can be understood by both patients and physicians.</items>
              <items id="text">Investigators Global Assessment</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">@ internal @</items>
              <items id="text">Event Series</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="description">Any event.</items>
              <items id="text">Any event</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="description">@ internal @</items>
              <items id="text">List</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="comment">A representative area should be utilised as a means to generate this score.</items>
              <items id="description">The total IGA score.</items>
              <items id="text">Investigator Global Assessment score</items>
            </term_definitions>
            <term_definitions code="at0005">
              <items id="description">No inflammatory signs of atopic dermatitis.</items>
              <items id="text">Clear</items>
            </term_definitions>
            <term_definitions code="at0006">
              <items id="description">Just perceptible erythema and just perceptible papulation/infiltration.</items>
              <items id="text">Almost clear</items>
            </term_definitions>
            <term_definitions code="at0007">
              <items id="description">Mild erythema and mild papulation/infiltration.</items>
              <items id="text">Mild disease</items>
            </term_definitions>
            <term_definitions code="at0008">
              <items id="description">Moderate erythema and moderate papulation/infiltration.</items>
              <items id="text">Moderate disease</items>
            </term_definitions>
            <term_definitions code="at0009">
              <items id="description">Severe erythema and severe papulation/infiltration.</items>
              <items id="text">Severe disease</items>
            </term_definitions>
            <term_definitions code="at0010">
              <items id="description">Severe erythema and severe papulation/infiltration with oozing/crusting.</items>
              <items id="text">Very severe disease</items>
            </term_definitions>
          </children>
