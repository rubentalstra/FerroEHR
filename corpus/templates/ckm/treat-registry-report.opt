            <term_definitions code="at0000">
              <items id="description">Atopic dermatitis EASI score.</items>
              <items id="text">EASI score</items>
            </term_definitions>
            <term_definitions code="at0001">
              <items id="description">@ internal @</items>
              <items id="text">Event Series</items>
            </term_definitions>
            <term_definitions code="at0002">
              <items id="description">Any event.</items>
              <items id="text">Any event</items>
            </term_definitions>
            <term_definitions code="at0003">
              <items id="description">@ internal @</items>
              <items id="text">Tree</items>
            </term_definitions>
            <term_definitions code="at0004">
              <items id="description">The part of the body being assessed.</items>
              <items id="text">Body area</items>
            </term_definitions>
            <term_definitions code="at0005">
              <items id="description">Head and neck skin area.</items>
              <items id="text">Head and neck</items>
            </term_definitions>
            <term_definitions code="at0006">
              <items id="description">Upper limb skin area.</items>
              <items id="text">Upper limbs</items>
            </term_definitions>
            <term_definitions code="at0007">
              <items id="description">The trunk skin area.</items>
              <items id="text">Trunk</items>
            </term_definitions>
            <term_definitions code="at0008">
              <items id="description">Lower limbs skin area.</items>
              <items id="text">Lower limbs</items>
            </term_definitions>
            <term_definitions code="at0009">
              <items id="description">The level of severity of the symptom for a representative part of the body area.</items>
              <items id="text">Severity index</items>
            </term_definitions>
            <term_definitions code="at0010">
              <items id="description">The extent of redness.</items>
              <items id="text">Redness</items>
            </term_definitions>
            <term_definitions code="at0011">
              <items id="description">The thickness of the lesion.</items>
              <items id="text">Thickness</items>
            </term_definitions>
            <term_definitions code="at0012">
              <items id="description">The extent of crusting.</items>
              <items id="text">Crusting</items>
            </term_definitions>
            <term_definitions code="at0013">
              <items id="description">The extent of lichenification.</items>
              <items id="text">Lichenification</items>
            </term_definitions>
            <term_definitions code="at0014">
              <items id="description">The symptom is absent.</items>
              <items id="text">Absent</items>
            </term_definitions>
            <term_definitions code="at0015">
              <items id="description">The symptom is mild.</items>
              <items id="text">Mild</items>
            </term_definitions>
            <term_definitions code="at0016">
              <items id="description">The symptom is moderate</items>
              <items id="text">Moderate</items>
            </term_definitions>
            <term_definitions code="at0017">
              <items id="description">The symptom is severe.</items>
              <items id="text">Severe</items>
            </term_definitions>
            <term_definitions code="at0018">
              <items id="description">The extent of the area affected.</items>
              <items id="text">Affected area</items>
            </term_definitions>
            <term_definitions code="at0019">
              <items id="description">1% to 9% of the body area is affected.</items>
              <items id="text">1% to 9%</items>
            </term_definitions>
            <term_definitions code="at0020">
              <items id="description">10% to 29% of the body area is affected.</items>
              <items id="text">10% to 29%</items>
            </term_definitions>
            <term_definitions code="at0021">
              <items id="description">30% to 49% of the body area is affected.</items>
              <items id="text">30% to 49%</items>
            </term_definitions>
            <term_definitions code="at0022">
              <items id="description">50% to 69% of the body area is affected.</items>
              <items id="text">50% to 69%</items>
            </term_definitions>
            <term_definitions code="at0023">
              <items id="description">70% to 89% of the body area is affected.</items>
              <items id="text">70% to 89%</items>
            </term_definitions>
            <term_definitions code="at0024">
              <items id="description">90% to 100% of the body area is affected.</items>
              <items id="text">90% to 100%</items>
            </term_definitions>
            <term_definitions code="at0025">
              <items id="description">The total EASI score.</items>
              <items id="text">Total EASI score</items>
            </term_definitions>
