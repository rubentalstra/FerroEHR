        <archetype_id>
          <value>openEHR-EHR-ADMIN_ENTRY.episode_institution.v0</value>
        </archetype_id>
        <term_definitions code="at0000">
          <items id="description">Administrative details about a period of admitted patient care between a formal or statistical admission and a formal or statistical separation, characterised by only one care type of care from a healthcare institution.</items>
          <items id="text">Episode of care - institution</items>
        </term_definitions>
        <term_definitions code="at0001">
          <items id="description">@ internal @</items>
          <items id="text">Item tree</items>
        </term_definitions>
        <term_definitions code="at0002">
          <items id="description">The date of transfer of care to home or another instituion, or date of death.</items>
          <items id="text">Separation date</items>
        </term_definitions>
        <term_definitions code="at0003">
          <items id="comment">For example: home; hospital; nursing home; or rehabilitation hospital.</items>
          <items id="description">The category of destination after discharge.</items>
          <items id="text">Destination category</items>
        </term_definitions>
        <term_definitions code="at0004">
          <items id="description">The date of formal or statistical admission to the institution.</items>
          <items id="text">Admission date</items>
        </term_definitions>
        <term_definitions code="at0006">
          <items id="comment">For example: recovered/not recovered/death.</items>
          <items id="description">Outcome for the individual at the end of the episode.</items>
          <items id="text">Outcome</items>
        </term_definitions>
        <term_definitions code="at0007">
          <items id="comment">For example: hospital, community, or nursing home. 'Admitted from' should be coded with a terminology, where possible.</items>
          <items id="description">Where the individual was admitted from into the institution.</items>
          <items id="text">Admitted from</items>
        </term_definitions>
