                    <archetype_id>
                      <value>openEHR-DEMOGRAPHIC-CLUSTER.person_additional_data_iso.v0</value>
                    </archetype_id>
                    <term_definitions code="at0000">
                      <items id="description">Person additional demographic data according to ISO 22220: sex and mother's family name</items>
                      <items id="text">Person additional demographic data</items>
                    </term_definitions>
                    <term_definitions code="at0001">
                      <items id="description">The sex of the subject.</items>
                      <items id="text">Sex</items>
                    </term_definitions>
                    <term_definitions code="at0002">
                      <items id="description">Mother's original family name</items>
                      <items id="text">Mother's family name</items>
                    </term_definitions>
                    <term_definitions code="at0003">
                      <items id="description">Comments recorded for a person registration to distinguish between two or more persons with the same or similar demographic information</items>
                      <items id="text">Identification comment</items>
                    </term_definitions>
                    <term_definitions code="at0010">
                      <items id="description">Male</items>
                      <items id="text">Male</items>
                    </term_definitions>
                    <term_definitions code="at0011">
                      <items id="description">Female</items>
                      <items id="text">Female</items>
                    </term_definitions>
                    <term_definitions code="at0012">
                      <items id="description">is normally used for babies for whom sex has not been determined for whatever reason, should not generally be used on data collection forms completed by the respondent and should only be used if the person or respondent volunteers that the person is intersex or where it otherwise becomes clear during the collection process that the individual is neither male nor female</items>
                      <items id="text">Intersex or indeterminate</items>
                    </term_definitions>
                    <term_definitions code="at0013">
                      <items id="description">is not to be used on primary collection forms. It is primarily for use in administrative collections when transferring data from data sets where the item has not been collected.</items>
                      <items id="text">Not declared/inadequately described</items>
                    </term_definitions>
                  </children>
