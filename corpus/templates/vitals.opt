<?xml version="1.0" encoding="utf-8"?>
<!-- CNF corpus vitals template (template_id `cnf.vitals`).

     Authored for the Simplified-Formats (SF-*) schedule cases and the
     update_composition-wrong_template case, all of which reference the
     `cnf.opt.vitals` corpus alias with `vitals/body_temperature:i/any_event:i/...`
     FLAT paths. The web-template node ids are generated from the archetype node
     NAMES per ITS-REST simplified_formats master04-basic_concepts.adoc
     §"Node ID Generation Rules": "Vitals"->vitals, "Body temperature"->
     body_temperature, "Any event"->any_event, "Temperature"->temperature,
     "Symptom"->symptom, "Body exposure"->body_exposure.

     Leaf constraint shapes (ITS-REST simplified_formats master05-rm_mapping.adoc):
       * Temperature = DV_QUANTITY (§DV_QUANTITY: |magnitude/|unit; /_normal_range
         is the RM-level DV_INTERVAL<DV_QUANTITY> attribute, needs no template
         constraint), property `openehr::127` (Temperature), unit `Cel`.
       * Symptom = OPEN coded value-set: ELEMENT.value is a DV_CODED_TEXT|DV_TEXT
         choice. master04 §"Open Value-Sets and the `|other` Suffix": an open
         value-set is "non-`limit-to-list` in ADL" and "the same leaf may at
         runtime carry either a DV_CODED_TEXT (chosen from the list) or a DV_TEXT
         (free-text value)"; the DV_TEXT alternative IS that openness, so `|other`
         is legal and `|other`+`|code` on the same leaf MUST be rejected as
         mutually exclusive (master05 §"When a DV_CODED_TEXT becomes a DV_TEXT").
       * Body exposure = CLOSED coded value-set: ELEMENT.value is DV_CODED_TEXT
         only (limit-to-list local code_list). master04 §"Open Value-Sets": on a
         closed list `|other` MUST be rejected, and a `|code` outside the bound
         set fails the terminology binding (master04 §Validation).

     Occurrences (master04 §Validation "Cardinality constraints are satisfied",
     §"Instance Indexing"): the OBSERVATION (body_temperature) is 0..* and the
     EVENT (any_event) is 0..*, so multiple `body_temperature:i` expand to
     distinct RM OBSERVATIONs and multiple `any_event:i` to distinct RM EVENTs
     (SF-INDEX-semantics / SF-INDEX-multi_event_commit). The Temperature ELEMENT
     (at0004) is 0..1, so a second `temperature:1` exceeds cardinality and is
     rejected (SF-FLAT-reject_cardinality). -->
<template xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="http://schemas.openehr.org/v1">
  <language>
    <terminology_id><value>ISO_639-1</value></terminology_id>
    <code_string>en</code_string>
  </language>
  <description>
    <original_author id="Original Author">CNF corpus</original_author>
    <lifecycle_state>Initial</lifecycle_state>
    <details>
      <language><terminology_id><value>ISO_639-1</value></terminology_id><code_string>en</code_string></language>
      <purpose>CNF Simplified-Formats vitals carrier template</purpose>
    </details>
  </description>
  <uid><value>c2a3a1a1-244b-41d7-9329-6b8a2c742889</value></uid>
  <template_id><value>cnf.vitals</value></template_id>
  <concept>Vitals</concept>
  <definition>
    <rm_type_name>COMPOSITION</rm_type_name>
    <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences>
    <node_id>at0000</node_id>
    <!-- category: event (openehr::433) -->
    <attributes xsi:type="C_SINGLE_ATTRIBUTE">
      <rm_attribute_name>category</rm_attribute_name>
      <existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence>
      <children xsi:type="C_COMPLEX_OBJECT">
        <rm_type_name>DV_CODED_TEXT</rm_type_name>
        <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences>
        <node_id />
        <attributes xsi:type="C_SINGLE_ATTRIBUTE">
          <rm_attribute_name>defining_code</rm_attribute_name>
          <existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence>
          <children xsi:type="C_CODE_PHRASE">
            <rm_type_name>CODE_PHRASE</rm_type_name>
            <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences>
            <node_id />
            <terminology_id><value>openehr</value></terminology_id>
            <code_list>433</code_list>
          </children>
        </attributes>
      </children>
    </attributes>
    <!-- content -> OBSERVATION body_temperature (occurrences 0..*: multiple
         body_temperature:i expand to distinct RM OBSERVATIONs, SF-INDEX-semantics) -->
    <attributes xsi:type="C_MULTIPLE_ATTRIBUTE">
      <rm_attribute_name>content</rm_attribute_name>
      <existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></existence>
      <children xsi:type="C_ARCHETYPE_ROOT">
        <rm_type_name>OBSERVATION</rm_type_name>
        <occurrences><lower_included>true</lower_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></occurrences>
        <node_id>at0000</node_id>
        <attributes xsi:type="C_SINGLE_ATTRIBUTE">
          <rm_attribute_name>data</rm_attribute_name>
          <existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence>
          <children xsi:type="C_COMPLEX_OBJECT">
            <rm_type_name>HISTORY</rm_type_name>
            <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences>
            <node_id>at0001</node_id>
            <attributes xsi:type="C_MULTIPLE_ATTRIBUTE">
              <rm_attribute_name>events</rm_attribute_name>
              <existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence>
              <!-- EVENT any_event: 0..* so any_event:0/any_event:1 expand to
                   distinct RM EVENTs (SF-INDEX-multi_event_commit) -->
              <children xsi:type="C_COMPLEX_OBJECT">
                <rm_type_name>EVENT</rm_type_name>
                <occurrences><lower_included>true</lower_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></occurrences>
                <node_id>at0002</node_id>
                <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                  <rm_attribute_name>data</rm_attribute_name>
                  <existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence>
                  <children xsi:type="C_COMPLEX_OBJECT">
                    <rm_type_name>ITEM_TREE</rm_type_name>
                    <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences>
                    <node_id>at0003</node_id>
                    <attributes xsi:type="C_MULTIPLE_ATTRIBUTE">
                      <rm_attribute_name>items</rm_attribute_name>
                      <existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></existence>
                      <!-- ELEMENT Temperature -> DV_QUANTITY (property openehr::127, unit Cel) -->
                      <children xsi:type="C_COMPLEX_OBJECT">
                        <rm_type_name>ELEMENT</rm_type_name>
                        <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></occurrences>
                        <node_id>at0004</node_id>
                        <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                          <rm_attribute_name>value</rm_attribute_name>
                          <existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></existence>
                          <children xsi:type="C_DV_QUANTITY">
                            <rm_type_name>DV_QUANTITY</rm_type_name>
                            <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences>
                            <node_id />
                            <property><terminology_id><value>openehr</value></terminology_id><code_string>127</code_string></property>
                            <list xsi:type="C_QUANTITY_ITEM"><units>Cel</units></list>
                          </children>
                        </attributes>
                      </children>
                      <!-- ELEMENT Symptom -> OPEN value-set: DV_CODED_TEXT|DV_TEXT choice -->
                      <children xsi:type="C_COMPLEX_OBJECT">
                        <rm_type_name>ELEMENT</rm_type_name>
                        <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></occurrences>
                        <node_id>at0005</node_id>
                        <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                          <rm_attribute_name>value</rm_attribute_name>
                          <existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></existence>
                          <children xsi:type="C_COMPLEX_OBJECT">
                            <rm_type_name>DV_CODED_TEXT</rm_type_name>
                            <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences>
                            <node_id />
                            <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                              <rm_attribute_name>defining_code</rm_attribute_name>
                              <existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence>
                              <children xsi:type="C_CODE_PHRASE">
                                <rm_type_name>CODE_PHRASE</rm_type_name>
                                <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences>
                                <node_id />
                                <terminology_id><value>local</value></terminology_id>
                                <code_list>at0010</code_list>
                                <code_list>at0011</code_list>
                              </children>
                            </attributes>
                          </children>
                          <children xsi:type="C_COMPLEX_OBJECT">
                            <rm_type_name>DV_TEXT</rm_type_name>
                            <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences>
                            <node_id />
                          </children>
                        </attributes>
                      </children>
                      <!-- ELEMENT Body exposure -> CLOSED value-set: DV_CODED_TEXT only -->
                      <children xsi:type="C_COMPLEX_OBJECT">
                        <rm_type_name>ELEMENT</rm_type_name>
                        <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></occurrences>
                        <node_id>at0006</node_id>
                        <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                          <rm_attribute_name>value</rm_attribute_name>
                          <existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>0</lower><upper>1</upper></existence>
                          <children xsi:type="C_COMPLEX_OBJECT">
                            <rm_type_name>DV_CODED_TEXT</rm_type_name>
                            <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences>
                            <node_id />
                            <attributes xsi:type="C_SINGLE_ATTRIBUTE">
                              <rm_attribute_name>defining_code</rm_attribute_name>
                              <existence><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></existence>
                              <children xsi:type="C_CODE_PHRASE">
                                <rm_type_name>CODE_PHRASE</rm_type_name>
                                <occurrences><lower_included>true</lower_included><upper_included>true</upper_included><lower_unbounded>false</lower_unbounded><upper_unbounded>false</upper_unbounded><lower>1</lower><upper>1</upper></occurrences>
                                <node_id />
                                <terminology_id><value>local</value></terminology_id>
                                <code_list>at0020</code_list>
                                <code_list>at0021</code_list>
                              </children>
                            </attributes>
                          </children>
                        </attributes>
                      </children>
                      <cardinality><is_ordered>false</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></interval></cardinality>
                    </attributes>
                  </children>
                </attributes>
              </children>
              <cardinality><is_ordered>false</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>1</lower></interval></cardinality>
            </attributes>
          </children>
        </attributes>
        <archetype_id><value>openEHR-EHR-OBSERVATION.body_temperature.v1</value></archetype_id>
        <term_definitions code="at0000"><items id="description">Body temperature observation</items><items id="text">Body temperature</items></term_definitions>
        <term_definitions code="at0001"><items id="description">@ internal @</items><items id="text">History</items></term_definitions>
        <term_definitions code="at0002"><items id="description">Any event</items><items id="text">Any event</items></term_definitions>
        <term_definitions code="at0003"><items id="description">@ internal @</items><items id="text">Tree</items></term_definitions>
        <term_definitions code="at0004"><items id="description">The measured body temperature</items><items id="text">Temperature</items></term_definitions>
        <term_definitions code="at0005"><items id="description">Associated symptom</items><items id="text">Symptom</items></term_definitions>
        <term_definitions code="at0006"><items id="description">Body exposure during measurement</items><items id="text">Body exposure</items></term_definitions>
        <term_definitions code="at0010"><items id="description">Fever</items><items id="text">Fever</items></term_definitions>
        <term_definitions code="at0011"><items id="description">Chills</items><items id="text">Chills</items></term_definitions>
        <term_definitions code="at0020"><items id="description">Naked</items><items id="text">Naked</items></term_definitions>
        <term_definitions code="at0021"><items id="description">Clothed</items><items id="text">Clothed</items></term_definitions>
      </children>
      <cardinality><is_ordered>false</is_ordered><is_unique>false</is_unique><interval><lower_included>true</lower_included><lower_unbounded>false</lower_unbounded><upper_unbounded>true</upper_unbounded><lower>0</lower></interval></cardinality>
    </attributes>
    <archetype_id><value>openEHR-EHR-COMPOSITION.encounter.v1</value></archetype_id>
    <template_id><value>cnf.vitals</value></template_id>
    <term_definitions code="at0000"><items id="description">Vitals</items><items id="text">Vitals</items></term_definitions>
  </definition>
</template>
